These people are on the Attend ban list but still enrolled in events that
haven't ended. The ban only blocks new adds, so review and withdraw them by hand.

<% @by_participant.each do |participant, participant_events| %>
<%= participant.full_name %> (<%= participant.email %>)
<% participant_events.each do |pe| %>
  - <%= pe.event.name %><%= " (#{pe.event.starts_at.strftime('%b %-d, %Y')})" if pe.event.starts_at %>, <%= pe.status.humanize.downcase %>
    <%= participant_url(pe) %>
<% end %>

<% end %>
Ban list: <%= @bans_url %>

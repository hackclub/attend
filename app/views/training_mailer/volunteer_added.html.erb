<p>Hi <%= @first_name %>,</p>

<p>
  <% if @added_by %>
    <strong><%= @added_by.name.presence || @added_by.email %></strong> added you as a volunteer at
  <% else %>
    You've been added as a volunteer at
  <% end %>
  <strong><%= @event.name %></strong>.
</p>

<% if @badges.any? %>
  <p>
    Everyone working at a Hack Club event needs to complete our safeguarding training first.
    Before the event, please earn <%= @badges.map { |badge| "<strong>#{ERB::Util.h(badge.name)}</strong>" }.to_sentence.html_safe %>
    on Attend — sign in with your Hack Club account using this email address (<%= @user.email %>).
  </p>

  <p><%= mail_button "Start your training", @training_url %></p>
<% end %>

<p>
  <% if @added_by %>
    Questions? Just reply to this email and it'll go to <%= @added_by.email %>.
  <% else %>
    Questions? Just reply to this email.
  <% end %>
</p>

<% content_for :title, "Attend – Hack Club" %>

<% if user_signed_in? %>
  <div class="flex flex-col items-center justify-center py-16">
    <h1 class="text-2xl font-semibold mb-4">Welcome back</h1>
    <p class="text-(--text-soft) mb-8">You're signed in as <%= current_user.email %></p>
    <%= link_to "Go to Dashboard", dashboard_path,
          class: "bg-[#d42f46] hover:bg-[#b82840] text-[var(--accent-on)] font-medium py-2.5 px-6 rounded-md transition-colors" %>
  </div>
<% else %>
  <% content_for :full_bleed, true %>
  <% content_for :head do %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <% end %>

  <div class="landing" data-controller="landing-map" data-landing-map-pins-value="<%= @landing[:pins].to_json %>">
    <header class="landing-header">
      <div class="landing-header-inner">
        <div class="flex shrink-0 items-center gap-2.5">
          <img src="/icon-512.png" alt="" class="size-8 shrink-0">
          <span class="text-xl font-bold text-(--text-strong)">Attend</span>
          <span class="hidden whitespace-nowrap text-sm text-(--text-soft) sm:inline">by Hack Club</span>
        </div>
        <%= button_to user_hack_club_omniauth_authorize_path,
              method: :post,
              data: { turbo: false },
              form: { class: "min-w-0" },
              class: "landing-cta" do %>
          <img src="https://assets.hackclub.com/icon-rounded.svg" alt="" width="20" height="20" class="size-5 shrink-0">
          Continue with Hack Club
        <% end %>
      </div>
    </header>

    <div class="landing-grid">
      <section class="landing-copy">
        <h1 class="landing-sentence">
          Attend has enabled
          <span class="landing-num"><%= number_with_delimiter(@landing[:events]) %></span>
          hackathons across the world, supporting
          <span class="landing-num"><%= number_with_delimiter(@landing[:students]) %></span>
          students from
          <span class="landing-num"><%= number_with_delimiter(@landing[:countries]) %></span>
          countries.
        </h1>

        <%# Doors for everyone who can't sign in. Never hidden at any width:
            guardians arrive from invite emails and incident reporters from an
            event, both overwhelmingly on phones. %>
        <nav class="landing-actions" aria-labelledby="landing-actions-heading">
          <h2 id="landing-actions-heading" class="landing-actions-label">Quick actions</h2>
          <ul class="landing-actions-list">
            <li>
              <%= link_to guardian_portal_center_path, class: "landing-action" do %>
                <span class="landing-action-title">Parent or guardian</span>
                <span class="landing-action-hint">Forms and consent for your child</span>
                <span class="landing-action-arrow" aria-hidden="true">→</span>
              <% end %>
            </li>
            <li>
              <%= link_to incident_report_path, class: "landing-action" do %>
                <span class="landing-action-title">Report an incident</span>
                <span class="landing-action-hint">Tell the safety team what happened</span>
                <span class="landing-action-arrow" aria-hidden="true">→</span>
              <% end %>
            </li>
            <li>
              <a href="mailto:attend@hackclub.com" class="landing-action">
                <span class="landing-action-title">Need help?</span>
                <span class="landing-action-hint">Email attend@hackclub.com</span>
                <span class="landing-action-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </nav>
      </section>

      <aside class="landing-map-column" aria-label="Map of events">
        <div class="landing-map-frame">
          <div data-landing-map-target="map" class="landing-map"></div>
          <div class="landing-legend" aria-hidden="true">
            <span><i class="landing-pin landing-pin--past landing-pin--static"></i>Happened</span>
            <span><i class="landing-pin landing-pin--upcoming landing-pin--static"></i>Upcoming</span>
          </div>
        </div>
      </aside>
    </div>

    <% if Rails.env.development? %>
      <div class="landing-dev">
        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-(--text-soft)">Development only</p>
        <%= form_with url: dev_sign_in_path, method: :post, class: "space-y-3" do |f| %>
          <%= f.email_field :email, placeholder: "you@hackclub.com",
                required: true,
                class: "w-full rounded-md border border-(--border-card) bg-(--bg-app) px-4 py-2.5 text-sm text-(--text-strong) focus:border-(--accent) focus:outline-none focus:ring-1 focus:ring-(--accent)" %>
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 text-xs text-(--text)">
              <%= f.check_box :create_user, class: "rounded border-(--border-card) text-(--accent) focus:ring-(--accent)" %>
              Create user if not found
            </label>
            <%= f.submit "Continue", class: "cursor-pointer rounded-md bg-(--bg-dark) px-4 py-2 text-sm font-medium text-[#ffffff] hover:opacity-90 transition-opacity" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

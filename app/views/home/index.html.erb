<% content_for :title, "Attend – Hack Club" %>

<% if user_signed_in? %>
  <div class="flex flex-col items-center justify-center py-16">
    <h1 class="text-2xl font-semibold mb-4">Welcome back</h1>
    <p class="text-[#5a6473] mb-8">You're signed in as <%= current_user.email %></p>
    <%= link_to "Go to Dashboard", dashboard_path,
          class: "bg-[#d42f46] hover:bg-[#b82840] text-[var(--accent-on)] font-medium py-2.5 px-6 rounded-md transition-colors" %>
  </div>
<% else %>
  <% content_for :full_bleed, true %>

  <div class="bg-[#f9fafc] text-[#3c4858] antialiased">
    <!-- Top nav. Mirrors the signed-in header treatment in the layout so the
         front door and the app read as one product. -->
    <header class="border-b border-[#e0e6ed] bg-white">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-2.5">
            <img src="/icon-512.png" alt="" class="size-8">
            <span class="text-xl font-bold text-[#1f2d3d]">Attend</span>
            <span class="whitespace-nowrap text-sm text-[#5a6473]">by Hack Club</span>
          </div>
          <%= button_to user_hack_club_omniauth_authorize_path,
                method: :post,
                data: { turbo: false },
                class: "inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-lg border border-[#e0e6ed] px-4 py-2 text-sm font-medium text-[#3c4858] hover:border-[#ec3750] hover:text-[#ec3750] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ec3750] transition-colors" do %>
            Sign in
            <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 4.47a.75.75 0 011.06 0l5 5a.75.75 0 010 1.06l-5 5a.75.75 0 11-1.06-1.06L11.69 10 7.21 5.53a.75.75 0 010-1.06z" clip-rule="evenodd"/>
            </svg>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section>
      <div class="mx-auto max-w-7xl px-6 pt-12 pb-16 lg:px-8 lg:pt-20 lg:pb-24">
        <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-12">
          <!-- Copy -->
          <div class="max-w-xl">
            <h1 class="text-4xl font-bold tracking-tight text-[#1f2d3d] text-balance sm:text-6xl lg:text-7xl">
              Run the event.<br>
              <span class="text-[#ec3750]">Not the spreadsheet.</span>
            </h1>
            <p class="mt-6 text-lg text-[#3c4858]">
              Attend is the internal platform Hack Club staff use to wrangle participants, travel, waivers, rooming, and everything else that goes into pulling off an event.
            </p>
            <div class="mt-10 flex flex-wrap items-center gap-4">
              <%= button_to user_hack_club_omniauth_authorize_path,
                    method: :post,
                    data: { turbo: false },
                    class: "inline-flex items-center gap-3 rounded-xl bg-[#d42f46] px-7 py-4 text-xl font-bold text-[var(--accent-on)] shadow-[var(--shadow-md)] hover:bg-[#b82840] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ec3750] transition-colors" do %>
                <img src="https://assets.hackclub.com/icon-rounded.svg" alt="" width="24" height="24" class="size-6">
                Continue with Hack Club
              <% end %>
              <a href="mailto:attend@hackclub.com" class="inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-medium text-[#3c4858] hover:text-[#ec3750] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ec3750]">
                Need access? <span aria-hidden="true" class="ml-1">→</span>
              </a>
            </div>

            <!-- Doors for everyone who can't sign in. Never hidden at any width:
                 guardians arrive from invite emails and incident reporters from
                 an event, both overwhelmingly on phones. -->
            <div class="mt-10 border-t border-[#e0e6ed] pt-6">
              <p class="text-sm text-[#5a6473]">Not Hack Club staff? You don't need an account.</p>
              <div class="mt-1 flex flex-col sm:flex-row sm:gap-8">
                <%= link_to guardian_portal_center_path, class: "group inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-medium text-[#1f2d3d] hover:text-[#ec3750] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ec3750]" do %>
                  Parent or guardian <span aria-hidden="true" class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
                <% end %>
                <%= link_to incident_report_path, class: "group inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-medium text-[#1f2d3d] hover:text-[#ec3750] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ec3750]" do %>
                  Report an incident <span aria-hidden="true" class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
                <% end %>
              </div>
            </div>

            <% if Rails.env.development? %>
              <div class="mt-12 rounded-xl border border-[#e0e6ed] bg-white p-5 shadow-[var(--shadow-sm)]">
                <p class="mb-3 text-xs font-medium uppercase tracking-wider text-[#5a6473]">Development only</p>
                <%= form_with url: dev_sign_in_path, method: :post, class: "space-y-3" do |f| %>
                  <%= f.email_field :email, placeholder: "you@hackclub.com",
                        required: true,
                        class: "w-full rounded-lg border border-[#e0e6ed] bg-[#f9fafc] px-4 py-2.5 text-sm text-[#1f2d3d] placeholder-[#5a6473] focus:border-[#ec3750] focus:outline-none focus:ring-1 focus:ring-[#ec3750]" %>
                  <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 text-xs text-[#3c4858]">
                      <%= f.check_box :create_user, class: "rounded border-[#e0e6ed] text-[#ec3750] focus:ring-[#ec3750]" %>
                      Create user if not found
                    </label>
                    <%= f.submit "Continue", class: "cursor-pointer rounded-lg bg-[#17171d] px-4 py-2 text-sm font-medium text-[#ffffff] hover:bg-[#252429] transition-colors" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Product peek. The real app's surfaces: white cards on snow, hairline
               borders, themed shadows. Hidden below lg — on a phone it is a full
               square of ornament between the CTA and the real content. -->
          <div aria-hidden="true" class="relative hidden lg:block">
            <div class="relative mx-auto aspect-square w-full max-w-lg">
              <!-- Event card -->
              <div class="absolute left-0 top-6 w-[70%] rounded-xl border border-[#e0e6ed] bg-white p-5 shadow-[var(--shadow-lg)]">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-xl font-bold text-[#1f2d3d]">Assemble</p>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#33d6a6]/10 px-2.5 py-1 text-xs font-medium text-[#1f2d3d]">
                    <span class="size-1.5 rounded-full bg-[#33d6a6]"></span>
                    Live
                  </span>
                </div>
                <p class="mt-1 text-sm text-[#5a6473]">San Francisco · Aug 8–11</p>
                <div class="mt-5 grid grid-cols-3 gap-3 border-t border-[#e0e6ed] pt-4 text-center">
                  <div>
                    <p class="text-lg font-semibold tabular-nums text-[#1f2d3d]">312</p>
                    <p class="text-xs text-[#5a6473]">Teens</p>
                  </div>
                  <div>
                    <p class="text-lg font-semibold tabular-nums text-[#1f2d3d]">41</p>
                    <p class="text-xs text-[#5a6473]">Staff</p>
                  </div>
                  <div>
                    <p class="text-lg font-semibold tabular-nums text-[#1f2d3d]">28</p>
                    <p class="text-xs text-[#5a6473]">Countries</p>
                  </div>
                </div>
              </div>

              <!-- Participant pass -->
              <div class="absolute right-0 top-32 w-[62%] overflow-hidden rounded-xl border border-[#e0e6ed] bg-white shadow-[var(--shadow-lg)]">
                <div class="bg-[#d42f46] px-4 py-2.5">
                  <p class="text-xs font-semibold uppercase tracking-widest text-[var(--accent-on)]">Attend · Pass</p>
                </div>
                <div class="p-4">
                  <div class="flex items-center gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#ec3750]/10 text-sm font-semibold text-[#ec3750]">FA</span>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold text-[#1f2d3d]">Fiona Albright</p>
                      <p class="text-xs text-[#5a6473]">Participant · Group B</p>
                    </div>
                  </div>
                  <div class="mt-4 grid grid-cols-5 gap-1">
                    <% 20.times do |i| %>
                      <div class="aspect-square rounded-[2px] <%= [ 0, 3, 5, 7, 8, 11, 14, 16, 18 ].include?(i) ? 'bg-[#1f2d3d]' : 'bg-[#e0e6ed]' %>"></div>
                    <% end %>
                  </div>
                  <div class="mt-3 flex items-center justify-between text-xs text-[#5a6473]">
                    <span>NFC · A8-3F-2C</span>
                    <span class="inline-flex items-center gap-1.5 font-medium text-[#1f2d3d]">
                      <span class="size-1.5 rounded-full bg-[#33d6a6]"></span>
                      Checked in
                    </span>
                  </div>
                </div>
              </div>

              <!-- Scanner toast -->
              <div class="absolute bottom-8 left-4 w-[62%] rounded-xl border border-[#e0e6ed] bg-white p-4 shadow-[var(--shadow-lg)]">
                <div class="flex items-center gap-3">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#33d6a6]/10 text-[#1f9d78]">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-[#1f2d3d]">Scanned in · Dining Hall</p>
                    <p class="text-xs text-[#5a6473]">Just now · by Max</p>
                  </div>
                  <span class="text-xs tabular-nums text-[#5a6473]">+1</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
<% end %>

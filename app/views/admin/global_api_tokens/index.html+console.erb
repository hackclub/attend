<% content_for :breadcrumbs, cs_breadcrumbs([ "API tokens", nil ]) %>
<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Global API tokens</h1>
      <p class="cs-description">
        Global tokens authenticate to the API as you, with your full global-admin access across every event —
        unless you limit one to specific scopes below. Only global admins can create them. Treat them like a password.
      </p>
    </div>
  </div>

  <% if flash[:global_api_token] %>
    <div class="cs-alert cs-alert-success" role="status">
      <%= cs_status_icon(:success) %>
      <div class="min-w-0">
        <p class="cs-alert-title">Your new token</p>
        <p class="flex flex-wrap items-center gap-2 my-1">
          <span class="cs-copy">
            <span class="cs-copy-value"><%= flash[:global_api_token] %></span>
          </span>
          <button type="button" class="cs-btn"
                  data-controller="clipboard"
                  data-clipboard-content-value="<%= flash[:global_api_token] %>"
                  data-action="click->clipboard#copy">Copy</button>
        </p>
        <p>Copy this token now. It won't be shown again.</p>
      </div>
    </div>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Create a token</h2>
    </div>
    <div class="cs-container-body">
      <%= form_with url: admin_global_api_tokens_path, method: :post, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
        <%= cs_field id: "name", label: "Name", optional: true, class: "max-w-md", constraint: "For example: reporting script" do |aria| %>
          <%= f.text_field :name, class: "cs-input", **aria %>
        <% end %>

        <fieldset class="cs-field">
          <legend class="cs-field-label">Limit to scopes<span class="cs-field-optional"> - optional</span></legend>
          <p class="cs-field-description">
            Leave every box unchecked for a full-access token. Tick one and the token can do
            <strong>only</strong> that — every other endpoint returns 403, including read-only ones.
          </p>
          <div class="mt-2">
            <% GlobalApiToken::SCOPES.each do |scope, label| %>
              <% scope_id = "scope_#{scope.parameterize.underscore}" %>
              <div class="cs-option">
                <%= check_box_tag "scopes[]", scope, false, id: scope_id %>
                <div>
                  <label for="<%= scope_id %>" class="cs-option-label"><%= label %></label>
                  <p class="cs-option-description"><code><%= scope %></code></p>
                </div>
              </div>
            <% end %>
          </div>
        </fieldset>

        <div class="flex justify-end mt-4">
          <%= f.button "Generate token", class: "cs-btn cs-btn-primary cs-btn-full" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Your tokens <span class="cs-counter">(<%= @global_api_tokens.size %>)</span></h2>
    </div>

    <% if @global_api_tokens.any? %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Scope</th>
              <th scope="col">Created</th>
              <th scope="col">Last used</th>
              <th scope="col">Status</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @global_api_tokens.each do |token| %>
              <tr>
                <td><%= token.name.presence || "Untitled" %></td>
                <td>
                  <% if token.unrestricted? %>
                    <%= cs_badge("Full access", "yellow") %>
                  <% else %>
                    <div class="cs-token-group">
                      <% token.scope_labels.each do |label| %>
                        <span class="cs-token cs-token-readonly"><%= label %></span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td class="whitespace-nowrap"><%= cs_relative_time(token.created_at) %></td>
                <td class="whitespace-nowrap"><%= token.last_used_at ? cs_relative_time(token.last_used_at) : "Never" %></td>
                <td class="whitespace-nowrap">
                  <% if token.active? %>
                    <%= cs_status(:success, "Active") %>
                  <% else %>
                    <%= cs_status(:stopped, "Revoked") %>
                  <% end %>
                </td>
                <td class="text-right">
                  <% if token.active? %>
                    <%= button_to "Revoke",
                          revoke_admin_global_api_token_path(token),
                          method: :delete,
                          data: { turbo_confirm: "Revoke this token? Anything using it will immediately lose access." },
                          class: "cs-btn cs-btn-link" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="cs-empty">
        <p class="cs-empty-title">No tokens yet.</p>
      </div>
    <% end %>
  </section>

  <details class="cs-expandable cs-expandable-container">
    <summary>API usage example</summary>
    <div class="cs-expandable-content">
      <pre class="cs-copy-value p-3 rounded bg-(--cs-bg-shaded) overflow-x-auto">curl <%= api_v1_events_url %> \
  -H "Authorization: Bearer YOUR_GLOBAL_TOKEN"</pre>
      <p class="cs-small cs-secondary mt-3 mb-1">With a token scoped to <code>bans:write</code>:</p>
      <pre class="cs-copy-value p-3 rounded bg-(--cs-bg-shaded) overflow-x-auto">curl -X POST <%= api_v1_bans_url %> \
  -H "Authorization: Bearer YOUR_SCOPED_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"email":"banned@example.com","reason":"why"}'</pre>
    </div>
  </details>
</div>

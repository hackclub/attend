<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Staff", nil ]) %>
<% role_badge_colors = { "event_admin" => "red", "ops" => "blue", "limited" => "green", "safeguarding_lead" => "yellow", "read_only" => nil } %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Event staff <span class="cs-counter">(<%= @event_role_assignments.size %>)</span></h1>
    </div>
    <div class="cs-actions">
      <%= link_to "Add staff member", new_admin_event_staff_path(current_event), class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Staff</h2>
    </div>
    <% if @event_role_assignments.any? %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">User</th>
              <th scope="col">Role</th>
              <th scope="col">Added</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @event_role_assignments.each do |assignment| %>
              <tr>
                <td class="whitespace-nowrap">
                  <div><%= assignment.user.display_name_or_fallback %></div>
                  <div class="cs-small cs-secondary"><%= assignment.user.email %></div>
                </td>
                <td class="whitespace-nowrap">
                  <%= cs_badge(assignment.role.titleize, role_badge_colors[assignment.role]) %>
                </td>
                <td class="whitespace-nowrap"><%= cs_relative_time(assignment.created_at) %></td>
                <td class="whitespace-nowrap text-right">
                  <% if assignment.inherited_from_series? %>
                    <span title="Series <%= assignment.series_role %>s act as event admins on every event in the series. Manage them from the series members page."><%= cs_status(:info, "Inherited from series") %></span>
                  <% else %>
                    <%= button_to "Remove", admin_event_staff_path(current_event, assignment), method: :delete, class: "cs-btn cs-btn-link", data: { turbo_confirm: "Are you sure you want to remove #{assignment.user.email} from this event?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="cs-empty">
        <p class="cs-empty-title">No staff members assigned to this event yet</p>
        <p>Add staff members to give them access to manage this event.</p>
        <div class="cs-actions">
          <%= link_to "Add staff member", new_admin_event_staff_path(current_event), class: "cs-btn" %>
        </div>
      </div>
    <% end %>
  </section>

  <div class="cs-alert">
    <%= cs_status_icon(:info) %>
    <div>
      <p class="cs-alert-title">Role permissions</p>
      <%# Driven off ROLE_DETAILS so this legend can't drift from what the roles
          actually do — the full can/cannot breakdown is on the Add Staff page. %>
      <ul class="mt-1 space-y-1">
        <% EventRoleAssignment::ROLE_DETAILS.each do |_role, details| %>
          <li><strong><%= details[:label] %>:</strong> <%= details[:summary] %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

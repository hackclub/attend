<%# How many people on this event's roster are missing required training.
    Locals: summary (TrainingStatus#summary) %>
<% if summary[:untrained].positive? %>
  <div class="cs-alert cs-alert-error">
    <%= cs_status_icon(:error) %>
    <div>
      <p class="cs-alert-title"><%= summary[:untrained] %> of <%= summary[:required] %> people need to complete their training</p>
      <p>They're marked "Not trained" below. Send them to <%= link_to training_url, training_url, class: "cs-link" %> to do it.</p>
    </div>
  </div>
<% elsif summary[:required].positive? %>
  <div class="cs-alert cs-alert-success">
    <%= cs_status_icon(:success) %>
    <div>
      <p class="cs-alert-title">Everyone who needs training has done it</p>
      <% if summary[:expiring].positive? %><p><%= pluralize(summary[:expiring], "person") %> should renew soon.</p><% end %>
    </div>
  </div>
<% end %>

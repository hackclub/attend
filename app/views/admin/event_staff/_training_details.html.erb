<%# How someone's connected to the event, from the details they gave before
    training (TrainingProfile). Phone numbers stay with people who manage staff. %>
<% profile = user.training_profile %>
<% if profile %>
  <div class="text-sm text-gray-500 whitespace-normal"><%= profile.connection_label %>: <%= profile.connection_detail %></div>
  <% if can_manage_staff? %>
    <div class="text-sm text-gray-500"><%= link_to profile.phone_display, "tel:#{profile.phone_number}", class: "hover:underline" %></div>
  <% end %>
<% end %>

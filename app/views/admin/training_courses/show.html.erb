<div class="space-y-6">
  <%= link_to "← Training", admin_training_path, class: "text-sm text-gray-500 hover:text-[#ec3750]" %>
  <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @course.title %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= render "admin/training/course_status", course: @course %> · <%= @course.access_open? ? "open to anyone" : "invite-only" %> · pass mark <%= @course.pass_mark %>% · awards <%= @course.badge&.name || "no badge" %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Preview", training_course_path(@course), class: "px-4 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-50" unless @course.archived? %>
      <%= link_to "Edit", edit_admin_training_course_path(@course), class: "px-4 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-50" %>
      <% if @course.draft? || @course.archived? %>
        <%= button_to "Publish", admin_training_course_path(@course), method: :patch, params: { training_course: { status: "published" } }, class: "px-4 py-2 bg-[#d42f46] text-white rounded-md text-sm hover:bg-[#b82840]", data: { turbo_confirm: (@course.access_open? ? "Publish this course? Everyone signed in to Attend will be able to take it." : "Publish this course? Invited people, and staff whose role needs its badge, will be able to take it.") } %>
      <% else %>
        <%= button_to "Unpublish", admin_training_course_path(@course), method: :patch, params: { training_course: { status: "draft" } }, class: "px-4 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-50" %>
        <%= button_to "Archive", admin_training_course_path(@course), method: :patch, params: { training_course: { status: "archived" } }, class: "px-4 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-50", data: { turbo_confirm: "Archive this course? Badges it awarded stay valid." } %>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
      <h2 class="text-lg font-medium text-gray-900">Lessons (<%= @lessons.size %>)</h2>
      <%= link_to "Add Lesson", new_admin_training_course_lesson_path(@course), class: "text-sm text-[#ec3750] hover:underline" %>
    </div>
    <table class="min-w-full divide-y divide-gray-100">
      <tbody class="divide-y divide-gray-100 text-sm">
        <% if @lessons.empty? %><tr><td class="px-6 py-8 text-center text-gray-500">No lessons yet.</td></tr><% end %>
        <% @lessons.each_with_index do |lesson, index| %>
          <tr>
            <td class="px-6 py-4 text-gray-400"><%= index + 1 %></td>
            <td class="px-6 py-4"><%= link_to lesson.title, edit_admin_training_course_lesson_path(@course, lesson), class: "font-medium text-gray-900 hover:text-[#ec3750]" %></td>
            <td class="px-6 py-4 text-gray-600"><%= lesson.video? ? "#{lesson.video_source.to_s.titleize} video" : "—" %></td>
            <td class="px-6 py-4 text-gray-600"><%= lesson.quiz? ? pluralize(lesson.questions.size, "question") : "—" %></td>
            <td class="px-6 py-4 text-right"><%= render "admin/training/move_buttons", path: move_admin_training_course_lesson_path(@course, lesson), label: lesson.title, first: index.zero?, last: index == @lessons.size - 1 %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/training_courses/invitations", course: @course, invitations: @invitations %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <div class="px-6 py-4 border-b border-gray-100"><h2 class="text-lg font-medium text-gray-900">Learners (<%= @enrollments.size %>)</h2></div>
    <table class="min-w-full divide-y divide-gray-100">
      <tbody class="divide-y divide-gray-100 text-sm">
        <% if @enrollments.empty? %><tr><td class="px-6 py-8 text-center text-gray-500">Nobody has started this course yet.</td></tr><% end %>
        <% @enrollments.each do |enrollment| %>
          <tr>
            <td class="px-6 py-4"><%= link_to enrollment.user.display_name_or_fallback, admin_user_path(enrollment.user), class: "font-medium text-gray-900 hover:text-[#ec3750]" %><div class="text-gray-500"><%= enrollment.user.email %></div></td>
            <td class="px-6 py-4 text-gray-600"><%= @completed_counts.fetch(enrollment.id, 0) %> of <%= @lessons.size %> lessons</td>
            <td class="px-6 py-4 text-gray-600"><%= enrollment.completed_at ? "Completed #{l(enrollment.completed_at.to_date, format: :long)}" : "In progress" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @course.draft? && @enrollments.empty? %>
    <div class="flex justify-end">
      <%= button_to "Delete course", admin_training_course_path(@course), method: :delete, class: "text-sm text-red-600 hover:text-red-900", data: { turbo_confirm: "Delete this course and all its lessons?" } %>
    </div>
  <% end %>
</div>

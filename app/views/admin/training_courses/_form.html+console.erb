<%= form_with model: course, url: (course.persisted? ? admin_training_course_path(course.slug_in_database) : admin_training_courses_path), class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header"><h2 class="cs-h2">Course details</h2></div>
    <div class="cs-container-body">
      <%= cs_form_field f, :title, label: "Title" %>
      <%= cs_form_field f, :summary, label: "Summary", optional: true, description: "Shown on the course list." do |aria| %>
        <%= f.text_area :summary, rows: 3, class: "cs-input", **aria %>
      <% end %>
      <%= cs_form_field f, :slug, label: "URL", optional: true, constraint: "Lowercase letters, numbers and dashes. Leave blank to make one from the title." do |aria| %>
        <div class="flex items-center gap-2"><span class="cs-secondary">/training/</span><%= f.text_field :slug, class: "cs-input flex-1", **aria %></div>
      <% end %>
      <%= cs_form_field f, :training_badge_id, label: "Awards badge", optional: true, description: "Given to everyone who completes the course." do |aria| %>
        <%= f.select :training_badge_id, TrainingBadge.ordered.map { |b| [ b.name, b.id ] }, { include_blank: "No badge" }, class: "cs-select", **aria %>
      <% end %>
      <div class="cs-field-grid">
        <%= cs_form_field f, :pass_mark, label: "Quiz pass mark (%)", as: :number_field, input: { min: 1, max: 100 } %>
        <%= cs_form_field f, :estimated_minutes, label: "Estimated minutes", optional: true, as: :number_field, input: { min: 1 } %>
      </div>
      <%= cs_form_field f, :access, label: "Who can take it",
            description: (course.badge ? "Invite-only courses also reach everyone whose role at an upcoming event needs the badge it awards." : "Invite-only courses are for people you invite from the course page.") do |aria| %>
        <%= f.select :access, [ [ "Invite-only", "invite_only" ], [ "Anyone signed in to Attend", "open" ] ], {}, class: "cs-select", **aria %>
      <% end %>
      <%= cs_form_field f, :reveal_answers, label: "Show correct answers", description: "Learners always see which questions they got wrong, and why the answer they picked was wrong." do |aria| %>
        <%= f.select :reveal_answers, [ [ "Once they pass", "after_pass" ], [ "After every attempt", "every_attempt" ] ], {}, class: "cs-select", **aria %>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Declaration</h2>
        <p class="cs-container-description">A yes/no question asked before the first lesson, and again on every retake. A yes stops their training and flags them ineligible until the <%= TrainingDisclosure::SAFETY_TEAM_NAME %> reviews it. Only global admins see answers.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <%= cs_form_field f, :disclosure_required, label: "Ask the declaration", bare: true do |aria| %>
        <div class="cs-option">
          <%= f.check_box :disclosure_required, **aria %>
          <div>
            <%= f.label :disclosure_required, "Ask the declaration before this course", class: "cs-option-label" %>
          </div>
        </div>
      <% end %>
      <%= cs_form_field f, :disclosure_question, label: "Question", optional: true,
            description: "Leave blank to use the standard wording. Have the #{TrainingDisclosure::SAFETY_TEAM_NAME} sign off any change." do |aria| %>
        <%= f.text_area :disclosure_question, rows: 3, class: "cs-input", placeholder: TrainingDisclosure::DEFAULT_QUESTION, **aria %>
      <% end %>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col sm:flex-row justify-end gap-2">
    <%= link_to "Cancel", (course.persisted? ? admin_training_course_path(course.slug_in_database) : admin_training_path), class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button (course.persisted? ? "Save course" : "Create course"), class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

<% content_for :breadcrumbs, cs_breadcrumbs([ "Conduct bans", nil ]) %>
<%# The filters carried onto pagination links. Built by hand rather than with
    params.permit: these are query-string filters, not model attributes. %>
<% pagination_params = { search: params[:search].presence, status: @status }.compact %>
<% filtering = pagination_params.any? %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Conduct bans <span class="cs-counter">(<%= @total_count %>)</span></h1>
      <p class="cs-description">Emails on this list are blocked from being added to any event.</p>
    </div>
    <div class="cs-actions">
      <%= link_to "Add ban", new_admin_ban_path, class: "cs-btn cs-btn-primary" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Bans</h2>
    </div>
    <%= form_with url: admin_bans_path, method: :get, class: "cs-filter-bar", data: { turbo_frame: "_top" } do |f| %>
      <label class="cs-search flex-1 min-w-[14rem]">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
        <%= f.search_field :search, value: params[:search], placeholder: "Find bans by email, Slack ID or reason", "aria-label": "Find bans by email, Slack ID or reason", class: "cs-input" %>
      </label>
      <%= f.select :status, [ [ "All statuses", "" ], [ "Active", "active" ], [ "Revoked", "revoked" ], [ "Expired", "expired" ] ], { selected: @status }, class: "cs-select w-auto!", "aria-label": "Status" %>
      <%= f.button "Search", name: "commit", value: "Search", class: "cs-btn" %>
      <% if filtering %>
        <%= link_to "Clear", admin_bans_path, class: "cs-btn" %>
      <% end %>
    <% end %>
    <% if @bans.empty? %>
      <div class="cs-empty border-t border-(--cs-border-divider-secondary)">
        <% if filtering %>
          <p class="cs-empty-title">No bans match<%= " &ldquo;#{h(params[:search])}&rdquo;".html_safe if params[:search].present? %>.</p>
          <div class="cs-actions">
            <%= link_to "Clear filters", admin_bans_path, class: "cs-btn" %>
          </div>
        <% else %>
          <p class="cs-empty-title">No bans yet.</p>
          <div class="cs-actions">
            <%= link_to "Add ban", new_admin_ban_path, class: "cs-btn" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="cs-table-wrap border-t border-(--cs-border-divider-secondary)">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Emails</th>
              <th scope="col">Status</th>
              <th scope="col">Expires</th>
              <th scope="col">Added by</th>
              <th scope="col" class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @bans.each do |ban| %>
              <tr>
                <td>
                  <div><%= (ban.ban_emails.map(&:email) + ban.ban_slack_ids.map { "Slack #{_1.slack_id}" }).join(", ") %></div>
                  <% if ban.reason.present? %>
                    <div class="cs-small cs-muted truncate max-w-[280px]" title="<%= ban.reason %>"><%= ban.reason %></div>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <% case ban.status %>
                  <% when "Active", "Indefinite" %>
                    <%= cs_status(:error, ban.status) %>
                  <% when "Revoked" %>
                    <%= cs_status(:warning, "Revoked") %>
                  <% else %>
                    <%= cs_status(:stopped, "Expired") %>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <%= ban.expires_at ? cs_absolute_time_tag(ban.expires_at) : "—" %>
                </td>
                <td class="whitespace-nowrap"><%= ban.ucat? ? "UCAT sync" : (ban.created_by&.email || "—") %></td>
                <td class="whitespace-nowrap text-right">
                  <%= link_to "View", admin_ban_path(ban), class: "cs-link" %>
                  <%= link_to "Edit", edit_admin_ban_path(ban), class: "cs-link ml-4" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @total_pages > 1 %>
      <div class="cs-container-footer flex flex-wrap items-center justify-between gap-3">
        <span><%= "Showing #{(@page - 1) * @per_page + 1} to #{[ (@page * @per_page), @total_count ].min} of #{@total_count} bans" %></span>
        <nav class="cs-pagination" aria-label="Pagination">
          <% if @page > 1 %>
            <%= link_to admin_bans_path(pagination_params.merge(page: @page - 1)), "aria-label": "Previous page" do %>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
            <% end %>
          <% else %>
            <span aria-disabled="true" aria-label="Previous page"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg></span>
          <% end %>
          <span aria-current="page"><%= @page %></span>
          <span class="cs-muted">of <%= @total_pages %></span>
          <% if @page < @total_pages %>
            <%= link_to admin_bans_path(pagination_params.merge(page: @page + 1)), "aria-label": "Next page" do %>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
            <% end %>
          <% else %>
            <span aria-disabled="true" aria-label="Next page"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></span>
          <% end %>
        </nav>
      </div>
    <% end %>
  </section>
</div>

<% email_messages = {
     blank: "Email address is required.",
     invalid: "Enter a valid email address. For example: name@example.com",
     taken: "This email address is already on a ban list."
   } %>
<%= form_with model: [:admin, ban], class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Ban details</h2>
      </div>
    </div>
    <div class="cs-container-body">
      <% cs_claim_errors(ban, :"ban_emails.email") %>
      <%= cs_field id: "ban_emails", label: "Emails", group: true,
            description: "Add the primary email plus any alias addresses. All share this ban's expiry.",
            errors: cs_field_error_messages(ban, :ban_emails, label: "Emails", messages: { blank: "Add at least one email address.", invalid: "Enter a valid email address." }),
            data: { controller: "nested-form" } do |_aria| %>
        <% cs_claim_errors(ban, :ban_emails) %>
        <div data-nested-form-target="container" class="space-y-2">
          <% ban.ban_emails.each_with_index do |ban_email, index| %>
            <%= f.fields_for :ban_emails, ban_email do |ef| %>
              <% row_errors = cs_field_error_messages(ef.object, :email, label: "Email address", messages: email_messages) %>
              <div data-nested-form-target="item" class="<%= "hidden" if ef.object.marked_for_destruction? %>"
                   data-cs-field data-cs-label="Email address" data-cs-error-id="<%= ef.field_id(:email) %>-error">
                <div class="flex items-center gap-2">
                  <%= ef.email_field :email, class: "cs-input flex-1", "aria-label": "Email address #{index + 1}",
                        aria: { invalid: (true if row_errors.any?), describedby: ("#{ef.field_id(:email)}-error" if row_errors.any?) }.compact %>
                  <% if ef.object.persisted? %>
                    <%= ef.hidden_field :_destroy, data: { nested_form_target: "destroyField" } %>
                  <% end %>
                  <button type="button" data-action="nested-form#remove" class="cs-btn cs-btn-link">Remove</button>
                </div>
                <% if row_errors.any? %>
                  <%= cs_field_message(:error, row_errors.first, id: "#{ef.field_id(:email)}-error", data: { cs_server_error: true }) %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <template data-nested-form-target="template">
          <%= f.fields_for :ban_emails, BanEmail.new, child_index: "NEW_RECORD" do |ef| %>
            <div data-nested-form-target="item" data-cs-field data-cs-label="Email address">
              <div class="flex items-center gap-2">
                <%= ef.email_field :email, class: "cs-input flex-1", "aria-label": "Another email address" %>
                <button type="button" data-action="nested-form#remove" class="cs-btn cs-btn-link">Remove</button>
              </div>
            </div>
          <% end %>
        </template>

        <button type="button" data-action="nested-form#add" class="cs-btn mt-2">Add another email</button>
      <% end %>

      <%= cs_form_field f, :expires_at, label: "Expires at", optional: true,
            constraint: "Leave blank for an indefinite ban." do |aria| %>
        <%= f.datetime_local_field :expires_at, value: ban.expires_at&.strftime("%Y-%m-%dT%H:%M"), class: "cs-input", **aria %>
      <% end %>

      <%= cs_form_field f, :reason, label: "Reason", optional: true do |aria| %>
        <%= f.text_area :reason, rows: 3, class: "cs-input", **aria %>
      <% end %>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col sm:flex-row justify-end gap-2">
    <%= link_to "Cancel", admin_bans_path, class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button submit_label, class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

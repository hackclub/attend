<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Check-ins", admin_event_scans_path(current_event) ], [ "Scan contexts", nil ]) %>

<div class="cs-header">
  <div class="cs-header-text">
    <h1 class="cs-h1">Scan contexts <span class="cs-counter">(<%= @scan_contexts.size %>)</span></h1>
    <p class="cs-description">Manage locations and contexts for QR code scanning</p>
  </div>
  <div class="cs-actions">
    <%= link_to "New context", new_admin_event_scan_context_path(current_event), class: "cs-btn cs-btn-primary" %>
  </div>
</div>

<section class="cs-container">
  <div class="cs-container-header cs-container-header-divided">
    <h2 class="cs-h2">Contexts</h2>
  </div>
  <% if @scan_contexts.any? %>
    <div class="cs-table-wrap">
      <table class="cs-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Kind</th>
            <th scope="col">Schedule</th>
            <th scope="col">Scans</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @scan_contexts.each do |context| %>
            <tr>
              <td>
                <span class="whitespace-nowrap font-bold"><%= context.name %></span>
                <% if context.usage_note.present? %>
                  <div class="cs-small cs-muted"><%= context.usage_note %></div>
                <% end %>
              </td>
              <td class="whitespace-nowrap"><%= cs_badge(context.kind_label) %></td>
              <td class="whitespace-nowrap">
                <% if context.starts_at? || context.ends_at? %>
                  <%= [ cs_absolute_time(context.starts_at, zone: context.time_display_zone), cs_absolute_time(context.ends_at, zone: context.time_display_zone) ].compact.join(" – ") %>
                <% else %>
                  <span class="cs-muted">—</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap tabular-nums"><%= context.scans.count %></td>
              <td class="whitespace-nowrap">
                <div class="flex items-center justify-end gap-1">
                  <%= link_to "Edit", edit_admin_event_scan_context_path(current_event, context), class: "cs-btn cs-btn-link" %>
                  <% if context.scans.none? %>
                    <%= button_to "Delete", admin_event_scan_context_path(current_event, context), method: :delete, class: "cs-btn cs-btn-link", form: { data: { turbo_confirm: "Are you sure you want to delete this context?" } } %>
                  <% else %>
                    <span class="cs-btn cs-btn-link" aria-disabled="true" title="Cannot delete: has associated scans">Delete</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="cs-empty">
      <p class="cs-empty-title">No scan contexts</p>
      <p>No scan contexts configured for this event.</p>
      <div class="cs-actions">
        <%= link_to "New context", new_admin_event_scan_context_path(current_event), class: "cs-btn" %>
      </div>
    </div>
  <% end %>
</section>

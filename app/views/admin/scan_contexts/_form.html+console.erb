<%= form_with model: [:admin, current_event, scan_context], local: true, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
  <div class="cs-stack">
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Context settings</h2>
      </div>
      <div class="cs-container-body space-y-5">
        <%= cs_form_field f, :name, label: "Location name",
              description: "A descriptive name for this scanning location.",
              constraint: "For example: Main entrance, Central station or Registration desk" do |aria| %>
          <%= f.text_field :name, class: "cs-input", required: true, **aria %>
        <% end %>

        <div class="space-y-3">
          <%= cs_form_field f, :checks_in, label: "Checks person in to event", bare: true do |aria| %>
            <div class="cs-option">
              <%= f.check_box :checks_in, **aria %>
              <div>
                <%= f.label :checks_in, "Checks person in to event", class: "cs-option-label" %>
                <p class="cs-option-description">When scanned at this location, mark the participant as checked in to the event</p>
              </div>
            </div>
          <% end %>

          <%= cs_form_field f, :is_travel_pickup, label: "Travel pickup location", bare: true do |aria| %>
            <div class="cs-option">
              <%= f.check_box :is_travel_pickup, **aria %>
              <div>
                <%= f.label :is_travel_pickup, "Travel pickup location", class: "cs-option-label" %>
                <p class="cs-option-description">When scanned at this location, mark the participant as collected from their travel arrival point</p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="cs-field-grid">
          <%= cs_form_field f, :starts_at, label: "Starts at", optional: true,
                constraint: "When scanning at this location opens." do |aria| %>
            <%= f.datetime_local_field :starts_at, class: "cs-input", **aria %>
          <% end %>
          <%= cs_form_field f, :ends_at, label: "Ends at", optional: true,
                constraint: "When scanning at this location closes. Must be after the start time." do |aria| %>
            <%= f.datetime_local_field :ends_at, class: "cs-input",
                  data: { cs_after: f.field_id(:starts_at), cs_after_message: "Enter an end time after the start time." }, **aria %>
          <% end %>
        </div>

        <%= cs_form_field f, :position, label: "Display order", optional: true,
              constraint: "A whole number, 0 or more. Contexts are listed by start time. Lower numbers come first among contexts with the same or no start time." do |aria| %>
          <%= f.number_field :position, class: "cs-input w-32!", min: 0, step: 1, **aria %>
        <% end %>
      </div>
    </section>

    <%= cs_form_errors f %>

    <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
      <%= link_to "Cancel", admin_event_scan_contexts_path(current_event), class: "cs-btn cs-btn-link" %>
      <%= f.button scan_context.persisted? ? "Update context" : "Create context", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  </div>
<% end %>

<%= form_with model: [:admin, current_event, scan_context], local: true, class: "space-y-6" do |f| %>
  <% if scan_context.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(scan_context.errors.count, "error") %> prohibited this context from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc list-inside space-y-1">
              <% scan_context.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Location Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]", placeholder: "e.g., Main Entrance, Central Station, Registration Desk" %>
    <p class="mt-1 text-sm text-gray-500">A descriptive name for this scanning location</p>
  </div>

  <fieldset>
    <legend class="block text-sm font-medium text-gray-700 mb-1">What a scan here means</legend>
    <p class="mb-2 text-sm text-gray-500">Sets each participant's status when they're scanned here.</p>
    <div class="space-y-2">
      <% ScanContext::KIND_DESCRIPTIONS.each do |kind, description| %>
        <div class="flex items-start">
          <%= f.radio_button :kind, kind, class: "mt-1 border-gray-300 text-[#ec3750] focus:ring-[#ec3750]" %>
          <div class="ml-3">
            <%= f.label :kind, kind.humanize, value: kind, class: "text-sm font-medium text-gray-700" %>
            <p class="text-sm text-gray-500"><%= description %></p>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= f.label :usage_note, "When to use this (recommended)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="mb-1 text-sm text-gray-500">Shown under the name in the scanner, so staff pick the right point. For example: "Scan everyone as they board the bus back from the museum." Up to 200 characters.</p>
    <%= f.text_area :usage_note, rows: 2, maxlength: 200, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_at, "Starts At", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_local_field :starts_at, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
      <p class="mt-1 text-sm text-gray-500">Optional — when scanning at this location opens</p>
    </div>
    <div>
      <%= f.label :ends_at, "Ends At", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_local_field :ends_at, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
      <p class="mt-1 text-sm text-gray-500">Optional — when scanning at this location closes</p>
    </div>
  </div>

  <div>
    <%= f.label :position, "Display Order", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :position, class: "w-32 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]", min: 0 %>
    <p class="mt-1 text-sm text-gray-500">Lower numbers appear first in the dropdown</p>
  </div>

  <div class="pt-4 flex flex-col sm:flex-row justify-end gap-3">
    <%= link_to "Cancel", admin_event_scan_contexts_path(current_event), class: "w-full sm:w-auto text-center bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300" %>
    <%= f.submit scan_context.persisted? ? "Update Context" : "Create Context", class: "w-full sm:w-auto bg-[#d42f46] text-white px-4 py-2 rounded-md hover:bg-[#b82840] cursor-pointer" %>
  </div>
<% end %>

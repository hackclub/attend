<% content_for :title, "Messages – #{current_event.name} – Attend" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold">Messages</h1>
      <p class="text-gray-600">Send messages to attendees and guardians via multiple channels.</p>
    </div>
    <%= link_to "New Message", new_admin_event_message_path(current_event), 
        class: "bg-[#ec3750] hover:bg-[#d42f46] text-white font-semibold py-2 px-4 rounded-lg" %>
  </div>

  <% if @messages.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-100 table-fixed">
        <thead class="bg-gray-50">
          <tr>
            <th class="w-1/3 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Message</th>
            <th class="w-40 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Audience</th>
            <th class="w-32 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Channels</th>
            <th class="w-28 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="w-32 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sent By</th>
            <th class="w-32 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sent</th>
            <th class="w-16 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @messages.each do |message| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <% message_link = message.draft? ? edit_admin_event_message_path(current_event, message) : admin_event_message_path(current_event, message) %>
                <%= link_to message_link, class: "block" do %>
                  <% if message.subject.present? %>
                    <div class="text-sm font-medium text-gray-900"><%= message.subject %></div>
                  <% end %>
                  <div class="text-sm text-gray-500 truncate max-w-xs"><%= truncate(message.body.presence || "(empty)", length: 60) %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <%= message.audience_label %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex gap-1">
                  <% message.channels.each do |channel| %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                      <%= case channel
                          when 'slack' then 'bg-purple-100 text-purple-800'
                          when 'email' then 'bg-blue-100 text-blue-800'
                          when 'sms' then 'bg-green-100 text-green-800'
                          end %>">
                      <%= channel.titleize %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                  <%= case message.status
                      when 'draft' then 'bg-gray-100 text-gray-800'
                      when 'scheduled' then 'bg-yellow-100 text-yellow-800'
                      when 'sending' then 'bg-blue-100 text-blue-800'
                      when 'completed' then 'bg-green-100 text-green-800'
                      when 'failed' then 'bg-red-100 text-red-800'
                      when 'cancelled' then 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= message.status.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <% if message.sent_by_user %>
                  <div class="flex items-center gap-2">
                    <% if message.sent_by_user.avatar_displayable? %>
                      <%= image_tag message.sent_by_user.avatar.variant(resize_to_fill: [24, 24]), class: "w-6 h-6 rounded-full object-cover flex-shrink-0" %>
                    <% else %>
                      <span class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0 text-xs font-medium text-gray-600"><%= message.sent_by_user.initials %></span>
                    <% end %>
                    <span><%= message.sent_by_user.display_name_or_fallback %></span>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if message.sent_at.present? %>
                  <%= message.sent_at.strftime("%b %d, %H:%M") %>
                  <div class="text-xs text-gray-400">
                    <%= message.sent_count %>/<%= message.recipient_count %> delivered
                  </div>
                <% elsif message.scheduled_at.present? %>
                  <span class="text-yellow-600">Scheduled: <%= message.scheduled_at.strftime("%b %d, %H:%M") %></span>
                <% else %>
                  <span class="text-gray-400">Draft</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if message.draft? || message.scheduled? %>
                  <%= button_to admin_event_message_path(current_event, message), 
                      method: :delete,
                      data: { confirm: "Delete this draft?" },
                      class: "text-red-600 hover:text-red-800" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No messages yet</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating a new message.</p>
      <div class="mt-6">
        <%= link_to "New Message", new_admin_event_message_path(current_event), 
            class: "inline-flex items-center px-4 py-2 border border-transparent  text-sm font-medium rounded-md text-white bg-[#ec3750] hover:bg-[#d42f46]" %>
      </div>
    </div>
  <% end %>
</div>

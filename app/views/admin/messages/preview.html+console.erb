<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Messages", admin_event_messages_path(current_event) ], [ "Compose message", edit_admin_event_message_path(current_event, @message) ], [ "Preview and send", nil ]) %>

<%= render layout: "wizard", locals: { current_step: "preview", title: "Preview and send" } do %>
  <div class="cs-stack">
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Audience: <%= @message.audience_label %></h2>
      </div>
      <div class="cs-container-body">
        <p class="mb-3">
          <strong><%= @total_count %></strong> recipient<%= @total_count == 1 ? '' : 's' %> will receive this message via
          <strong><%= @message.channel_labels %></strong>.
        </p>

        <% if @recipients.any? %>
          <div class="cs-token-group">
            <% @recipients.each do |recipient| %>
              <span class="cs-token cs-token-readonly">
                <% if recipient.respond_to?(:participant) %>
                  <%= recipient.participant.display_name %>
                <% else %>
                  <%= recipient.full_name %>
                <% end %>
              </span>
            <% end %>
            <% if @total_count > 20 %>
              <span class="cs-token cs-token-readonly cs-muted">+<%= @total_count - 20 %> more</span>
            <% end %>
          </div>
        <% else %>
          <div class="cs-alert cs-alert-warning">
            <%= cs_status_icon(:warning) %>
            <p>No recipients match this criteria. The message won't be sent to anyone.</p>
          </div>
        <% end %>
      </div>
    </section>

    <% if @preview_recipient && @message.uses_placeholders? %>
      <div class="cs-alert">
        <%= cs_status_icon(:info) %>
        <p>Placeholders are filled in as they will be for <strong><%= @preview_recipient.try(:display_name) || @preview_recipient.full_name %></strong>.</p>
      </div>
    <% end %>

    <% if @message.channels.include?("slack") %>
      <section class="cs-container">
        <div class="cs-container-header">
          <h2 class="cs-h2">Slack preview</h2>
        </div>
        <div class="cs-container-body">
          <%# A mock of Slack's own dark message view, so it keeps Slack's colours. %>
          <div class="bg-[#1a1d21] rounded-lg p-4 text-white">
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded bg-[#d42f46] flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold text-sm">HC</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2">
                  <span class="font-bold text-white">Hack Club Attend</span>
                  <span class="text-xs text-gray-400">App</span>
                </div>
                <div class="mt-1 text-[15px] text-gray-100 whitespace-pre-wrap break-words"><%= @message.body_as_html(recipient: @preview_recipient, images_as_links: true) %></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <% if @message.channels.include?("email") %>
      <section class="cs-container">
        <div class="cs-container-header cs-container-header-divided">
          <div>
            <h2 class="cs-h2">Email preview</h2>
            <p class="cs-container-description">
              Subject: <strong><%= @message.subject_for(@preview_recipient) || "You have a new message from #{current_event.name}" %></strong>
            </p>
          </div>
        </div>
        <div class="cs-container-body">
          <div class="message-body text-sm">
            <%= sanitize @message.body_as_html(recipient: @preview_recipient), tags: %w[p br strong em b i a ul ol li h1 h2 h3 h4 code pre blockquote img], attributes: %w[href target rel src alt width style] %>
          </div>
        </div>
      </section>
    <% end %>

    <% if @message.channels.include?("sms") %>
      <section class="cs-container">
        <div class="cs-container-header">
          <h2 class="cs-h2">SMS preview</h2>
        </div>
        <div class="cs-container-body">
          <%# A mock of a phone's message bubble. %>
          <% sms_text = @message.body_as_plain(recipient: @preview_recipient) %>
          <div class="max-w-xs">
            <div class="bg-green-500 text-white rounded-2xl rounded-bl-sm px-4 py-2 text-sm whitespace-pre-line">
              <%= sms_text %>
            </div>
            <p class="cs-small cs-muted mt-2 text-right">
              <%= pluralize(sms_text.length, "character") %>
              <% if sms_text.length > 160 %>
                <%= cs_status(:warning, "(~#{(sms_text.length / 160.0).ceil} segments)") %>
              <% end %>
            </p>
          </div>
        </div>
      </section>
    <% end %>

    <% if @message.scheduled_at.present? %>
      <div class="cs-alert cs-alert-warning">
        <%= cs_status_icon(:pending) %>
        <p>
          <strong>Scheduled:</strong> This message will be sent on
          <strong><%= cs_absolute_time_tag(@message.scheduled_at, zone: current_event.event_time_zone) %></strong>
        </p>
      </div>
    <% end %>

    <div class="cs-wizard-actions">
      <%= link_to "Edit message", edit_admin_event_message_path(current_event, @message), class: "cs-btn cs-btn-link" %>
      <% if @message.scheduled_at.present? && @message.scheduled_at > Time.current %>
        <%= button_to "Schedule message", send_now_admin_event_message_path(current_event, @message),
            method: :post,
            form: { data: { turbo_confirm: "Schedule this message to be sent on #{cs_absolute_time(@message.scheduled_at, zone: current_event.event_time_zone)}?" } },
            class: "cs-btn cs-btn-primary",
            disabled: @total_count == 0 %>
      <% else %>
        <%= button_to "Send now", send_now_admin_event_message_path(current_event, @message),
            method: :post,
            form: { data: { turbo_confirm: "Send this message to #{pluralize(@total_count, "recipient")} now?" } },
            class: "cs-btn cs-btn-primary",
            disabled: @total_count == 0 %>
      <% end %>
    </div>
  </div>
<% end %>

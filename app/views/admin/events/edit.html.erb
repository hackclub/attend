<% content_for :title, "Edit #{@event.name} – Attend" %>

<div class="w-full max-w-4xl">
  <h1 class="text-2xl font-bold mb-6">Edit <%= @event.name %></h1>
  <%= render "form", event: @event %>

  <% if policy(@event).destroy? %>
    <div class="mt-12 border-2 border-dashed border-red-400 rounded-lg p-6" data-controller="delete-event">
      <h2 class="text-lg font-semibold text-red-700 mb-2">Danger Zone</h2>
      <p class="text-sm text-gray-600 mb-4">
        Permanently delete this event and all associated data. This action cannot be undone.
      </p>
      <button type="button"
              data-action="click->delete-event#showConfirmation"
              class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
        Delete Event
      </button>

      <div data-delete-event-target="modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
          <h3 class="text-xl font-bold text-red-700 mb-4">Delete "<%= @event.name %>"?</h3>
          <p class="text-gray-600 mb-4">
            This will permanently delete the event and all associated participants, incidents, messages, and other data.
            <strong>This action cannot be undone.</strong>
          </p>
          <%= form_with url: admin_event_path(@event), method: :delete, class: "space-y-4" do |f| %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Type <strong class="font-mono"><%= @event.name %></strong> to confirm:</label>
              <input type="text"
                     name="confirmation"
                     required
                     autocomplete="off"
                     placeholder="<%= @event.name %>"
                     class="w-full rounded-md border-gray-300  focus:border-red-500 focus:ring-red-500 px-3 py-2">
            </div>
            <div class="flex gap-3 justify-end">
              <button type="button"
                      data-action="click->delete-event#hideConfirmation"
                      class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg transition-colors">
                Cancel
              </button>
              <button type="submit"
                      class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                Permanently Delete
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

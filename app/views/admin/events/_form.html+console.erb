<%= form_with model: [:admin, event], class: "cs-stack", multipart: true do |f| %>
  <% if params[:return_to].in?(Admin::EventsController::SETUP_RETURNS) %>
    <%= hidden_field_tag :return_to, params[:return_to] %>
  <% end %>
  <% if event.errors.any? %>
    <div class="cs-alert cs-alert-error" role="alert">
      <%= cs_status_icon(:error) %>
      <div>
        <p class="cs-alert-title"><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</p>
        <ul class="mt-1 list-disc list-inside">
          <% event.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Basic information</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :name, class: "cs-field-label" %>
          <%= f.text_field :name, class: "cs-input" %>
        </div>
        <div>
          <%= f.label :slug, class: "cs-field-label" %>
          <%= f.text_field :slug, class: "cs-input", placeholder: "auto-generated from name" %>
          <p class="cs-field-hint">Lowercase letters, numbers, and dashes only</p>
        </div>
        <% if current_user.global_admin? && EventSeries.any? %>
          <div>
            <%= f.label :event_series_id, "Series", class: "cs-field-label" %>
            <%= f.collection_select :event_series_id, EventSeries.order(:name), :id, :name, { include_blank: "No series — standalone event" }, class: "cs-select" %>
            <p class="cs-field-hint">Series members can manage this event and it inherits the series' branding.</p>
          </div>
        <% elsif event.event_series %>
          <div>
            <span class="cs-field-label block">Series</span>
            <p class="mt-1 flex items-center gap-2">
              <%= render "admin/events/avatar", event: event.event_series, size: 20, rounded: "rounded-md" %>
              Part of <strong><%= event.event_series.name %></strong>
            </p>
          </div>
        <% end %>
      </div>

      <div class="cs-field mt-4">
        <%= f.label :logo, "Logo", class: "cs-field-label" %>
        <div class="mt-1 flex items-center gap-4"
             data-controller="instant-upload"
             data-instant-upload-field-value="logo"
             data-instant-upload-url-value="<%= event.persisted? ? attach_image_admin_event_path(event) : "" %>">
          <%= render "admin/events/image_preview", event: event, field: "logo" %>
          <div class="flex flex-col gap-1 min-w-0">
            <%= f.file_field :logo, accept: "image/jpeg,image/png,image/gif,image/webp,image/svg+xml", data: { instant_upload_target: "input", action: "change->instant-upload#upload" }, class: "cs-file" %>
            <span data-instant-upload-target="status" class="cs-small" aria-live="polite"></span>
          </div>
        </div>
        <p class="cs-field-hint">JPEG, PNG, GIF, WebP, or SVG. Max 5MB. Shown in the sidebar and event picker.<% if event.persisted? %> Uploads as soon as you pick a file.<% end %></p>
      </div>

      <div class="cs-field mt-4">
        <%= f.label :banner, "Ticket banner", class: "cs-field-label" %>
        <div class="mt-1 flex items-center gap-4"
             data-controller="instant-upload"
             data-instant-upload-field-value="banner"
             data-instant-upload-url-value="<%= event.persisted? ? attach_image_admin_event_path(event) : "" %>">
          <%= render "admin/events/image_preview", event: event, field: "banner" %>
          <div class="flex flex-col gap-1 min-w-0">
            <%= f.file_field :banner, accept: "image/jpeg,image/png", data: { instant_upload_target: "input", action: "change->instant-upload#upload" }, class: "cs-file" %>
            <span data-instant-upload-target="status" class="cs-small" aria-live="polite"></span>
          </div>
        </div>
        <p class="cs-field-hint">Shown as the hero image on Google Wallet tickets (full image, roughly 5:4) and cropped to a wide center strip on Apple Wallet tickets. PNG or JPEG, 1032&times;812px recommended, max 5MB. Avoid text in the image and keep the important content centered.<% if event.persisted? %> Uploads as soon as you pick a file.<% end %></p>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Location and time</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :location_city, class: "cs-field-label" %>
          <%= f.text_field :location_city, class: "cs-input" %>
        </div>
        <div>
          <%= f.label :location_country, class: "cs-field-label" %>
          <%= f.text_field :location_country, class: "cs-input" %>
        </div>
        <div>
          <%= f.label :timezone, class: "cs-field-label" %>
          <%= f.time_zone_select :timezone, nil, {}, class: "cs-select" %>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Venue details</h2>
        <p class="cs-container-description">Optional venue information for Google Wallet passes. Both venue name and address are required for the pass to display venue info.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :venue_name, "Venue name", class: "cs-field-label" %>
          <%= f.text_field :venue_name, class: "cs-input", placeholder: "e.g. Reaktor" %>
        </div>
        <div>
          <%= f.label :location_address, "Venue address", class: "cs-field-label" %>
          <%= f.text_field :location_address,
              id: "venue-address-input",
              class: "cs-input",
              placeholder: "Start typing to search...",
              autocomplete: "off" %>
          <p class="cs-field-hint">Search for a place using Google Places</p>
        </div>
      </div>
      <%= f.hidden_field :location_latitude, id: "venue-latitude" %>
      <%= f.hidden_field :location_longitude, id: "venue-longitude" %>
    </div>
  </section>

  <script nonce="<%= content_security_policy_nonce %>">
    (function() {
      var script = document.createElement('script');
      script.src = 'https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.dig(:google, :key) %>&libraries=places&callback=initPlacesAutocomplete';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    })();

    function initPlacesAutocomplete() {
      var input = document.getElementById('venue-address-input');
      if (!input) return;

      var autocomplete = new google.maps.places.Autocomplete(input, {
        types: ['establishment', 'geocode']
      });

      autocomplete.addListener('place_changed', function() {
        var place = autocomplete.getPlace();
        if (place.geometry) {
          document.getElementById('venue-latitude').value = place.geometry.location.lat();
          document.getElementById('venue-longitude').value = place.geometry.location.lng();
        }
        if (place.formatted_address) {
          input.value = place.formatted_address;
        }
      });
    }
  </script>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Event dates</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :starts_at, class: "cs-field-label" %>
          <%= f.datetime_local_field :starts_at, value: f.object.schedule_time_field_value(:starts_at), class: "cs-input" %>
        </div>
        <div>
          <%= f.label :ends_at, class: "cs-field-label" %>
          <%= f.datetime_local_field :ends_at, value: f.object.schedule_time_field_value(:ends_at), class: "cs-input" %>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Registration period</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :registration_open_at, class: "cs-field-label" %>
          <%= f.datetime_local_field :registration_open_at, value: f.object.schedule_time_field_value(:registration_open_at), class: "cs-input" %>
        </div>
        <div>
          <%= f.label :registration_close_at, class: "cs-field-label" %>
          <%= f.datetime_local_field :registration_close_at, value: f.object.schedule_time_field_value(:registration_close_at), class: "cs-input" %>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Arrival window</h2>
        <p class="cs-container-description">Optional. Shown to attendees as "when to arrive" on their dashboard.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :arrival_opens_at, "Arrival opens at", class: "cs-field-label" %>
          <%= f.datetime_local_field :arrival_opens_at, value: f.object.schedule_time_field_value(:arrival_opens_at), class: "cs-input" %>
        </div>
        <div>
          <%= f.label :arrival_closes_at, "Arrival closes at", class: "cs-field-label" %>
          <%= f.datetime_local_field :arrival_closes_at, value: f.object.schedule_time_field_value(:arrival_closes_at), class: "cs-input" %>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Contact</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div data-controller="email-domain" data-email-domain-domains-value="<%= Event::SUPPORT_EMAIL_DOMAINS.to_json %>">
          <%= f.label :support_email, "Support email", class: "cs-field-label" %>
          <%= f.email_field :support_email, required: true, class: "cs-input", placeholder: "team@hackclub.com", data: { email_domain_target: "input", action: "input->email-domain#validate blur->email-domain#validate" } %>
          <p class="cs-field-hint text-red-600 hidden" data-email-domain-target="message"></p>
          <p class="cs-field-hint">Used as the from and reply-to address on participant and guardian emails. Must be a <%= Event::SUPPORT_EMAIL_DOMAINS_SENTENCE %> address.</p>
        </div>
      </div>
    </div>
  </section>

  <% if event.persisted? && event.scan_contexts.any? %>
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Rooming</h2>
      </div>
      <div class="cs-container-body">
        <div class="cs-field">
          <%= f.label :hotel_scan_context_id, "Hotel scan context", class: "cs-field-label" %>
          <%= f.select :hotel_scan_context_id,
              event.scan_contexts.map { |c| [c.name, c.id] },
              { include_blank: "None", selected: event.hotel_scan_context_id },
              class: "cs-select" %>
          <p class="cs-field-hint">Select the scanning context used for hotel check-in. Participants with this scan will show as green on the rooming finalize page.</p>
        </div>
      </div>
    </section>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Event options</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-option">
        <%= f.check_box :freedom_waivers_enabled %>
        <div>
          <%= f.label :freedom_waivers_enabled, "Enable freedom waivers", class: "cs-option-label" %>
          <p class="cs-option-description">Allow guardians to grant additional freedom permissions for minor participants</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :travel_enabled, { checked: f.object.travel_enabled? } %>
        <div>
          <%= f.label :travel_enabled, "Enable travel", class: "cs-option-label" %>
          <p class="cs-option-description">Collect travel information from participants. Disabling hides the travel onboarding step, travel dashboards, and Travel Calendar</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :visa_options_enabled %>
        <div class="w-full">
          <%= f.label :visa_options_enabled, "Enable visa options", class: "cs-option-label" %>
          <p class="cs-option-description">Show visa requirement fields in travel information for international participants</p>
          <div class="cs-field mt-3">
            <%= f.label :visa_application_url, "Visa letter application URL", class: "cs-field-label" %>
            <%= f.url_field :visa_application_url, placeholder: "https://visas.hackclub.com/...", class: "cs-input" %>
            <p class="cs-field-hint">Envoy (visas.hackclub.com) application form participants are pointed to when they need a visa letter.</p>
          </div>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :accommodation_enabled %>
        <div>
          <%= f.label :accommodation_enabled, "Enable accommodation", class: "cs-option-label" %>
          <p class="cs-option-description">Show accommodation/housing preferences in onboarding for events with overnight stays</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :roommate_preferences_enabled %>
        <div>
          <%= f.label :roommate_preferences_enabled, "Enable roommate preferences", class: "cs-option-label" %>
          <p class="cs-option-description">Show roommate preference fields on the accommodation onboarding step</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :guardian_invites_locked %>
        <div>
          <%= f.label :guardian_invites_locked, "Lock guardian invites", class: "cs-option-label" %>
          <p class="cs-option-description">Hold off sending guardian invitations while waiver details are being finalised</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :onboarding_invites_held %>
        <div>
          <%= f.label :onboarding_invites_held, "Hold onboarding invitations", class: "cs-option-label" %>
          <p class="cs-option-description">Add and import participants without emailing them. Unticking this sends every held invitation, as does the button on the participants page or the series page.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">NFC badges</h2>
        <p class="cs-container-description">Enable NFC badge support for events with physical PCB badges or NFC wristbands.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <div class="cs-option">
        <%= f.check_box :nfc_badges_enabled %>
        <div>
          <%= f.label :nfc_badges_enabled, "Enable NFC badges", class: "cs-option-label" %>
          <p class="cs-option-description">Allow participants to be checked in by scanning NFC badges</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :nfc_badge_write_on_checkin_enabled %>
        <div>
          <%= f.label :nfc_badge_write_on_checkin_enabled, "Prompt NFC write on initial check-in", class: "cs-option-label" %>
          <p class="cs-option-description">After a participant scans their QR code, offer to write their ID to an NFC badge</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Groups</h2>
        <p class="cs-container-description">Tag participants with named groups (e.g. "Hardware", "General Attendance") to distinguish cohorts within the same event.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <div class="cs-option">
        <%= f.check_box :groups_enabled %>
        <div>
          <%= f.label :groups_enabled, "Enable groups", class: "cs-option-label" %>
          <p class="cs-option-description">Show group chips on tickets, scans, the participant table, messaging, rooming, and the Travel Calendar.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
    <%= link_to "Cancel", (event.persisted? ? admin_event_dashboard_path(event.slug) : admin_root_path), class: "cs-btn cs-btn-link cs-btn-full justify-center" %>
    <%= f.button class: "cs-btn cs-btn-primary cs-btn-full justify-center" %>
  </div>
<% end %>

<%# The Features tab: which parts of Attend this event uses. Locals: event %>
<%= cs_settings_form event, url: admin_event_path(event), tab: "features" do |f| %>
<section class="cs-container">
  <div class="cs-container-header">
    <h2 class="cs-h2">Event options</h2>
  </div>
  <div class="cs-container-body">
    <div class="cs-option">
      <%= f.check_box :travel_enabled, { checked: f.object.travel_enabled? } %>
      <div>
        <%= f.label :travel_enabled, "Enable travel", class: "cs-option-label" %>
        <p class="cs-option-description">Collect travel information from participants. Disabling hides the travel onboarding step, travel dashboards, and Travel Calendar</p>
      </div>
    </div>
    <div class="cs-option">
      <%= f.check_box :visa_options_enabled %>
      <div class="w-full">
        <%= f.label :visa_options_enabled, "Enable visa options", class: "cs-option-label" %>
        <p class="cs-option-description">Show visa requirement fields in travel information for international participants</p>
      </div>
    </div>
    <% if policy(f.object).review_visa_letters? %>
      <%= cs_form_field f, :visa_letters, label: "Visa invitation letters",
            description: "Issue visa invitation letters from Attend. Your event admins review applications under Visa letters." do |aria| %>
        <%= f.select :visa_letters, VisaLettersHelper::VISA_LETTER_MODE_LABELS.map { |mode, (label, _)| [ label, mode ] }, { selected: f.object.visa_letters_mode }, class: "cs-select", **aria %>
      <% end %>
    <% end %>
    <div class="cs-option">
      <%= f.check_box :accommodation_enabled %>
      <div>
        <%= f.label :accommodation_enabled, "Enable accommodation", class: "cs-option-label" %>
        <p class="cs-option-description">Show accommodation/housing preferences in onboarding for events with overnight stays</p>
      </div>
    </div>
    <div class="cs-option">
      <%= f.check_box :roommate_preferences_enabled %>
      <div>
        <%= f.label :roommate_preferences_enabled, "Enable roommate preferences", class: "cs-option-label" %>
        <p class="cs-option-description">Show roommate preference fields on the accommodation onboarding step</p>
      </div>
    </div>
    <div class="cs-option">
      <%= f.check_box :onboarding_invites_held %>
      <div>
        <%= f.label :onboarding_invites_held, "Hold onboarding invitations", class: "cs-option-label" %>
        <p class="cs-option-description">Add and import participants without emailing them. Unticking this sends every held invitation, as does the button on the participants page or the series page.</p>
      </div>
    </div>
  </div>
  <%= cs_settings_save f %>
</section>
<% end %>

<%= cs_settings_form event, url: admin_event_path(event), tab: "features" do |f| %>
<section class="cs-container">
  <div class="cs-container-header">
    <div>
      <h2 class="cs-h2">NFC badges</h2>
      <p class="cs-container-description">Enable NFC badge support for events with physical PCB badges or NFC wristbands.</p>
    </div>
  </div>
  <div class="cs-container-body">
    <div class="cs-option">
      <%= f.check_box :nfc_badges_enabled %>
      <div>
        <%= f.label :nfc_badges_enabled, "Enable NFC badges", class: "cs-option-label" %>
        <p class="cs-option-description">Allow participants to be checked in by scanning NFC badges</p>
      </div>
    </div>
    <div class="cs-option">
      <%= f.check_box :nfc_badge_write_on_checkin_enabled %>
      <div>
        <%= f.label :nfc_badge_write_on_checkin_enabled, "Prompt NFC write on initial check-in", class: "cs-option-label" %>
        <p class="cs-option-description">After a participant scans their QR code, offer to write their ID to an NFC badge</p>
      </div>
    </div>
  </div>
  <%= cs_settings_save f %>
</section>
<% end %>

<%= cs_settings_form event, url: admin_event_path(event), tab: "features" do |f| %>
<section class="cs-container">
  <div class="cs-container-header">
    <div>
      <h2 class="cs-h2">Groups</h2>
      <p class="cs-container-description">Tag participants with named groups (for example, "Hardware" or "General Attendance") to distinguish cohorts within the same event.</p>
    </div>
  </div>
  <div class="cs-container-body">
    <div class="cs-option">
      <%= f.check_box :groups_enabled %>
      <div>
        <%= f.label :groups_enabled, "Enable groups", class: "cs-option-label" %>
        <p class="cs-option-description">Show group chips on tickets, scans, the participant table, messaging, rooming, and the Travel Calendar.</p>
      </div>
    </div>
  </div>
  <%= cs_settings_save f %>
</section>
<% end %>


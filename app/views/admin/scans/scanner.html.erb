<% content_for :title, "Scanner – #{current_event.name} – Attend" %>

<%= content_for :head do %>
  <script src="<%= asset_path("vendor/zxing.min.js") %>"></script>
  <%# Turbo doesn't re-run scripts when it restores a cached snapshot, so a %>
  <%# back-navigation would land on a dead preview. Opt out of the cache and %>
  <%# every arrival here is a fresh render that boots the camera again. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-0">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-1">
    <div class="flex items-center gap-3">
      <%= link_to admin_event_scans_path(current_event), class: "text-sm text-[#ec3750] hover:text-blue-800" do %>← Check Ins<% end %>
      <h1 class="text-xl sm:text-2xl font-bold">Scanner</h1>
    </div>
    <span class="text-xs sm:text-sm text-gray-500 hidden sm:block">Check in participants by scanning QR codes or NFC tokens</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Scanner -->
    <div class="lg:col-span-2 bg-white rounded-lg border border-gray-200 p-4 sm:p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2">
          <h2 class="text-base sm:text-lg font-semibold">Camera Scanner</h2>
          <div id="camera-status" class="flex items-center gap-2">
            <span class="w-2 h-2 bg-gray-400 rounded-full" id="status-dot"></span>
            <span class="text-xs sm:text-sm text-gray-500" id="status-text">Initializing...</span>
          </div>
          <button type="button" id="restart-camera-btn" class="hidden text-xs sm:text-sm text-[#ec3750] hover:text-blue-800 min-h-[44px] sm:min-h-0 px-1">
            Restart camera
          </button>
        </div>
        
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1" data-controller="role-info">
          <% if @scan_contexts.size > 1 %>
            <label for="scan-context" class="text-xs sm:text-sm text-gray-500 whitespace-nowrap">Context:</label>
            <select id="scan-context" data-role-info-target="select" data-action="role-info#update" class="border border-gray-300 rounded-md px-2 py-1 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#ec3750] aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-red-200" autocomplete="off" required aria-invalid="true" aria-describedby="scan-context-required">
              <option value="" selected disabled>Choose a context</option>
              <% @scan_contexts.each do |context| %>
                <option value="<%= context.id %>">
                  <%= context.name %> — <%= context.kind_label %>
                </option>
              <% end %>
            </select>
          <% else %>
            <input type="hidden" id="scan-context" value="<%= @scan_contexts.first&.id %>" data-role-info-target="select">
          <% end %>
          <% @scan_contexts.select { |context| context.usage_note.present? }.each do |context| %>
            <p class="hidden w-full text-xs text-gray-500" data-role-info-target="panel" data-role="<%= context.id %>"><%= context.usage_note %></p>
          <% end %>
        </div>
      </div>
      
      <div class="flex items-center gap-2 mb-3 hidden" id="camera-select-wrapper">
        <label for="camera-select" class="text-xs sm:text-sm text-gray-500 whitespace-nowrap">Camera:</label>
        <select id="camera-select" class="flex-1 border border-gray-300 rounded-md px-2 py-1 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#ec3750]"></select>
      </div>

      <div id="qr-reader" class="w-full bg-gray-900 rounded-lg overflow-hidden relative" style="min-height: 280px;">
        <video id="qr-video" class="w-full h-full object-cover" style="min-height: 280px;" muted playsinline></video>
        <!-- iOS home-screen web apps often refuse a camera prompt that isn't
             tied to a tap, so keep a manual way to (re)start it. -->
        <button type="button" id="start-camera-btn"
                class="hidden absolute inset-0 w-full h-full flex items-center justify-center text-white text-sm font-medium bg-gray-900/80">
          Tap to start camera
        </button>
        <% if @scan_contexts.size > 1 %>
          <div id="scan-context-required" class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-1 px-6 text-center text-white bg-gray-900">
            <p class="text-sm sm:text-base font-semibold">Choose a context to start scanning</p>
            <p class="text-xs sm:text-sm text-gray-300">Pick where you're scanning people in from the Context menu.</p>
          </div>
        <% end %>
      </div>
      
      <%# Stays up until dismissed or replaced by the next result, so a busy %>
      <%# organizer can always look back and see what their last scan did. %>
      <div id="scan-result" class="mt-4 rounded-lg hidden" role="status" aria-live="polite">
        <!-- Scan result appears here -->
      </div>
      <p id="scan-queue-note" class="mt-2 text-xs text-gray-500 hidden" aria-live="polite"></p>
      <%# Scans saved on the device while the connection is down, and what %>
      <%# became of them. Painted by app/javascript/scanner/ui.js. %>
      <div id="scan-sync" class="hidden" aria-live="polite"></div>

      <!-- Search by name or ID -->
      <div class="mt-4 pt-4 border-t border-gray-200">
        <p class="text-sm text-gray-500 mb-2">Search by name or ID:</p>
        <div class="relative">
          <input type="text" id="participant-search" placeholder="Name or first 8 chars of ID..." 
                 class="w-full border border-gray-300 rounded-md px-3 py-2.5 sm:py-2 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#ec3750]"
                 autocomplete="off">
          <div id="search-results" class="absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-md shadow-lg hidden max-h-64 overflow-y-auto">
            <!-- Search results appear here -->
          </div>
        </div>
      </div>

      <!-- Manual entry fallback -->
      <div class="mt-4 pt-4 border-t border-gray-200">
        <p class="text-sm text-gray-500 mb-2">Or enter full participant ID manually:</p>
        <form id="manual-scan-form" class="flex flex-col sm:flex-row gap-2">
          <input type="text" id="manual-participant-id" placeholder="Participant ID (UUID)" 
                 class="flex-1 border border-gray-300 rounded-md px-3 py-2.5 sm:py-2 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#ec3750]">
          <button type="submit" class="bg-[#d42f46] text-white px-4 py-2.5 sm:py-2 rounded-md hover:bg-[#b82840] text-sm font-medium min-h-[44px] sm:min-h-0">
            Look Up
          </button>
        </form>
      </div>

      <!-- NFC Scanner (via macOS bridge) -->
      <div class="mt-4 pt-4 border-t border-gray-200" id="nfc-scanner-section">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <p class="text-sm font-medium text-gray-700">NFC Scanner</p>
              <div id="nfc-status" class="flex items-center gap-1.5">
                <span class="w-2 h-2 bg-gray-400 rounded-full" id="nfc-status-dot"></span>
                <span class="text-xs text-gray-500" id="nfc-status-text">Not connected</span>
              </div>
            </div>
            <button type="button" id="nfc-connect-btn" class="text-xs text-[#ec3750] hover:text-blue-800">
              Connect
            </button>
          </div>
          <p class="text-xs text-gray-500 mb-3">
            Connect to the Attend NFC Bridge app to scan NFC badges or passports.
            <a href="https://github.com/hackclub/attend-nfc/releases/latest" target="_blank" class="text-[#ec3750] hover:underline">Download bridge app →</a>
          </p>
          
          <% if current_event.nfc_badges_enabled? %>
          <!-- NFC Write Panel (shown after QR scan) -->
          <div id="nfc-write-panel" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-4 mt-3">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-blue-800">Write NFC Badge</span>
              <button type="button" id="nfc-write-cancel" class="text-xs text-[#ec3750] hover:text-blue-800">Cancel</button>
            </div>
            <p class="text-xs text-blue-700 mb-3">
              Tap a fresh NFC badge to the reader to assign it to <strong id="nfc-write-participant-name"></strong>
            </p>
            <div id="nfc-write-status" class="text-xs text-[#ec3750]">Waiting for badge...</div>
          </div>
          <% end %>
      </div>
    </div>

    <!-- Recent Scans -->
    <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6" data-controller="event-scans" data-event-scans-event-id-value="<%= current_event.id %>">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base sm:text-lg font-semibold">Recent Scans</h2>
        <%= link_to "View All", history_admin_event_scans_path(current_event), class: "text-xs text-[#ec3750] hover:text-blue-800" %>
      </div>
      <div id="recent-scans" class="space-y-3 max-h-[300px] sm:max-h-[500px] overflow-y-auto" data-event-scans-target="scans">
        <% if @recent_scans.any? %>
          <% @recent_scans.each do |scan| %>
            <div class="flex items-center justify-between border-b border-gray-100 pb-3 last:border-0">
              <div class="min-w-0 flex-1 mr-2">
                <p class="font-medium text-sm truncate"><%= scan.participant.display_name %></p>
                <p class="text-xs text-gray-500">
                  <%= scan.scanned_at.strftime("%H:%M") %>
                  <% if scan.scan_context %>
                    <span class="text-gray-400">@ <%= scan.scan_context.name %></span>
                  <% end %>
                </p>
                <p class="text-xs text-gray-400">by <%= scan.user.display_name_or_fallback %></p>
              </div>
              <%= link_to "View", admin_event_participant_path(current_event, scan.participant_event), 
                  class: "text-xs text-[#ec3750] hover:text-blue-800 min-h-[44px] min-w-[44px] flex items-center justify-center" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500 text-center py-8 text-sm" data-event-scans-target="empty"><%= @offline_shell ? "Scans from today are not shown without a connection." : "No scans yet today" %></p>
        <% end %>
      </div>
      
      <% unless @offline_shell %>
        <div class="mt-4 pt-4 border-t border-gray-200">
          <p class="text-sm text-gray-500">
            <span class="font-medium text-gray-700" id="scan-count" data-event-scans-target="count"><%= @recent_scans.count %></span> scans today
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Participant Modal -->
<div id="participant-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
  <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
    <!-- Header -->
    <div id="modal-header" class="bg-gradient-to-r from-blue-600 to-blue-800 text-white px-4 sm:px-6 py-4">
      <div class="flex justify-between items-start gap-4">
        <div class="min-w-0 flex-1">
          <p class="text-blue-200 text-xs sm:text-sm" id="modal-action-text">Checked In</p>
          <h3 class="text-xl sm:text-2xl font-bold truncate" id="modal-name"></h3>
          <div id="modal-groups" class="flex flex-wrap gap-1 mt-1"></div>
          <p class="text-blue-200 text-xs mt-1" id="modal-context-name"></p>
        </div>
        <button data-close-participant-modal class="text-white/70 hover:text-white text-2xl leading-none min-h-[44px] min-w-[44px] flex items-center justify-center -mr-2">&times;</button>
      </div>
    </div>
    
    <!-- Alerts -->
    <div id="modal-alerts" class="px-4 sm:px-6"></div>
    
    <!-- Content -->
    <div class="p-4 sm:p-6">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 text-sm">
        <div>
          <dt class="text-gray-500">Status</dt>
          <dd id="modal-status" class="font-semibold"></dd>
        </div>
        <div>
          <dt class="text-gray-500">Pronouns</dt>
          <dd id="modal-pronouns"></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-gray-500">Email</dt>
          <dd id="modal-email" class="truncate"></dd>
        </div>
        <% if can_view_participant_pii? %>
          <div>
            <dt class="text-gray-500">Phone</dt>
            <dd id="modal-phone"></dd>
          </div>
        <% end %>
        <div>
          <dt class="text-gray-500">T-Shirt Size</dt>
          <dd id="modal-tshirt" class="font-medium"></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-gray-500">Dietary</dt>
          <dd id="modal-dietary"></dd>
        </div>
      </dl>

      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a id="modal-view-link" href="#" class="flex-1 bg-[#d42f46] text-white px-4 py-3 sm:py-2 rounded-lg text-center hover:bg-[#b82840] font-medium min-h-[44px] flex items-center justify-center">
          View Full Profile
        </a>
        <button data-close-participant-modal class="flex-1 bg-gray-100 text-gray-700 px-4 py-3 sm:py-2 rounded-lg hover:bg-gray-200 font-medium min-h-[44px]">
          Scan Next
        </button>
      </div>
      <% if current_event.nfc_badges_enabled? %>
      <div id="modal-nfc-section" class="mt-4 pt-4 border-t border-gray-200 hidden">
        <button id="modal-write-nfc-btn" class="w-full bg-purple-600 text-white px-4 py-3 sm:py-2 rounded-lg hover:bg-purple-700 font-medium min-h-[44px] flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
          <span id="modal-nfc-btn-text">Write NFC Badge</span>
        </button>
        <p id="modal-nfc-status" class="text-xs text-gray-500 text-center mt-2"></p>
      </div>
      <% end %>
    </div>
  </div>
</div>

<%= scanner_mount(skin: :classic) %>

<%# Up/down reorder buttons. Locals: path (the record's move path), label, first, last %>
<span class="inline-flex gap-1">
  <%= button_to "↑", path, method: :patch, params: { direction: "up" }, class: "px-2 text-gray-500 hover:text-[#ec3750] disabled:opacity-30", disabled: first, "aria-label": "Move #{label} up" %>
  <%= button_to "↓", path, method: :patch, params: { direction: "down" }, class: "px-2 text-gray-500 hover:text-[#ec3750] disabled:opacity-30", disabled: last, "aria-label": "Move #{label} down" %>
</span>

<% label, colors = { "pending" => [ "Awaiting review", "bg-amber-100 text-amber-800" ], "cleared" => [ "Cleared", "bg-green-100 text-green-800" ], "upheld" => [ "Upheld — ineligible", "bg-red-100 text-red-800" ] }.fetch(disclosure.review_status, [ "Answered no", "bg-gray-100 text-gray-600" ]) %>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= colors %>"><%= label %></span>

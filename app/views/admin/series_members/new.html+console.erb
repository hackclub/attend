<% content_for :title, "Add Member – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs(cs_gated_crumb("Event series", admin_series_index_path, policy(EventSeries).index?), [ @series.name, admin_series_path(@series) ], [ "Members", admin_series_members_path(@series) ], [ "Add member", nil ]) %>

<div class="cs-stack max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Add series member</h1>
    </div>
  </div>

  <%= form_with url: admin_series_members_path(@series), method: :post, class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Member details</h2>
      </div>
      <div class="cs-container-body">
        <%= cs_field id: "email", label: "User email", errors: cs_field_error_messages(@series_role_assignment, :user_id, label: "User email", messages: { taken: "This person is already a member of this series." }),
              constraint: "If they don't have an account yet, one is created for them and linked when they first sign in. For example: name@hackclub.com" do |aria| %>
          <%= email_field_tag :email, params[:email], class: "cs-input", required: true, autocomplete: "off", **aria %>
        <% end %>

        <%= fields_for :series_role_assignment, @series_role_assignment do |sra| %>
          <%= cs_form_field sra, :role, label: "Role", messages: {}, data: { controller: "role-info" } do |aria| %>
            <%= sra.select :role,
              SeriesRoleAssignment::ROLE_DETAILS.map { |role, details| [details[:label], role] },
              { selected: @series_role_assignment&.role.presence || "organizer" },
              class: "cs-select", required: true,
              data: { role_info_target: "select", action: "change->role-info#update" }, **aria %>

            <% SeriesRoleAssignment::ROLE_DETAILS.each do |role, details| %>
              <div data-role-info-target="panel" data-role="<%= role %>" class="cs-alert mt-3 hidden">
                <%= cs_status_icon(:info) %>
                <div class="w-full">
                  <p class="cs-alert-title"><%= details[:label] %></p>
                  <p><%= details[:summary] %></p>
                  <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <p class="cs-kv-label">Can</p>
                      <ul class="mt-1 space-y-1">
                        <% details[:can].each do |perm| %>
                          <li><%= cs_status(:success, perm) %></li>
                        <% end %>
                      </ul>
                    </div>
                    <% if details[:cannot].any? %>
                      <div>
                        <p class="cs-kv-label">Cannot</p>
                        <ul class="mt-1 space-y-1">
                          <% details[:cannot].each do |perm| %>
                            <li><%= cs_status(:stopped, perm) %></li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>

    <%= cs_form_errors @series_role_assignment, except: [ :user_id, :user ] %>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
      <%= link_to "Cancel", admin_series_members_path(@series), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button "Add member", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

<% content_for :title, "#{@series.name} Members – Attend" %>

<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="flex items-center gap-3 min-w-0">
      <%= render "admin/events/avatar", event: @series, size: 32, rounded: "rounded-lg" %>
      <h1 class="text-2xl font-bold text-gray-900 truncate"><%= @series.name %> Members</h1>
    </div>
    <%= link_to "Add Member", new_admin_series_member_path(@series), class: "w-full sm:w-auto text-center px-4 py-2 bg-[#ec3750] text-white rounded-md hover:bg-[#d42f46] transition-colors" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <% if @series_role_assignments.any? %>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Added</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @series_role_assignments.each do |assignment| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= assignment.user.display_name_or_fallback %></div>
                <div class="text-sm text-gray-500"><%= assignment.user.email %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= assignment.role == 'owner' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= assignment.role.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assignment.created_at.strftime("%B %d, %Y") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= button_to "Remove", admin_series_member_path(@series, assignment), method: :delete, class: "text-red-600 hover:text-red-900", data: { turbo_confirm: "Are you sure you want to remove #{assignment.user.email} from this series?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-gray-500">No members in this series yet.</p>
        <p class="text-sm text-gray-400 mt-2">Members can create and manage events within this series without needing global admin.</p>
      </div>
    <% end %>
  </div>

  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
    <h3 class="text-sm font-medium text-blue-800 mb-2">Role Permissions</h3>
    <ul class="text-sm text-blue-700 space-y-1">
      <li><strong>Owner:</strong> Edits the series and manages members, plus everything organizers can do</li>
      <li><strong>Organizer:</strong> Creates events in this series and acts as event admin on all of them</li>
    </ul>
  </div>
</div>

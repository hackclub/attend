<% content_for :breadcrumbs, cs_breadcrumbs([ "Training", admin_training_path ], [ @badge.name, nil ]) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1"><%= @badge.name %></h1>
      <% if @badge.description.present? %><p class="cs-description"><%= @badge.description %></p><% end %>
    </div>
    <div class="cs-actions">
      <%= link_to "Edit", edit_admin_training_badge_path(@badge), class: "cs-btn cs-btn-full" %>
      <%= link_to "Award manually", new_admin_training_badge_award_path(@badge), class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header"><h2 class="cs-h2">Badge details</h2></div>
    <div class="cs-container-body">
      <dl class="cs-kv cs-kv-3">
        <div><dt class="cs-kv-label">Required for</dt><dd class="cs-kv-value"><%= render "admin/training/required_roles", badge: @badge %></dd></div>
        <div><dt class="cs-kv-label">Validity</dt><dd class="cs-kv-value"><%= training_validity(@badge) %></dd></div>
        <div>
          <dt class="cs-kv-label">Awarded by</dt>
          <dd class="cs-kv-value">
            <% if @badge.courses.any? %>
              <%= safe_join(@badge.courses.map { |course| link_to(course.title, admin_training_course_path(course), class: "cs-link") }, ", ") %>
            <% else %>
              <span class="cs-muted">No course yet — manual awards only</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Holders <span class="cs-counter">(<%= @awards.size %>)</span></h2>
      <div class="cs-actions">
        <% Admin::TrainingBadgesController::STATUS_FILTERS.each do |filter| %>
          <%= link_to filter.titleize, admin_training_badge_path(@badge, status: filter), class: "cs-btn #{"cs-btn-primary" if filter == @filter}", "aria-current": (filter == @filter ? "true" : nil) %>
        <% end %>
      </div>
    </div>
    <% if @awards.empty? %>
      <div class="cs-empty"><p class="cs-empty-title">No <%= @filter == "all" ? "" : "#{@filter} " %>awards</p></div>
    <% else %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Holder</th>
              <th scope="col">Status</th>
              <th scope="col">Awarded</th>
              <th scope="col">How</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @awards.each do |award| %>
              <% state = training_award_state(award) %>
              <tr>
                <td>
                  <%= link_to award.user.display_name_or_fallback, admin_user_path(award.user), class: "cs-link" %>
                  <div class="cs-small cs-secondary"><%= award.user.email %></div>
                </td>
                <td class="whitespace-nowrap">
                  <%= cs_status({ current: :success, expiring: :warning, expired: :stopped, revoked: :error }.fetch(state), training_award_state_label(award)) %>
                  <% if award.revoked? && award.revoked_reason.present? %>
                    <div class="cs-small cs-secondary"><%= award.revoked_reason %></div>
                  <% end %>
                </td>
                <td class="whitespace-nowrap"><%= cs_absolute_time(award.awarded_at, date_only: true) %></td>
                <td>
                  <% if award.course %>
                    Completed <%= award.course.title %>
                  <% else %>
                    By <%= award.awarded_by&.display_name_or_fallback || "an admin" %><% if award.note.present? %>: <span class="cs-secondary"><%= award.note %></span><% end %>
                  <% end %>
                </td>
                <td class="whitespace-nowrap text-right">
                  <% unless award.revoked? %>
                    <details class="inline-block text-left">
                      <summary class="cs-btn cs-btn-link">Revoke</summary>
                      <%= form_with url: revoke_admin_training_badge_award_path(@badge, award), method: :patch, class: "mt-2 flex gap-2" do %>
                        <%= text_field_tag :reason, nil, class: "cs-input", placeholder: "Reason (optional)", "aria-label": "Reason for revoking" %>
                        <%= button_tag "Revoke", class: "cs-btn" %>
                      <% end %>
                    </details>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>

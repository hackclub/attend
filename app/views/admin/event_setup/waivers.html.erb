<% content_for :title, "Event Setup: Waivers – Attend" %>

<div class="w-full max-w-3xl">
  <% unless params[:return_to] == "integrations" %>
    <%= render "progress", current_step: "waivers" %>
  <% end %>

  <h1 class="text-2xl font-bold mb-1">Set up waivers</h1>
  <p class="text-gray-500 mb-6">Participants (and their guardians) sign waivers digitally through DocuSeal during onboarding. Choose how you'd like to set them up.</p>

  <%= render "waiver_options", event: @event, return_to: params[:return_to].presence %>
</div>

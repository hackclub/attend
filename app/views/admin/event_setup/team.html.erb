<% content_for :title, "Event Setup: Team – Attend" %>

<%= render layout: "wizard", locals: {
      current_step: "team",
      title: "Team",
      description: "Staff can be added later from event settings."
    } do %>
  <div class="cs-stack">
    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided">
        <h2 class="cs-h2">Staff <span class="cs-counter">(<%= @event_role_assignments.size %>)</span></h2>
      </div>
      <% if @event_role_assignments.any? %>
        <div class="cs-table-wrap">
          <table class="cs-table">
            <thead>
              <tr><th scope="col">Email</th><th scope="col">Role</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
              <% @event_role_assignments.each do |assignment| %>
                <tr>
                  <td><%= assignment.user.email %></td>
                  <td><%= EventRoleAssignment::ROLE_DETAILS.dig(assignment.role, :label) || assignment.role.humanize %></td>
                  <td class="text-right">
                    <% if assignment.inherited_from_series? %>
                      <span title="Series <%= assignment.series_role %>s act as event admins on every event in the series. Manage them from the series members page."><%= cs_status(:info, "Inherited from series") %></span>
                    <% else %>
                      <%= button_to "Remove", admin_event_setup_team_member_path(@event, assignment), method: :delete, class: "cs-btn cs-btn-link", form: { data: { turbo_confirm: "Remove #{assignment.user.email} from #{@event.name}?" } } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="cs-empty">
          <p class="cs-empty-title">No staff yet</p>
          <p>Only global admins can reach this event until you add someone.</p>
        </div>
      <% end %>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Add a staff member</h2>
      </div>
      <div class="cs-container-body">
        <%= form_with url: admin_event_setup_team_path(@event), method: :post do |f| %>
          <div class="cs-field">
            <%= label_tag :email, "User email", class: "cs-field-label" %>
            <%= email_field_tag :email, params[:email], class: "cs-input", placeholder: "user@example.com", required: true %>
            <p class="cs-field-hint">They need an Attend account already. If they don't have one, ask them to sign in to Attend first.</p>
          </div>

          <%= fields_for :event_role_assignment do |era| %>
            <div class="cs-field" data-controller="role-info">
              <%= era.label :role, "Role", class: "cs-field-label" %>
              <%= era.select :role,
                EventRoleAssignment::ROLE_DETAILS.map { |role, details| [ details[:label], role ] },
                { selected: "event_admin" },
                class: "cs-select",
                data: { role_info_target: "select", action: "change->role-info#update" } %>

              <% EventRoleAssignment::ROLE_DETAILS.each do |role, details| %>
                <div data-role-info-target="panel" data-role="<%= role %>" class="cs-alert mt-3 hidden">
                  <%= cs_status_icon(:info) %>
                  <div class="w-full">
                    <p class="cs-alert-title"><%= details[:label] %></p>
                    <p><%= details[:summary] %></p>
                    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4">
                      <div>
                        <p class="cs-kv-label">Can</p>
                        <ul class="mt-1 space-y-1">
                          <% details[:can].each do |perm| %>
                            <li><%= cs_status(:success, perm) %></li>
                          <% end %>
                        </ul>
                      </div>
                      <% if details[:cannot].any? %>
                        <div>
                          <p class="cs-kv-label">Cannot</p>
                          <ul class="mt-1 space-y-1">
                            <% details[:cannot].each do |perm| %>
                              <li><%= cs_status(:stopped, perm) %></li>
                            <% end %>
                          </ul>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="flex justify-end mt-4">
            <%= f.button "Add staff member", class: "cs-btn" %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <div class="cs-wizard-actions">
    <%= link_to "Exit setup", admin_event_dashboard_path(@event.slug), class: "cs-btn cs-btn-link" %>
    <%= link_to "Previous", admin_event_setup_waivers_path(@event), class: "cs-btn" %>
    <%= link_to "Next", admin_event_setup_review_path(@event), class: "cs-btn cs-btn-primary" %>
  </div>
<% end %>

<% content_for :title, "Event Setup: Schedule – Attend" %>

<%= render layout: "wizard", locals: {
      current_step: "schedule",
      title: "Schedule and location",
      description: "You can change these later in event settings."
    } do %>
  <%= form_with model: @event, url: admin_event_setup_schedule_path(@event), method: :patch, class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
    <section class="cs-container">
      <div class="cs-container-header">
        <div>
        <h2 class="cs-h2">Event dates</h2>
        <p class="cs-container-description">Times are in the event's time zone: <%= f.object.event_local_time_zone.name %>.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-field-grid">
          <%= cs_form_field f, :starts_at, label: "Starts at", optional: true do |aria| %>
            <%= f.datetime_local_field :starts_at, value: f.object.local_time_field_value(:starts_at), lang: "en-GB", class: "cs-input", **aria %>
          <% end %>
          <%= cs_form_field f, :ends_at, label: "Ends at", optional: true do |aria| %>
            <%= f.datetime_local_field :ends_at, value: f.object.local_time_field_value(:ends_at), lang: "en-GB", class: "cs-input", **aria %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
        <h2 class="cs-h2">Registration period</h2>
        <p class="cs-container-description">Times are in the event's time zone: <%= f.object.event_local_time_zone.name %>.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-field-grid">
          <%= cs_form_field f, :registration_open_at, label: "Registration opens at", optional: true do |aria| %>
            <%= f.datetime_local_field :registration_open_at, value: f.object.local_time_field_value(:registration_open_at), lang: "en-GB", class: "cs-input", **aria %>
          <% end %>
          <%= cs_form_field f, :registration_close_at, label: "Registration closes at", optional: true do |aria| %>
            <%= f.datetime_local_field :registration_close_at, value: f.object.local_time_field_value(:registration_close_at), lang: "en-GB", class: "cs-input", **aria %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
        <h2 class="cs-h2">Arrival window</h2>
        <p class="cs-container-description">Shown to attendees as "when to arrive" on their dashboard. Leave blank if check-in times aren't decided yet. Times are in the event's time zone: <%= f.object.event_local_time_zone.name %>.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-field-grid">
          <%= cs_form_field f, :arrival_opens_at, label: "Arrival opens at", optional: true do |aria| %>
            <%= f.datetime_local_field :arrival_opens_at, value: f.object.local_time_field_value(:arrival_opens_at), lang: "en-GB", class: "cs-input", **aria %>
          <% end %>
          <%= cs_form_field f, :arrival_closes_at, label: "Arrival closes at", optional: true do |aria| %>
            <%= f.datetime_local_field :arrival_closes_at, value: f.object.local_time_field_value(:arrival_closes_at), lang: "en-GB", class: "cs-input", **aria %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
        <h2 class="cs-h2">Location</h2>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-field-grid">
          <%= cs_form_field f, :location_city, label: "City", optional: true %>
          <%= cs_form_field f, :location_country, label: "Country", optional: true %>
          <%= cs_form_field f, :venue_name, label: "Venue name", optional: true, constraint: "For example: Reaktor" %>
          <%= cs_form_field f, :location_address, label: "Venue address", optional: true, id: "venue-address-input",
                constraint: "Start typing to search Google Places." do |aria| %>
            <%= f.text_field :location_address, id: "venue-address-input", class: "cs-input", autocomplete: "off", **aria %>
          <% end %>
        </div>
        <p class="cs-field-hint mt-3">Venue name and address are optional, but both are needed for venue info on Google Wallet passes.</p>
        <%= f.hidden_field :location_latitude, id: "venue-latitude" %>
        <%= f.hidden_field :location_longitude, id: "venue-longitude" %>
      </div>
    </section>

    <%= cs_form_errors f %>

    <div class="cs-wizard-actions">
      <%= link_to "Exit setup", admin_event_dashboard_path(@event.slug), class: "cs-btn cs-btn-link" %>
      <%= link_to "Skip this step", admin_event_setup_modules_path(@event), class: "cs-btn cs-btn-link" %>
      <%= link_to "Previous", edit_admin_event_path(@event, return_to: "setup"), class: "cs-btn" %>
      <%= f.button "Next", class: "cs-btn cs-btn-primary" %>
    </div>
  <% end %>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    var script = document.createElement('script');
    script.src = 'https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.dig(:google, :key) %>&libraries=places&callback=initPlacesAutocomplete';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  })();

  function initPlacesAutocomplete() {
    var input = document.getElementById('venue-address-input');
    if (!input) return;

    var autocomplete = new google.maps.places.Autocomplete(input, {
      types: ['establishment', 'geocode']
    });

    autocomplete.addListener('place_changed', function() {
      var place = autocomplete.getPlace();
      if (place.geometry) {
        document.getElementById('venue-latitude').value = place.geometry.location.lat();
        document.getElementById('venue-longitude').value = place.geometry.location.lng();
      }
      if (place.formatted_address) {
        input.value = place.formatted_address;
      }
    });
  }
</script>

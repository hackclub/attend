<% content_for :title, "Event Setup: Accommodation – Attend" %>

<div class="w-full max-w-4xl">
  <%= render "progress", current_step: "stays" %>

  <h1 class="text-2xl font-bold mb-1">Who are you putting up, and when?</h1>
  <p class="text-gray-500 mb-6">Add a stay for each stretch of accommodation you're providing, like a hotel during the event or the night before or after. Skip this if nobody needs a bed, for example everyone sleeps at the venue. You can add stays later.</p>

  <div class="space-y-6">
    <% if @event.accommodation_enabled? %>
      <%= render "admin/rooming_stays/list", stays: @stays, roster_counts: @roster_counts, exempt_count: @exempt_count, return_to: "setup" %>

      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Add a stay</h2>
        <%= render "admin/rooming_stays/form", stay: @new_stay, url: admin_event_rooming_stays_path(@event.slug), method: :post, submit: "Add stay", return_to: "setup" %>
      </div>
    <% else %>
      <div class="bg-blue-50 border border-blue-200 rounded-md p-4 text-sm text-blue-900">
        Accommodation is off. Turn it on in <%= link_to "Modules", admin_event_setup_modules_path(@event), class: "font-medium underline" %> to set up stays and rooming.
      </div>
    <% end %>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-between gap-3">
      <%= link_to "Back", admin_event_setup_modules_path(@event), class: "w-full sm:w-auto text-center text-gray-500 hover:text-gray-700 font-medium py-2 px-4" %>
      <%= link_to "Continue", admin_event_setup_waivers_path(@event, return_to: params[:return_to].presence), class: "w-full sm:w-auto text-center bg-[#d42f46] text-white px-6 py-2 rounded-md hover:bg-[#b82840]" %>
    </div>
  </div>
</div>

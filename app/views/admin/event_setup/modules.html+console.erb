<% content_for :title, "Event Setup: Modules – Attend" %>

<%= render layout: "wizard", locals: {
      current_step: "modules",
      title: "Modules",
      description: "Modules you turn off are hidden from onboarding and the dashboards."
    } do %>
  <%= form_with model: @event, url: admin_event_setup_modules_path(@event, return_to: params[:return_to].presence), method: :patch, class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Participant onboarding</h2>
          <p class="cs-container-description">What participants and guardians are asked for.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-option">
          <%= f.check_box :travel_enabled, { checked: f.object.travel_enabled? } %>
          <div>
            <%= f.label :travel_enabled, "Travel", class: "cs-option-label" %>
            <p class="cs-option-description">Collect travel information from participants. Turning this off hides the travel onboarding step, travel dashboards and the travel calendar.</p>
          </div>
        </div>
        <div data-controller="wizard-reveal">
          <div class="cs-option">
            <%= f.check_box :visa_options_enabled, checked: f.object.visa_options_enabled?, data: { wizard_reveal_target: "input", action: "change->wizard-reveal#update" } %>
            <div>
              <%= f.label :visa_options_enabled, "Visa options", class: "cs-option-label" %>
              <p class="cs-option-description">Show visa requirement fields in travel information for international participants.</p>
            </div>
          </div>
        </div>
        <% if policy(f.object).review_visa_letters? %>
          <%= cs_form_field f, :visa_letters, label: "Visa invitation letters",
                description: "Issue visa invitation letters from Attend. Your event admins review applications under Visa letters." do |aria| %>
            <%= f.select :visa_letters, VisaLettersHelper::VISA_LETTER_MODE_LABELS.map { |mode, (label, _)| [ label, mode ] }, { selected: f.object.visa_letters_mode }, class: "cs-select", **aria %>
          <% end %>
        <% end %>
        <div class="cs-option">
          <%= f.check_box :accommodation_enabled, { checked: f.object.accommodation_enabled? } %>
          <div>
            <%= f.label :accommodation_enabled, "Accommodation", class: "cs-option-label" %>
            <p class="cs-option-description">Show accommodation and housing preferences in onboarding, for events with overnight stays.</p>
          </div>
        </div>
        <div class="cs-option">
          <%= f.check_box :roommate_preferences_enabled, { checked: f.object.roommate_preferences_enabled? } %>
          <div>
            <%= f.label :roommate_preferences_enabled, "Roommate preferences", class: "cs-option-label" %>
            <p class="cs-option-description">Show roommate preference fields on the accommodation onboarding step.</p>
          </div>
        </div>
        <div class="cs-option">
          <%= f.check_box :freedom_waivers_enabled, { checked: f.object.freedom_waivers_enabled? } %>
          <div>
            <%= f.label :freedom_waivers_enabled, "Freedom waivers", class: "cs-option-label" %>
            <p class="cs-option-description">Let guardians grant extra freedom permissions for minor participants. Affects the waiver setup in the next step.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">On-site operations</h2>
          <p class="cs-container-description">Tools for running the event itself.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-option">
          <%= f.check_box :groups_enabled, { checked: f.object.groups_enabled? } %>
          <div>
            <%= f.label :groups_enabled, "Groups", class: "cs-option-label" %>
            <p class="cs-option-description">Tag participants with named groups (for example, "Hardware" or "General Attendance") to tell cohorts apart within one event.</p>
          </div>
        </div>
        <div class="cs-option">
          <%= f.check_box :nfc_badges_enabled, { checked: f.object.nfc_badges_enabled? } %>
          <div>
            <%= f.label :nfc_badges_enabled, "NFC badges", class: "cs-option-label" %>
            <p class="cs-option-description">Check participants in by scanning NFC badges or wristbands. Write-on-check-in can be turned on later in event settings.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Invitation holds</h2>
          <p class="cs-container-description">Pause outgoing emails while the event is still being set up.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-option">
          <%= f.check_box :guardian_invites_locked, { checked: f.object.guardian_invites_locked? } %>
          <div>
            <%= f.label :guardian_invites_locked, "Lock guardian invites", class: "cs-option-label" %>
            <p class="cs-option-description">Hold off sending guardian invitations while waiver details are being finalised. Useful until your waivers are set up.</p>
          </div>
        </div>
        <div class="cs-option">
          <%= f.check_box :onboarding_invites_held, { checked: f.object.onboarding_invites_held? } %>
          <div>
            <%= f.label :onboarding_invites_held, "Hold onboarding invitations", class: "cs-option-label" %>
            <p class="cs-option-description">Add and import participants without emailing them, then send every invitation at once from the participants page or the series page. Useful when the series decides launch day.</p>
          </div>
        </div>
      </div>
    </section>

    <%= cs_form_errors f %>

    <div class="cs-wizard-actions">
      <%= link_to "Exit setup", admin_event_dashboard_path(@event.slug), class: "cs-btn cs-btn-link" %>
      <%= link_to "Previous", admin_event_setup_schedule_path(@event), class: "cs-btn" %>
      <%= f.button "Next", class: "cs-btn cs-btn-primary" %>
    </div>
  <% end %>
<% end %>

<%
  # Prefer the batch-loaded participant passed in from the show action;
  # fall back to a lookup for render sites that can't supply it.
  participant ||= Participant.find(journey[:participant_id])
  primary_leg = journey[:primary_leg]
  inbound = journey[:direction] == :inbound

  status_pill_classes = {
    "gray"   => "bg-gray-100 text-gray-700",
    "blue"   => "bg-blue-100 text-blue-800",
    "amber"  => "bg-amber-100 text-amber-800",
    "green"  => "bg-green-100 text-green-800",
    "red"    => "bg-red-100 text-red-800",
    "orange" => "bg-orange-100 text-orange-800"
  }
  pill_class = status_pill_classes[journey[:status_color]] || status_pill_classes["gray"]

  search_blob = [
    journey[:participant_name],
    journey[:participant_preferred_name],
    journey[:legs].map { |l| l[:flight_code] },
    journey[:legs].map { |l| l[:departure_airport] },
    journey[:legs].map { |l| l[:arrival_airport] }
  ].flatten.compact.join(" ").downcase

  data_attributes = {
    controller: "travel-detail",
    travel_detail_journey_value: journey.to_json,
    travel_detail_participant_name_value: journey[:participant_preferred_name].presence || journey[:participant_name],
    travel_detail_event_slug_value: current_event.slug,
    airport_filter_target: "journey",
    airport: journey[:primary_airport_iata],
    terminal: journey[:primary_terminal],
    status: journey[:status],
    is_delayed: journey[:is_delayed] ? "1" : "0",
    is_um: journey[:is_unaccompanied_minor] ? "1" : "0",
    arriving_now: journey[:arriving_now] ? "1" : "0",
    is_alert: (%i[cancelled diverted].include?(journey[:status]) || journey[:is_delayed]) ? "1" : "0",
    search: search_blob
  }
%>

<li data-controller="<%= data_attributes[:controller] %>"
    data-travel-detail-journey-value="<%= data_attributes[:travel_detail_journey_value] %>"
    data-travel-detail-participant-name-value="<%= data_attributes[:travel_detail_participant_name_value] %>"
    data-travel-detail-event-slug-value="<%= data_attributes[:travel_detail_event_slug_value] %>"
    data-airport-filter-target="journey"
    data-airport="<%= data_attributes[:airport] %>"
    data-terminal="<%= data_attributes[:terminal] %>"
    data-status="<%= data_attributes[:status] %>"
    data-is-delayed="<%= data_attributes[:is_delayed] %>"
    data-is-um="<%= data_attributes[:is_um] %>"
    data-arriving-now="<%= data_attributes[:arriving_now] %>"
    data-is-alert="<%= data_attributes[:is_alert] %>"
    data-search="<%= data_attributes[:search] %>"
    class="<%= 'bg-red-50/40 border-l-4 border-red-500' if journey[:is_unaccompanied_minor] %>">

  <div class="px-4 py-3 hover:bg-gray-50 transition-colors cursor-pointer"
       data-action="click->travel-detail#toggle">
    <div class="grid grid-cols-12 gap-3 items-center">

      <%# Status + photo %>
      <div class="col-span-12 sm:col-span-3 flex items-center gap-3 min-w-0">
        <% if journey[:participant_has_headshot] %>
          <%= image_tag participant.headshot.variant(resize_to_fill: [56, 56]),
              class: "w-12 h-12 rounded-full object-cover border border-white shadow-sm shrink-0" %>
        <% else %>
          <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
        <% end %>
        <div class="min-w-0">
          <%= link_to admin_event_participant_path(current_event, journey[:participant_event_id]),
              class: "block font-semibold text-gray-900 hover:text-[#ec3750] truncate",
              data: { turbo_frame: "_top" } do %>
            <% if journey[:participant_preferred_name].present? %>
              <%= journey[:participant_preferred_name] %> <span class="text-gray-400 font-normal">(<%= journey[:participant_name] %>)</span>
            <% else %>
              <%= journey[:participant_name] %>
            <% end %>
          <% end %>
          <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
            <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= pill_class %> inline-flex items-center gap-1">
              <% if journey[:arriving_now] && journey[:status] == :in_flight %>
                <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
              <% end %>
              <%= journey[:status_label] %>
              <% if primary_leg[:progress].present? && primary_leg[:progress] > 0 && primary_leg[:progress] < 1 && journey[:status] == :in_flight %>
                · <%= (primary_leg[:progress] * 100).round %>%
              <% end %>
            </span>
            <% if journey[:is_unaccompanied_minor] %>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-600 text-white">UM</span>
            <% end %>
            <% (journey[:groups] || []).each do |g| %>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-medium"
                    style="background-color: <%= g[:color] || '#e5e7eb' %>; color: <%= g[:color] ? 'white' : '#1f2d3d' %>;">
                <%= g[:name] %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <%# Route + flight code %>
      <div class="col-span-7 sm:col-span-3 min-w-0 text-sm">
        <div class="flex items-center gap-1 text-gray-700 flex-wrap">
          <% journey[:legs].each_with_index do |leg, idx| %>
            <% if idx == 0 %>
              <span class="font-mono font-medium"><%= leg[:departure_airport] %></span>
            <% end %>
            <span class="text-gray-300">→</span>
            <span class="font-mono font-medium"><%= leg[:arrival_airport] %></span>
          <% end %>
        </div>
        <div class="text-xs text-gray-500 mt-0.5 flex items-center gap-2 flex-wrap">
          <% journey[:legs].each_with_index do |leg, idx| %>
            <% if idx > 0 %><span class="text-gray-300">·</span><% end %>
            <span class="font-mono bg-gray-100 px-1.5 rounded"><%= leg[:flight_code] %></span>
          <% end %>
          <% if journey[:leg_count] > 1 %>
            <span class="text-gray-400"><%= journey[:leg_count] %> legs</span>
          <% end %>
        </div>
      </div>

      <%# Terminal / gate %>
      <div class="col-span-5 sm:col-span-2 text-sm">
        <% if journey[:primary_terminal].present? || journey[:primary_gate].present? %>
          <div class="font-semibold text-gray-900">
            <%= journey[:primary_terminal].present? ? "T#{journey[:primary_terminal]}" : "—" %>
            <% if journey[:primary_gate].present? %>
              <span class="text-gray-400 mx-1">·</span><%= journey[:primary_gate] %>
            <% end %>
          </div>
          <div class="text-xs text-gray-500"><%= inbound ? "Arrives" : "Departs" %> <%= journey[:primary_airport_iata] %></div>
        <% else %>
          <div class="text-xs text-gray-400">Terminal/gate unknown</div>
        <% end %>
      </div>

      <%# ETA / ETD with delay %>
      <div class="col-span-7 sm:col-span-2 text-sm">
        <% if journey[:primary_time_iso].present? %>
          <%
            display_tz = journey[:primary_airport_tz].presence || current_event.timezone
            t = Time.parse(journey[:primary_time_iso]).in_time_zone(display_tz)
            today = Time.current.in_time_zone(display_tz).to_date
            day_diff = (t.to_date - today).to_i
            day_label =
              case day_diff
              when 0 then { text: "Today",     color: "text-emerald-700 bg-emerald-50" }
              when 1 then { text: "Tomorrow",  color: "text-blue-700 bg-blue-50" }
              when -1 then { text: "Yesterday", color: "text-gray-600 bg-gray-100" }
              else
                { text: t.strftime("%a %-d %b"), color: day_diff < 0 ? "text-gray-600 bg-gray-100" : "text-amber-800 bg-amber-50" }
              end
          %>
          <div class="inline-flex items-center gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[11px] font-medium <%= day_label[:color] %>"><%= day_label[:text] %></span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-lg font-bold text-gray-900"
                  data-arrivals-tick-target="time"
                  data-time-iso="<%= journey[:primary_time_iso] %>">
              <%= t.strftime("%H:%M") %>
            </span>
            <% if journey[:is_delayed] %>
              <span class="px-1.5 py-0.5 rounded text-xs font-bold bg-red-100 text-red-700">+<%= journey[:delay_minutes] %>m</span>
            <% end %>
          </div>
          <div class="text-[11px] text-gray-500">
            local <%= journey[:primary_airport_iata] %>
            <% if journey[:primary_airport_tz].blank? %>
              <span class="text-amber-600">(tz unknown — showing event time)</span>
            <% end %>
          </div>
          <% if journey[:is_delayed] && journey[:primary_scheduled_iso].present? %>
            <% sched = Time.parse(journey[:primary_scheduled_iso]).in_time_zone(display_tz) %>
            <div class="text-xs text-gray-400 line-through">
              was <%= sched.strftime(sched.to_date == t.to_date ? "%H:%M" : "%a %H:%M") %>
            </div>
          <% elsif primary_leg[:eta_source] == :stored %>
            <div class="text-xs text-gray-400">Scheduled (no live data)</div>
          <% end %>
        <% else %>
          <div class="text-sm text-gray-400">No time</div>
        <% end %>
      </div>

      <%# Countdown / time-since %>
      <div class="col-span-5 sm:col-span-1 text-right text-xs"
           data-arrivals-tick-target="countdown"
           data-time-iso="<%= journey[:primary_time_iso] %>"
           data-status="<%= journey[:status] %>"
           data-direction="<%= journey[:direction] %>">
        <% if journey[:status] == :picked_up && journey[:scanned_at].present? %>
          <span class="text-green-600 font-medium">Checked in</span>
        <% elsif journey[:status] == :landed %>
          <span class="text-amber-700 font-medium">Awaiting pickup</span>
        <% elsif journey[:primary_time_iso].present? %>
          <span class="text-gray-500"></span>
        <% end %>
      </div>

      <%# Chevron %>
      <div class="col-span-12 sm:col-span-1 flex justify-end">
        <span class="text-gray-400 p-1" data-travel-detail-target="chevron">
          <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </span>
      </div>
    </div>

    <% if primary_leg[:last_tracked_at].present? %>
      <div class="text-[11px] text-gray-400 mt-1.5">Updated <%= time_ago_in_words(primary_leg[:last_tracked_at]) %> ago</div>
    <% end %>
  </div>

  <div data-travel-detail-target="content" class="hidden"></div>
</li>

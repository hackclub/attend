<% content_for :head do %>
<% end %>

<%
  current_counts = @tab == "outbound" ? @outbound_summary_counts : @summary_counts
  inbound_total  = @summary_counts[:total]
  outbound_total = @outbound_summary_counts[:total]

  # Chip definitions per tab
  status_chips = if @tab == "inbound"
    [
      { value: "all",          label: "All",            count: current_counts[:total],          color: "gray" },
      { value: "alerts",       label: "Alerts",         count: current_counts[:alerts],         color: "red", icon: "warn" },
      { value: "landed",       label: "Landed waiting", count: current_counts[:landed_waiting], color: "amber", pulse: true },
      { value: "arriving_now", label: "Arriving <30m",  count: current_counts[:arriving_now],   color: "rose" },
      { value: "in_flight",    label: "In flight",      count: current_counts[:in_flight],      color: "blue" },
      { value: "scheduled",    label: "Scheduled",      count: current_counts[:scheduled],      color: "gray" },
      { value: "picked_up",    label: "Picked up",      count: current_counts[:picked_up],      color: "green" },
      { value: "ums",          label: "UMs",            count: current_counts[:ums],            color: "red", icon: "warn" }
    ]
  else
    [
      { value: "all",       label: "All",       count: current_counts[:total],     color: "gray" },
      { value: "alerts",    label: "Alerts",    count: current_counts[:alerts],    color: "red", icon: "warn" },
      { value: "scheduled", label: "Scheduled", count: current_counts[:scheduled], color: "gray" },
      { value: "in_flight", label: "Departed",  count: current_counts[:in_flight], color: "blue" },
      { value: "landed",    label: "Arrived",   count: current_counts[:landed_waiting] + current_counts[:picked_up], color: "green" },
      { value: "ums",       label: "UMs",       count: current_counts[:ums],       color: "red", icon: "warn" }
    ]
  end

  chip_palette = ->(c, active) {
    base = "px-3 py-1.5 rounded-full text-sm font-medium border transition-all whitespace-nowrap inline-flex items-center gap-1.5"
    palettes = {
      "gray"  => active ? "bg-gray-900 text-white border-gray-900"          : "bg-white text-gray-700 border-gray-300 hover:border-gray-400",
      "red"   => active ? "bg-red-600 text-white border-red-600"            : "bg-white text-red-700 border-red-300 hover:border-red-400",
      "amber" => active ? "bg-amber-500 text-white border-amber-500"        : "bg-white text-amber-800 border-amber-300 hover:border-amber-400",
      "rose"  => active ? "bg-rose-600 text-white border-rose-600"          : "bg-white text-rose-700 border-rose-300 hover:border-rose-400",
      "blue"  => active ? "bg-blue-600 text-white border-blue-600"          : "bg-white text-blue-700 border-blue-300 hover:border-blue-400",
      "green" => active ? "bg-green-600 text-white border-green-600"        : "bg-white text-green-700 border-green-300 hover:border-green-400"
    }
    "#{base} #{palettes[c]}"
  }
%>

<div data-controller="airport-filter arrivals-tick"
     data-airport-filter-tab-value="<%= @tab %>">

  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
    <div>
      <h1 class="text-2xl font-bold flex items-center gap-3">
        <svg class="w-7 h-7 text-[#ec3750]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
        Airport Mode
      </h1>
      <p class="text-gray-500 text-sm mt-1"><%= current_event.name %></p>
    </div>

    <%# Live flight tracking was removed (OAG). Flight details are entered manually;
        staff mark pickups by hand on each journey card. %>
  </div>

  <%# Tabs %>
  <div class="flex border-b border-gray-200 mb-4 items-center justify-between">
    <div class="flex">
      <% [["inbound", "Inbound", inbound_total], ["outbound", "Outbound", outbound_total]].each do |value, label, count| %>
        <% active = @tab == value %>
        <%= link_to admin_event_airport_mode_path(current_event, tab: value, view: @view),
            class: "px-4 py-2.5 text-sm font-medium border-b-2 -mb-px flex items-center gap-2 #{active ? "border-[#ec3750] text-[#ec3750]" : "border-transparent text-gray-500 hover:text-gray-700"}" do %>
          <%= label %>
          <span class="<%= active ? "bg-[#ec3750]/10 text-[#ec3750]" : "bg-gray-100 text-gray-600" %> text-xs px-2 py-0.5 rounded-full"><%= count %></span>
        <% end %>
      <% end %>
    </div>
    <div class="flex items-center gap-1 pb-1">
      <%= link_to admin_event_airport_mode_path(current_event, tab: @tab, view: "board"),
          class: "p-1.5 rounded #{@view == 'board' ? 'bg-gray-100 text-gray-900' : 'text-gray-400 hover:text-gray-600'}",
          title: "Board view (grouped by airport)" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
      <% end %>
      <%= link_to admin_event_airport_mode_path(current_event, tab: @tab, view: "grid"),
          class: "p-1.5 rounded #{@view == 'grid' ? 'bg-gray-100 text-gray-900' : 'text-gray-400 hover:text-gray-600'}",
          title: "Grid view (earliest to latest)" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6v6H4zM14 6h6v6h-6zM4 16h6v4H4zM14 16h6v4h-6z"/></svg>
      <% end %>
    </div>
  </div>

  <%# Sticky control bar: chips + search + filters %>
  <div class="sticky top-0 z-20 bg-white/95 backdrop-blur border border-gray-200 rounded-lg p-3 mb-4 shadow-sm">
    <% if current_event.groups_enabled? && current_event.groups.any? %>
      <div class="flex flex-wrap gap-2 mb-3 items-center text-sm">
        <span class="text-gray-500">Group:</span>
        <%= link_to "All", url_for(request.params.except(:group_id).merge(only_path: true)),
            class: "px-2.5 py-1 rounded-full border #{@selected_group.nil? ? 'bg-[#ec3750] text-white border-[#ec3750]' : 'border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
        <% current_event.groups.ordered.each do |g| %>
          <%= link_to g.name, url_for(request.params.merge(group_id: g.id, only_path: true)),
              class: "px-2.5 py-1 rounded-full border #{@selected_group&.id == g.id ? 'border-transparent text-white' : 'border-gray-300 text-gray-700 hover:bg-gray-50'}",
              style: (@selected_group&.id == g.id ? "background-color: #{g.normalized_color || '#ec3750'}" : "") %>
        <% end %>
      </div>
    <% end %>

    <%# Status chips %>
    <div class="flex flex-wrap gap-2 mb-3" data-airport-filter-target="chipGroup">
      <% status_chips.each do |chip| %>
        <button type="button"
                data-action="click->airport-filter#setStatus"
                data-airport-filter-target="chip"
                data-status="<%= chip[:value] %>"
                class="<%= chip_palette.call(chip[:color], chip[:value] == "all") %>"
                data-active-class="<%= chip_palette.call(chip[:color], true) %>"
                data-inactive-class="<%= chip_palette.call(chip[:color], false) %>">
          <% if chip[:pulse] %><span class="w-2 h-2 rounded-full bg-current animate-pulse"></span><% end %>
          <% if chip[:icon] == "warn" %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <% end %>
          <span><%= chip[:label] %></span>
          <span class="text-xs opacity-80">(<%= chip[:count] %>)</span>
        </button>
      <% end %>
    </div>

    <%# Search + filters %>
    <div class="flex flex-col sm:flex-row gap-2">
      <div class="flex-1 relative">
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/></svg>
        <input type="search"
               placeholder="Search by name, flight code, or airport (e.g. JFK)"
               data-airport-filter-target="search"
               data-action="input->airport-filter#search"
               class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#ec3750]/30 focus:border-[#ec3750]" />
      </div>

      <% if @airports_for_filter.size > 1 %>
        <select data-airport-filter-target="airportSelect"
                data-action="change->airport-filter#setAirport"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="">All airports</option>
          <% @airports_for_filter.each do |a| %>
            <option value="<%= a %>"><%= a %></option>
          <% end %>
        </select>
      <% end %>

      <% if @terminals_for_filter.any? %>
        <select data-airport-filter-target="terminalSelect"
                data-action="change->airport-filter#setTerminal"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <option value="">All terminals</option>
          <% @terminals_for_filter.each do |t| %>
            <option value="<%= t %>">Terminal <%= t %></option>
          <% end %>
        </select>
      <% end %>

      <button type="button"
              data-action="click->airport-filter#reset"
              class="px-3 py-2 text-sm text-gray-600 hover:text-gray-900 border border-transparent hover:border-gray-300 rounded-lg">
        Clear
      </button>
    </div>
  </div>

  <%# Empty state for the active tab %>
  <% if @journeys.empty? %>
    <div class="bg-white border border-gray-200 rounded-lg p-12 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
      </svg>
      <p class="text-gray-500">No <%= @tab %> flights to track.</p>
    </div>
  <% end %>

  <% if @view == "grid" %>
    <%# Flat grid sorted earliest → latest %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
      <% @journeys.each do |journey| %>
        <%= render partial: "journey_card", locals: { journey: journey } %>
      <% end %>
    </div>
  <% else %>
    <%# Boards grouped by airport %>
    <div class="space-y-4">
      <% @journeys_by_airport.each do |airport, journeys| %>
        <section class="bg-white border border-gray-200 rounded-lg overflow-hidden"
                 data-airport-filter-target="airportSection"
                 data-airport="<%= airport %>">
          <header class="px-4 py-2.5 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
            <h2 class="font-semibold text-gray-800 flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="font-mono"><%= airport %></span>
              <span class="text-xs text-gray-500 font-normal"
                    data-airport-filter-target="airportCount"><%= journeys.size %></span>
            </h2>
          </header>
          <ul class="divide-y divide-gray-100">
            <% journeys.each do |journey| %>
              <%= render partial: "journey_row", locals: { journey: journey } %>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% end %>
</div>

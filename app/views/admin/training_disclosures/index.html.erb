<div class="space-y-6">
  <%= link_to "← Training", admin_training_path, class: "text-sm text-gray-500 hover:text-[#ec3750]" %>
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Safety Reviews (<%= @disclosures.size %>)</h1>
    <p class="text-sm text-gray-500">People who answered yes to a course declaration. They can't train or work events until the <%= TrainingDisclosure::SAFETY_TEAM_NAME %> clears them.</p>
  </div>
  <div class="flex gap-2 text-sm">
    <% Admin::TrainingDisclosuresController::FILTERS.each do |filter| %>
      <%= link_to filter.titleize, admin_training_disclosures_path(status: filter), class: "px-3 py-1 rounded-full #{filter == @filter ? "bg-[#ec3750] text-white" : "bg-gray-100 text-gray-700"}" %>
    <% end %>
  </div>
  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100">
      <tbody class="divide-y divide-gray-100 text-sm">
        <% if @disclosures.empty? %><tr><td class="px-6 py-8 text-center text-gray-500">Nothing here.</td></tr><% end %>
        <% @disclosures.each do |disclosure| %>
          <tr>
            <td class="px-6 py-4"><%= link_to disclosure.user.display_name_or_fallback, admin_training_disclosure_path(disclosure), class: "font-medium text-gray-900 hover:text-[#ec3750]" %><div class="text-gray-500"><%= disclosure.user.email %></div></td>
            <td class="px-6 py-4 text-gray-600"><%= disclosure.course&.title || "Deleted course" %></td>
            <td class="px-6 py-4 text-gray-600"><%= l(disclosure.answered_at.to_date, format: :long) %></td>
            <td class="px-6 py-4"><%= render "admin/training/disclosure_status", disclosure: disclosure %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

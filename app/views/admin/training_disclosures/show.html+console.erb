<% content_for :breadcrumbs, cs_breadcrumbs([ "Training", admin_training_path ], [ "Safety reviews", admin_training_disclosures_path ], [ @disclosure.user.display_name_or_fallback, nil ]) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1"><%= @disclosure.user.display_name_or_fallback %></h1>
      <p class="cs-description">Viewing this declaration is recorded in the audit log.</p>
    </div>
    <div class="cs-actions">
      <%= link_to "User record", admin_user_path(@disclosure.user), class: "cs-btn cs-btn-full" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header"><h2 class="cs-h2">Declaration</h2></div>
    <div class="cs-container-body">
      <dl class="cs-kv cs-kv-2">
        <div class="col-span-full">
          <dt class="cs-kv-label">Question, as they saw it</dt>
          <dd class="cs-kv-value"><%= @disclosure.question %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Answer</dt>
          <dd class="cs-kv-value"><%= @disclosure.answered_yes? ? cs_badge("Yes", "red") : cs_badge("No") %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Status</dt>
          <dd class="cs-kv-value"><%= render "admin/training/disclosure_status", disclosure: @disclosure %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Email</dt>
          <dd class="cs-kv-value"><%= @disclosure.user.email %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Declared</dt>
          <dd class="cs-kv-value"><%= cs_absolute_time(@disclosure.answered_at) %><span class="cs-secondary"> before <%= @disclosure.course&.title || "a deleted course" %></span></dd>
        </div>
        <% if @disclosure.reviewed_at %>
          <div class="col-span-full">
            <dt class="cs-kv-label">Review</dt>
            <dd class="cs-kv-value">
              <%= @disclosure.review_status.titleize %> by <%= @disclosure.reviewed_by&.display_name_or_fallback || "an admin" %>, <%= cs_relative_time(@disclosure.reviewed_at, inline: true) %>
              <p class="mt-1 whitespace-pre-line"><%= @disclosure.review_note %></p>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <% if @disclosure.answered_yes? %>
    <%= form_with url: admin_training_disclosure_path(@disclosure), method: :patch, class: "cs-stack" do %>
      <section class="cs-container">
        <div class="cs-container-header">
          <div>
            <h2 class="cs-h2"><%= @disclosure.review_pending? ? "Review" : "Change the review" %></h2>
            <p class="cs-container-description">Clearing lets them carry on training and work events. Upholding keeps them ineligible.</p>
          </div>
        </div>
        <div class="cs-container-body">
          <%= cs_field id: "note", label: "Note", description: "Why — kept with the record, encrypted, and visible to global admins only." do |aria| %>
            <%= text_area_tag :note, nil, rows: 4, class: "cs-input", required: true, **aria %>
          <% end %>
        </div>
      </section>
      <div class="flex flex-col sm:flex-row justify-end gap-2">
        <%= button_tag "Uphold — keep ineligible", name: "outcome", value: "upheld", class: "cs-btn cs-btn-full" %>
        <%= button_tag "Clear", name: "outcome", value: "cleared", class: "cs-btn cs-btn-primary cs-btn-full",
              data: { turbo_confirm: "Clear this person to train and work at Hack Club events?" } %>
      </div>
    <% end %>
  <% end %>

  <% if @history.any? %>
    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided"><h2 class="cs-h2">Their other declarations</h2></div>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <tbody>
            <% @history.each do |other| %>
              <tr>
                <td><%= other.course&.title || "Deleted course" %></td>
                <td class="whitespace-nowrap"><%= cs_relative_time(other.answered_at) %></td>
                <td class="whitespace-nowrap"><%= render "admin/training/disclosure_status", disclosure: other %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>

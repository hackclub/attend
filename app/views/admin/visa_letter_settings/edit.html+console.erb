<% content_for :title, "Visa letter settings – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Visa letters", admin_event_visa_letters_path(@event) ], [ "Settings", nil ], event: @event) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Visa letter settings</h1>
      <p class="cs-description">How <%= @event.name %> takes applications for visa invitation letters.</p>
    </div>
  </div>

  <%= form_with model: @event, url: admin_event_visa_letter_settings_path(@event), method: :patch, local: true, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
    <div class="cs-stack">
      <section class="cs-container">
        <div class="cs-container-body space-y-5">
          <%= cs_form_field f, :visa_letters, label: "Who can apply", group: true do |aria| %>
            <div class="space-y-3">
              <% VisaLettersHelper::VISA_LETTER_MODE_LABELS.each do |mode, (label, description)| %>
                <div class="cs-option">
                  <%= f.radio_button :visa_letters, mode, checked: @event.visa_letters_mode == mode, **aria %>
                  <div>
                    <%= f.label :visa_letters, label, value: mode, class: "cs-option-label" %>
                    <p class="cs-option-description"><%= description %></p>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= cs_form_field f, :visa_letter_deadline, label: "Application deadline", optional: true,
                description: "The public form closes at the end of this day, on the event's clock. #{visa_letter_default_deadline_hint(@event)}" do |aria| %>
            <%= f.date_field :visa_letter_deadline, value: @event.visa_letter_deadline_date, class: "cs-input w-48!", **aria %>
          <% end %>

          <%= cs_form_field f, :visa_letter_rejection_reasons, label: "Saved rejection reasons", optional: true,
                description: "Offered when rejecting an application, so reviewers word common problems the same way.",
                constraint: "One per line. For example: The name doesn't match your passport." do |aria| %>
            <%= f.text_area :visa_letter_rejection_reasons, value: @rejection_reasons_text, rows: 5, class: "cs-input", **aria %>
          <% end %>
        </div>
      </section>

      <%= cs_form_errors f %>

      <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
        <%= link_to "Cancel", admin_event_visa_letters_path(@event), class: "cs-btn cs-btn-link" %>
        <%= f.button "Save settings", class: "cs-btn cs-btn-primary cs-btn-full" %>
      </div>
    </div>
  <% end %>
</div>

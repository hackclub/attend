<% content_for :title, "Visa letter settings – Attend" %>
<div class="max-w-3xl space-y-6">
  <%= link_to "← Visa letters", admin_event_visa_letters_path(@event), class: "text-sm text-gray-500 hover:text-[#ec3750]" %>
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Visa letter settings</h1>
    <p class="text-sm text-gray-500">How <%= @event.name %> takes applications for visa invitation letters.</p>
  </div>

  <%= form_with model: @event, url: admin_event_visa_letter_settings_path(@event), method: :patch, local: true, class: "bg-white border border-gray-200 rounded-lg p-6 space-y-5" do |f| %>
    <% if @event.errors.any? %>
      <div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-md px-4 py-3"><%= @event.errors.full_messages.to_sentence %></div>
    <% end %>
    <fieldset class="space-y-3">
      <legend class="text-sm font-medium text-gray-700">Who can apply</legend>
      <% VisaLettersHelper::VISA_LETTER_MODE_LABELS.each do |mode, (label, description)| %>
        <div class="flex items-start gap-2">
          <%= f.radio_button :visa_letters, mode, checked: @event.visa_letters_mode == mode, class: "mt-1" %>
          <div>
            <%= f.label :visa_letters, label, value: mode, class: "text-sm font-medium text-gray-700" %>
            <p class="text-sm text-gray-500"><%= description %></p>
          </div>
        </div>
      <% end %>
    </fieldset>
    <div>
      <%= f.label :visa_letter_deadline, "Application deadline (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :visa_letter_deadline, value: @event.visa_letter_deadline_date, class: "border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      <p class="text-xs text-gray-500 mt-1">The public form closes at the end of this day, on the event's clock.</p>
    </div>
    <div>
      <%= f.label :visa_letter_rejection_reasons, "Saved rejection reasons (optional, one per line)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :visa_letter_rejection_reasons, value: @rejection_reasons_text, rows: 5, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
    </div>
    <div class="flex justify-end gap-2">
      <%= link_to "Cancel", admin_event_visa_letters_path(@event), class: "px-4 py-2 text-sm text-gray-600" %>
      <%= f.button "Save settings", class: "px-4 py-2 bg-[#d42f46] text-white rounded-md text-sm" %>
    </div>
  <% end %>
</div>

<% content_for :breadcrumbs, cs_breadcrumbs([ "Participants", admin_event_participants_path(current_event) ], [ "Import participants", nil ]) %>

<div>
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Import participants</h1>
      <p class="cs-description">Import participants from a CSV file</p>
    </div>
    <div class="cs-actions">
      <%= link_to "Download template", template_admin_event_imports_path(current_event), class: "cs-btn" %>
    </div>
  </div>

  <div data-controller="dropzone">
    <%= form_with url: admin_event_imports_path(current_event), method: :post, multipart: true, local: true, id: "import-form", class: "cs-stack" do |f| %>
      <section class="cs-container">
        <div class="cs-container-header">
          <div>
            <h2 class="cs-h2">CSV file</h2>
            <p class="cs-container-description">Need a template? Download a CSV template with all supported columns.</p>
          </div>
        </div>
        <div class="cs-container-body">
          <div class="cs-field">
            <%= label_tag :csv_file, "Participants CSV", class: "cs-field-label" %>
            <div
              data-action="click->dropzone#openFilePicker dragover->dropzone#handleDragOver dragleave->dropzone#handleDragLeave drop->dropzone#handleDrop"
              class="border-2 border-dashed border-(--cs-border-input) rounded-lg p-10 text-center hover:border-(--cs-accent) hover:bg-(--cs-bg-selected) transition-colors cursor-pointer"
              data-dropzone-target="zone"
            >
              <div data-dropzone-target="content">
                <p class="cs-secondary">Drag and drop your CSV file here</p>
                <p class="mt-3"><span class="cs-btn">Choose file</span></p>
                <p class="cs-small cs-muted mt-2">or click anywhere in this area to browse</p>
              </div>
              <div data-dropzone-target="selected" class="hidden">
                <p><span class="cs-status cs-status-success"><%= cs_status_icon(:success) %><span class="font-bold" data-dropzone-target="fileName"></span></span></p>
                <p class="cs-small cs-muted mt-2">Click to change file</p>
              </div>
              <%= file_field_tag :csv_file, accept: ".csv", class: "hidden cs-file", data: { dropzone_target: "input", action: "change->dropzone#fileSelected" } %>
            </div>
            <p class="cs-field-hint">CSV files only. You'll see a preview before the import starts.</p>
          </div>
        </div>
      </section>

      <section class="cs-container">
        <div class="cs-container-header">
          <h2 class="cs-h2">Invitations</h2>
        </div>
        <div class="cs-container-body">
          <% if current_event.onboarding_invites_held? %>
            <div class="cs-alert cs-alert-warning">
              <%= cs_status_icon(:warning) %>
              <div>
                <p class="cs-alert-title">Onboarding invitations are held for this event.</p>
                <p>Imported participants are added without an email; their invitations go out when the event's held invitations are sent.</p>
              </div>
            </div>
          <% else %>
            <div class="cs-option">
              <%= check_box_tag :send_invitations, "1", true %>
              <div>
                <%= label_tag :send_invitations, "Send invitation emails to imported participants", class: "cs-option-label" %>
                <p class="cs-option-description">Untick to add them silently. Their invitations are kept on the pending invitations tab and can be sent later in one go.</p>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <div class="cs-columns cs-columns-2">
        <section class="cs-container">
          <div class="cs-container-header">
            <h2 class="cs-h2">What will be imported</h2>
          </div>
          <div class="cs-container-body">
            <ul class="list-disc list-inside space-y-1">
              <li>Participant details (name, email, phone, address, t-shirt size)</li>
              <li>Parent/guardian information (will receive consent invitation)</li>
              <li>Emergency contact details</li>
              <li>Dietary requirements and allergies</li>
              <li>Medical conditions and requirements</li>
              <li>Travel and flight information</li>
            </ul>
          </div>
        </section>

        <div class="cs-alert cs-alert-warning self-start">
          <%= cs_status_icon(:warning) %>
          <div>
            <p class="cs-alert-title">Important notes</p>
            <ul class="mt-1 list-disc list-inside space-y-1">
              <li>You'll see a preview before the import starts</li>
              <li>Participants already registered for this event will be skipped</li>
              <li>Existing participants (by email) will have their details updated</li>
              <li>Invitation emails are sent at a controlled pace to avoid rate limits</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2">
        <%= link_to "Cancel", admin_event_participants_path(current_event), class: "cs-btn cs-btn-link" %>
        <%= button_tag "Upload & preview", type: "submit", name: "commit", value: "Upload & Preview", class: "cs-btn cs-btn-primary", id: "submit-btn", data: { dropzone_target: "submit" }, disabled: true %>
      </div>
    <% end %>
  </div>
</div>

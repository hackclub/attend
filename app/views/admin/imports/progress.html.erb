<% content_for :breadcrumbs, cs_breadcrumbs([ "Participants", admin_event_participants_path(current_event) ], [ "Import progress", nil ]) %>
<% progress_state_class = @import_batch.completed? ? "cs-progress-success" : (@import_batch.failed? ? "cs-progress-error" : nil) %>

<div data-controller="import-progress" data-import-progress-import-batch-id-value="<%= @import_batch.id %>">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Import progress</h1>
      <p class="cs-description" data-import-progress-target="statusMessage"><%= @import_batch.current_status_message %></p>
    </div>
    <% if @import_batch.completed? %>
      <div class="cs-actions">
        <%= link_to "View imported participants", admin_event_participants_path(current_event), class: "cs-btn cs-btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="cs-stack">
    <% if @import_batch.failed? %>
      <div class="cs-alert cs-alert-error" role="alert">
        <%= cs_status_icon(:error) %>
        <div class="flex-1">
          <p class="cs-alert-title">Import failed</p>
          <p>
            The import encountered an error and could not complete.
            <%= @import_batch.imported_count %> participants were imported before the failure.
          </p>
          <div class="mt-3">
            <%= link_to "Try again", new_admin_event_import_path(current_event), class: "cs-btn" %>
          </div>
        </div>
      </div>
    <% end %>

    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Progress</h2>
      </div>
      <div class="cs-container-body cs-stack">
        <div class="cs-progress-field">
          <div class="cs-progress-label">
            <span>Imported</span>
            <span data-import-progress-target="percentage"><%= @import_batch.progress_percentage %>%</span>
          </div>
          <div class="cs-progress" role="progressbar" aria-label="Import progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @import_batch.progress_percentage %>">
            <span class="transition-all duration-300 <%= progress_state_class %>"
                  data-import-progress-target="progressBar"
                  style="width: <%= @import_batch.progress_percentage %>%"></span>
          </div>
        </div>

        <dl class="cs-kv <%= @import_batch.send_invitations ? "cs-kv-3" : "cs-kv-4 cs-kv-divided" %>">
          <div><dt class="cs-kv-label">Total</dt><dd class="cs-kv-value-lg" data-import-progress-target="totalCount"><%= @import_batch.total_count %></dd></div>
          <div><dt class="cs-kv-label">Imported</dt><dd class="cs-kv-value-lg" data-import-progress-target="importedCount"><%= @import_batch.imported_count %></dd></div>
          <div><dt class="cs-kv-label">Skipped</dt><dd class="cs-kv-value-lg" data-import-progress-target="skippedCount"><%= @import_batch.skipped_count %></dd></div>
          <div><dt class="cs-kv-label">Errors</dt><dd class="cs-kv-value-lg" data-import-progress-target="errorCount"><%= @import_batch.error_count %></dd></div>
          <% if @import_batch.send_invitations %>
            <div><dt class="cs-kv-label">Invites sent</dt><dd class="cs-kv-value-lg" data-import-progress-target="invitesSentCount"><%= @import_batch.invites_sent_count %></dd></div>
          <% end %>
        </dl>
      </div>
    </section>

    <section class="cs-container" data-import-progress-target="errorsSection" style="<%= @import_batch.errors_data.empty? ? 'display: none;' : '' %>">
      <div class="cs-container-header">
        <h2 class="cs-h2"><%= cs_status(:error, "Errors") %></h2>
      </div>
      <div class="cs-container-body">
        <ul class="space-y-2" data-import-progress-target="errorsList">
          <% @import_batch.errors_data.last(10).each do |error| %>
            <li>
              <% if error["row"] %>
                Row <%= error["row"] %><%= " (#{error["email"]})" if error["email"] %>: <%= error["error"] %>
              <% else %>
                <%= error["email"] %>: <%= error["error"] %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  </div>
</div>

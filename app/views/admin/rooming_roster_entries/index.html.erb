<% content_for :title, "#{@stay.name}: who's staying – Attend" %>
<% option_choices = @stay.eligibility_options.map { |o| [ o.display_label, o.id ] } %>
<% waiting = @entries.count { |e| !@in_pool_ids.include?(e.participant_event_id) } %>
<% input_class = "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
<% button_class = "bg-[#d42f46] text-white px-4 py-2 rounded-md hover:bg-[#b82840] cursor-pointer" %>

<div class="w-full space-y-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <%= link_to "← Accommodation", admin_event_rooming_stays_path(@event.slug), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold mt-2"><%= @stay.name %>: who's staying (<%= @entries.size %>)</h1>
      <p class="text-sm text-gray-500 mt-1">Only people on this list are roomed for <%= @stay.name %>. Taking someone off also frees any room they had in it.</p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Edit stay", edit_admin_event_rooming_stay_path(@event.slug, @stay), class: "px-4 py-2 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50" %>
      <%= link_to "Room this stay", admin_event_rooming_wizard_path(@event.slug, stay_id: @stay.id), class: button_class %>
    </div>
  </div>

  <% if @result&.not_registered.present? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 text-sm text-yellow-900" role="status">
      <p class="font-medium">
        <%= [ ("#{@result.added.size} added" if @result.added.any?), ("#{@result.updated.size} already on the list" if @result.updated.any?) ].compact.join(", ").upcase_first.presence&.then { |s| "#{s}. " } %><%= pluralize(@result.not_registered.size, "email") %> didn't match anyone registered for this event
      </p>
      <p class="mt-1">Check the spelling, or invite them first.</p>
      <ul class="mt-2 font-mono text-xs">
        <% @result.not_registered.each do |email| %>
          <li><%= email %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if waiting.positive? %>
    <div class="bg-blue-50 border border-blue-200 rounded-md p-4 text-sm text-blue-900" role="status">
      <p class="font-medium"><%= pluralize(waiting, "person") %> can't be roomed yet</p>
      <p class="mt-1">Rooming needs a registration that's in progress or complete, with the accommodation form filled in. They join the pool as soon as theirs is.</p>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <% if @entries.any? %>
      <table class="min-w-full divide-y divide-gray-100 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Added</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reference</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rooming</th>
            <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @entries.each do |entry| %>
            <% pe = entry.participant_event %>
            <tr>
              <td class="px-4 py-3 whitespace-nowrap"><%= link_to pe.participant.full_name, admin_event_participant_path(@event.slug, pe), class: "text-[#ec3750] hover:underline" %></td>
              <td class="px-4 py-3"><%= entry.eligibility_option&.display_label || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-gray-500">
                <%= { "manual" => "By hand", "csv" => "Email list", "group" => "Group", "api" => "Shop/API" }.fetch(entry.source) %>
                <% if entry.added_by_user %> · <%= entry.added_by_user.name %><% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap font-mono text-gray-500"><%= entry.external_reference.presence || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% if @in_pool_ids.include?(pe.id) %>
                  <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Ready</span>
                <% else %>
                  <span class="inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">Waiting on registration</span>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right">
                <%= button_to "Remove", admin_event_rooming_stay_roster_entry_path(@event.slug, @stay, entry), method: :delete, class: "text-red-600 hover:underline",
                      form: { class: "contents", data: { turbo_confirm: "Take #{pe.participant.full_name} off #{@stay.name}? Any room they have in it is freed." } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-8 text-center text-sm text-gray-500">
        <p class="font-medium text-gray-900">Nobody's on the list yet</p>
        <p class="mt-1">Add people below, or have your shop add buyers through the API.</p>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 <%= @groups.any? ? "lg:grid-cols-3" : "lg:grid-cols-2" %> gap-6">
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900">Pick people</h2>
      <p class="text-sm text-gray-500 mb-4">Hold Ctrl or ⌘ to pick more than one.</p>
      <%= form_with url: admin_event_rooming_stay_roster_entries_path(@event.slug, @stay), method: :post, class: "space-y-4" do %>
        <%= hidden_field_tag :mode, "participants" %>
        <div>
          <%= label_tag "roster-pick", "People", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag "participant_event_ids", options_for_select(@available.map { |pe| [ pe.participant.full_name, pe.id ] }), multiple: true, size: 8, id: "roster-pick", class: input_class %>
        </div>
        <div>
          <%= label_tag "roster-pick-option", "Reason (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag "eligibility_option_id", options_for_select(option_choices), include_blank: "No reason given", id: "roster-pick-option", class: input_class %>
        </div>
        <%= submit_tag "Add", class: button_class %>
      <% end %>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900">Paste emails</h2>
      <p class="text-sm text-gray-500 mb-4">One per line, a spreadsheet column, or a whole CSV export from your shop. Anything that isn't an email is ignored.</p>
      <%= form_with url: admin_event_rooming_stay_roster_entries_path(@event.slug, @stay), method: :post, class: "space-y-4", data: { turbo: false } do %>
        <%= hidden_field_tag :mode, "emails" %>
        <div>
          <%= label_tag "roster-emails", "Emails", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= text_area_tag "emails", nil, rows: 6, id: "roster-emails", class: "#{input_class} font-mono" %>
        </div>
        <div>
          <%= label_tag "roster-emails-option", "Reason (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag "eligibility_option_id", options_for_select(option_choices), include_blank: "No reason given", id: "roster-emails-option", class: input_class %>
        </div>
        <%= submit_tag "Add", class: button_class %>
      <% end %>
    </div>

    <% if @groups.any? %>
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900">Add a group</h2>
        <p class="text-sm text-gray-500 mb-4">Everyone currently in the group. People who join it later aren't added.</p>
        <%= form_with url: admin_event_rooming_stay_roster_entries_path(@event.slug, @stay), method: :post, class: "space-y-4" do %>
          <%= hidden_field_tag :mode, "group" %>
          <div>
            <%= label_tag "roster-group", "Group", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag "group_id", options_from_collection_for_select(@groups, :id, :name), id: "roster-group", class: input_class %>
          </div>
          <div>
            <%= label_tag "roster-group-option", "Reason (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag "eligibility_option_id", options_for_select(option_choices), include_blank: "No reason given", id: "roster-group-option", class: input_class %>
          </div>
          <%= submit_tag "Add", class: button_class %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

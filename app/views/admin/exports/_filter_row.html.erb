<%# locals: index (integer or "NEW_RECORD"), filter (hash with "field"/"operator"/"value" or nil), fields_by_category, categories %>
<% field = filter && Exports::FieldRegistry.fetch(filter["field"].to_s) %>
<div class="flex flex-wrap items-start gap-2" data-export-filter-row>
  <select name="filters[<%= index %>][field]" data-export-field-select data-action="export-builder#fieldChanged"
          aria-label="Field"
          class="cs-select w-auto! min-w-[14rem]">
    <option value="">Choose a field…</option>
    <% fields_by_category.each do |category, fields| %>
      <optgroup label="<%= categories[category][:label] %>">
        <% fields.select(&:filterable?).each do |f| %>
          <option value="<%= f.key %>" <%= "selected" if field&.key == f.key %>><%= f.label %></option>
        <% end %>
      </optgroup>
    <% end %>
  </select>

  <select name="filters[<%= index %>][operator]" data-export-operator-select data-action="export-builder#operatorChanged"
          aria-label="Operator"
          class="cs-select w-auto!">
    <% field&.operators&.each do |op| %>
      <option value="<%= op %>" <%= "selected" if filter["operator"] == op %>><%= Exports::Filter::OPERATOR_LABELS[op] %></option>
    <% end %>
  </select>

  <span class="flex-1 min-w-[10rem]" data-export-value-wrapper>
    <% if field && !Exports::Filter::VALUELESS_OPERATORS.include?(filter["operator"]) %>
      <% if field.type == :enum %>
        <select name="filters[<%= index %>][value][]" multiple size="<%= [ field.enum_values.size, 5 ].min %>"
                aria-label="Value"
                class="cs-select">
          <% field.enum_values.each do |val| %>
            <option value="<%= val %>" <%= "selected" if Array(filter["value"]).include?(val) %>><%= val.humanize.downcase %></option>
          <% end %>
        </select>
      <% else %>
        <input name="filters[<%= index %>][value]" value="<%= filter["value"] %>" placeholder="value"
               aria-label="Value"
               type="<%= { date: "date", datetime: "datetime-local" }[field.type] || "text" %>"
               class="cs-input">
      <% end %>
    <% end %>
  </span>

  <button type="button" data-action="export-builder#removeFilter" class="cs-btn cs-btn-icon cs-btn-link" title="Remove filter" aria-label="Remove filter">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8m0-8l-8 8"/></svg>
  </button>
</div>

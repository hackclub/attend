<%
  fields_meta = @fields_by_category.values.flatten.select(&:filterable?).to_h do |f|
    [ f.key, { label: f.label, type: f.type, operators: f.operators, enumValues: f.enum_values || [] } ]
  end
  prefill_columns = @prefill ? @prefill[:columns].map(&:to_s) : []
  prefill_filters = @prefill ? @prefill[:filters] : []
  prefill_row_mode = @prefill ? @prefill[:row_mode] : "participant"
%>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Exports", nil ]) %>

<div>
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Export data</h1>
      <p class="cs-description">Build a custom CSV export: choose columns, filter rows and save templates.</p>
    </div>
  </div>

  <div class="cs-stack">
    <% if @templates.any? || @presets.any? %>
      <section class="cs-container">
        <div class="cs-container-header <%= "cs-container-header-divided" if @templates.any? %>">
          <h2 class="cs-h2">Saved templates &amp; presets</h2>
        </div>

        <% if @templates.any? %>
          <div class="cs-table-wrap">
            <table class="cs-table cs-table-compact">
              <thead>
                <tr>
                  <th scope="col">Template</th>
                  <th scope="col">Contents</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% @templates.each do |template| %>
                  <tr>
                    <td class="font-bold"><%= template.name %></td>
                    <td class="cs-secondary"><%= pluralize(template.columns.size, "column") %><%= ", #{pluralize(template.filters.size, 'filter')}" if template.filters.any? %></td>
                    <td>
                      <div class="flex items-center justify-end gap-2">
                        <%= button_to "Delete", admin_event_export_template_path(current_event, template), method: :delete, data: { turbo_confirm: "Delete template \"#{template.name}\"?" }, class: "cs-btn cs-btn-link" %>
                        <%= link_to "Load", admin_event_exports_path(current_event, template_id: template.id), class: "cs-btn" %>
                        <%= button_to "Download", admin_event_exports_path(current_event, template_id: template.id), method: :post, data: { turbo: false }, class: "cs-btn" %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>

        <% if @presets.any? %>
          <div class="cs-container-body <%= "border-t border-(--cs-border-divider-secondary) pt-4!" if @templates.any? %>">
            <p class="cs-kv-label mb-2">Presets</p>
            <div class="flex flex-wrap gap-2">
              <% @presets.each do |key, preset| %>
                <%= link_to preset[:label], admin_event_exports_path(current_event, preset: key), class: "cs-btn", title: preset[:description] %>
              <% end %>
            </div>
            <p class="cs-field-hint mt-2">Presets load the classic exports into the builder below — tweak them or download as-is.</p>
          </div>
        <% end %>
      </section>
    <% end %>

    <%= form_with url: admin_event_exports_path(current_event), method: :post,
          class: "cs-stack",
          html: { novalidate: true },
          data: {
            turbo: false,
            controller: "export-builder cs-form-validation",
            export_builder_fields_value: fields_meta.to_json,
            export_builder_operator_labels_value: Exports::Filter::OPERATOR_LABELS.to_json
          } do %>

      <section class="cs-container">
        <div class="cs-container-header cs-container-header-divided">
          <div>
            <h2 class="cs-h2">Columns</h2>
            <p class="cs-container-description">Pick exactly which fields end up in the CSV</p>
          </div>
          <div class="cs-actions">
            <span class="cs-secondary shrink-0" data-export-builder-target="count"></span>
            <label class="cs-search w-56">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
              <input type="search" placeholder="Find fields" autocomplete="off" aria-label="Find fields"
                     class="cs-input"
                     data-export-builder-target="searchInput"
                     data-action="input->export-builder#search">
            </label>
          </div>
        </div>

        <div class="divide-y divide-(--cs-border-divider-secondary)">
          <% @fields_by_category.each do |category, fields| %>
            <details class="cs-expandable px-5 py-3" data-export-category="<%= category %>" <%= "open" if fields.any? { |f| prefill_columns.include?(f.key) } %>>
              <summary>
                <span class="flex-1 min-w-0">
                  <span class="cs-kv-label font-medium"><%= @categories[category][:label] %></span>
                  <span class="cs-secondary font-normal ml-2"><%= @categories[category][:description] %></span>
                </span>
              </summary>
              <%# Select all/none live in the section body: buttons inside a
                  <summary> are nested controls (the summary is itself a toggle). %>
              <div class="cs-expandable-content flex items-center gap-1 pl-4 pb-0">
                <button type="button" data-action="export-builder#selectCategory" class="cs-btn cs-btn-link -ml-3">Select all</button>
                <button type="button" data-action="export-builder#deselectCategory" class="cs-btn cs-btn-link">Select none</button>
              </div>
              <div class="cs-expandable-content grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-2 pl-4">
                <% fields.each do |field| %>
                  <label class="cs-option mt-0!">
                    <%= check_box_tag "columns[]", field.key, prefill_columns.include?(field.key),
                          id: "column_#{field.key.parameterize(separator: '_')}",
                          data: { export_builder_target: "columnCheckbox", action: "export-builder#updateCount" } %>
                    <span class="cs-option-label"><%= field.label %></span>
                  </label>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </section>

      <section class="cs-container">
        <div class="cs-container-header">
          <div>
            <h2 class="cs-h2">Filters</h2>
            <p class="cs-container-description">Only rows matching <strong>all</strong> filters are exported. Any field can be a filter — it doesn't need to be an exported column.</p>
          </div>
        </div>
        <div class="cs-container-body">
          <div class="space-y-2 mb-3" data-export-builder-target="filtersContainer">
            <% prefill_filters.each_with_index do |filter, i| %>
              <%= render "filter_row", index: i, filter: filter, fields_by_category: @fields_by_category, categories: @categories %>
            <% end %>
          </div>

          <template data-export-builder-target="filterTemplate">
            <%= render "filter_row", index: "NEW_RECORD", filter: nil, fields_by_category: @fields_by_category, categories: @categories %>
          </template>

          <div class="flex flex-wrap items-center gap-2">
            <button type="button" data-action="export-builder#addFilter" class="cs-btn">Add filter</button>
            <span class="cs-small cs-muted ml-2">Quick add:</span>
            <button type="button" data-action="export-builder#addFilter" data-field="participant_event.status" data-operator="in" class="cs-btn cs-btn-link">status</button>
            <button type="button" data-action="export-builder#addFilter" data-field="participant_event.checked_in_at" data-operator="present" class="cs-btn cs-btn-link">checked-in only</button>
            <button type="button" data-action="export-builder#addFilter" data-field="groups.names" data-operator="contains" class="cs-btn cs-btn-link">group</button>
            <button type="button" data-action="export-builder#addFilter" data-field="travel.inbound.mode" data-operator="in" class="cs-btn cs-btn-link">travel mode</button>
          </div>
        </div>
      </section>

      <section class="cs-container">
        <div class="cs-container-header">
          <h2 class="cs-h2">Rows</h2>
        </div>
        <div class="cs-container-body">
          <div class="cs-tiles sm:flex-row!">
            <label class="cs-tile flex-1">
              <span class="cs-option">
                <%= radio_button_tag :row_mode, "participant", prefill_row_mode != "flight_leg" %>
                <span>
                  <span class="cs-option-label block">One row per participant</span>
                </span>
              </span>
            </label>
            <label class="cs-tile flex-1">
              <span class="cs-option">
                <%= radio_button_tag :row_mode, "flight_leg", prefill_row_mode == "flight_leg" %>
                <span>
                  <span class="cs-option-label block">One row per flight leg</span>
                  <span class="cs-option-description block">Enables the Flight Legs fields; participants without flights are skipped</span>
                </span>
              </span>
            </label>
          </div>
        </div>
      </section>

      <section class="cs-container">
        <div class="cs-container-body pt-5! flex flex-col sm:flex-row items-start justify-between gap-4">
          <div class="flex items-start gap-2">
            <%= cs_field id: "template_name", label: "Template name", constraint: "Needed to save a template." do |aria| %>
              <%= text_field_tag :template_name, nil, class: "cs-input", required: true, **aria %>
            <% end %>
            <%= button_tag "Save as template", type: "submit", formaction: admin_event_export_templates_path(current_event), formmethod: "post", class: "cs-btn mt-6" %>
          </div>
          <%# Downloading doesn't need a template name, so it skips the client-side checks. %>
          <%= button_tag "Download CSV", type: "submit", formnovalidate: true, class: "cs-btn cs-btn-primary sm:mt-6" %>
        </div>
      </section>
    <% end %>
  </div>
</div>

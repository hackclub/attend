<% content_for :breadcrumbs, cs_breadcrumbs([ "Held messages", nil ]) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Held messages <span class="cs-counter">(<%= @pending.size %>)</span></h1>
      <p class="cs-description">Messages and Slack blasts that looked like marketing, spam, or not about their event<%= " in a series you own" unless current_user.global_admin? %>. Nothing here has been sent. Approve one to send it, or reject it to send it back to its author.</p>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Waiting for review</h2>
    </div>
    <% if @pending.empty? %>
      <div class="cs-empty">
        <p class="cs-empty-title">Nothing is waiting for review.</p>
      </div>
    <% else %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Event</th>
              <th scope="col">From</th>
              <th scope="col">Why</th>
              <th scope="col">Held</th>
              <th scope="col" class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pending.each do |review| %>
              <tr>
                <td>
                  <div><%= review.event.name %></div>
                  <div class="cs-small cs-muted"><%= review.kind_label %></div>
                </td>
                <td><%= review.submitted_by_user&.email || "—" %></td>
                <td>
                  <div class="flex flex-wrap gap-1 mb-1">
                    <% review.category_labels.each do |label| %>
                      <%= cs_badge(label, "red") %>
                    <% end %>
                  </div>
                  <div class="cs-small cs-muted max-w-[360px]"><%= review.reason %></div>
                </td>
                <td class="whitespace-nowrap"><%= cs_relative_time(review.created_at) %></td>
                <td class="text-right">
                  <%= link_to "Review", admin_broadcast_review_path(review), class: "cs-btn" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% if @decided.any? %>
    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided">
        <h2 class="cs-h2">Recently decided</h2>
      </div>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Event</th>
              <th scope="col">From</th>
              <th scope="col">Decision</th>
              <th scope="col">By</th>
              <th scope="col">When</th>
            </tr>
          </thead>
          <tbody>
            <% @decided.each do |review| %>
              <tr>
                <td>
                  <%= link_to review.event.name, admin_broadcast_review_path(review), class: "cs-link" %>
                  <div class="cs-small cs-muted"><%= review.kind_label %></div>
                </td>
                <td><%= review.submitted_by_user&.email || "—" %></td>
                <td><%= cs_status(*{ "approved" => [ :success, "Approved" ], "rejected" => [ :error, "Rejected" ] }.fetch(review.status, [ :stopped, "Withdrawn" ])) %></td>
                <td><%= review.decided_by_user&.email || "Author cancelled" %></td>
                <td class="whitespace-nowrap"><%= review.decided_at ? cs_relative_time(review.decided_at) : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @selectable_users %>
    <%= render "recipients" %>
  <% end %>
</div>

<% content_for :breadcrumbs, cs_breadcrumbs(
     [ "Participants", admin_event_participants_path(current_event) ],
     [ @participant_event.participant.display_name, admin_event_participant_path(current_event, @participant_event) ],
     [ "Edit guardian", nil ]
   ) %>

<div class="max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Edit guardian</h1>
      <p class="cs-description">Editing guardian for <%= @participant_event.participant.display_name %></p>
    </div>
  </div>

  <div class="cs-stack">
    <% unless @guardian_participant_event.completed? %>
      <div class="cs-alert cs-alert-warning">
        <%= cs_status_icon(:warning) %>
        <div>
          <p class="cs-alert-title">Note</p>
          <p>If you change the email address, the invite will need to be resent to the new address.</p>
        </div>
      </div>
    <% end %>

    <% if @guardian_participant_event.completed? %>
      <div class="cs-alert">
        <%= cs_status_icon(:info) %>
        <div>
          <p class="cs-alert-title">Info</p>
          <p>This guardian has already completed their portal. Changes here will update their information directly.</p>
        </div>
      </div>
    <% end %>

    <%= form_with model: @guardian, url: admin_event_participant_guardian_path(current_event, @participant_event, @guardian_participant_event), method: :patch, local: true, class: "cs-stack", data: { controller: "phone-input" } do |f| %>
      <% if @guardian.errors.any? %>
        <div class="cs-alert cs-alert-error" role="alert">
          <%= cs_status_icon(:error) %>
          <div>
            <p class="cs-alert-title"><%= pluralize(@guardian.errors.count, "error") %> stopped this guardian from saving</p>
            <ul class="mt-1 list-disc list-inside">
              <% @guardian.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <section class="cs-container">
        <div class="cs-container-header">
          <div>
            <h2 class="cs-h2">Contact information</h2>
          </div>
        </div>
        <div class="cs-container-body">
          <div class="cs-field-grid">
            <div>
              <%= f.label :legal_first_name, "First name", class: "cs-field-label" %>
              <%= f.text_field :legal_first_name, class: "cs-input", required: true %>
            </div>
            <div>
              <%= f.label :legal_last_name, "Last name", class: "cs-field-label" %>
              <%= f.text_field :legal_last_name, class: "cs-input", required: true %>
            </div>
            <div>
              <%= f.label :email, class: "cs-field-label" %>
              <%= f.email_field :email, class: "cs-input", required: true %>
              <% if @guardian_participant_event.invited_via_email.present? && @guardian_participant_event.invited_via_email != @guardian.email %>
                <p class="cs-field-hint">
                  Originally invited via: <%= @guardian_participant_event.invited_via_email %>
                </p>
              <% end %>
            </div>
            <div>
              <%= f.label :phone, class: "cs-field-label" %>
              <%= f.telephone_field :phone, class: "cs-input" %>
            </div>
          </div>
        </div>
      </section>

      <section class="cs-container">
        <div class="cs-container-header">
          <div>
            <h2 class="cs-h2">Address</h2>
          </div>
        </div>
        <div class="cs-container-body">
          <div data-controller="address-autocomplete" data-address-autocomplete-fill-components-value="true">
            <div class="cs-field">
              <%= f.label :address_line_1, "Address line 1", class: "cs-field-label" %>
              <%= f.text_field :address_line_1, class: "cs-input", data: { address_autocomplete_target: "input" } %>
            </div>

            <div class="cs-field">
              <%= f.label :address_line_2, "Address line 2", class: "cs-field-label" %>
              <%= f.text_field :address_line_2, class: "cs-input" %>
            </div>

            <div class="cs-field grid grid-cols-2 gap-4 md:grid-cols-4">
              <div class="col-span-2 md:col-span-1">
                <%= f.label :city, class: "cs-field-label" %>
                <%= f.text_field :city, class: "cs-input", data: { address_autocomplete_target: "city" } %>
              </div>
              <div>
                <%= f.label :state, "State/Province", class: "cs-field-label" %>
                <%= f.text_field :state, class: "cs-input", data: { address_autocomplete_target: "state" } %>
              </div>
              <div>
                <%= f.label :postal_code, "Postal code", class: "cs-field-label" %>
                <%= f.text_field :postal_code, class: "cs-input", data: { address_autocomplete_target: "postalCode" } %>
              </div>
            </div>

            <div class="cs-field">
              <%= f.label :country, class: "cs-field-label" %>
              <%= f.text_field :country, class: "cs-input", data: { address_autocomplete_target: "country" } %>
            </div>
          </div>
        </div>
      </section>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <%= link_to "Cancel", admin_event_participant_path(current_event, @participant_event), class: "cs-btn cs-btn-link cs-btn-full" %>
        <%= f.button "Save guardian", class: "cs-btn cs-btn-primary cs-btn-full" %>
      </div>
    <% end %>
  </div>
</div>

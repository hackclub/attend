<% content_for :breadcrumbs do %>
  <ol class="flex items-center space-x-2 text-sm text-gray-500">
    <li><%= link_to "Participants", admin_event_participants_path(current_event), class: "hover:text-gray-700" %></li>
    <li><span class="mx-2">/</span></li>
    <li><%= link_to @participant_event.participant.display_name, admin_event_participant_path(current_event, @participant_event), class: "hover:text-gray-700" %></li>
    <li><span class="mx-2">/</span></li>
    <li class="text-gray-900 font-medium">Replace Guardian</li>
  </ol>
<% end %>
<% current = @guardian_participant_event.guardian %>
<% signed = Guardians::Replacement.dependent_consents(@participant_event).select { |consent| consent.signed? || consent.guardian_signed_at.present? } %>
<% input_class = "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>

<div class="max-w-2xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">Replace Guardian</h1>
    <p class="text-gray-600 mt-1">
      Swap <%= current.full_name %> for a different person on <%= @participant_event.participant.display_name %>'s registration.
    </p>
  </div>

  <div class="border-2 border-dashed border-orange-400 rounded-lg p-4">
    <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-6">
      <strong>This can't be undone.</strong>
      <ul class="list-disc pl-5 mt-1 space-y-1">
        <li><%= current.full_name %> (<%= current.email %>) is removed from this registration and loses access to its portal.</li>
        <% if signed.any? %>
          <li>Discards what they signed: <%= signed.map(&:display_name).to_sentence %>. The new guardian signs again.</li>
        <% else %>
          <li>Every guardian-signed waiver and document goes back to pending for the new guardian.</li>
        <% end %>
        <li>Emergency contacts move across to the new guardian.</li>
        <li>A submitted registration goes back to waiting on the guardian, and the new guardian is emailed their portal invite.</li>
      </ul>
      <p class="mt-2">Fixing a typo in the same person's details? Use <%= link_to "Edit guardian", edit_admin_event_participant_guardian_path(current_event, @participant_event, @guardian_participant_event), class: "underline" %> instead, which keeps their signatures.</p>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <%= form_with model: @replacement, scope: :guardian, url: replace_admin_event_participant_guardian_path(current_event, @participant_event, @guardian_participant_event), method: :post, local: true, data: { controller: "phone-input", turbo_confirm: "Replace #{current.full_name}? What they signed on this registration will be discarded." } do |f| %>
        <% if @replacement.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-6">
            <ul class="list-disc list-inside">
              <% @replacement.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <h3 class="font-medium text-gray-900">New guardian</h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :legal_first_name, "First Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :legal_first_name, class: input_class, required: true %>
            </div>
            <div>
              <%= f.label :legal_last_name, "Last Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :legal_last_name, class: input_class, required: true %>
            </div>
          </div>

          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email, class: input_class, required: true %>
          </div>

          <div>
            <%= f.label :phone, "Phone (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.telephone_field :phone, class: input_class %>
            <p class="text-xs text-gray-500 mt-1">Include the country code. For example: +1 415 555 0132</p>
          </div>

          <div>
            <%= label_tag "guardian_relationship", "Relationship (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_field_tag "guardian[relationship]", @relationship || @guardian_participant_event.relationship, id: "guardian_relationship", class: input_class %>
          </div>
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <%= link_to "Cancel", admin_event_participant_path(current_event, @participant_event), class: "px-4 py-2 text-gray-700 hover:text-gray-900" %>
          <%= f.submit "Replace guardian", class: "px-4 py-2 bg-[#ec3750] text-white rounded-md hover:bg-[#d62c45] cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

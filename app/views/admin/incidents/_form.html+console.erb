<% search_icon = capture do %>
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
<% end %>

<%= form_with model: [:admin, current_event, incident], local: true, class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation firehouse-confirm", action: "submit->firehouse-confirm#confirm" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Incident details</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <%= cs_form_field f, :category, label: "Category", messages: { blank: "Category is required.", inclusion: "Select a valid category." } do |aria| %>
          <%= f.select :category, Incident.categories.keys.map { |c| [c.humanize, c] }, { prompt: "Select category" }, class: "cs-select", required: true, **aria %>
        <% end %>

        <%= cs_form_field f, :severity, label: "Severity", messages: { blank: "Severity is required.", inclusion: "Select a valid severity." } do |aria| %>
          <%= f.select :severity, Incident.severities.keys.map { |s| [s.humanize, s] }, { prompt: "Select severity" }, class: "cs-select", required: true, **aria %>
        <% end %>

        <%= cs_form_field f, :status, label: "Status" do |aria| %>
          <%= f.select :status, Incident.statuses.keys.map { |s| [s.humanize.titleize, s] }, {}, class: "cs-select", **aria %>
        <% end %>

        <%= cs_form_field f, :occurred_at, label: "Date and time of incident", optional: true do |aria| %>
          <%= f.datetime_local_field :occurred_at, class: "cs-input", **aria %>
        <% end %>

        <%= cs_form_field f, :location, label: "Location", optional: true, constraint: "For example: Main Hall, Room 204" %>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">People involved</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field" data-controller="multiselect">
        <p class="cs-field-label">Participants involved</p>
        <div class="border border-(--cs-border-input) rounded-(--cs-radius-item) overflow-hidden">
          <div class="p-3 border-b border-(--cs-border-divider-secondary)">
            <label class="cs-search">
              <%= search_icon %>
              <input type="text"
                     data-multiselect-target="search"
                     placeholder="Search participants..."
                     aria-label="Search participants"
                     class="cs-input"
                     data-action="input->multiselect#filter">
            </label>
          </div>
          <div class="px-3 py-2 border-b border-(--cs-border-divider-secondary) flex items-center justify-between gap-3">
            <span class="cs-small cs-secondary">
              <strong data-multiselect-target="count"><%= incident.participant_event_ids.count %></strong> participant<span data-multiselect-target="plural"><%= incident.participant_event_ids.count == 1 ? '' : 's' %></span> selected
            </span>
            <button type="button"
                    class="cs-btn cs-btn-link"
                    data-action="click->multiselect#clearAll">
              Clear all
            </button>
          </div>
          <div class="max-h-48 overflow-y-auto divide-y divide-(--cs-border-divider-secondary)" data-multiselect-target="list">
            <% current_event.participant_events.includes(:participant).order("participants.legal_first_name").each do |pe| %>
              <label class="flex items-center gap-2.5 px-3 py-2 cursor-pointer hover:bg-(--cs-bg-hover)"
                     data-name="<%= pe.participant.display_name.downcase %> <%= pe.participant.email.downcase %>">
                <input type="checkbox"
                       name="incident[participant_event_ids][]"
                       value="<%= pe.id %>"
                       <%= incident.participant_event_ids.include?(pe.id) ? 'checked' : '' %>
                       class="size-4 shrink-0 accent-(--cs-accent)"
                       data-multiselect-target="checkbox"
                       data-action="change->multiselect#updateCount">
                <span class="flex-1 min-w-0">
                  <span class="block truncate"><%= pe.participant.display_name %></span>
                  <span class="block truncate cs-small cs-muted"><%= pe.participant.email %></span>
                </span>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <% staff_users = current_event.event_role_assignments.includes(:user).map(&:user).uniq.sort_by { |u| u.display_name_or_fallback } %>
      <div class="cs-field" data-controller="multiselect">
        <p class="cs-field-label">Staff who helped</p>
        <div class="border border-(--cs-border-input) rounded-(--cs-radius-item) overflow-hidden">
          <div class="p-3 border-b border-(--cs-border-divider-secondary)">
            <label class="cs-search">
              <%= search_icon %>
              <input type="text"
                     data-multiselect-target="search"
                     placeholder="Search staff..."
                     aria-label="Search staff"
                     class="cs-input"
                     data-action="input->multiselect#filter">
            </label>
          </div>
          <div class="px-3 py-2 border-b border-(--cs-border-divider-secondary) flex items-center justify-between gap-3">
            <span class="cs-small cs-secondary">
              <strong data-multiselect-target="count"><%= incident.helping_staff_ids.count %></strong> staff member<span data-multiselect-target="plural"><%= incident.helping_staff_ids.count == 1 ? '' : 's' %></span> selected
            </span>
            <button type="button"
                    class="cs-btn cs-btn-link"
                    data-action="click->multiselect#clearAll">
              Clear all
            </button>
          </div>
          <div class="max-h-48 overflow-y-auto divide-y divide-(--cs-border-divider-secondary)" data-multiselect-target="list">
            <% staff_users.each do |user| %>
              <label class="flex items-center gap-2.5 px-3 py-2 cursor-pointer hover:bg-(--cs-bg-hover)"
                     data-name="<%= user.display_name_or_fallback.downcase %> <%= user.email.downcase %>">
                <input type="checkbox"
                       name="incident[helping_staff_ids][]"
                       value="<%= user.id %>"
                       <%= incident.helping_staff_ids.include?(user.id) ? 'checked' : '' %>
                       class="size-4 shrink-0 accent-(--cs-accent)"
                       data-multiselect-target="checkbox"
                       data-action="change->multiselect#updateCount">
                <% if user.avatar_displayable? %>
                  <%= image_tag user.avatar.variant(resize_to_fill: [32, 32]), class: "cs-avatar", alt: "" %>
                <% else %>
                  <span class="cs-avatar" aria-hidden="true"><%= user.initials %></span>
                <% end %>
                <span class="flex-1 min-w-0">
                  <span class="block truncate"><%= user.display_name_or_fallback %></span>
                  <span class="block truncate cs-small cs-muted"><%= user.email %></span>
                </span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">What happened</h2>
    </div>
    <div class="cs-container-body">
      <%= cs_form_field f, :summary, label: "Summary", optional: true, description: "A brief summary of the incident." %>

      <%= cs_form_field f, :details, label: "Details", optional: true, description: "A detailed description of what happened." do |aria| %>
        <%= f.text_area :details, rows: 6, class: "cs-input", **aria %>
      <% end %>

      <%= cs_form_field f, :actions_taken, label: "Actions taken", optional: true, description: "What actions have been taken or are planned." do |aria| %>
        <%= f.text_area :actions_taken, rows: 4, class: "cs-input", **aria %>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Visibility</h2>
    </div>
    <div class="cs-container-body">
      <fieldset class="cs-field">
        <legend class="cs-field-label">Visible to roles<span class="cs-field-optional"> - optional</span></legend>
        <p class="cs-field-description">The roles that can view this incident.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <% EventRoleAssignment.roles.keys.each do |role| %>
            <label class="cs-option mt-0! cursor-pointer">
              <%= check_box_tag "incident[visible_to_roles][]", role, incident.visible_to_roles.include?(role) %>
              <span class="cs-option-label"><%= role.humanize %></span>
            </label>
          <% end %>
        </div>
        <%= hidden_field_tag "incident[visible_to_roles][]", "" %>
      </fieldset>

      <% unless incident.persisted? %>
        <label class="cs-option mt-4 cursor-pointer">
          <%= check_box_tag "sync_to_slack", "1", false %>
          <span>
            <span class="cs-option-label block">Sync to HQ Firehouse</span>
            <span class="cs-option-description block">Posts the incident to the HQ Slack channel for visibility.</span>
          </span>
        </label>
      <% end %>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col sm:flex-row justify-end gap-2">
    <%= link_to "Cancel", admin_event_incidents_path(current_event), class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button incident.persisted? ? "Update incident" : "Create incident", class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

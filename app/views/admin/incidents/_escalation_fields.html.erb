<%# Fields for a report to HQ. `phone` is the organizer's best-known callback number. %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div>
    <%= label_tag "escalation_priority", "How urgently does HQ need to respond?", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= select_tag "escalation[priority]", options_for_select(IncidentReport::PRIORITIES.map { |k, v| [v, k] }, "standard"),
          id: "escalation_priority", class: "w-full border border-gray-300 rounded-md px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
    <p class="mt-1 text-xs text-gray-500">Emergency rings the safeguarding team's phones. Use it for anything happening right now.</p>
  </div>
  <div>
    <%= label_tag "escalation_reporter_phone", "Number HQ can call you on", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= telephone_field_tag "escalation[reporter_phone]", phone, id: "escalation_reporter_phone", placeholder: "+1 555 555 0100",
          class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
    <p class="mt-1 text-xs text-gray-500">Required. Include the country code.</p>
  </div>
</div>
<label class="inline-flex items-center mt-3">
  <%= check_box_tag "escalation[emergency_services_called]", "1", false, class: "rounded border-gray-300 text-[#ec3750] focus:ring-[#ec3750]" %>
  <span class="ml-2 text-sm text-gray-700">Emergency services (police, ambulance) have been called</span>
</label>

<% content_for :title, "Incident Details – #{current_event.name} – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Incidents", admin_event_incidents_path(current_event) ], [ "Incident details", nil ]) %>

<div class="cs-stack max-w-4xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Incident details</h1>
      <div class="cs-description flex flex-wrap items-center gap-2 mt-1">
        <%= render_category_badge(@incident.category) %>
        <%= render_severity_badge(@incident.severity) %>
        <%= incident_status(@incident.status) %>
      </div>
    </div>
    <div class="cs-actions">
      <% if @incident.behavior? || @incident.safeguarding? || @incident.other? %>
        <%= button_to "Send to Slack", send_to_slack_admin_event_incident_path(current_event, @incident), method: :post, class: "cs-btn", data: { turbo_confirm: "Send this conduct report to Slack?" } %>
      <% end %>
      <%= link_to "Edit", edit_admin_event_incident_path(current_event, @incident), class: "cs-btn cs-btn-primary" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Overview</h2>
    </div>
    <div class="cs-container-body">
      <dl class="cs-kv cs-kv-2">
        <div>
          <dt class="cs-kv-label">Reported by</dt>
          <dd class="cs-kv-value"><%= @incident.reported_by.display_name_or_fallback %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Occurred</dt>
          <dd class="cs-kv-value"><%= cs_absolute_time_tag(@incident.occurred_at) || "Not specified" %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Location</dt>
          <dd class="cs-kv-value"><%= @incident.location.presence || "Not specified" %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Participants involved</dt>
          <dd class="cs-kv-value">
            <% if @incident.participants.any? %>
              <ul class="space-y-0.5">
                <% @incident.incident_participants.includes(participant_event: :participant).each do |ip| %>
                  <li>
                    <%= link_to "#{ip.participant_event.participant.preferred_name || ip.participant_event.participant.legal_first_name} #{ip.participant_event.participant.legal_last_name}",
                        admin_event_participant_path(current_event, ip.participant_event),
                        class: "cs-link" %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <span class="cs-muted">No participants linked</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="cs-kv-label">Staff who helped</dt>
          <dd class="cs-kv-value">
            <% if @incident.helping_staff.any? %>
              <ul class="space-y-0.5">
                <% @incident.helping_staff.each do |staff| %>
                  <li><%= staff.display_name_or_fallback %></li>
                <% end %>
              </ul>
            <% else %>
              <span class="cs-muted">No staff recorded</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="cs-kv-label">Visible to</dt>
          <dd class="cs-kv-value">
            <div class="cs-token-group">
              <% @incident.visible_to_roles.reject(&:blank?).each do |role| %>
                <span class="cs-token cs-token-readonly"><%= role.humanize %></span>
              <% end %>
            </div>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Report</h2>
    </div>
    <div class="cs-container-body">
      <dl class="cs-kv">
        <div>
          <dt class="cs-kv-label">Summary</dt>
          <dd class="cs-kv-value"><%= @incident.summary.presence || "No summary provided" %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Details</dt>
          <dd class="cs-kv-value whitespace-pre-wrap"><%= @incident.details.presence || "No details provided" %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Actions taken</dt>
          <dd class="cs-kv-value whitespace-pre-wrap"><%= @incident.actions_taken.presence || "No actions recorded yet" %></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Add comment</h2>
    </div>
    <div class="cs-container-body">
      <%= form_with model: @comment || IncidentComment.new, url: admin_event_incident_comments_path(current_event, @incident),
            html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
        <%= cs_form_field f, :body, label: "Comment", description: "A comment or note about this incident." do |aria| %>
          <%= f.text_area :body, rows: 3, class: "cs-input", required: true, **aria %>
        <% end %>
        <%= cs_form_errors f %>
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mt-4">
          <%= cs_form_field f, :new_status, label: "Change status to", optional: true do |aria| %>
            <%= f.select :new_status,
                [["No change", ""]] + Incident.statuses.keys.map { |s| [s.humanize, s] },
                {},
                class: "cs-select", **aria %>
          <% end %>
          <%= f.button "Add comment", class: "cs-btn cs-btn-primary cs-btn-full" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Timeline</h2>
    </div>
    <div class="cs-container-body">
      <%
        timeline_items = []
        comments_with_status_change = @incident.comments.includes(:user).select { |c| c.new_status.present? }
        status_change_times = comments_with_status_change.map { |c| c.created_at.to_i }

        @incident.versions.each do |v|
          # Skip version updates that happened at same second as a comment with status change
          next if v.event == "update" && status_change_times.include?(v.created_at.to_i)
          timeline_items << { type: :version, item: v, time: v.created_at }
        end
        @incident.comments.includes(:user).each do |c|
          timeline_items << { type: :comment, item: c, time: c.created_at }
        end
        timeline_items.sort_by! { |t| t[:time] }.reverse!
      %>
      <ol class="cs-steps">
        <% timeline_items.each do |entry| %>
          <% if entry[:type] == :comment %>
            <% comment = entry[:item] %>
            <li>
              <%= incident_comment_step_icon(comment.new_status) %>
              <div>
                <p class="cs-step-title">
                  <% if comment.source == "slack" %>
                    <strong>Fire Dept (<%= comment.slack_display_name.presence || comment.slack_user_id %>)</strong>
                    <% slack_link = "https://hackclub.slack.com/archives/#{comment.slack_channel_id}/p#{comment.slack_message_ts&.delete('.')}" %>
                    <a href="<%= slack_link %>" target="_blank" class="cs-link">commented</a>
                  <% else %>
                    <strong><%= comment.user.display_name_or_fallback %></strong>
                    commented
                  <% end %>
                  <% if comment.new_status.present? %>
                    and changed status to <strong><%= comment.new_status.humanize %></strong>
                  <% end %>
                </p>
                <p class="cs-step-detail"><%= cs_absolute_time_tag(entry[:time]) %></p>
                <div class="mt-2 text-sm rounded-(--cs-radius-item) bg-(--cs-bg-shaded) p-3">
                  <%= simple_format(comment.body) %>
                </div>
              </div>
            </li>
          <% else %>
            <% version = entry[:item] %>
            <% actor = User.find_by(id: version.whodunnit) %>
            <li>
              <%= incident_step_icon(version.event == "create" ? :success : :pending) %>
              <div>
                <p class="cs-step-title">
                  <strong><%= actor&.display_name_or_fallback || "System" %></strong>
                  <%= version.event == "create" ? "created" : "updated" %> the incident
                  <% if version.changeset.present? %>
                    <span class="cs-muted">
                      (<%= version.changeset.keys.reject { |k| k == "updated_at" }.map(&:humanize).join(", ") %>)
                    </span>
                  <% end %>
                </p>
                <p class="cs-step-detail"><%= cs_absolute_time_tag(entry[:time]) %></p>
              </div>
            </li>
          <% end %>
        <% end %>
      </ol>
    </div>
  </section>
</div>

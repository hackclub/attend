<% content_for :title, "Edit Emergency Contact – #{@participant_event.participant.display_name} – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Participants", admin_event_participants_path(current_event) ], [ participant_name(@participant_event.participant), admin_event_participant_path(current_event, @participant_event) ], cs_gated_crumb("Safeguarding", safeguarding_admin_event_participant_path(current_event, @participant_event), policy(@participant_event).view_safeguarding?), [ "Edit emergency contact", nil ]) %>

<div class="max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Edit emergency contact</h1>
      <p class="cs-description">For <%= @participant_event.participant.display_name %></p>
    </div>
  </div>

  <%= render "form",
    form_url: admin_event_participant_emergency_contact_path(current_event, @participant_event, @emergency_contact),
    form_method: :patch,
    submit_label: "Save changes" %>
</div>

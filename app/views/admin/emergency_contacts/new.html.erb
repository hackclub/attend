<% content_for :title, "Add Emergency Contact – #{@participant_event.participant.display_name} – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs(
     [ "Participants", admin_event_participants_path(current_event) ],
     [ @participant_event.participant.display_name, admin_event_participant_path(current_event, @participant_event) ],
     [ "Safeguarding", safeguarding_admin_event_participant_path(current_event, @participant_event) ],
     [ "Add emergency contact", nil ]
   ) %>

<div class="max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Add emergency contact</h1>
      <p class="cs-description">For <%= @participant_event.participant.display_name %></p>
    </div>
  </div>

  <%= render "form",
    form_url: admin_event_participant_emergency_contacts_path(current_event, @participant_event),
    form_method: :post,
    submit_label: "Add emergency contact" %>
</div>

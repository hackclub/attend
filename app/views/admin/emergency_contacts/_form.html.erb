<%= form_with model: @emergency_contact, url: form_url, method: form_method, local: true, class: "cs-stack", data: { controller: "phone-input" } do |f| %>
  <% if @emergency_contact.errors.any? %>
    <div class="cs-alert cs-alert-error" role="alert">
      <%= cs_status_icon(:error) %>
      <div>
        <p class="cs-alert-title"><%= pluralize(@emergency_contact.errors.count, "error") %> stopped this contact from saving</p>
        <ul class="mt-1 list-disc list-inside">
          <% @emergency_contact.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Contact details</h2>
      </div>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div>
          <%= f.label :name, class: "cs-field-label" %>
          <%= f.text_field :name, class: "cs-input" %>
        </div>

        <div>
          <%= f.label :relationship, class: "cs-field-label" %>
          <%= f.text_field :relationship, class: "cs-input" %>
        </div>

        <div>
          <%= f.label :phone, class: "cs-field-label" %>
          <%= f.telephone_field :phone, class: "cs-input" %>
        </div>

        <div>
          <%= f.label :email, class: "cs-field-label" %>
          <%= f.email_field :email, class: "cs-input" %>
        </div>

        <div>
          <%= f.label :priority, class: "cs-field-label" %>
          <div class="w-32">
            <%= f.number_field :priority, min: 1, class: "cs-input" %>
          </div>
          <p class="cs-field-hint">Lower numbers are contacted first.</p>
        </div>

        <% guardian_options = @participant_event.guardian_participant_events.includes(:guardian).map { |gpe| [gpe.guardian.full_name, gpe.id] } %>
        <% if guardian_options.any? %>
          <div>
            <%= f.label :guardian_participant_event_id, "Linked guardian (optional)", class: "cs-field-label" %>
            <%= f.select :guardian_participant_event_id, guardian_options, { include_blank: "— Not linked to a guardian —" }, class: "cs-select" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
    <%= link_to "Cancel", safeguarding_admin_event_participant_path(current_event, @participant_event), class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button submit_label, class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

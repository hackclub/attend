<%= form_with model: @emergency_contact, url: form_url, method: form_method, local: true, class: "space-y-4" do |f| %>
  <% if @emergency_contact.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded">
      <ul class="list-disc list-inside">
        <% @emergency_contact.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
  </div>

  <div>
    <%= f.label :relationship, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :relationship, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
  </div>

  <div>
    <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
  </div>

  <div>
    <%= f.label :priority, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :priority, min: 1, class: "w-32 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    <p class="mt-1 text-sm text-gray-500">Lower numbers are contacted first.</p>
  </div>

  <% guardian_options = @participant_event.guardian_participant_events.includes(:guardian).map { |gpe| [gpe.guardian.full_name, gpe.id] } %>
  <% if guardian_options.any? %>
    <div>
      <%= f.label :guardian_participant_event_id, "Linked guardian (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :guardian_participant_event_id, guardian_options, { include_blank: "— Not linked to a guardian —" }, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
  <% end %>

  <div class="pt-2 flex flex-col sm:flex-row gap-3">
    <%= f.submit submit_label, class: "w-full sm:w-auto bg-purple-600 text-white px-6 py-2 rounded-md hover:bg-purple-700 cursor-pointer" %>
    <%= link_to "Cancel", safeguarding_admin_event_participant_path(current_event, @participant_event), class: "w-full sm:w-auto text-center px-6 py-2 text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>

<% content_for :title, "Event invites – Attend" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Event invites</h1>
      <p class="text-sm text-gray-500">Invite someone to create an event and set it up themselves. They become its event admin.</p>
    </div>
    <%= link_to "Invite someone", new_admin_event_creation_invite_path, class: "px-4 py-2 bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] transition-colors" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg">
    <div class="overflow-x-auto -mx-4 sm:mx-0">
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invited by</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100 text-xs sm:text-sm">
          <% if @invites.empty? %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-gray-500">No invites yet.</td>
            </tr>
          <% end %>
          <% @invites.each do |invite| %>
            <% label, _, pill = event_creation_invite_status(invite) %>
            <tr>
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= invite.email %></div>
                <% if invite.note.present? %>
                  <div class="text-sm text-gray-500 truncate max-w-[280px]" title="<%= invite.note %>"><%= invite.note %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= pill %>"><%= label %></span>
                <% if invite.pending? %>
                  <div class="mt-1 text-xs text-gray-500">
                    <%= "#{time_ago_in_words(invite.last_sent_at)} ago, " if invite.last_sent_at %>expires <%= l(invite.expires_at.to_date, format: :long) %>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">
                <% if invite.event %>
                  <%= link_to invite.event.name, admin_event_dashboard_path(invite.event), class: "text-[#ec3750] hover:underline" %>
                  <% unless invite.event.setup_complete? %>
                    <div class="text-xs text-gray-500">Setup in progress</div>
                  <% end %>
                <% elsif invite.completed? %>
                  Deleted
                <% elsif invite.event_series %>
                  In <%= invite.event_series.name %>
                <% else %>
                  Standalone
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= invite.invited_by&.email || "—" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <% if invite.pending? || invite.expired? %>
                  <%= button_to "Resend", resend_admin_event_creation_invite_path(invite), method: :post, class: "text-[#ec3750] hover:underline cursor-pointer", form: { class: "inline" } %>
                <% end %>
                <% if invite.pending? || invite.started? %>
                  <%= button_to "Revoke", revoke_admin_event_creation_invite_path(invite), method: :patch, class: "text-[#ec3750] hover:underline cursor-pointer ml-4", form: { class: "inline", data: { turbo_confirm: "Revoke the invite for #{invite.email}? Their link will stop working." } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% content_for :title, "Event invites – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs([ "Events", admin_root_path ], [ "Event invites", nil ]) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Event invites <span class="cs-counter">(<%= @invites.size %>)</span></h1>
      <p class="cs-description">Invite someone to create an event and set it up themselves. They become its event admin.</p>
    </div>
    <div class="cs-actions">
      <%= link_to "Invite someone", new_admin_event_creation_invite_path, class: "cs-btn cs-btn-primary" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Invites</h2>
    </div>
    <% if @invites.empty? %>
      <div class="cs-empty">
        <p class="cs-empty-title">No invites yet.</p>
        <div class="cs-actions">
          <%= link_to "Invite someone", new_admin_event_creation_invite_path, class: "cs-btn" %>
        </div>
      </div>
    <% else %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Status</th>
              <th scope="col">Event</th>
              <th scope="col">Invited by</th>
              <th scope="col" class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @invites.each do |invite| %>
              <% label, type, _ = event_creation_invite_status(invite) %>
              <tr>
                <td>
                  <div><%= invite.email %></div>
                  <% if invite.note.present? %>
                    <div class="cs-small cs-muted truncate max-w-[280px]" title="<%= invite.note %>"><%= invite.note %></div>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <%= cs_status(type, label) %>
                  <% if invite.pending? %>
                    <div class="cs-small cs-muted">
                      <%= cs_relative_time(invite.last_sent_at) if invite.last_sent_at %><%= ", " if invite.last_sent_at %>expires <%= cs_absolute_time_tag(invite.expires_at, date_only: true) %>
                    </div>
                  <% end %>
                </td>
                <td>
                  <% if invite.event %>
                    <%= link_to invite.event.name, admin_event_dashboard_path(invite.event), class: "cs-link" %>
                    <% unless invite.event.setup_complete? %>
                      <div class="cs-small cs-muted">Setup in progress</div>
                    <% end %>
                  <% elsif invite.completed? %>
                    <span class="cs-muted">Deleted</span>
                  <% elsif invite.event_series %>
                    <span class="cs-muted">In <%= invite.event_series.name %></span>
                  <% else %>
                    <span class="cs-muted">Standalone</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap"><%= invite.invited_by&.email || "—" %></td>
                <td class="whitespace-nowrap text-right">
                  <% if invite.pending? || invite.expired? %>
                    <%= button_to "Resend", resend_admin_event_creation_invite_path(invite), method: :post, class: "cs-btn cs-btn-link", form: { class: "inline" } %>
                  <% end %>
                  <% if invite.pending? || invite.started? %>
                    <%= button_to "Revoke", revoke_admin_event_creation_invite_path(invite), method: :patch, class: "cs-btn cs-btn-link", form: { class: "inline", data: { turbo_confirm: "Revoke the invite for #{invite.email}? Their link will stop working." } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>

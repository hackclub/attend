<% content_for :title, "Invite someone to create an event – Attend" %>

<div class="space-y-6 max-w-3xl">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Invite someone to create an event</h1>
      <p class="text-sm text-gray-500">They get an email with a link, sign in with Hack Club, and go through event setup on their own.</p>
    </div>
    <%= link_to "View sent invites", admin_event_creation_invites_path, class: "px-4 py-2 bg-white border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-6 py-4">
      <%= form_with model: [ :admin, @invite ], class: "space-y-6" do |f| %>
        <% if @invite.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-md p-4">
            <ul class="list-disc list-inside text-sm text-red-600">
              <% @invite.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :email, label_text("Email address", required: true), class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email, required: true, autocomplete: "off", class: "mt-1 block w-full rounded-md border-gray-300 focus:border-[#ec3750] focus:ring-[#ec3750]", placeholder: "person@example.com" %>
          <p class="mt-1 text-sm text-gray-500">Only the Hack Club account with this address can accept the invite.</p>
        </div>

        <% if EventSeries.any? %>
          <div>
            <%= f.label :event_series_id, "Series", class: "block text-sm font-medium text-gray-700" %>
            <%= f.collection_select :event_series_id, EventSeries.order(:name), :id, :name, { include_blank: "No series (standalone event)" }, class: "mt-1 block w-full rounded-md border-gray-300 focus:border-[#ec3750] focus:ring-[#ec3750]" %>
            <p class="mt-1 text-sm text-gray-500">The event they create will be part of this series. They don't become a series member.</p>
          </div>
        <% end %>

        <div>
          <%= f.label :note, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :note, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 focus:border-[#ec3750] focus:ring-[#ec3750]" %>
          <p class="mt-1 text-sm text-gray-500">Included in the invite email.</p>
        </div>

        <div class="flex flex-col sm:flex-row justify-end gap-3">
          <%= link_to "Cancel", admin_event_creation_invites_path, class: "w-full sm:w-auto text-center px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition-colors" %>
          <%= f.submit "Send invite", class: "w-full sm:w-auto px-4 py-2 bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

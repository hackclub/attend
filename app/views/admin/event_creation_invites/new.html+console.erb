<% content_for :title, "Invite someone to create an event – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs([ "Events", admin_root_path ], [ "Event invites", admin_event_creation_invites_path ], [ "New invite", nil ]) %>

<div class="cs-stack max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Invite someone to create an event</h1>
      <p class="cs-description">They get an email with a link, sign in with Hack Club, and go through event setup on their own.</p>
    </div>
    <div class="cs-actions">
      <%= link_to "View sent invites", admin_event_creation_invites_path, class: "cs-btn" %>
    </div>
  </div>

  <%= form_with model: [ :admin, @invite ], class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Invite details</h2>
      </div>
      <div class="cs-container-body">
        <%= cs_form_field f, :email, label: "Email address",
              constraint: "Only the Hack Club account with this address can accept the invite.",
              messages: { blank: "Email address is required.", invalid: "Enter a valid email address. For example: name@example.com" } do |aria| %>
          <%= f.email_field :email, class: "cs-input", autocomplete: "off", required: true, **aria %>
        <% end %>

        <% if EventSeries.any? %>
          <%= cs_form_field f, :event_series_id, label: "Series", optional: true, error_keys: [ :event_series ],
                constraint: "The event they create will be part of this series. They don't become a series member." do |aria| %>
            <%= f.collection_select :event_series_id, EventSeries.order(:name), :id, :name, { include_blank: "No series (standalone event)" }, class: "cs-select", **aria %>
          <% end %>
        <% end %>

        <%= cs_form_field f, :note, label: "Note", optional: true,
              constraint: "Included in the invite email." do |aria| %>
          <%= f.text_area :note, rows: 3, class: "cs-input", **aria %>
        <% end %>
      </div>
    </section>

    <%= cs_form_errors f %>

    <div class="flex flex-col sm:flex-row justify-end gap-2">
      <%= link_to "Cancel", admin_event_creation_invites_path, class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button "Send invite", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

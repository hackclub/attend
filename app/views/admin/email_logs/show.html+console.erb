<% content_for :breadcrumbs, cs_breadcrumbs([ "Email logs", admin_email_logs_path ], [ "Email log details", nil ]) %>
<% email_status_types = { "sent" => :in_progress, "delivered" => :success, "opened" => :success, "bounced" => :error, "failed" => :error } %>
<% timeline_types = {
     "sent" => :info,
     "delivered" => :success,
     "opened" => :success,
     "bounced" => :error,
     "link_clicked" => :info,
     "spam_complaint" => :warning
   } %>

<%# Global-admin-only page: the dashed orange border is the project's admin-only marker. %>
<%# The whole page is global-admin only (see the controller), so it carries no
    admin-only outline: that marks admin bits inside pages others can see. %>
<div class="cs-stack">
  <div class="cs-header mb-0!">
    <div class="cs-header-text">
      <h1 class="cs-h1">Email log details</h1>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2"><%= @email_log.subject %></h2>
    </div>
    <div class="cs-container-body cs-stack">
      <dl class="cs-kv cs-kv-3">
        <div>
          <dt class="cs-kv-label">To</dt>
          <dd class="cs-kv-value"><%= @email_log.to_address %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">From</dt>
          <dd class="cs-kv-value"><%= @email_log.from_address %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Mailer</dt>
          <dd class="cs-kv-value font-mono"><%= @email_log.mailer_class %>#<%= @email_log.mailer_action %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Status</dt>
          <dd class="cs-kv-value"><%= cs_status(email_status_types.fetch(@email_log.status, :pending), @email_log.status.titleize) %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Sent</dt>
          <dd class="cs-kv-value"><%= cs_absolute_time_tag(@email_log.created_at) %></dd>
        </div>
        <% if @email_log.delivered_at %>
          <div>
            <dt class="cs-kv-label">Delivered</dt>
            <dd class="cs-kv-value"><%= cs_absolute_time_tag(@email_log.delivered_at) %></dd>
          </div>
        <% end %>
        <% if @email_log.opened_at %>
          <div>
            <dt class="cs-kv-label">Opened</dt>
            <dd class="cs-kv-value"><%= cs_absolute_time_tag(@email_log.opened_at) %></dd>
          </div>
        <% end %>
        <% if @email_log.postmark_message_id %>
          <div>
            <dt class="cs-kv-label">Postmark message ID</dt>
            <dd class="cs-kv-value"><span class="cs-copy-value"><%= @email_log.postmark_message_id %></span></dd>
          </div>
        <% end %>
        <% if @email_log.event %>
          <div>
            <dt class="cs-kv-label">Event</dt>
            <dd class="cs-kv-value">
              <%= link_to @email_log.event.name, admin_event_dashboard_path(@email_log.event.slug), class: "cs-link" %>
            </dd>
          </div>
        <% end %>
        <% if @email_log.emailable %>
          <div>
            <dt class="cs-kv-label">Related record</dt>
            <dd class="cs-kv-value"><%= @email_log.emailable_type %> #<%= @email_log.emailable_id.to_s.first(8) %>...</dd>
          </div>
        <% end %>
      </dl>

      <% if @email_log.bounced_at %>
        <div class="cs-alert cs-alert-error">
          <%= cs_status_icon(:error) %>
          <div class="flex-1">
            <p class="cs-alert-title">Bounced</p>
            <dl class="cs-kv cs-kv-3 mt-2">
              <div>
                <dt class="cs-kv-label">Bounced</dt>
                <dd class="cs-kv-value"><%= cs_absolute_time_tag(@email_log.bounced_at) %></dd>
              </div>
              <div>
                <dt class="cs-kv-label">Bounce type</dt>
                <dd class="cs-kv-value"><%= @email_log.bounce_type %></dd>
              </div>
              <% if @email_log.bounce_description %>
                <div>
                  <dt class="cs-kv-label">Bounce description</dt>
                  <dd class="cs-kv-value"><%= @email_log.bounce_description %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <% if @email_log.body.present? %>
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Message body</h2>
      </div>
      <div class="cs-container-body prose prose-sm max-w-none">
        <%= sanitize @email_log.body, tags: %w[p br a strong em ul ol li h1 h2 h3 h4 h5 h6 span div img], attributes: %w[href class style src alt width height] %>
      </div>
    </section>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Event timeline</h2>
    </div>

    <% if @events.any? %>
      <div class="cs-container-body">
        <ol class="cs-steps">
          <% @events.each do |event| %>
            <% type = timeline_types.fetch(event.event_type, :pending) %>
            <li>
              <span class="cs-step-icon cs-status-<%= type.to_s.dasherize %>"><%= cs_status_icon(type) %></span>
              <div class="flex min-w-0 flex-wrap justify-between gap-x-4">
                <div class="min-w-0">
                  <p class="cs-step-title font-bold"><%= event.event_type.titleize %></p>
                  <% if event.metadata.present? && event.metadata.any? %>
                    <div class="cs-step-detail space-y-0.5">
                      <% event.metadata.each do |key, value| %>
                        <% next if value.blank? %>
                        <p><span class="font-bold"><%= key.to_s.humanize %>:</span> <%= value.is_a?(Hash) ? value.to_json : value %></p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <p class="cs-step-detail whitespace-nowrap">
                  <%= cs_absolute_time_tag(event.occurred_at) %>
                </p>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
    <% else %>
      <div class="cs-empty">
        <p class="cs-empty-title">No events recorded yet.</p>
      </div>
    <% end %>
  </section>
</div>

<div class="space-y-6 border-2 border-dashed border-orange-400 p-4 rounded-lg">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">Email Logs</h1>
    <span class="text-sm text-orange-600 font-medium">Global Admin Only</span>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg">
    <div class="p-4 border-b border-gray-200">
      <%= form_with url: admin_email_logs_path, method: :get, class: "grid grid-cols-2 md:grid-cols-3 gap-4", data: { turbo_frame: "_top" } do |f| %>
        <div>
          <%= f.label :search, "Search Email", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :search, value: params[:search], placeholder: "email@example.com", class: "mt-1 block w-full px-3 py-2 rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] text-sm" %>
        </div>
        <div>
          <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :status, [["All Statuses", ""], ["Sent", "sent"], ["Delivered", "delivered"], ["Opened", "opened"], ["Bounced", "bounced"], ["Failed", "failed"]], { selected: params[:status] }, class: "mt-1 block w-full px-3 py-2 rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] text-sm" %>
        </div>
        <div class="flex items-end gap-2">
          <%= link_to "Clear", admin_email_logs_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition-colors" %>
          <%= f.submit "Filter", class: "px-4 py-2 bg-[#ec3750] text-white rounded-md hover:bg-[#d42f46] transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <% if @email_logs.any? %>
      <div class="overflow-x-auto -mx-4 sm:mx-0">
        <table class="min-w-full divide-y divide-gray-100">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sent At</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">To</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mailer</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100 text-xs sm:text-sm">
            <% @email_logs.each do |log| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 truncate max-w-[180px]" title="<%= log.to_address %>">
                  <%= log.to_address %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 truncate max-w-[200px]" title="<%= log.subject %>">
                  <%= log.subject %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <span class="font-mono text-xs"><%= log.mailer_action %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% status_color = case log.status
                     when "sent" then "bg-yellow-100 text-yellow-800"
                     when "delivered" then "bg-blue-100 text-blue-800"
                     when "opened" then "bg-green-100 text-green-800"
                     when "bounced" then "bg-red-100 text-red-800"
                     when "failed" then "bg-red-100 text-red-800"
                     else "bg-gray-100 text-gray-800"
                     end %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_color %>">
                    <%= log.status.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= log.event&.name || "—" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "View", admin_email_log_path(log), class: "text-[#ec3750] hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-gray-500">No email logs found matching your criteria.</p>
      </div>
    <% end %>
  </div>
</div>

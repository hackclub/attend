<% content_for :breadcrumbs, cs_breadcrumbs([ "Email logs", nil ]) %>
<% email_status_types = { "sent" => :in_progress, "delivered" => :success, "opened" => :success, "bounced" => :error, "failed" => :error } %>

<%# Global-admin-only page: the dashed orange border is the project's admin-only marker. %>
<%# The whole page is global-admin only (see the controller), so it carries no
    admin-only outline: that marks admin bits inside pages others can see. %>
<div class="cs-stack">
  <div class="cs-header mb-0!">
    <div class="cs-header-text">
      <h1 class="cs-h1">Email logs</h1>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Sent emails</h2>
    </div>
    <%= form_with url: admin_email_logs_path, method: :get, class: "px-5 pb-4", data: { turbo_frame: "_top" } do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 items-end">
        <div>
          <%= f.label :search, "Search email", class: "cs-field-label" %>
          <label class="cs-search">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
            <%= f.search_field :search, value: params[:search], placeholder: "email@example.com", class: "cs-input" %>
          </label>
        </div>
        <div>
          <%= f.label :status, "Status", class: "cs-field-label" %>
          <%= f.select :status, [ [ "All statuses", "" ], [ "Sent", "sent" ], [ "Delivered", "delivered" ], [ "Opened", "opened" ], [ "Bounced", "bounced" ], [ "Failed", "failed" ] ], { selected: params[:status] }, class: "cs-select" %>
        </div>
        <div class="flex items-end gap-2">
          <%= link_to "Clear", admin_email_logs_path, class: "cs-btn cs-btn-link" %>
          <%= f.button "Filter", name: "commit", value: "Filter", class: "cs-btn" %>
        </div>
      </div>
    <% end %>

    <% if @email_logs.any? %>
      <div class="cs-table-wrap border-t border-(--cs-border-divider-secondary)">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Sent at</th>
              <th scope="col">To</th>
              <th scope="col">Subject</th>
              <th scope="col">Mailer</th>
              <th scope="col">Status</th>
              <th scope="col">Event</th>
              <th scope="col" class="text-right">Details</th>
            </tr>
          </thead>
          <tbody>
            <% @email_logs.each do |log| %>
              <tr>
                <td class="whitespace-nowrap cs-secondary font-mono">
                  <%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
                </td>
                <td class="whitespace-nowrap truncate max-w-[180px]" title="<%= log.to_address %>">
                  <%= log.to_address %>
                </td>
                <td class="truncate max-w-[200px]" title="<%= log.subject %>">
                  <%= log.subject %>
                </td>
                <td class="whitespace-nowrap">
                  <span class="cs-copy-value"><%= log.mailer_action %></span>
                </td>
                <td class="whitespace-nowrap">
                  <%= cs_status(email_status_types.fetch(log.status, :pending), log.status.titleize) %>
                </td>
                <td class="whitespace-nowrap cs-secondary">
                  <%= log.event&.name || "—" %>
                </td>
                <td class="whitespace-nowrap text-right">
                  <%= link_to "View", admin_email_log_path(log), class: "cs-link" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="cs-empty border-t border-(--cs-border-divider-secondary)">
        <p class="cs-empty-title">No email logs</p>
        <p>No email logs found matching your criteria.</p>
      </div>
    <% end %>
  </section>
</div>

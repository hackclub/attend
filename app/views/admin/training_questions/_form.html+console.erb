<%= form_with model: question, url: (question.persisted? ? admin_training_course_lesson_question_path(course, lesson, question) : admin_training_course_lesson_questions_path(course, lesson)), class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header"><h2 class="cs-h2">Question</h2></div>
    <div class="cs-container-body">
      <%= cs_form_field f, :prompt, label: "Question" do |aria| %>
        <%= f.text_area :prompt, rows: 2, class: "cs-input", **aria %>
      <% end %>
      <%= cs_form_field f, :explanation, label: "Explanation", optional: true,
            description: "Shown with the correct answer once it's revealed — the takeaway you want people to remember." do |aria| %>
        <%= f.text_area :explanation, rows: 3, class: "cs-input", **aria %>
      <% end %>
    </div>
  </section>

  <section class="cs-container" data-controller="nested-form">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Answers</h2>
        <p class="cs-container-description">Tick every correct answer. One correct answer shows as a single choice; more than one, as "choose all that apply". The reason shows whenever a learner picks that answer.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <% cs_claim_errors(question, :options, :"options.body") %>
      <div data-nested-form-target="container" class="space-y-4">
        <% question.options.each_with_index do |option, index| %>
          <%= f.fields_for :options, option do |of| %>
            <div data-nested-form-target="item" class="rounded border border-(--cs-border-divider-secondary) p-3 space-y-2 <%= "hidden" if of.object.marked_for_destruction? %>">
              <div class="flex items-center gap-2">
                <%= of.text_field :body, class: "cs-input flex-1", placeholder: "Answer #{index + 1}", "aria-label": "Answer #{index + 1}" %>
                <label class="inline-flex items-center gap-1 whitespace-nowrap"><%= of.check_box :correct %> Correct</label>
                <% if of.object.persisted? %>
                  <%= of.hidden_field :_destroy, data: { nested_form_target: "destroyField" } %>
                <% end %>
                <button type="button" data-action="nested-form#remove" class="cs-btn cs-btn-link">Remove</button>
              </div>
              <%= of.text_area :explanation, rows: 2, class: "cs-input text-sm", placeholder: "Why this answer is right or wrong (optional)", "aria-label": "Reason for answer #{index + 1}" %>
            </div>
          <% end %>
        <% end %>
      </div>

      <template data-nested-form-target="template">
        <%= f.fields_for :options, TrainingQuestionOption.new, child_index: "NEW_RECORD" do |of| %>
          <div data-nested-form-target="item" class="rounded border border-(--cs-border-divider-secondary) p-3 space-y-2">
            <div class="flex items-center gap-2">
              <%= of.text_field :body, class: "cs-input flex-1", placeholder: "Another answer", "aria-label": "Another answer" %>
              <label class="inline-flex items-center gap-1 whitespace-nowrap"><%= of.check_box :correct %> Correct</label>
              <button type="button" data-action="nested-form#remove" class="cs-btn cs-btn-link">Remove</button>
            </div>
            <%= of.text_area :explanation, rows: 2, class: "cs-input text-sm", placeholder: "Why this answer is right or wrong (optional)", "aria-label": "Reason for this answer" %>
          </div>
        <% end %>
      </template>

      <button type="button" data-action="nested-form#add" class="cs-btn mt-3">Add another answer</button>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col sm:flex-row justify-between gap-2">
    <div>
      <% if question.persisted? %>
        <%= link_to "Delete question", admin_training_course_lesson_question_path(course, lesson, question), class: "cs-btn cs-btn-full",
              data: { turbo_method: :delete, turbo_confirm: "Delete this question?" } %>
      <% end %>
    </div>
    <div class="flex flex-col sm:flex-row gap-2">
      <%= link_to "Cancel", edit_admin_training_course_lesson_path(course, lesson, anchor: "quiz"), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button (question.persisted? ? "Save question" : "Add question"), class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  </div>
<% end %>

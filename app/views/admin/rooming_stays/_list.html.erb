<%# The event's stays with who's in each. locals: stays:, roster_counts:, exempt_count:, return_to: (optional) %>
<% if stays.empty? %>
  <div class="bg-white border border-gray-200 rounded-lg p-8 text-center text-sm text-gray-500">
    <p class="font-medium text-gray-900">No stays</p>
    <p class="mt-1">Add one below for each stretch of accommodation you're providing. If nobody needs a bed, for example everyone sleeps at the venue, you don't need any.</p>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stay</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">When</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Who's in it</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rooms</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% stays.each do |stay| %>
          <tr>
            <td class="px-4 py-3">
              <div class="font-medium text-gray-900 whitespace-nowrap"><%= stay.name %></div>
              <% if stay.eligible_only? && stay.eligibility_options.any? %>
                <div class="text-xs text-gray-500"><%= stay.eligibility_options.map(&:display_label).join(" · ") %></div>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <%= stay.kind_label %>
              <% if stay.starts_on || stay.ends_on %>
                <div class="text-xs text-gray-500"><%= [ stay.starts_on, stay.ends_on ].compact.map { |d| l(d, format: :short) }.join(" – ") %></div>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if stay.everyone? %>
                Everyone with accommodation
                <% if exempt_count.positive? %>
                  <div class="text-xs text-gray-500">except <%= exempt_count %> marked exempt</div>
                <% end %>
              <% else %>
                <%= link_to "#{pluralize(roster_counts[stay.id] || 0, "person")} on the list", admin_event_rooming_stay_roster_entries_path(@event.slug, stay), class: "text-[#ec3750] hover:underline" %>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap"><%= stay.rooms.size %></td>
            <td class="px-4 py-3 whitespace-nowrap">
              <div class="flex items-center gap-3">
                <%= link_to "Rooming", admin_event_rooming_wizard_path(@event.slug, stay_id: (stay.id unless stay.main?)), class: "text-[#ec3750] hover:underline" %>
                <%= link_to "Edit", edit_admin_event_rooming_stay_path(@event.slug, stay, return_to: local_assigns[:return_to]), class: "text-gray-600 hover:underline" %>
                <%= button_to "Remove", admin_event_rooming_stay_path(@event.slug, stay, return_to: local_assigns[:return_to]), method: :delete, class: "text-red-600 hover:underline",
                      form: { class: "contents", data: { turbo_confirm: "Remove #{stay.name}? Its rooms and room assignments#{" and its list of who's staying" if stay.eligible_only?} go with it." } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

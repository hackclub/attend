<div class="max-w-2xl mx-auto px-4 py-6">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Your Profile</h1>
    <p class="text-sm text-gray-500 mt-1">Manage your display name and profile picture</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-6 py-5">
      <%= form_with model: @user, url: admin_profile_path, method: :patch, class: "space-y-6", data: { controller: "avatar-preview" } do |f| %>
        <div class="flex items-center gap-6">
          <div class="relative" data-avatar-preview-target="container">
            <% if @user.avatar_displayable? %>
              <%= image_tag @user.avatar.variant(resize_to_fill: [96, 96]), class: "h-24 w-24 rounded-full object-cover", data: { avatar_preview_target: "image" } %>
            <% else %>
              <div class="h-24 w-24 rounded-full bg-gray-200 flex items-center justify-center" data-avatar-preview-target="placeholder">
                <span class="text-2xl font-semibold text-gray-500"><%= @user.initials %></span>
              </div>
              <img src="" class="h-24 w-24 rounded-full object-cover hidden" data-avatar-preview-target="image">
            <% end %>
          </div>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-2">Profile Picture</label>
            <%= f.file_field :avatar, accept: "image/jpeg,image/png,image/gif,image/webp", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100", data: { action: "change->avatar-preview#preview", avatar_preview_target: "input" } %>
            <p class="mt-1 text-xs text-gray-500">JPG, PNG, GIF, or WebP up to 5MB</p>
          </div>
        </div>

        <div>
          <%= f.label :display_name, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :display_name, placeholder: @user.name || @user.email, class: "mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] px-3 py-2" %>
          <p class="mt-1 text-xs text-gray-500">This name will be shown on comments, audit logs, and other activity. If left blank, your OIDC name (<%= @user.name || "not set" %>) or email will be used.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :phone_number, "Phone number", class: "block text-sm font-medium text-gray-700" %>
            <%= f.telephone_field :phone_number,
                  placeholder: @user.oidc_claims&.dig("phone_number").presence || "+15551234567",
                  class: "mt-1 block w-full rounded-md border-gray-300 focus:border-[#ec3750] focus:ring-[#ec3750] px-3 py-2" %>
            <p class="mt-1 text-xs text-gray-500">
              Used for emergency incident calls.
              <%= @user.oidc_claims&.dig("phone_number").present? ? "Defaults to your Hack Club account number; override here." : "Not provided by Hack Club login — set it here." %>
            </p>
          </div>
          <div>
            <%= f.label :slack_user_id, "Slack member ID", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :slack_user_id,
                  placeholder: @user.oidc_claims&.dig("slack_id").presence || "U01ABCDEF",
                  class: "mt-1 block w-full rounded-md border-gray-300 focus:border-[#ec3750] focus:ring-[#ec3750] px-3 py-2" %>
            <p class="mt-1 text-xs text-gray-500">
              Used for Slack DM alerts.
              <%= @user.oidc_claims&.dig("slack_id").present? ? "Defaults to your Hack Club account; override here." : "Set it here." %>
            </p>
          </div>
        </div>

        <div class="border-t border-gray-200 pt-6">
          <h3 class="text-sm font-medium text-gray-700 mb-3">Account Information</h3>
          <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2 text-sm">
            <div>
              <dt class="text-gray-500">Email</dt>
              <dd class="text-gray-900"><%= @user.email %></dd>
            </div>
            <div>
              <dt class="text-gray-500">Name (from OIDC)</dt>
              <dd class="text-gray-900"><%= @user.name || "—" %></dd>
            </div>
            <div>
              <dt class="text-gray-500">Role</dt>
              <dd class="text-gray-900"><%= @user.global_role.titleize %></dd>
            </div>
            <div>
              <dt class="text-gray-500">Last Sign In</dt>
              <dd class="text-gray-900"><%= @user.last_sign_in_at&.strftime("%B %d, %Y at %H:%M") || "—" %></dd>
            </div>
          </dl>
        </div>

        <div class="flex justify-end pt-4">
          <%= f.submit "Save Changes", class: "px-4 py-2 bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <% if @user.avatar.attached? %>
        <div class="mt-4">
          <%= button_to "Remove profile picture", avatar_admin_profile_path, method: :delete, form: { data: { turbo_confirm: "Are you sure you want to remove your profile picture?" } }, class: "text-sm text-red-600 hover:text-red-800" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

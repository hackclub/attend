<%# Cloudscape wizard frame for a series broadcast, as admin/messages/_wizard
    is for one event's message. Render as a layout:
      render layout: "wizard", locals: { current_step: "compose" | "preview", title: } %>
<% steps = [
     { key: "compose", label: "Write broadcast",
       path: @broadcast.persisted? ? edit_admin_series_broadcast_path(@series, @broadcast) : nil },
     { key: "preview", label: "Preview and send", path: nil }
   ]
   current_index = steps.index { |s| s[:key] == current_step } %>

<div class="cs-wizard">
  <nav class="cs-wizard-nav" aria-label="Broadcast steps">
    <ol>
      <% steps.each_with_index do |step, index| %>
        <% state = if index == current_index then "current"
                   elsif step[:path] then "available"
                   else "disabled"
                   end %>
        <li class="cs-wizard-nav-step cs-wizard-nav-step-<%= state %>">
          <span class="cs-wizard-nav-number">Step <%= index + 1 %></span>
          <% if state == "available" %>
            <%= link_to step[:label], step[:path], class: "cs-wizard-nav-label" %>
          <% else %>
            <span class="cs-wizard-nav-label" <%= 'aria-current="step"'.html_safe if state == "current" %>><%= step[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <div class="cs-wizard-main">
    <p class="cs-wizard-step-count">Step <%= current_index + 1 %> of <%= steps.size %></p>
    <div class="cs-header">
      <div class="cs-header-text">
        <h1 class="cs-h1"><%= title %></h1>
        <p class="cs-description"><%= @series.name %></p>
      </div>
    </div>
    <%= yield %>
  </div>
</div>

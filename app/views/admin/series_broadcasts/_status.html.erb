<%# A series broadcast's status pill in the original admin. %>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
  <%= case broadcast.status
      when "draft" then "bg-gray-100 text-gray-800"
      when "scheduled" then "bg-yellow-100 text-yellow-800"
      when "pending_review" then "bg-amber-100 text-amber-800"
      when "sending" then "bg-blue-100 text-blue-800"
      when "completed" then "bg-green-100 text-green-800"
      when "cancelled" then "bg-gray-100 text-gray-500"
      end %>">
  <%= broadcast.status.titleize %>
</span>

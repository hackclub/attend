<%= form_with model: [ :admin, @series ], url: @series.persisted? ? admin_series_path(@series) : admin_series_index_path, class: "cs-stack", multipart: true, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Series details</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <%= cs_form_field f, :name, label: "Series name" do |aria| %>
          <%= f.text_field :name, class: "cs-input", required: true, **aria %>
        <% end %>
        <%= cs_form_field f, :slug, label: "Slug", optional: true,
              constraint: "Lowercase letters, numbers and hyphens (-) only. Leave blank to create one from the name.",
              messages: {
                blank: "Slug is required. Enter a slug or a series name.",
                taken: "This slug is already in use.",
                invalid: "Enter a valid slug. Use lowercase letters, numbers and hyphens (-) only.",
                exclusion: "This slug is reserved. Enter a different slug."
              } do |aria| %>
          <%= f.text_field :slug, class: "cs-input", pattern: "[a-z0-9\\-]+", data: { cs_pattern_message: "Enter a valid slug. Use lowercase letters, numbers and hyphens (-) only." }, **aria %>
        <% end %>
      </div>

      <%= cs_form_field f, :description, label: "Description", optional: true,
            constraint: "A short line about what this series is." do |aria| %>
        <%= f.text_area :description, rows: 2, class: "cs-input", **aria %>
      <% end %>

      <%= cs_form_field f, :contact_email, label: "Contact email", optional: true,
            messages: { invalid: "Enter a valid email address." },
            constraint: "The sender and reply-to for emails from events in this series that don't set their own support email. Defaults to team@hackclub.com when neither is set." do |aria| %>
        <%= f.email_field :contact_email, class: "cs-input", **aria %>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Branding</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <%= cs_form_field f, :logo, label: "Logo", optional: true,
              constraint: "JPEG, PNG, GIF, WebP or SVG, up to 5 MB. Events in this series without their own logo inherit it." do |aria| %>
          <% if @series.logo.attached? %>
            <div class="mb-2"><%= render "admin/events/avatar", event: @series, size: 48, rounded: "rounded-lg" %></div>
          <% end %>
          <%= f.file_field :logo, accept: "image/jpeg,image/png,image/gif,image/webp,image/svg+xml", class: "cs-file", **aria %>
        <% end %>
        <%= cs_form_field f, :banner, label: "Banner", optional: true,
              constraint: "PNG or JPEG, up to 5 MB. Inherited by events in this series too." do |aria| %>
          <% if @series.banner.attached? %>
            <div class="mb-2"><%= image_tag @series.banner, alt: "Current banner", class: "h-16 rounded-md object-cover" %></div>
          <% end %>
          <%= f.file_field :banner, accept: "image/jpeg,image/png", class: "cs-file", **aria %>
        <% end %>
      </div>
    </div>
  </section>

  <% brand = @series.brand_theme %>
  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Registration branding</h2>
      <p class="cs-container-description">How registration looks for every event in this series. Fonts and images come from files in the repo: add images under app/assets/images/brands/ and fonts to BrandTheme::FONTS, then pick them here. Colours only apply to the light theme, and every text, button and outline colour has to pass WCAG contrast before it saves.</p>
    </div>
    <div class="cs-container-body space-y-4">
      <% brand_contrast_errors = @series.errors[:brand] %>
      <% cs_claim_errors(@series, :brand) %>
      <%= cs_form_alert(brand_contrast_errors, title: "These colours don't meet contrast minimums") %>

      <div class="cs-field-grid">
        <% BrandHelper::BRAND_COLOR_FIELDS.each do |field, (label, hint)| %>
          <% id = "event_series_brand_#{field}" %>
          <% cs_claim_errors(@series, :"brand_#{field}") %>
          <%= cs_field id: id, label: label, optional: !BrandTheme::REQUIRED_COLORS.include?(field), constraint: hint, errors: brand_field_errors(@series, field) do |aria| %>
            <div class="flex items-center gap-2">
              <span class="size-8 shrink-0 rounded border border-(--cs-border-input)" style="background-color: <%= brand.public_send(field).to_s.match?(BrandTheme::HEX) ? brand.public_send(field) : "transparent" %>" aria-hidden="true"></span>
              <%= text_field_tag "event_series[brand][#{field}]", brand.public_send(field), id: id, placeholder: "#rrggbb", class: "cs-input", pattern: "#[0-9a-fA-F]{6}", data: { cs_pattern_message: "Enter a hex colour like #1a2b3c." }, **aria %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="cs-field-grid">
        <%= cs_field id: "event_series_brand_body_font", label: "Body font", optional: true, errors: brand_field_errors(@series, "body_font") do |aria| %>
          <%= select_tag "event_series[brand][body_font]", brand_font_options_for_select(brand.body_font), id: "event_series_brand_body_font", class: "cs-select", **aria %>
        <% end %>
        <%= cs_field id: "event_series_brand_heading_font", label: "Heading font", optional: true, errors: brand_field_errors(@series, "heading_font") do |aria| %>
          <%= select_tag "event_series[brand][heading_font]", brand_font_options_for_select(brand.heading_font), id: "event_series_brand_heading_font", class: "cs-select", **aria %>
        <% end %>
        <%= cs_field id: "event_series_brand_nav_style", label: "Step navigation", constraint: "Numbered steps, or the event card with a progress bar.", errors: brand_field_errors(@series, "nav_style") do |aria| %>
          <%= select_tag "event_series[brand][nav_style]", brand_nav_options_for_select(brand.nav_style), id: "event_series_brand_nav_style", class: "cs-select", **aria %>
        <% end %>
      </div>
      <% cs_claim_errors(@series, :brand_body_font, :brand_heading_font, :brand_nav_style) %>

      <div class="cs-field-grid">
        <% BrandHelper::BRAND_IMAGE_FIELDS.each do |field, (label, hint)| %>
          <% id = "event_series_brand_#{field}" %>
          <% cs_claim_errors(@series, :"brand_#{field}") %>
          <%= cs_field id: id, label: label, optional: true, constraint: hint, errors: brand_field_errors(@series, field) do |aria| %>
            <%= select_tag "event_series[brand][#{field}]", brand_image_options_for_select(brand.public_send(field)), id: id, class: "cs-select", **aria %>
          <% end %>
        <% end %>
      </div>

      <details class="cs-expandable" <%= "open" if brand.tokens.present? || @series.errors.include?(:brand_tokens) %>>
        <summary>Exact token values (advanced)</summary>
        <div class="cs-expandable-content">
          <% cs_claim_errors(@series, :brand_tokens) %>
          <%= cs_field id: "event_series_brand_tokens", label: "Token overrides", optional: true,
                constraint: "One token: #hex per line, to pin a shade instead of having it worked out. Tokens: #{BrandTheme::TOKENS.join(", ")}.",
                errors: brand_field_errors(@series, "tokens") do |aria| %>
            <%= text_area_tag "event_series[brand][tokens]", brand.tokens_text, id: "event_series_brand_tokens", rows: 6, class: "cs-input font-mono", placeholder: "text-muted: #8a6440", **aria %>
          <% end %>
        </div>
      </details>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Registration notes</h2>
      <p class="cs-container-description">Optional text shown to registrants at every event in this series.</p>
    </div>
    <div class="cs-container-body space-y-4">
      <%= cs_form_field f, :registration_note, label: "Next steps note", optional: true,
            constraint: "On the welcome, review and \"you're registered\" screens." do |aria| %>
        <%= f.text_area :registration_note, rows: 2, class: "cs-input", placeholder: "Bring a laptop! You'll need one to build your project.", **aria %>
      <% end %>
      <div class="cs-field-grid">
        <%= cs_form_field f, :address_note, label: "Why we ask for an address", optional: true, constraint: "Above the address fields." do |aria| %>
          <%= f.text_field :address_note, class: "cs-input", **aria %>
        <% end %>
        <%= cs_form_field f, :tshirt_note, label: "T-shirt hint", optional: true, constraint: "Under the t-shirt size question." do |aria| %>
          <%= f.text_field :tshirt_note, class: "cs-input", placeholder: "Unisex, US sizing.", **aria %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Account linking</h2>
      <p class="cs-container-description">Adds an accounts step to onboarding before documents. Events can override this in their own settings. Changing it while people are mid-registration can shift where they are in the steps.</p>
    </div>
    <div class="cs-container-body space-y-4">
      <div class="cs-field-grid">
        <% EventSeries::ACCOUNT_LINKING_PROVIDERS.each do |provider| %>
          <% provider_name = AccountLinking.provider_name(provider) %>
          <div class="cs-stack">
            <%= cs_form_field f, :"#{provider}_linking", label: "#{provider_name} account",
                  warning: (%(#{provider_name} OAuth credentials aren't configured, so participants can't connect yet and "Required" won't block anyone.) unless AccountLinking.available?(provider)) do |aria| %>
              <%= f.select :"#{provider}_linking", [ [ "Don't ask", "off" ], [ "Optional", "optional" ], [ "Required", "required" ] ],
                    { selected: @series.account_linking_mode(provider) }, class: "cs-select", **aria %>
            <% end %>
            <%= cs_form_field f, :"#{provider}_help_url", label: "#{provider_name} how-to link", optional: true,
                  constraint: "Shown to people who don't have an account yet." do |aria| %>
              <%= f.url_field :"#{provider}_help_url", class: "cs-input", placeholder: "https://", **aria %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
    <%= link_to "Cancel", @series.persisted? ? admin_series_path(@series) : admin_series_index_path, class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button @series.persisted? ? "Save changes" : "Create series", class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

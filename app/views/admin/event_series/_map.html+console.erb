<% markers = series_map_markers(event_rows) %>
<section class="cs-container h-full flex flex-col">
  <div class="cs-container-header">
    <h2 class="cs-h2">Venue locations</h2>
  </div>

  <% if markers.empty? %>
    <div class="cs-empty flex-1">
      <p class="cs-empty-title">No venues to plot</p>
      <p>None of these events has a venue location set yet, so there's nothing to plot. Add one in an event's settings.</p>
    </div>
  <% else %>
    <%# Markers travel as JSON rather than interpolated markup so an event name
        is never parsed as HTML on its way onto the map. %>
    <div class="px-5 flex-1 flex flex-col"
         data-controller="series-map"
         data-series-map-markers-value="<%= markers.to_json %>">
      <div class="series-map flex-1 bg-(--cs-bg-shaded)" data-series-map-target="map" role="group" aria-label="Map of this series' event venues. Each venue is also listed, with the same details, in the Events list on this page."></div>
    </div>

    <%# Swatches come from the same ramp the markers do, so the legend cannot
        drift from the map when the ramp is re-stepped. Both counts sit together:
        how much is plotted and how much is missing is one fact, not two. %>
    <div class="px-5 pt-3 pb-4 flex flex-wrap items-center gap-x-4 gap-y-1 cs-small cs-secondary">
      <span class="flex items-center gap-1.5">
        <span class="series-marker-dot inline-block w-2 h-2" style="background: <%= series_blocked_fill(0.0) %>" aria-hidden="true"></span>
        <span class="series-marker-dot inline-block w-3.5 h-3.5" style="background: <%= series_blocked_fill(1.0) %>" aria-hidden="true"></span>
        Deeper and larger means more people still blocked
      </span>
      <span>
        <%= pluralize(markers.length, "venue") %> plotted<% if dashboard.unmapped_events.any? %>, <%= pluralize(dashboard.unmapped_events.length, "event") %> with no location set<% end %>
      </span>
    </div>
  <% end %>
</section>

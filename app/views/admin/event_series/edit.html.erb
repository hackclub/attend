<% content_for :title, "Edit #{@series.name} – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs([ "Series", admin_series_index_path ], [ @series.name, admin_series_path(@series) ], [ "Settings", nil ]) %>

<div class="cs-stack max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Series settings</h1>
      <p class="cs-description">Branding here is inherited by every event in <%= @series.name %> that doesn't set its own.</p>
    </div>
  </div>

  <%= render "form" %>
</div>

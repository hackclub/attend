<%# One box of the series form. Locals: f, save (true when the box saves on its own) %>
<section class="cs-container">
  <div class="cs-container-header">
    <h2 class="cs-h2">Registration notes</h2>
    <p class="cs-container-description">Optional text shown to registrants at every event in this series.</p>
  </div>
  <div class="cs-container-body space-y-4">
    <%= cs_form_field f, :registration_note, label: "Next steps note", optional: true,
          constraint: "On the welcome, review and \"you're registered\" screens." do |aria| %>
      <%= f.text_area :registration_note, rows: 2, class: "cs-input", placeholder: "Bring a laptop! You'll need one to build your project.", **aria %>
    <% end %>
    <div class="cs-field-grid">
      <%= cs_form_field f, :address_note, label: "Why we ask for an address", optional: true, constraint: "Above the address fields." do |aria| %>
        <%= f.text_field :address_note, class: "cs-input", **aria %>
      <% end %>
      <%= cs_form_field f, :tshirt_note, label: "T-shirt hint", optional: true, constraint: "Under the t-shirt size question." do |aria| %>
        <%= f.text_field :tshirt_note, class: "cs-input", placeholder: "Unisex, US sizing.", **aria %>
      <% end %>
    </div>
    <div class="cs-option">
      <%= f.check_box :hide_privacy_notes, { checked: @series.hide_privacy_notes? } %>
      <div>
        <%= f.label :hide_privacy_notes, "Hide the privacy notes", class: "cs-option-label" %>
        <p class="cs-option-description">Leaves out the notes on who can see rooming and health answers, and the private request links, on the accommodation and health steps. Health sections also stop offering to discuss privately.</p>
      </div>
    </div>
    <div class="cs-option">
      <%= f.check_box :hide_invitation_letter, { checked: @series.hide_invitation_letter? } %>
      <div>
        <%= f.label :hide_invitation_letter, "Hide the invitation letter", class: "cs-option-label" %>
        <p class="cs-option-description">Leaves the invitation letter download off the entry ticket on the dashboard and the "you're registered" screen. Visa letter applications are not affected.</p>
      </div>
    </div>
  </div>
  <%= cs_settings_save f if local_assigns[:save] %>
</section>

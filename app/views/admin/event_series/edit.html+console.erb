<% content_for :title, "Settings – #{@series.name} – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs(cs_gated_crumb("Event series", admin_series_index_path, policy(EventSeries).index?), [ @series.name, admin_series_path(@series) ], [ "Settings", nil ]) %>

<div class="cs-stack">
  <%= render "admin/event_series/settings_header", series: @series, current_tab: :general %>

  <%= cs_settings_form @series, url: admin_series_path(@series), tab: "general", multipart: true do |f| %>
    <%= render "admin/event_series/form_details", f: f, save: true %>
  <% end %>
  <%= cs_settings_form @series, url: admin_series_path(@series), tab: "general", multipart: true do |f| %>
    <%= render "admin/event_series/form_branding", f: f, save: true %>
  <% end %>
  <%= cs_settings_form @series, url: admin_series_path(@series), tab: "general", multipart: true do |f| %>
    <%= render "admin/event_series/form_registration_branding", f: f, save: true %>
  <% end %>
  <%= cs_settings_form @series, url: admin_series_path(@series), tab: "general", multipart: true do |f| %>
    <%= render "admin/event_series/form_registration_notes", f: f, save: true %>
  <% end %>
  <%= cs_settings_form @series, url: admin_series_path(@series), tab: "general", multipart: true do |f| %>
    <%= render "admin/event_series/form_account_linking", f: f, save: true %>
  <% end %>

  <%= cs_form_errors @series %>
</div>

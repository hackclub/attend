<% phase_statuses = { "Past" => :stopped, "Draft" => :pending, "Upcoming" => :pending, "Active" => :success } %>
<%# Search and pagination round-trip through the series page, anchored back to
    this section so a 300-event series doesn't land the reader at the top. %>
<% pagination_params = { events_search: @events_search.presence }.compact %>
<section class="cs-container" id="series-events">
  <div class="cs-container-header">
    <h2 class="cs-h2">Events <span class="cs-counter">(<%= @events_total_count %>)</span></h2>
  </div>
  <%= form_with url: admin_series_path(series, anchor: "series-events"), method: :get, class: "cs-filter-bar" do |f| %>
    <label class="cs-search flex-1 min-w-[14rem]">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
      <%= f.search_field :events_search, value: @events_search, placeholder: "Find events", "aria-label": "Find events by name or location", class: "cs-input" %>
    </label>
    <%= f.button "Search", name: nil, class: "cs-btn" %>
  <% end %>

  <div class="cs-table-wrap border-t border-(--cs-border-divider-secondary)">
    <table class="cs-table">
      <thead>
        <tr>
          <th scope="col">Event</th>
          <th scope="col">Status</th>
          <th scope="col">Progress</th>
        </tr>
      </thead>
      <tbody>
        <% event_rows.each do |row| %>
          <% event = row[:event] %>
          <% phase_label, _phase_type = event_phase(event) %>
          <tr id="series-event-<%= event.id %>">
            <td>
              <div class="flex items-center gap-3 min-w-0">
                <%= render "admin/events/avatar", event: event, size: 32, rounded: "rounded-lg" %>
                <div class="min-w-0">
                  <%= link_to event.name, admin_event_dashboard_path(event.slug), class: "cs-link cs-link-strong" %>
                  <p class="cs-small cs-secondary">
                    <span class="whitespace-nowrap"><%= cs_event_date_range(event) %></span>
                    <% if event.location_city.present? %>
                      · <%= [ event.location_city, event.location_country ].compact_blank.join(", ") %>
                    <% end %>
                  </p>
                </div>
              </div>
            </td>
            <td>
              <div class="flex flex-col gap-1">
                <%= cs_status(phase_statuses.fetch(phase_label, :info), phase_label) %>
                <% if !event.completed? && !event.setup_complete? %>
                  <%= cs_status(:warning, "Setup incomplete") %>
                <% end %>
              </div>
            </td>
            <td class="min-w-48">
              <div class="cs-progress-field">
                <div class="cs-progress-label">
                  <span class="tabular-nums"><%= pluralize(row[:active], "participant") %></span>
                  <span class="tabular-nums"><%= row[:percent] %>% cleared</span>
                </div>
                <div class="cs-progress" aria-hidden="true"><span style="width: <%= row[:percent] %>%"></span></div>
                <p class="cs-progress-hint">
                  <% if row[:active].zero? %>
                    No participants yet
                  <% elsif row[:top_blocker] %>
                    <span class="tabular-nums"><%= row[:top_blocker][:count] %></span> stuck on <%= row[:top_blocker][:stage].label.downcase %>
                  <% else %>
                    Everyone cleared
                  <% end %>
                </p>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if event_rows.empty? %>
      <div class="cs-empty">
        <p class="cs-empty-title">No event matches &ldquo;<%= @events_search %>&rdquo;.</p>
        <p><%= link_to "Show every event", admin_series_path(series, anchor: "series-events"), class: "cs-link" %></p>
      </div>
    <% end %>
  </div>

  <% if @events_total_pages > 1 %>
    <div class="cs-container-footer flex flex-wrap items-center justify-between gap-3">
      <span>
        Showing <%= (@events_page - 1) * @events_per_page + 1 %> to <%= [ @events_page * @events_per_page, @events_total_count ].min %> of <%= @events_total_count %> events
      </span>
      <nav class="cs-pagination" aria-label="Events pagination">
        <% if @events_page > 1 %>
          <%= link_to admin_series_path(series, pagination_params.merge(events_page: @events_page - 1, anchor: "series-events")), "aria-label": "Previous page" do %>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
          <% end %>
        <% else %>
          <span aria-disabled="true" aria-label="Previous page"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg></span>
        <% end %>
        <span aria-current="page"><%= @events_page %></span>
        <span class="cs-muted">of <%= @events_total_pages %></span>
        <% if @events_page < @events_total_pages %>
          <%= link_to admin_series_path(series, pagination_params.merge(events_page: @events_page + 1, anchor: "series-events")), "aria-label": "Next page" do %>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
          <% end %>
        <% else %>
          <span aria-disabled="true" aria-label="Next page"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></span>
        <% end %>
      </nav>
    </div>
  <% end %>
</section>

<%= form_with model: [ :admin, @series ], url: @series.persisted? ? admin_series_path(@series) : admin_series_index_path, class: "cs-stack", multipart: true do |f| %>
  <% if @series.errors.any? %>
    <div class="cs-alert cs-alert-error" role="alert">
      <%= cs_status_icon(:error) %>
      <div>
        <p class="cs-alert-title"><%= pluralize(@series.errors.count, "error") %> prohibited this series from being saved:</p>
        <ul class="mt-1 list-disc list-inside">
          <% @series.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Series details</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div class="cs-field">
          <%= f.label :name, class: "cs-field-label" %>
          <%= f.text_field :name, class: "cs-input" %>
        </div>
        <div class="cs-field">
          <%= f.label :slug, class: "cs-field-label" %>
          <%= f.text_field :slug, class: "cs-input", placeholder: "auto-generated from name" %>
          <p class="cs-field-hint">Lowercase letters, numbers, and dashes only</p>
        </div>
      </div>

      <div class="cs-field">
        <%= f.label :description, class: "cs-field-label" %>
        <%= f.text_area :description, rows: 2, class: "cs-input", placeholder: "Optional — a short line about what this series is" %>
      </div>

      <div class="cs-field">
        <%= f.label :contact_email, "Contact email", class: "cs-field-label" %>
        <%= f.email_field :contact_email, class: "cs-input", placeholder: "sunbeam@hackclub.com" %>
        <p class="cs-field-hint">Used as the sender/reply-to for emails from events in this series that don't set their own support email. Defaults to team@hackclub.com if neither is set.</p>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Branding</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-field-grid">
        <div class="cs-field">
          <%= f.label :logo, "Logo", class: "cs-field-label" %>
          <% if @series.logo.attached? %>
            <div class="mb-2"><%= render "admin/events/avatar", event: @series, size: 48, rounded: "rounded-lg" %></div>
          <% end %>
          <%= f.file_field :logo, accept: "image/jpeg,image/png,image/gif,image/webp,image/svg+xml", class: "cs-file" %>
          <p class="cs-field-hint">JPEG, PNG, GIF, WebP, or SVG. Max 5MB. Events in this series without their own logo inherit it.</p>
        </div>
        <div class="cs-field">
          <%= f.label :banner, "Banner", class: "cs-field-label" %>
          <% if @series.banner.attached? %>
            <div class="mb-2"><%= image_tag @series.banner, alt: "Current banner", class: "h-16 rounded-md object-cover" %></div>
          <% end %>
          <%= f.file_field :banner, accept: "image/jpeg,image/png", class: "cs-file" %>
          <p class="cs-field-hint">PNG or JPEG. Max 5MB. Inherited by events in this series too.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
    <%= link_to "Cancel", @series.persisted? ? admin_series_path(@series) : admin_series_index_path, class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button @series.persisted? ? "Save changes" : "Create series", class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

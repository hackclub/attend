<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Event", admin_event_dashboard_path(current_event.slug), class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h1 class="text-2xl font-bold mb-2">Send Slack Blast</h1>
    <p class="text-gray-600 mb-6">Send a direct message to all participants with linked Slack accounts.</p>

    <% if @participant_count.zero? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
        <p class="text-yellow-800">No participants have linked their Slack accounts yet.</p>
      </div>
    <% else %>
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
        <p class="text-blue-800">
          This will send a DM to <strong><%= @participant_count %></strong> participant<%= @participant_count == 1 ? "" : "s" %> 
          who have completed onboarding and linked their Slack account.
        </p>
      </div>

      <%= form_with url: admin_event_slack_blasts_path(current_event), method: :post, class: "space-y-4" do |f| %>
        <div data-controller="tinymce" data-tinymce-slack-mode-value="true">
          <%= label_tag :message, "Message", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= text_area_tag :message, nil, 
              rows: 6, 
              class: "w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] px-3 py-2",
              data: { tinymce_target: "editor" } %>
          <p class="mt-1 text-sm text-gray-500">Use the toolbar for formatting. Bold, italic, strikethrough, links, lists, and code are supported in Slack.</p>
        </div>

        <div class="flex justify-end gap-3 pt-4">
          <%= link_to "Cancel", admin_event_dashboard_path(current_event.slug), class: "px-4 py-2 text-gray-700 hover:text-gray-900" %>
          <%= submit_tag "Send Blast", 
              class: "bg-[#ec3750] hover:bg-[#d42f46] text-white font-semibold py-2 px-4 rounded-lg cursor-pointer",
              data: { confirm: "Are you sure you want to send this message to #{@participant_count} participants?" } %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

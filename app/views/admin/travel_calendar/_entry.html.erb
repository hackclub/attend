<%
  mode_label = if entry[:mode] == "plane"
    "Flight"
  elsif entry[:mode].present?
    entry[:mode].titleize
  else
    "Mode not provided"
  end
  direction_label = entry[:direction].titleize
  pickup_label = entry[:pickup_state]&.to_s&.humanize
  pickup_label = "Checked in" if entry[:pickup_state] == :checked_in
  search_text = [
    entry[:participant_name],
    entry[:participant_preferred_name],
    entry[:direction],
    mode_label,
    entry[:route],
    entry[:reference],
    entry[:details],
    pickup_label,
    entry[:groups].map { |group| group[:name] }
  ].flatten.compact.join(" ").downcase
  group_ids = entry[:groups].map { |group| group[:id] }.join(" ")
  awaiting_pickup = entry[:pickup_state] == :awaiting_pickup
  participant = @participants_by_id[entry[:participant_id]]
  collapsed_details = entry[:route].presence || entry[:details].presence || "Details not provided"
  reference_label = entry[:mode] == "plane" ? "Flight code" : "Carrier"
  pickup_status = {
    awaiting_pickup: :warning,
    collected: :success,
    checked_in: :success,
    pickup_not_needed: :stopped
  }.fetch(entry[:pickup_state], :pending)
%>

<li data-travel-calendar-filter-target="entry"
    data-travel-calendar-filter-search-value="<%= search_text %>"
    data-travel-calendar-filter-direction-value="<%= entry[:direction] %>"
    data-travel-calendar-filter-mode-value="<%= entry[:mode] %>"
    data-travel-calendar-filter-pickup-value="<%= entry[:pickup_state] %>"
    data-travel-calendar-filter-groups-value="<%= group_ids %>"
    class="border-b border-(--cs-border-divider-secondary) last:border-b-0 <%= "bg-(--cs-bg-selected)" if awaiting_pickup %>">
  <div class="grid gap-3 px-5 py-4 sm:grid-cols-[5rem_minmax(0,1fr)_auto] sm:items-start">
    <div>
      <p class="cs-h3 tabular-nums">
        <%= entry[:primary_time_at]&.in_time_zone(current_event.event_time_zone)&.strftime("%H:%M") || "No time" %>
      </p>
    </div>

    <div class="flex min-w-0 items-start gap-3">
      <% if participant&.headshot_displayable? %>
        <%= image_tag participant.headshot.variant(resize_to_fill: [40, 40]),
                      alt: "",
                      class: "size-10 shrink-0 rounded-full border border-(--cs-border-divider-secondary) object-cover" %>
      <% end %>

      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <%= link_to(entry[:participant_preferred_name].presence || entry[:participant_name],
                      admin_event_participant_path(current_event, entry[:participant_event_id]),
                      class: "cs-link cs-link-strong") %>
          <% if entry[:participant_preferred_name].present? %>
            <span class="cs-small cs-muted"><%= entry[:participant_name] %></span>
          <% end %>
        </div>

        <p class="mt-1">
          <span class="font-bold"><%= direction_label %> · <%= mode_label %></span>
          <span class="cs-muted"> · </span><%= collapsed_details %>
          <% if entry[:reference].present? %>
            <span class="cs-muted"> · </span><span class="cs-secondary"><%= reference_label %>: <%= entry[:reference] %></span>
          <% end %>
        </p>

        <% if entry[:is_unaccompanied_minor] || entry[:groups].any? %>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% if entry[:is_unaccompanied_minor] %>
              <%= cs_badge("Unaccompanied minor", "blue") %>
            <% end %>
            <% entry[:groups].each do |group| %>
              <%= cs_badge(group[:name]) %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if entry[:direction] == "inbound" %>
      <div class="flex flex-wrap items-center gap-2 sm:max-w-52 sm:justify-end">
        <%= cs_status(pickup_status, pickup_label) %>
        <% if awaiting_pickup %>
          <%= button_to "Pickup not needed",
                        dismiss_pickup_admin_event_travel_path(current_event),
                        method: :post,
                        params: { travel_id: entry[:id] },
                        class: "cs-btn" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <details class="cs-expandable border-t border-(--cs-border-divider-secondary) px-5 py-2">
    <summary class="min-h-10">View travel details</summary>
    <div class="cs-expandable-content pb-2">
      <dl class="cs-kv cs-kv-4">
        <div>
          <dt class="cs-kv-label">Direction</dt>
          <dd class="cs-kv-value"><%= direction_label %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Mode</dt>
          <dd class="cs-kv-value"><%= mode_label %></dd>
        </div>
        <div>
          <dt class="cs-kv-label">Route</dt>
          <dd class="cs-kv-value"><%= entry[:route].presence || "Not provided" %></dd>
        </div>
        <div>
          <dt class="cs-kv-label"><%= reference_label %></dt>
          <dd class="cs-kv-value"><%= entry[:reference].presence || "Not provided" %></dd>
        </div>
        <% if entry[:details].present? %>
          <div class="md:col-span-4">
            <dt class="cs-kv-label">Notes</dt>
            <dd class="cs-kv-value whitespace-pre-wrap"><%= entry[:details] %></dd>
          </div>
        <% end %>
      </dl>
      <%= link_to "Open participant travel",
                  travel_admin_event_participant_path(current_event, entry[:participant_event_id]),
                  class: "cs-link mt-4 inline-flex min-h-10 items-center" %>
    </div>
  </details>
</li>

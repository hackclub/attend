<% content_for :title, "Manual Invitations – Attend" %>
<div class="max-w-3xl space-y-6">
  <%= link_to "← Visa letters", admin_event_visa_letters_path(@event), class: "text-sm text-gray-500 hover:text-[#ec3750]" %>
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Manual Invitations</h1>
    <p class="text-sm text-gray-500 mt-1">This will send an email to the participant inviting them to fill out a visa letter application. This bypasses the submission deadline and any previous application restrictions. It isn't a place at the event.</p>
  </div>

  <% if @event.visa_letters_mode == "off" %>
    <p class="text-sm bg-blue-50 border border-blue-200 rounded-md px-4 py-3">Visa letters are off for this event, so invitations can't be used until you <%= link_to "turn them on", edit_admin_event_visa_letter_settings_path(@event), class: "underline" %>.</p>
  <% end %>

  <%= form_with url: admin_event_visa_letter_invitations_path(@event), method: :post, class: "bg-white border border-gray-200 rounded-lg p-6 space-y-3" do %>
    <h2 class="text-lg font-medium text-gray-900">New Invitation</h2>
    <%= label_tag :emails, "Participant Email", class: "block text-sm font-medium text-gray-700" %>
    <%= text_area_tag :emails, nil, rows: 3, placeholder: "participant@example.com", class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
    <p class="text-xs text-gray-500">The participant will receive an email with a link to fill out their visa letter application. Use the address of their Hack Club account. To invite several people, put one email per line or separate them with commas.</p>
    <div class="flex justify-end"><%= button_tag "Send Invitation", class: "px-4 py-2 bg-[#d42f46] text-white rounded-md text-sm" %></div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg overflow-x-auto">
    <% if @invitations.empty? %>
      <p class="p-6 text-sm text-gray-500">No invitations yet.</p>
    <% else %>
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase">
          <tr><th class="px-4 py-3">Email</th><th class="px-4 py-3">Invited By</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Sent</th><th class="px-4 py-3">Application</th><th class="px-4 py-3"></th></tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @invitations.each do |invitation| %>
            <tr>
              <td class="px-4 py-3"><%= invitation.email %></td>
              <td class="px-4 py-3"><%= invitation.issued_by&.display_name_or_fallback || "An admin" %></td>
              <td class="px-4 py-3"><%= invitation.claimed? ? "Claimed" : "Pending" %></td>
              <td class="px-4 py-3 whitespace-nowrap"><%= time_ago_in_words(invitation.created_at) %> ago</td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% if (application = invitation.visa_letter_application) %>
                  <%= link_to application.reference_number, admin_event_visa_letter_path(@event, application), class: "underline font-mono" %>
                <% else %>
                  –
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% unless invitation.claimed? %>
                  <%= button_to "Withdraw", admin_event_visa_letter_invitation_path(@event, invitation), method: :delete, class: "text-[#ec3750] underline",
                        form: { data: { turbo_confirm: "Withdraw the invitation for #{invitation.email}? Their link stops working." } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

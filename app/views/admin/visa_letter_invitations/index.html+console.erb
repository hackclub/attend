<% content_for :title, "Manual Invitations – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Visa letters", admin_event_visa_letters_path(@event) ], [ "Manual Invitations", nil ], event: @event) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Manual Invitations <span class="cs-counter">(<%= @invitations.size %>)</span></h1>
      <p class="cs-description">This will send an email to the participant inviting them to fill out a visa letter application. This bypasses the submission deadline and any previous application restrictions. It isn't a place at the event.</p>
    </div>
  </div>

  <% if @event.visa_letters_mode == "off" %>
    <div class="cs-alert" role="status">
      <%= cs_status_icon(:info) %>
      <div>Visa letters are off for this event, so invitations can't be used until you <%= link_to "turn them on", edit_admin_event_visa_letter_settings_path(@event), class: "cs-link" %>.</div>
    </div>
  <% end %>

  <%= form_with url: admin_event_visa_letter_invitations_path(@event), method: :post do %>
    <section class="cs-container">
      <div class="cs-container-header"><h2 class="cs-h2">New Invitation</h2></div>
      <div class="cs-container-body space-y-4">
        <%= cs_field id: "emails", label: "Participant Email", description: "The participant will receive an email with a link to fill out their visa letter application. Use the address of their Hack Club account.",
              constraint: "To invite several people, put one email per line or separate them with commas." do |aria| %>
          <%= text_area_tag :emails, nil, rows: 3, class: "cs-input", placeholder: "participant@example.com", **aria %>
        <% end %>
        <div class="flex justify-end"><%= button_tag "Send Invitation", class: "cs-btn cs-btn-primary cs-btn-full" %></div>
      </div>
    </section>
  <% end %>

  <section class="cs-container">
    <% if @invitations.empty? %>
      <div class="cs-empty"><p class="cs-empty-title">No invitations yet</p></div>
    <% else %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Invited By</th>
              <th scope="col">Status</th>
              <th scope="col">Sent</th>
              <th scope="col">Application</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @invitations.each do |invitation| %>
              <tr>
                <td><%= invitation.email %></td>
                <td><%= invitation.issued_by&.display_name_or_fallback || "An admin" %></td>
                <td class="whitespace-nowrap"><%= invitation.claimed? ? cs_status(:success, "Claimed") : cs_status(:pending, "Pending") %></td>
                <td class="whitespace-nowrap"><%= cs_relative_time(invitation.created_at) %></td>
                <td class="whitespace-nowrap">
                  <% if (application = invitation.visa_letter_application) %>
                    <%= link_to application.reference_number, admin_event_visa_letter_path(@event, application), class: "cs-link font-mono" %>
                  <% else %>
                    <span class="cs-muted">–</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <% unless invitation.claimed? %>
                    <%= button_to "Withdraw", admin_event_visa_letter_invitation_path(@event, invitation), method: :delete, class: "cs-btn cs-btn-link",
                          form: { class: "contents", data: { turbo_confirm: "Withdraw the invitation for #{invitation.email}? Their link stops working." } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>

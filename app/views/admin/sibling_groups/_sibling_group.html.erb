<div id="sibling_group_<%= sibling_group.id %>" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
  <div>
    <span class="font-medium text-gray-900">
      <%= sibling_group.label.presence || "Sibling Group" %>
    </span>
    <span class="text-gray-500 text-sm ml-2">
      <%= sibling_group.participants.map(&:display_name).join(", ") %>
    </span>
  </div>
  <%= link_to "Remove",
              admin_event_sibling_group_path(@event.slug, sibling_group),
              data: { turbo_method: :delete, turbo_confirm: "Remove this sibling group?" },
              class: "text-red-600 hover:text-red-800 text-sm" %>
</div>

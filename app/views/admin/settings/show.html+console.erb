<% content_for :breadcrumbs, cs_breadcrumbs([ "Settings", nil ]) %>
<% row_divider = "border-t border-(--cs-border-divider-secondary) mt-4 pt-4" %>

<div class="cs-stack">
  <%= render "admin/settings/header", current_tab: :general %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Site</h2>
    </div>
    <div class="cs-container-body">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="cs-setting-title">Maintenance mode</h3>
          <p class="cs-setting-description">When enabled, non-admin users will see a maintenance page instead of the site.</p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <%= @maintenance_mode ? cs_status(:warning, "Enabled") : cs_status(:stopped, "Disabled") %>
          <%= button_to toggle_maintenance_admin_settings_path,
                method: :post,
                class: "cs-btn",
                data: { turbo_confirm: @maintenance_mode ? "Are you sure you want to disable maintenance mode? The site will be accessible to all users." : "Are you sure you want to enable maintenance mode? Non-admin users will be locked out." } do %>
            <%= @maintenance_mode ? 'Disable' : 'Enable' %>
          <% end %>
        </div>
      </div>

      <div class="<%= row_divider %> flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="cs-setting-title">Pause waiver sending</h3>
          <p class="cs-setting-description">When paused, no waivers will be sent to participants or guardians. Participants will see a message that waivers are not yet available.</p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <%= @waiver_sending_paused ? cs_status(:warning, "Paused") : cs_status(:success, "Active") %>
          <%= button_to toggle_waiver_sending_admin_settings_path,
                method: :post,
                class: "cs-btn",
                data: { turbo_confirm: @waiver_sending_paused ? "Resume waiver sending? Participants will be able to sign waivers again." : "Pause all waiver sending? Participants will not be able to sign waivers until resumed." } do %>
            <%= @waiver_sending_paused ? 'Resume' : 'Pause' %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</div>

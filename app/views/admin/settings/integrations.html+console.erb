<% content_for :title, "Integrations – Settings – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs([ "Settings", admin_settings_path ], [ "Integrations", nil ]) %>
<% row_divider = "border-t border-(--cs-border-divider-secondary) mt-4 pt-4" %>

<div class="cs-stack">
  <%= render "admin/settings/header", current_tab: :integrations %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Twilio SMS</h2>
    </div>
    <div class="cs-container-body">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="cs-setting-title">Enable SMS</h3>
          <p class="cs-setting-description">When enabled, SMS notifications will be sent via Twilio.</p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <%= @twilio_enabled ? cs_status(:success, "Enabled") : cs_status(:stopped, "Disabled") %>
          <%= button_to toggle_twilio_admin_settings_path,
                method: :post,
                class: "cs-btn",
                data: { turbo_confirm: @twilio_enabled ? "Are you sure you want to disable Twilio? SMS notifications will stop being sent." : "Are you sure you want to enable Twilio? SMS notifications will be sent." } do %>
            <%= @twilio_enabled ? 'Disable' : 'Enable' %>
          <% end %>
        </div>
      </div>

      <div class="<%= row_divider %>">
        <%= form_with url: update_twilio_from_number_admin_settings_path, method: :post, html: { novalidate: true }, data: { controller: "phone-input cs-form-validation" } do |f| %>
          <%= cs_field id: "twilio_from_number", label: "From phone number", optional: true,
                description: "The phone number used to send SMS messages.",
                constraint: "E.164 format, with the country code. For example: +14155551234" do |aria| %>
            <div class="flex flex-wrap items-center gap-2">
              <%= f.telephone_field :twilio_from_number,
                    value: @twilio_from_number,
                    class: "cs-input max-w-xs", **aria %>
              <%= f.button "Save", class: "cs-btn" %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="<%= row_divider %>">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="cs-setting-title">WhatsApp outside the US and Canada</h3>
            <p class="cs-setting-description">
              Broadcasts, incident report texts and staff notifications go to numbers that don't start with +1
              as WhatsApp messages from the number above. If WhatsApp fails, the message is sent as a text instead.
            </p>
          </div>
          <div class="flex items-center gap-4 shrink-0">
            <%= @whatsapp_enabled ? cs_status(:success, "Enabled") : cs_status(:stopped, "Disabled") %>
            <%= button_to toggle_whatsapp_admin_settings_path,
                  method: :post,
                  class: "cs-btn",
                  data: { turbo_confirm: @whatsapp_enabled ? "Stop sending WhatsApp messages? Everyone will get texts instead." : "Start sending WhatsApp messages to numbers outside the US and Canada?" } do %>
              <%= @whatsapp_enabled ? 'Disable' : 'Enable' %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="<%= row_divider %>">
        <%= form_with url: update_twilio_verify_admin_settings_path, method: :post, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
          <%= cs_field id: "twilio_verify_service_sid", label: "Verify service SID", optional: true,
                description: "The Twilio Verify service that sends guardian portal sign-in codes. Without it, guardians can only sign in by email.",
                constraint: "Starts with VA. Find it under Verify → Services in the Twilio console." do |aria| %>
            <%= f.text_field :twilio_verify_service_sid,
                  value: @twilio_verify_service_sid,
                  autocomplete: "off", spellcheck: false,
                  class: "cs-input max-w-md font-mono", **aria %>
          <% end %>
          <div class="cs-option mt-3">
            <%= f.check_box :twilio_verify_whatsapp, { checked: @twilio_verify_whatsapp } %>
            <div>
              <%= f.label :twilio_verify_whatsapp, "Send codes on WhatsApp outside the US and Canada", class: "cs-option-label" %>
              <p class="cs-option-description">Numbers that don't start with +1 get their code on WhatsApp, with a link to get it by text instead. Needs a WhatsApp sender attached to the Verify service.</p>
            </div>
          </div>
          <div class="mt-3">
            <%= f.button "Save", class: "cs-btn" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Support inbox notifications</h2>
    </div>
    <div class="cs-container-body">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="cs-setting-title">Text notifications</h3>
          <p class="cs-setting-description">
            When enabled, the numbers below get a text when a new support ticket comes in,
            and assignees get texts about replies on their tickets (at most one per ticket every 15 minutes).
            Sending also requires Twilio SMS to be enabled above.
          </p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <%= @support_sms_notifications_enabled ? cs_status(:success, "Enabled") : cs_status(:stopped, "Disabled") %>
          <%= button_to toggle_support_sms_admin_settings_path,
                method: :post,
                class: "cs-btn" do %>
            <%= @support_sms_notifications_enabled ? 'Disable' : 'Enable' %>
          <% end %>
        </div>
      </div>

      <div class="<%= row_divider %>">
        <%= form_with url: update_support_sms_numbers_admin_settings_path, method: :post, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
          <%= cs_field id: "support_sms_notification_numbers", label: "Notification numbers", optional: true,
                description: "Phone numbers texted when a new ticket is opened.",
                constraint: "One per line or comma-separated, in E.164 format. For example: +14155551234" do |aria| %>
            <%= f.text_area :support_sms_notification_numbers,
                  value: @support_sms_notification_numbers.join("\n"),
                  rows: 4,
                  class: "cs-input max-w-md font-mono", **aria %>
          <% end %>
          <div class="mt-2">
            <%= f.button "Save", class: "cs-btn" %>
          </div>
        <% end %>
      </div>

      <div class="<%= row_divider %>">
        <%= form_with url: update_support_email_addresses_admin_settings_path, method: :post, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
          <%= cs_field id: "support_email_notification_addresses", label: "Email notifications", optional: true,
                description: "Addresses emailed when a new SMS, WhatsApp, or Signal ticket is opened. Leave empty to send no emails.",
                constraint: "One per line or comma-separated." do |aria| %>
            <%= f.text_area :support_email_notification_addresses,
                  value: @support_email_notification_addresses.join("\n"),
                  rows: 4,
                  class: "cs-input max-w-md font-mono", **aria %>
          <% end %>
          <div class="mt-2">
            <%= f.button "Save", class: "cs-btn" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Admin help Slack channel</h2>
    </div>
    <div class="cs-container-body">
      <%= form_with url: update_admin_help_slack_channel_admin_settings_path, method: :post, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
        <%= cs_field id: "admin_help_slack_channel_id", label: "Channel ID", optional: true,
              description: "Where event admins ask questions about Attend. Global admins are invited when they're made one, and Event Admins, Ops, Safeguarding Leads, and series members when they're given a role on an event that hasn't ended. Limited and Read Only staff are never invited. The Attend Slack bot must be in the channel.",
              constraint: "Starts with C or G, then capital letters and numbers. For example: C0123ABCD" do |aria| %>
          <div class="flex flex-wrap items-center gap-2">
            <%= f.text_field :admin_help_slack_channel_id,
                  value: @admin_help_slack_channel_id,
                  pattern: "\\s*[CG][A-Z0-9]+\\s*",
                  data: { cs_pattern_message: "Enter a valid Slack channel ID. For example: C0123ABCD" },
                  class: "cs-input max-w-xs font-mono", **aria %>
            <%= f.button "Save", class: "cs-btn" %>
          </div>
        <% end %>
      <% end %>

      <div class="<%= row_divider %> flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="cs-setting-title">Sync global and active event admins</h3>
          <p class="cs-setting-description">
            <%= pluralize(@admin_help_member_count, "eligible person", plural: "eligible people") %>,
            <%= @admin_help_members_without_slack %> without a Slack account linked through Hack Club Auth (they can't be invited).
          </p>
          <% if @admin_help_last_sync["at"].present? %>
            <p class="cs-field-description mt-1">
              Last synced <%= cs_relative_time(Time.zone.parse(@admin_help_last_sync["at"])) %>:
              <%= @admin_help_last_sync["added"] %> added,
              <%= @admin_help_last_sync["already_member"] %> already in the channel,
              <%= @admin_help_last_sync["failed"] %> failed,
              <%= @admin_help_last_sync["no_slack"] %> without Slack.
            </p>
          <% end %>
        </div>
        <%= button_to "Sync to channel", sync_admin_help_slack_channel_admin_settings_path,
              method: :post,
              disabled: @admin_help_slack_channel_id.blank?,
              class: "cs-btn shrink-0",
              data: { turbo_confirm: "Invite #{pluralize(@admin_help_member_count - @admin_help_members_without_slack, "person", plural: "people")} with Slack accounts to the channel?" } %>
      </div>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Org support Slack channel</h2>
    </div>
    <div class="cs-container-body">
      <%= form_with url: update_org_support_slack_channel_admin_settings_path, method: :post, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
        <%= cs_field id: "org_support_slack_channel_id", label: "Channel ID", optional: true,
              description: "Every kind of admin: global admins and global read-only users, plus anyone with any role on an event or its series (Limited and Read Only included), from when they get the role until 7 days after the event ends. People Attend added are removed daily once that's passed; anyone who joined on their own is never removed. The Attend Slack bot must be in the channel, with permission to remove people.",
              constraint: "Starts with C or G, then capital letters and numbers. For example: C0123ABCD" do |aria| %>
          <div class="flex flex-wrap items-center gap-2">
            <%= f.text_field :org_support_slack_channel_id,
                  value: @org_support_slack_channel_id,
                  pattern: "\\s*[CG][A-Z0-9]+\\s*",
                  data: { cs_pattern_message: "Enter a valid Slack channel ID. For example: C0123ABCD" },
                  class: "cs-input max-w-xs font-mono", **aria %>
            <%= f.button "Save", class: "cs-btn" %>
          </div>
        <% end %>
      <% end %>

      <div class="<%= row_divider %> flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="cs-setting-title">Sync all admins</h3>
          <p class="cs-setting-description">
            <%= pluralize(@org_support_member_count, "eligible person", plural: "eligible people") %>,
            <%= @org_support_members_without_slack %> without a Slack account linked through Hack Club Auth (they can't be invited).
          </p>
          <% if @org_support_last_sync["at"].present? %>
            <p class="cs-field-description mt-1">
              Last synced <%= cs_relative_time(Time.zone.parse(@org_support_last_sync["at"])) %>:
              <%= @org_support_last_sync["added"] %> added,
              <%= @org_support_last_sync["already_member"] %> already in the channel,
              <%= @org_support_last_sync["removed"] %> removed,
              <%= @org_support_last_sync["failed"] %> failed,
              <%= @org_support_last_sync["no_slack"] %> without Slack<% if @org_support_last_sync["not_in_workspace"].to_i.positive? %>,
              <%= @org_support_last_sync["not_in_workspace"] %> not in this Slack workspace<% end %>.
            </p>
          <% end %>
        </div>
        <%= button_to "Sync to channel", sync_org_support_slack_channel_admin_settings_path,
              method: :post,
              disabled: @org_support_slack_channel_id.blank?,
              class: "cs-btn shrink-0",
              data: { turbo_confirm: "Invite #{pluralize(@org_support_member_count - @org_support_members_without_slack, "person", plural: "people")} with Slack accounts to the channel, and remove anyone Attend added whose events ended over 7 days ago?" } %>
      </div>
    </div>
  </section>
</div>

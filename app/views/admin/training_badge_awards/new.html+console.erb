<% content_for :breadcrumbs, cs_breadcrumbs([ "Training", admin_training_path ], [ @badge.name, admin_training_badge_path(@badge) ], [ "Award manually", nil ]) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Award <%= @badge.name %></h1>
      <p class="cs-description">For someone who has done equivalent training elsewhere.</p>
    </div>
  </div>

  <%= form_with model: @award, url: admin_training_badge_awards_path(@badge), scope: :training_badge_award, class: "cs-stack", html: { novalidate: true } do |f| %>
    <section class="cs-container">
      <div class="cs-container-body">
        <%= cs_field id: "email", label: "Email address", description: "Their Hack Club account email. An account is created if they haven't signed in yet." do |aria| %>
          <%= email_field_tag :email, params[:email], id: "email", class: "cs-input", **aria %>
        <% end %>
        <%= cs_form_field f, :note, label: "Where was the training done?", example: "NSPCC Child Protection certificate, March 2026" do |aria| %>
          <%= f.text_area :note, rows: 2, class: "cs-input", **aria %>
        <% end %>
        <div class="cs-field-grid">
          <%= cs_form_field f, :awarded_at, label: "Training completed" do |aria| %>
            <%= f.date_field :awarded_at, value: @award.awarded_at&.to_date, class: "cs-input", **aria %>
          <% end %>
          <%= cs_form_field f, :expires_at, label: "Expires", optional: true,
                constraint: (@badge.expires? ? "Defaults to #{@badge.validity_months} months after completion." : "This badge doesn't expire by default.") do |aria| %>
            <%= f.date_field :expires_at, value: @award.expires_at&.to_date, class: "cs-input", **aria %>
          <% end %>
        </div>
      </div>
    </section>

    <%= cs_form_errors f %>

    <div class="flex flex-col sm:flex-row justify-end gap-2">
      <%= link_to "Cancel", admin_training_badge_path(@badge), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button "Award badge", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

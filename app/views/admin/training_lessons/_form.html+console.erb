<% course = lesson.course %>
<%= form_with model: lesson, url: (lesson.persisted? ? admin_training_course_lesson_path(course, lesson) : admin_training_course_lessons_path(course)), class: "cs-stack", html: { novalidate: true, multipart: true }, data: { controller: "cs-form-validation" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header"><h2 class="cs-h2">Lesson</h2></div>
    <div class="cs-container-body">
      <%= cs_form_field f, :title, label: "Title" %>
      <%= cs_form_field f, :body, label: "Content", optional: true,
            description: "Markdown: ## headings, **bold**, - lists, > callouts, [links](https://…) and ![images](https://…)." do |aria| %>
        <%= f.text_area :body, rows: 18, class: "cs-input font-mono text-sm", **aria %>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Video</h2>
        <p class="cs-container-description">Upload a file, or link an unlisted YouTube or Vimeo video. Shown above the content.</p>
      </div>
    </div>
    <div class="cs-container-body">
      <% if lesson.video_file.attached? && lesson.persisted? %>
        <div class="cs-field">
          <p class="cs-label">Current upload</p>
          <p><%= lesson.video_file.filename %> <span class="cs-secondary">· <%= number_to_human_size(lesson.video_file.byte_size) %></span></p>
          <div class="cs-option mt-2">
            <%= check_box_tag "training_lesson[remove_video_file]", "1", false, id: "remove_video_file" %>
            <label for="remove_video_file" class="cs-option-label">Remove this video</label>
          </div>
        </div>
      <% end %>
      <%= cs_form_field f, :video_file, label: (lesson.video_file.attached? ? "Replace with a new upload" : "Upload a video"), optional: true,
            constraint: "MP4, WebM or MOV, up to 1 GB." do |aria| %>
        <%= f.file_field :video_file, accept: TrainingLesson::VIDEO_CONTENT_TYPES.join(","), class: "cs-input", **aria %>
      <% end %>
      <%= cs_form_field f, :video_url, label: "Or a YouTube or Vimeo link", optional: true do |aria| %>
        <%= f.url_field :video_url, class: "cs-input", placeholder: "https://www.youtube.com/watch?v=…", **aria %>
      <% end %>
      <%= cs_form_field f, :video_duration_seconds, label: "Video length (seconds)", optional: true,
            description: "Filled in automatically when a global admin plays the video in the course preview. Until it's known, a learner's browser reports the length, which can't be fully trusted.",
            as: :number_field, input: { min: 1, step: "any" } %>
      <%= cs_form_field f, :require_full_watch, label: "Must watch the whole video", bare: true do |aria| %>
        <div class="cs-option">
          <%= f.check_box :require_full_watch, **aria %>
          <div>
            <%= f.label :require_full_watch, "Must watch the whole video", class: "cs-option-label" %>
            <p class="cs-option-description">Learners can rewind but not skip ahead, and the lesson's quiz and done button stay locked until they reach the end.</p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col sm:flex-row justify-end gap-2">
    <%= link_to "Cancel", admin_training_course_path(course), class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button (lesson.persisted? ? "Save lesson" : "Add lesson"), class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

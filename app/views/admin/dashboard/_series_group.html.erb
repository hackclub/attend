<%# A collapsible row grouping a series' events on the events list. %>
<%# Locals: series, events (this series' events, in list order), first %>
<% series_start = events.filter_map(&:starts_at).min %>
<% series_end = events.filter_map(&:ends_at).max %>
<% series_participants = events.sum { |event| event_participant_count(event) } %>
<% live_count = events.count(&:active?) %>
<li class="<%= "border-t border-gray-100" unless first %>">
  <details class="group/series">
    <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer flex items-center justify-between px-5 py-4 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#ec3750] transition-colors">
      <div class="flex items-center gap-3 sm:gap-4 flex-1 min-w-0">
        <%= render "admin/events/avatar", event: series, size: 36, rounded: "rounded-lg" %>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="text-sm font-medium text-gray-900"><%= series.name %></span>
            <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-600 whitespace-nowrap">Series</span>
            <%# A collapsed group hides its rows' own pills, so surface the one
                thing worth interrupting for: an event running right now. %>
            <% if live_count.positive? %>
              <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-green-50 text-green-700 whitespace-nowrap"><%= live_count %> active</span>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 sm:gap-4 mt-1 text-xs text-gray-500">
            <span class="flex items-center gap-1 whitespace-nowrap">
              <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <%= event_date_range(series_start, series_end) %>
            </span>
            <span class="flex items-center gap-1 whitespace-nowrap">
              <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
              <%= pluralize(series_participants, "participant") %>
            </span>
            <span class="whitespace-nowrap"><%= pluralize(events.count, "event") %></span>
          </div>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300 group-hover/series:text-gray-500 transition-transform group-open/series:rotate-90 flex-shrink-0 ml-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </summary>
    <div class="border-t border-gray-100 bg-gray-50/50 pl-4">
      <ul>
        <%# The wrapper already draws the rule under the summary, so the first
            child must not draw its own on top of it. %>
        <% events.each_with_index do |event, i| %>
          <%= render "admin/dashboard/event_row", event: event, first: i.zero? %>
        <% end %>
      </ul>
      <% if policy(series).show? %>
        <%= link_to admin_series_path(series), class: "flex items-center gap-1.5 px-5 py-3 border-t border-gray-100 text-xs font-medium text-gray-500 hover:text-gray-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#ec3750] transition-colors" do %>
          View series
          <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        <% end %>
      <% end %>
    </div>
  </details>
</li>

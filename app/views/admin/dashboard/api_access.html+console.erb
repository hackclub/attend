<% content_for :title, "API access – #{current_event.name} – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Settings", (edit_admin_event_path(current_event) if policy(current_event).update?) ], [ "API access", nil ]) %>

<div class="cs-stack">
  <%= render "admin/events/settings_header", event: current_event, current_tab: :api %>

  <%# API access (not part of the form) %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">API access</h2>
        <p class="cs-container-description">Programmatic access to add and list participants</p>
      </div>
      <div class="cs-actions">
        <%= link_to "API docs", docs_path, target: "_blank", rel: "noopener", class: "cs-btn cs-btn-link" %>
      </div>
    </div>
    <div class="cs-container-body cs-stack">
      <div>
        <p class="cs-kv-label">API endpoints</p>
        <div class="mt-1 space-y-1">
          <code class="block font-mono cs-small overflow-x-auto">POST <%= api_v1_event_participants_url(current_event) %></code>
          <code class="block font-mono cs-small overflow-x-auto">GET&nbsp; <%= api_v1_event_participants_url(current_event) %></code>
        </div>
      </div>

      <%# API tokens %>
      <div>
        <h3 class="cs-h3">API tokens</h3>

        <% if flash[:event_api_token] %>
          <div class="cs-alert cs-alert-warning mt-3">
            <%= cs_status_icon(:warning) %>
            <div class="min-w-0">
              <p class="cs-alert-title">Copy this token now. It won't be shown again.</p>
              <code class="cs-copy-value block mt-1"><%= flash[:event_api_token] %></code>
            </div>
          </div>
        <% end %>

        <% if @event_api_tokens.present? %>
          <div class="cs-table-wrap mt-3">
            <table class="cs-table cs-table-compact">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Last used</th>
                  <th scope="col">Created</th>
                  <% if policy(current_event).manage_api_tokens? %>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% @event_api_tokens.each do |token| %>
                  <tr>
                    <td class="font-mono"><%= token.name %></td>
                    <td class="whitespace-nowrap cs-secondary">
                      <% if token.last_used_at %>
                        <%= cs_relative_time(token.last_used_at) %>
                      <% else %>
                        Never
                      <% end %>
                    </td>
                    <td class="whitespace-nowrap cs-secondary"><%= cs_relative_time(token.created_at) %></td>
                    <% if policy(current_event).manage_api_tokens? %>
                      <td>
                        <div class="flex items-center justify-end gap-1 whitespace-nowrap">
                          <%= button_to "Rotate", admin_rotate_event_api_token_path(current_event.slug, token.id),
                              method: :post,
                              form: { class: "contents", data: { turbo_confirm: "Rotating issues a new secret and invalidates the current one. Integrations using this token will stop working until updated. Continue?" } },
                              class: "cs-btn cs-btn-link" %>
                          <%= button_to "Revoke", admin_event_api_token_path(current_event.slug, token.id),
                              method: :delete,
                              form: { class: "contents", data: { turbo_confirm: "This permanently revokes the token. Any integration using it will stop working. Continue?" } },
                              class: "cs-btn cs-btn-link" %>
                        </div>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="cs-muted mt-2">No API tokens yet.</p>
        <% end %>

        <% if policy(current_event).manage_api_tokens? %>
          <%= form_with url: admin_event_api_tokens_path(current_event.slug), method: :post, class: "mt-3", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
            <%= cs_field id: "name", label: "Token name", constraint: "Describes what uses the token. For example: attend-integration-name" do |aria| %>
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono cs-secondary select-none"><%= current_user.email.to_s.split("@").first %>@</span>
                <%= f.text_field :name, required: true, pattern: ".*\\S.*", data: { cs_pattern_message: "Token name is required." },
                      class: "cs-input font-mono flex-1 min-w-48", **aria %>
                <%= f.button "Create token", class: "cs-btn" %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <p class="cs-small cs-muted mt-3">Tokens can invite participants, so only event admins can create, rotate, or revoke them.</p>
        <% end %>
      </div>

      <% if current_event.api_key_set? %>
        <div class="border-t border-(--cs-border-divider-secondary) pt-4">
          <h3 class="cs-h3">Legacy API key</h3>
          <div class="flex flex-wrap items-center gap-3 mt-2">
            <% if flash[:api_key] %>
              <div class="cs-alert cs-alert-warning flex-1">
                <%= cs_status_icon(:warning) %>
                <div class="min-w-0">
                  <p class="cs-alert-title">Copy this key now. It won't be shown again.</p>
                  <code class="cs-copy-value block mt-1"><%= flash[:api_key] %></code>
                </div>
              </div>
            <% else %>
              <code class="cs-copy-value flex-1">••••••••••••••••••••••••••••••••</code>
            <% end %>
            <% if policy(current_event).regenerate_api_key? %>
              <%= button_to "Regenerate",
                  regenerate_api_key_admin_event_path(current_event),
                  method: :post,
                  form: { class: "shrink-0", data: { turbo_confirm: "This will invalidate the existing legacy API key. Any integrations using it will stop working. Continue?" } },
                  class: "cs-btn" %>
            <% end %>
          </div>
          <p class="cs-small cs-muted mt-2">The single-key access from before named tokens. Still works; prefer named tokens above.</p>
        </div>
      <% end %>

      <details class="cs-expandable">
        <summary>View API usage example</summary>
        <div class="cs-expandable-content">
          <p class="cs-kv-label mb-2">Invite a participant:</p>
          <pre class="cs-copy-value whitespace-pre overflow-x-auto"><code>curl -X POST <%= api_v1_event_participants_url(current_event) %> \
  -H "Authorization: Bearer YOUR_API_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
    "first_name": "Jane",
    "last_name": "Doe",
    "email": "jane@example.com"
  }'</code></pre>
          <p class="cs-kv-label mt-4 mb-2">List participants:</p>
          <pre class="cs-copy-value whitespace-pre overflow-x-auto"><code>curl <%= api_v1_event_participants_url(current_event) %> \
  -H "Authorization: Bearer YOUR_API_TOKEN"</code></pre>
        </div>
      </details>
    </div>
  </section>
</div>

<% content_for :title, "Integrations – #{current_event.name} – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Settings", (edit_admin_event_path(current_event) if policy(current_event).update?) ], [ "Integrations", nil ]) %>

<div class="cs-stack">
  <%= render "admin/events/settings_header", event: current_event, current_tab: :integrations %>

  <%# Slack %>
  <%= cs_settings_form current_event, url: admin_event_integrations_path(current_event) do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Slack</h2>
        <p class="cs-container-description">Team communication and notifications</p>
      </div>
      <div class="cs-actions">
        <%= current_event.slack_channel_id.present? ? cs_status(:success, "Configured") : cs_status(:stopped, "Not configured") %>
      </div>
    </div>
    <div class="cs-container-body">
      <%= cs_form_field f, :slack_channel_id, label: "Channel ID", optional: true,
            description: "The private channel participants are invited to after linking Slack. In Slack, open the channel details and scroll to the bottom to find the ID.",
            constraint: "For example: C0123456789" do |aria| %>
        <%= f.text_field :slack_channel_id, class: "cs-input font-mono", **aria %>
      <% end %>
    </div>
    <%= cs_settings_save f %>
  </section>
  <% end %>

  <%= render "admin/events/account_linking_fields", event: current_event %>

  <%# Airtable sync %>
  <%= cs_settings_form current_event, url: admin_event_integrations_path(current_event) do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Airtable sync</h2>
        <p class="cs-container-description">Mirror of participant data in an Airtable table</p>
      </div>
      <div class="cs-actions">
        <% if @airtable_sync_paused %>
          <%= cs_status(:warning, "Paused") %>
        <% elsif @airtable_sync_stale %>
          <%= cs_status(:error, "Stale") %>
        <% elsif @airtable_sync_configured %>
          <%= cs_status(:success, "Active") %>
        <% end %>
      </div>
    </div>
    <div class="cs-container-body cs-stack">
      <%# Connection. The buttons submit forms that sit after this one: a
          form nested in the settings form would be dropped by the browser. %>
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div>
          <h3 class="cs-h3">Airtable account</h3>
          <p class="cs-secondary cs-small mt-1">
            <% if @airtable_connection %>
              Connected<% if @airtable_connection.account_label.present? %> as <strong><%= @airtable_connection.account_label %></strong><% end %>
            <% elsif current_event.airtable_api_key.present? %>
              Using a personal access token. Connect Airtable to replace it.
            <% else %>
              Not connected
            <% end %>
          </p>
        </div>
        <div class="cs-actions shrink-0">
          <% if @airtable_connection %>
            <button type="submit" form="airtable-disconnect-form" class="cs-btn whitespace-nowrap">Disconnect</button>
          <% end %>
          <% if @airtable_oauth_configured %>
            <button type="submit" form="airtable-connect-form" class="cs-btn whitespace-nowrap<%= " cs-btn-primary" unless @airtable_connection %>">
              <%= @airtable_connection ? "Reconnect" : "Connect Airtable" %>
            </button>
          <% end %>
        </div>
      </div>

      <% unless @airtable_oauth_configured || @airtable_connection %>
        <div class="cs-alert">
          <%= cs_status_icon(:info) %>
          <p>Connecting with Airtable isn't set up on this server yet, so this event needs a personal access token (under Advanced).</p>
        </div>
      <% end %>

      <% if @airtable_base_not_granted %>
        <div class="cs-alert cs-alert-warning">
          <%= cs_status_icon(:warning) %>
          <p>The connected Airtable account didn't give Attend access to this base. Reconnect and select the base on Airtable's consent screen.</p>
        </div>
      <% end %>

      <% if @airtable_connection %>
        <%= cs_form_field f, :airtable_base_id, label: "Base",
              constraint: "Only bases you selected on Airtable's consent screen are listed. Reconnect to add more." do |aria| %>
          <% if @airtable_base_options.any? %>
            <%= f.select :airtable_base_id, @airtable_base_options, { include_blank: "Choose a base" }, class: "cs-select", **aria %>
          <% else %>
            <%= f.text_field :airtable_base_id, class: "cs-input font-mono", placeholder: "app…", autocomplete: "off", **aria %>
          <% end %>
        <% end %>
        <p class="cs-secondary cs-small">
          Attend keeps a table called <strong><%= Airtable::RecordsSync.table_name_for(current_event) %></strong> in this base up to date, creating it on the first sync.
          Columns you add are left alone; edits to Attend's columns are overwritten on the next sync.
          <% if current_event.airtable_base_id.present? && current_event.airtable_sync_table_id.present? %>
            <%= link_to "Open in Airtable", "https://airtable.com/#{current_event.airtable_base_id}/#{current_event.airtable_sync_table_id}", target: "_blank", rel: "noopener", class: "cs-link" %>
          <% end %>
        </p>
      <% else %>
        <details class="cs-expandable" <%= "open" if current_event.airtable_api_key.present? || current_event.errors.include?(:airtable_api_key) || current_event.errors.include?(:airtable_sync_endpoint_url) %>>
          <summary>Advanced: use a personal access token instead</summary>
          <div class="cs-expandable-content cs-stack">
            <%= cs_form_field f, :airtable_api_key, label: "Personal access token", optional: true,
                  constraint: safe_join([ "Needs the ", content_tag(:code, "data.records:write"), " and ", content_tag(:code, "schema.bases:write"), " scopes. Leave blank to keep the saved token." ]) do |aria| %>
              <%= f.password_field :airtable_api_key, value: nil, placeholder: (current_event.airtable_api_key.present? ? "Saved, hidden" : "pat…"), class: "cs-input font-mono", autocomplete: "off", **aria %>
            <% end %>
            <%= cs_form_field f, :airtable_sync_endpoint_url, label: "Sync endpoint URL", optional: true,
                  constraint: safe_join([ "A token syncs through Airtable's Sync API. Add a synced table from the Sync API and copy its endpoint URL: https://api.airtable.com/v0/", content_tag(:strong, "app…"), "/", content_tag(:strong, "tbl…"), "/sync/…" ]) do |aria| %>
              <%= f.text_field :airtable_sync_endpoint_url, class: "cs-input font-mono", autocomplete: "off", spellcheck: false, **aria %>
            <% end %>
          </div>
        </details>
      <% end %>

      <% if @airtable_sync_configured %>
        <%# Sync status %>
        <div class="border-t border-(--cs-border-divider-secondary) pt-4 cs-stack">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <h3 class="cs-h3">Sync status</h3>
            <button type="submit" form="airtable-sync-now-form" class="cs-btn whitespace-nowrap shrink-0 self-start">
              <%= @airtable_sync_paused ? "Resume & Sync Now" : "Sync Now" %>
            </button>
          </div>

          <% if @airtable_sync_paused %>
            <div class="cs-alert cs-alert-warning">
              <%= cs_status_icon(:warning) %>
              <div>
                <p class="cs-alert-title">
                  Sync paused after a failure<% if @airtable_sync_paused_at %> <%= cs_relative_time(@airtable_sync_paused_at) %><% end %>
                </p>
                <p>
                  Attend stops syncing an event as soon as Airtable rejects its settings, rather than retrying
                  broken settings every 5 minutes.
                  <% if @airtable_config_owner %>
                    <%= @airtable_config_owner.name.presence || @airtable_config_owner.email %> was emailed
                    because they last saved these settings.
                  <% end %>
                  Fix the settings above and save, or hit Resume &amp; Sync Now to try again as-is.
                </p>
                <% if @airtable_synced_at %>
                  <p class="mt-1">
                    Airtable still shows the snapshot from
                    <strong><%= cs_relative_time(@airtable_synced_at) %></strong>.
                  </p>
                <% else %>
                  <p class="mt-1">This integration has never synced successfully.</p>
                <% end %>
              </div>
            </div>
          <% elsif @airtable_sync_stale %>
            <div class="cs-alert cs-alert-error">
              <%= cs_status_icon(:error) %>
              <div>
                <p class="cs-alert-title">
                  <% if @airtable_synced_at %>
                    Sync is failing — last successful sync was <%= cs_relative_time(@airtable_synced_at, inline: true) %>
                  <% else %>
                    Never synced successfully
                  <% end %>
                </p>
                <p>
                  <% unless @airtable_synced_at %>If you just saved these settings, a sync is already running — refresh in a minute. Otherwise, <% end %>
                  <% if @airtable_sync_failures.positive? %>
                    Airtable is showing stale data while Attend retries. A rate limit or an Airtable outage clears
                    up by itself; anything else has been reported to the Attend team.
                  <% elsif @airtable_connection %>
                    Airtable is showing stale data — check that the connected account can still see the base above.
                  <% else %>
                    Airtable is showing stale data — check that the sync endpoint above still exists in
                    Airtable and that the token can see that base.
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>

          <% if @airtable_sync_error %>
            <div class="cs-alert cs-alert-error">
              <%= cs_status_icon(:error) %>
              <div class="min-w-0">
                <p class="cs-alert-title">
                  Last sync attempt failed<% if @airtable_sync_error_at %> <%= cs_relative_time(@airtable_sync_error_at, inline: true) %><% end %>
                </p>
                <p class="font-mono break-all"><%= @airtable_sync_error %></p>
                <% if !@airtable_sync_paused && @airtable_sync_failures.positive? %>
                  <p><%= pluralize(@airtable_sync_failures, "failed attempt") %> in a row. Attend keeps retrying every 5 minutes.</p>
                <% end %>
              </div>
            </div>
          <% end %>

          <dl class="cs-kv cs-kv-3 cs-kv-divided">
            <% unless @airtable_sync_paused || @airtable_sync_stale %>
              <div>
                <dt class="cs-kv-label">Last synced</dt>
                <dd class="cs-kv-value">
                  <strong><%= cs_relative_time(@airtable_synced_at) %></strong>
                </dd>
              </div>
            <% end %>
            <div>
              <dt class="cs-kv-label">Participant records</dt>
              <dd class="cs-kv-value"><%= pluralize(@airtable_participant_count, "participant record") %> will be synced</dd>
            </div>
            <div>
              <dt class="cs-kv-label">Schedule</dt>
              <dd class="cs-kv-value">
                <% if @airtable_sync_paused %>
                  Automatic syncing is stopped until these settings are saved again
                <% else %>
                  Syncs automatically every 5 minutes and whenever these settings are saved. If Airtable rejects these settings, syncing pauses until they are fixed.
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      <% end %>
    </div>
    <%= cs_settings_save f %>
  </section>
  <% end %>

  <%= cs_form_errors current_event %>

  <%# Targets for the Airtable buttons inside the Airtable form above: a form
      nested in another is dropped by the browser. %>
  <%= form_with url: admin_event_trigger_airtable_sync_path(current_event), method: :post, id: "airtable-sync-now-form", class: "hidden" do %><% end %>
  <%= form_with url: admin_event_airtable_connection_path(current_event), method: :post, id: "airtable-connect-form", class: "hidden", data: { turbo: false } do %><% end %>
  <%= form_with url: admin_event_airtable_connection_path(current_event), method: :delete, id: "airtable-disconnect-form", class: "hidden",
        data: { turbo_confirm: "Disconnect Airtable? The sync stops until someone connects it again." } do %><% end %>

  <%# vote.hackclub.com (not part of the form) %>
  <% vote_ready = current_event.logo.attached? && current_event.banner.attached? %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">vote.hackclub.com</h2>
        <p class="cs-container-description">Create a peer-voting gallery for this event</p>
      </div>
      <div class="cs-actions">
        <%= current_event.vote_event_linked? ? cs_status(:success, "Linked") : cs_status(:stopped, "Not linked") %>
      </div>
    </div>
    <div class="cs-container-body cs-stack">
      <% if current_event.vote_event_linked? %>
        <% if current_event.vote_event_linked_at %>
          <dl class="cs-kv">
            <div>
              <dt class="cs-kv-label">Linked</dt>
              <dd class="cs-kv-value"><%= cs_relative_time(Time.zone.parse(current_event.vote_event_linked_at.to_s)) %></dd>
            </div>
          </dl>
        <% end %>
        <div class="cs-actions">
          <% if current_event.vote_event_admin_url.present? %>
            <%= link_to "Manage on vote.hackclub.com", current_event.vote_event_admin_url, target: "_blank", rel: "noopener", class: "cs-btn cs-btn-primary" %>
          <% end %>
          <% if current_event.vote_event_gallery_url.present? %>
            <%= link_to "View gallery", current_event.vote_event_gallery_url, target: "_blank", rel: "noopener", class: "cs-btn" %>
          <% end %>
        </div>
      <% else %>
        <p>
          Creates a new <strong>DRAFT</strong> event on vote.hackclub.com using this event's
          name, slug, logo and banner. You can then finish setting it up on vote.hackclub.com.
          If an event with this slug already exists, it will be linked instead.
        </p>

        <% unless vote_ready %>
          <div class="cs-alert cs-alert-warning">
            <%= cs_status_icon(:warning) %>
            <p>This event needs both a <strong>logo</strong> and a <strong>banner</strong> image before you can create a vote event.</p>
          </div>
        <% end %>

        <div>
          <%= button_to "Create vote.hackclub.com event",
              admin_event_create_vote_event_path(current_event),
              method: :post,
              disabled: !vote_ready,
              form: { data: { turbo_confirm: "Create a new DRAFT event on vote.hackclub.com for \"#{current_event.name}\"?" } },
              class: "cs-btn" %>
        </div>
      <% end %>
    </div>
  </section>
</div>

<%# One table of event rows. Series events collapse into an expandable row
    group placed where the series' first event would have appeared, so the
    live and completed lists group identically. %>
<%# Locals: events (in display order) %>
<div class="cs-table-wrap">
  <table class="cs-table" data-controller="cs-row-group">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Status</th>
        <th scope="col">Dates</th>
        <th scope="col">Participants</th>
        <th scope="col">Location</th>
      </tr>
    </thead>
    <tbody>
      <% rendered_series_ids = Set.new %>
      <% events.each do |event| %>
        <% if event.event_series_id %>
          <% next if rendered_series_ids.include?(event.event_series_id) %>
          <% rendered_series_ids << event.event_series_id %>
          <%= render "admin/dashboard/series_group",
                series: event.event_series,
                events: events.select { |e| e.event_series_id == event.event_series_id } %>
        <% else %>
          <%= render "admin/dashboard/event_row", event: event %>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

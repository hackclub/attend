<% content_for :title, "Waivers & documents – #{current_event.name} – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Settings", (edit_admin_event_path(current_event) if policy(current_event).update?) ], [ "Waivers & documents", nil ]) %>

<div class="cs-stack">
  <%= render "admin/events/settings_header", event: current_event, current_tab: :documents %>

  <%# Waiver options, moved here from the event's General settings. %>
  <%= cs_settings_form current_event, url: admin_event_integrations_path(current_event), tab: "documents" do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Waiver options</h2>
    </div>
    <div class="cs-container-body">
      <div class="cs-option">
        <%= f.check_box :freedom_waivers_enabled %>
        <div>
          <%= f.label :freedom_waivers_enabled, "Enable freedom waivers", class: "cs-option-label" %>
          <p class="cs-option-description">Allow guardians to grant additional freedom permissions for minor participants</p>
        </div>
      </div>
      <div class="cs-option">
        <%= f.check_box :guardian_invites_locked %>
        <div>
          <%= f.label :guardian_invites_locked, "Lock guardian invites", class: "cs-option-label" %>
          <p class="cs-option-description">Hold off sending guardian invitations while waiver details are being finalised</p>
        </div>
      </div>
    </div>
    <%= cs_settings_save f %>
  </section>
  <% end %>

  <%# DocuSeal %>
  <%= cs_settings_form current_event, url: admin_event_integrations_path(current_event), tab: "documents" do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">DocuSeal</h2>
        <p class="cs-container-description">Digital waiver and consent form signing</p>
      </div>
      <div class="cs-actions">
        <%= link_to "Need to use custom waivers?",
            "https://docs.hackclub.com/hack-club-playbook/events/attend/custom-waivers",
            target: "_blank", rel: "noopener",
            class: "cs-btn cs-btn-link" %>
        <%= link_to "Guided waiver setup",
            admin_event_setup_waivers_path(current_event, return_to: "integrations"),
            class: "cs-btn" %>
      </div>
    </div>
    <div class="cs-container-body cs-stack">
      <dl class="cs-kv cs-kv-2 cs-kv-divided">
        <div>
          <dt class="cs-kv-label">Waiver template</dt>
          <dd class="cs-kv-value cs-secondary cs-small">Standard participant waiver for minors (dual-signer: teen + guardian)</dd>
          <dd class="cs-kv-value mt-2">
            <% if current_event.docuseal_waiver_template_id.present? %>
              <%= cs_status(:success, "Configured") %>
            <% else %>
              <%= cs_status(:stopped, "Not configured") %>
            <% end %>
          </dd>
          <dd class="cs-kv-value mt-2 flex flex-wrap items-center gap-3">
            <% if current_event.docuseal_waiver_template_id.present? %>
              <span class="font-mono">ID: <%= current_event.docuseal_waiver_template_id %></span>
              <%= link_to "Configure mappings", admin_event_docuseal_template_mappings_path(current_event, "waiver"), class: "cs-link" %>
            <% else %>
              <%= link_to "Use default template",
                  admin_event_docuseal_template_use_default_path(current_event, "waiver"),
                  data: { turbo_method: :post },
                  class: "cs-btn cs-btn-primary" %>
            <% end %>
          </dd>
        </div>

        <% if current_event.freedom_waivers_enabled? %>
          <div>
            <dt class="cs-kv-label">Freedom waiver template</dt>
            <dd class="cs-kv-value cs-secondary cs-small">Independence waiver (single-signer: guardian only).</dd>
            <dd class="cs-kv-value mt-2">
              <% if current_event.docuseal_freedom_waiver_template_id.present? %>
                <%= cs_status(:success, "Configured") %>
              <% else %>
                <%= cs_status(:stopped, "Not configured") %>
              <% end %>
            </dd>
            <dd class="cs-kv-value mt-2 flex flex-wrap items-center gap-3">
              <% if current_event.docuseal_freedom_waiver_template_id.present? %>
                <span class="font-mono">ID: <%= current_event.docuseal_freedom_waiver_template_id %></span>
                <%= link_to "Configure mappings", admin_event_docuseal_template_mappings_path(current_event, "freedom_waiver"), class: "cs-link" %>
              <% else %>
                <%= link_to "Use default template",
                    admin_event_docuseal_template_use_default_path(current_event, "freedom_waiver"),
                    data: { turbo_method: :post },
                    class: "cs-btn" %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <%# Manual template ID entry (advanced) %>
      <details class="cs-expandable">
        <summary>Advanced: enter template IDs manually</summary>
        <div class="cs-expandable-content">
          <div class="cs-field-grid">
            <% [ [ :docuseal_waiver_template_id, "Waiver template ID" ], [ :docuseal_freedom_waiver_template_id, "Freedom waiver template ID" ] ].each do |attribute, label| %>
              <%= cs_form_field f, attribute, label: label, optional: true,
                    messages: { invalid: "Enter a valid #{label[0].downcase}#{label[1..]}. Use numbers only." },
                    constraint: "The template ID from DocuSeal. Numbers only." do |aria| %>
                <%= f.text_field attribute, class: "cs-input font-mono", inputmode: "numeric", pattern: "[0-9]+",
                      data: { cs_pattern_message: "Enter a valid #{label[0].downcase}#{label[1..]}. Use numbers only." }, **aria %>
              <% end %>
            <% end %>
          </div>
        </div>
      </details>
    </div>
    <%= cs_settings_save f %>
  </section>
  <% end %>

  <%= cs_form_errors current_event %>

  <%# Custom documents (not part of the form) %>
  <% active_custom_documents = current_event.custom_documents.active.order(:created_at) %>
  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <div>
        <h2 class="cs-h2">Custom documents <span class="cs-counter">(<%= active_custom_documents.size %>)</span></h2>
        <p class="cs-container-description">Extra DocuSeal documents participants must sign, for example a hotel waiver</p>
      </div>
    </div>
    <% if active_custom_documents.any? %>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Document</th>
              <th scope="col">Details</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% active_custom_documents.each do |doc| %>
              <tr>
                <td>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-bold"><%= doc.name %></span>
                    <% if doc.physical? %>
                      <%= cs_badge("Physical", "yellow") %>
                    <% end %>
                    <% if doc.optional? %>
                      <%= cs_badge("Optional", "blue") %>
                    <% end %>
                    <%= cs_badge(doc.signer_type.humanize) %>
                  </div>
                </td>
                <td class="cs-small cs-secondary">
                  <% if doc.physical? %>
                    <span>Downloaded, physically signed, and uploaded as a photo</span>
                  <% else %>
                    <span class="font-mono">Template ID: <%= doc.docuseal_template_id %></span>
                    <% if doc.field_mapper.has_mappings? %>
                      · <%= cs_status(:success, "Pre-fill configured") %>
                    <% end %>
                  <% end %>
                  <% if doc.optional? %>
                    · <span>Hidden until a participant adds it — <%= pluralize(doc.consents.where(withdrawn_at: nil).count, "participant") %> so far</span>
                  <% end %>
                </td>
                <td>
                  <div class="flex items-center justify-end gap-1 whitespace-nowrap">
                    <% if doc.physical? %>
                      <% if doc.template_pdf.attached? %>
                        <%= link_to "Download PDF", rails_blob_path(doc.template_pdf, disposition: "attachment"), class: "cs-btn cs-btn-link" %>
                      <% end %>
                    <% else %>
                      <%= link_to "Configure mappings", admin_event_docuseal_template_mappings_path(current_event, doc.mapping_key), class: "cs-btn cs-btn-link" %>
                    <% end %>
                    <%= link_to "Edit", admin_event_custom_document_edit_path(current_event, doc), class: "cs-btn cs-btn-link" %>
                    <%= button_to "Remove", admin_event_custom_document_path(current_event, doc),
                        method: :delete,
                        data: { turbo_confirm: "Remove \"#{doc.name}\"? Participants will no longer be asked to sign it. Existing signatures are kept." },
                        class: "cs-btn cs-btn-link",
                        form: { class: "contents" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="cs-empty">
        <p class="cs-empty-title">No custom documents yet</p>
        <p>Add one below and participants will be asked to sign it during registration.</p>
      </div>
    <% end %>

    <div class="cs-container-footer">
      <%= form_with url: admin_event_custom_documents_path(current_event), scope: :custom_document, method: :post,
          multipart: true, html: { novalidate: true }, data: { controller: "document-kind cs-form-validation" }, class: "cs-stack py-2" do |cd| %>
        <h3 class="cs-h3">Add a document</h3>
        <fieldset>
          <legend class="sr-only">Document type</legend>
          <div class="cs-tiles sm:grid sm:grid-cols-2" role="radiogroup" aria-label="Document type">
            <label class="cs-tile">
              <span class="cs-option">
                <%= cd.radio_button :document_kind, "electronic", checked: true,
                    data: { action: "document-kind#toggle" } %>
                <span>
                  <span class="cs-option-label font-bold block">Electronic</span>
                  <span class="cs-option-description block mt-1">Signed online through DocuSeal, with participant details pre-filled.</span>
                </span>
              </span>
            </label>
            <label class="cs-tile">
              <span class="cs-option">
                <%= cd.radio_button :document_kind, "physical",
                    data: { action: "document-kind#toggle" } %>
                <span>
                  <span class="cs-option-label font-bold block">Physical</span>
                  <span class="cs-option-description block mt-1">Downloaded as a PDF, signed on paper, and uploaded as a photo.</span>
                </span>
              </span>
            </label>
          </div>
        </fieldset>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <%= cs_form_field cd, :name, label: "Document name", constraint: "For example: Hotel waiver" do |aria| %>
            <%= cd.text_field :name, required: true, class: "cs-input", **aria %>
          <% end %>
          <%= cs_form_field cd, :docuseal_template_id, label: "DocuSeal template ID", data: { document_kind_target: "electronic" },
                constraint: "Numbers only. For example: 1234" do |aria| %>
            <%= cd.text_field :docuseal_template_id, required: true, class: "cs-input font-mono", inputmode: "numeric", pattern: "[0-9]+",
                  data: { cs_pattern_message: "Enter a valid DocuSeal template ID. Use numbers only." }, **aria %>
          <% end %>
          <%= cs_form_field cd, :template_pdf, label: "PDF document", class: "hidden", data: { document_kind_target: "physical" },
                constraint: "PDF, up to 25 MB." do |aria| %>
            <%= cd.file_field :template_pdf, required: true, accept: "application/pdf", class: "cs-file", **aria %>
          <% end %>
          <%= cs_form_field cd, :signer_type, label: "Who signs?",
                constraint: "Guardian roles only apply to under-18s. Adults sign by themselves, and guardian-only or under-18s-only documents are skipped for them." do |aria| %>
            <%= cd.select :signer_type,
                [ [ "Participant", "participant" ], [ "Guardian", "guardian" ],
                  [ "Participant + Guardian", "participant_and_guardian" ],
                  [ "Participant + Guardian, under-18s only", "minor_and_guardian" ] ],
                {},
                class: "cs-select", **aria %>
          <% end %>
        </div>
        <label class="cs-tile">
          <span class="cs-option">
            <%= cd.check_box :optional %>
            <span>
              <span class="cs-option-label font-bold block">Optional — participants choose whether to add it</span>
              <span class="cs-option-description block mt-1">
                For opt-in activities like zip lining or a hike. The document stays hidden — including from
                parents/guardians — until the participant adds it themselves, so nobody is handed a waiver for
                something their child isn't doing. Once added it must be signed like any other document, and
                the participant can remove it again if they change their mind.
              </span>
            </span>
          </span>
        </label>
        <%= cs_form_field cd, :description, label: "Description", optional: true,
              constraint: "Shown to participants. Say which activity it's for, or which sections to fill in." do |aria| %>
          <%= cd.text_area :description, rows: 2, class: "cs-input", **aria %>
        <% end %>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
          <%= cd.button "Add document", type: :submit, class: "cs-btn shrink-0" %>
          <p class="cs-small cs-muted">
            Participants can't complete registration until it's signed — optional ones only once they've added it.
            <span data-document-kind-target="electronic">After adding, use <strong>Configure mappings</strong> to set up pre-fill.</span>
            <span data-document-kind-target="physical" class="hidden">Participants download the PDF, sign it on paper, and
            upload a photo of the signed form. For under-18s, the parent/guardian then reviews the photo and confirms it's
            complete.</span>
          </p>
        </div>
      <% end %>
    </div>
  </section>
</div>

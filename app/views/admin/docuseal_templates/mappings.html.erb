<% content_for :title, "#{@display_name} Mappings – #{current_event.name} – Attend" %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <%= link_to admin_event_integrations_path(current_event), class: "text-gray-400 hover:text-gray-600" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900"><%= @display_name %> Field Mappings</h1>
      </div>
      <p class="text-sm text-gray-500">
        Map DocuSeal form fields to Attend data for auto-fill
      </p>
    </div>
  </div>

  <% if @template_id.blank? %>
    <!-- No Template Configured -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center">
      <svg class="w-12 h-12 text-yellow-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <h3 class="text-lg font-medium text-yellow-800 mb-2">No Template Configured</h3>
      <p class="text-yellow-700 mb-4">You need to use the default template first before configuring field mappings.</p>
      <%= link_to "Back to integrations →",
          admin_event_integrations_path(current_event),
          class: "inline-flex items-center px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white font-medium rounded-lg transition-colors" %>
    </div>
  <% elsif @template_snapshot.blank? %>
    <!-- Template Not Synced -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 text-center">
      <svg class="w-12 h-12 text-[#ec3750] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
      <h3 class="text-lg font-medium text-blue-800 mb-2">Sync Template Fields</h3>
      <p class="text-blue-700 mb-4">Template #<%= @template_id %> is configured. Sync fields from DocuSeal to configure mappings.</p>
      <%= button_to "Sync Fields from DocuSeal", 
          admin_event_docuseal_template_sync_path(current_event, @template_type),
          method: :post,
          class: "inline-flex items-center px-4 py-2 bg-[#ec3750] hover:bg-[#d42f46] text-white font-medium rounded-lg transition-colors" %>
    </div>
  <% else %>
    <!-- Template Info -->
    <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-sm text-gray-500">Template ID:</span>
          <span class="font-mono text-sm ml-2"><%= @template_id %></span>
        </div>
        <div class="flex items-center gap-4">
          <div class="text-sm text-gray-500">
            Last synced: <%= Time.parse(@template_snapshot["synced_at"]).strftime("%b %d, %Y %H:%M") rescue "Unknown" %>
          </div>
          <%= button_to "Re-sync Fields", 
              admin_event_docuseal_template_sync_path(current_event, @template_type),
              method: :post,
              class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
        </div>
      </div>
    </div>

    <%= form_with url: admin_event_docuseal_template_mappings_path(current_event, @template_type), method: :patch, local: true, class: "space-y-6" do |f| %>
      
      <% if @template_type == "freedom_waiver" %>
        <!-- Freedom Waiver Checkbox Config -->
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
          <h3 class="font-medium text-amber-800 mb-3">Freedom Waiver Checkbox Configuration</h3>
          <p class="text-sm text-amber-700 mb-4">
            Select which checkbox fields represent "granted" and "rejected" for the freedom waiver.
            When the guardian signs, these values will be used to set the freedom waiver status.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-amber-800 mb-1">Granted Checkbox Field</label>
              <select name="freedom_granted_field" class="block w-full rounded-md border-amber-300  focus:border-amber-500 focus:ring-amber-500 text-sm">
                <option value="">-- Select Field --</option>
                <% (@template_snapshot["fields"] || []).reject { |f| f["readonly"] }.each do |field| %>
                  <option value="<%= field["name"] %>" <%= "selected" if @freedom_checkbox_config["granted_field"] == field["name"] %>>
                    <%= field["name"] %>
                  </option>
                <% end %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-amber-800 mb-1">Rejected Checkbox Field</label>
              <select name="freedom_rejected_field" class="block w-full rounded-md border-amber-300  focus:border-amber-500 focus:ring-amber-500 text-sm">
                <option value="">-- Select Field --</option>
                <% (@template_snapshot["fields"] || []).reject { |f| f["readonly"] }.each do |field| %>
                  <option value="<%= field["name"] %>" <%= "selected" if @freedom_checkbox_config["rejected_field"] == field["name"] %>>
                    <%= field["name"] %>
                  </option>
                <% end %>
              </select>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Field Mappings -->
      <div class="bg-white border border-gray-200 rounded-lg ">
        <div class="p-4 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">Field Mappings</h2>
          <p class="text-sm text-gray-500">Map template fields to Attend data sources for auto-fill. Leave unmapped fields blank.</p>
        </div>
        
        <div class="divide-y divide-gray-100">
          <% submitters = @template_snapshot["submitters"] || [] %>
          <% fields = (@template_snapshot["fields"] || []).reject { |f| f["readonly"] } %>

          <% if fields.empty? %>
            <div class="p-8 text-center text-gray-500">
              No fields found in this template. Add fields in the builder first.
            </div>
          <% else %>
            <% fields.each_with_index do |field, index| %>
              <% 
                field_name = field["name"]
                existing_mapping = @current_mappings.find { |m| m["field_name"] == field_name }
                field_role = field["submitter_uuid"] ? submitters.find { |s| s["uuid"] == field["submitter_uuid"] }&.dig("name") : nil
              %>
              <div class="p-4 hover:bg-gray-50">
                <div class="flex items-center gap-4">
                  <!-- Field Name -->
                  <div class="flex-1">
                    <div class="font-medium text-gray-900"><%= field_name %></div>
                    <div class="text-xs text-gray-500">
                      <%= field["type"]&.capitalize || "Text" %>
                      <% if field_role %>
                        · <%= field_role %>
                      <% end %>
                    </div>
                    <input type="hidden" name="mappings[][field_name]" value="<%= field_name %>">
                    <input type="hidden" name="mappings[][role]" value="<%= field_role %>">
                  </div>
                  
                  <!-- Arrow -->
                  <div class="text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </div>
                  
                  <!-- Data Source -->
                  <div class="flex-1">
                    <select name="mappings[][source_key]" class="block w-full rounded-md border-gray-300  focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                      <option value="">-- Not Mapped --</option>
                      <optgroup label="Participant">
                        <% @data_sources.select { |k, _| k.start_with?("participant.") }.each do |key, label| %>
                          <option value="<%= key %>" <%= "selected" if existing_mapping&.dig("source_key") == key %>>
                            <%= label %>
                          </option>
                        <% end %>
                      </optgroup>
                      <optgroup label="Guardian">
                        <% @data_sources.select { |k, _| k.start_with?("guardian.") }.each do |key, label| %>
                          <option value="<%= key %>" <%= "selected" if existing_mapping&.dig("source_key") == key %>>
                            <%= label %>
                          </option>
                        <% end %>
                      </optgroup>
                      <optgroup label="Emergency Contact">
                        <% @data_sources.select { |k, _| k.start_with?("emergency_contact.") }.each do |key, label| %>
                          <option value="<%= key %>" <%= "selected" if existing_mapping&.dig("source_key") == key %>>
                            <%= label %>
                          </option>
                        <% end %>
                      </optgroup>
                      <optgroup label="Event">
                        <% @data_sources.select { |k, _| k.start_with?("event.") }.each do |key, label| %>
                          <option value="<%= key %>" <%= "selected" if existing_mapping&.dig("source_key") == key %>>
                            <%= label %>
                          </option>
                        <% end %>
                      </optgroup>
                    </select>
                  </div>
                  
                  <!-- Readonly Toggle -->
                  <div class="flex items-center gap-2">
                    <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
                      <input type="checkbox" 
                             name="mappings[][readonly]" 
                             value="1"
                             <%= "checked" if existing_mapping&.dig("readonly") %>
                             class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                      <span>Read-only</span>
                    </label>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Save Button -->
      <div class="flex justify-end gap-3">
        <%= link_to "Cancel", admin_event_integrations_path(current_event), 
            class: "px-4 py-2 text-gray-700 hover:text-gray-900 font-medium" %>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
          Save Mappings
        </button>
      </div>
    <% end %>
  <% end %>
</div>

<% content_for :title, "Incident Report – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs([ "Incident reports", admin_incidents_path ], [ truncate(@incident_report.summary.presence || "Incident report", length: 60), nil ]) %>

<div class="cs-stack max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1"><%= @incident_report.summary %></h1>
      <p class="cs-description flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>Filed <%= cs_absolute_time_tag(@incident_report.created_at) %></span>
        <%= incident_status(@incident_report.status) %>
        <%= incident_report_priority_badge(@incident_report.priority) %>
      </p>
    </div>
  </div>

  <% if @incident_report.emergency? && @incident_report.acknowledger_names.any? %>
    <div class="cs-alert cs-alert-success">
      <%= cs_status_icon(:success) %>
      <p>Acknowledged by <strong><%= @incident_report.acknowledger_names.to_sentence %></strong>.</p>
    </div>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Report details</h2>
    </div>
    <div class="cs-container-body cs-stack">
      <dl class="cs-kv cs-kv-2">
        <% fields = [
             ["Incident type", @incident_report.incident_type_label],
             ["Event", @incident_report.event_name],
             ["Reporter", @incident_report.reporter_name],
             ["Describes themselves as", @incident_report.role_label],
             ["Email", @incident_report.reporter_email],
             ["Phone", @incident_report.reporter_phone],
             ["Hack Club account", @incident_report.user&.email || "Not signed in"]
           ]
           fields << ["Emergency services called?", @incident_report.emergency_services_called? ? "Yes" : "No"] if @incident_report.medical_emergency?
           fields.each do |label, value| %>
          <div>
            <dt class="cs-kv-label"><%= label %></dt>
            <dd class="cs-kv-value"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
      </dl>

      <dl class="cs-kv">
        <div>
          <dt class="cs-kv-label">Details</dt>
          <dd class="cs-kv-value whitespace-pre-wrap"><%= @incident_report.details %></dd>
        </div>
        <% if @incident_report.attachments.attached? %>
          <div>
            <dt class="cs-kv-label">Attachments</dt>
            <dd class="cs-kv-value">
              <ul class="space-y-1">
                <% @incident_report.attachments.each do |attachment| %>
                  <li>
                    <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "cs-link" do %>
                      <%= attachment.filename %>
                    <% end %>
                    <span class="cs-small cs-muted">(<%= number_to_human_size(attachment.byte_size) %>)</span>
                  </li>
                <% end %>
              </ul>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Add comment</h2>
    </div>
    <div class="cs-container-body">
      <%= form_with model: @comment || IncidentReportComment.new, url: admin_incident_comments_path(@incident_report),
            html: { multipart: true, novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
        <%= cs_form_field f, :body, label: "Comment", description: "A comment or note about this report." do |aria| %>
          <%= f.text_area :body, rows: 3, class: "cs-input", required: true, **aria %>
        <% end %>
        <%= cs_form_field f, :attachments, label: "Attachments", optional: true,
              constraint: "Up to #{IncidentReportComment::MAX_ATTACHMENT_COUNT} files, 25 MB each." do |aria| %>
          <%= f.file_field :attachments, multiple: true, class: "cs-file", **aria %>
        <% end %>
        <% if @incident_report.reporter_phone.present? %>
          <label class="cs-option mt-4 cursor-pointer">
            <%= check_box_tag :share_with_reporter, "1", false %>
            <span>
              <span class="cs-option-label block">Share this update with the reporter</span>
              <span class="cs-option-description block">Texts the comment to <%= @incident_report.reporter_phone %>.</span>
            </span>
          </label>
        <% end %>
        <%= cs_form_errors f %>
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mt-4">
          <%= cs_form_field f, :new_status, label: "Change status to", optional: true do |aria| %>
            <%= f.select :new_status,
                [ [ "No change", "" ] ] + IncidentReport.statuses.keys.map { |s| [ s.humanize, s ] },
                {},
                class: "cs-select", **aria %>
          <% end %>
          <%= f.button "Add comment", class: "cs-btn cs-btn-primary cs-btn-full" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Timeline</h2>
    </div>
    <div class="cs-container-body">
      <%
        timeline_items = []
        comments_with_status_change = @incident_report.comments.includes(:user).select { |c| c.new_status.present? }
        status_change_times = comments_with_status_change.map { |c| c.created_at.to_i }

        @incident_report.versions.each do |v|
          next if v.event == "update" && status_change_times.include?(v.created_at.to_i)
          timeline_items << { type: :version, item: v, time: v.created_at }
        end
        @incident_report.comments.includes(:user).each do |c|
          timeline_items << { type: :comment, item: c, time: c.created_at }
        end
        timeline_items.sort_by! { |t| t[:time] }
      %>
      <% if timeline_items.empty? %>
        <p class="cs-muted">No activity yet.</p>
      <% else %>
        <ol class="cs-steps">
          <% timeline_items.each do |entry| %>
            <% if entry[:type] == :comment && entry[:item].source == "phone" %>
              <% comment = entry[:item] %>
              <li>
                <%= incident_step_icon(:info) %>
                <div>
                  <p class="cs-step-title"><%= comment.body %></p>
                  <p class="cs-step-detail"><%= cs_absolute_time_tag(entry[:time]) %></p>
                </div>
              </li>
            <% elsif entry[:type] == :comment %>
              <% comment = entry[:item] %>
              <li>
                <%= incident_comment_step_icon(comment.new_status) %>
                <div>
                  <p class="cs-step-title">
                    <strong><%= comment.user&.display_name_or_fallback || "System" %></strong>
                    commented
                    <% if comment.new_status.present? %>
                      and changed status to <strong><%= comment.new_status.humanize %></strong>
                    <% end %>
                  </p>
                  <p class="cs-step-detail"><%= cs_absolute_time_tag(entry[:time]) %></p>
                  <div class="mt-2 text-sm rounded-(--cs-radius-item) bg-(--cs-bg-shaded) p-3">
                    <%= simple_format(comment.body) %>
                  </div>
                  <% if comment.attachments.attached? %>
                    <ul class="mt-2 space-y-1 text-sm">
                      <% comment.attachments.each do |attachment| %>
                        <li>
                          <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "cs-link" do %>
                            <%= attachment.filename %>
                          <% end %>
                          <span class="cs-small cs-muted">(<%= number_to_human_size(attachment.byte_size) %>)</span>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                </div>
              </li>
            <% else %>
              <% version = entry[:item] %>
              <% timeline_user = User.find_by(id: version.whodunnit) %>
              <li>
                <%= incident_step_icon(version.event == "create" ? :success : :pending) %>
                <div>
                  <p class="cs-step-title">
                    <strong><%= timeline_user&.display_name_or_fallback || "System" %></strong>
                    <%= version.event == "create" ? "created" : "updated" %> the report
                  </p>
                  <p class="cs-step-detail"><%= cs_absolute_time_tag(entry[:time]) %></p>
                </div>
              </li>
            <% end %>
          <% end %>
        </ol>
      <% end %>
    </div>
  </section>
</div>

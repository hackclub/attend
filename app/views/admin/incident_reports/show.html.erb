<% content_for :title, "Incident Report – Attend" %>

<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-4">
    <%= link_to "← Back to all reports", admin_incidents_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="flex items-start justify-between gap-4 mb-1">
    <h1 class="text-2xl font-bold"><%= @incident_report.summary %></h1>
    <% pc = { "emergency" => "bg-red-100 text-red-800", "elevated" => "bg-amber-100 text-amber-800", "standard" => "bg-gray-100 text-gray-700" }[@incident_report.priority] %>
    <span class="shrink-0 px-3 py-1 rounded-full text-sm font-medium <%= pc %>"><%= @incident_report.priority_label&.split(" – ")&.first %></span>
  </div>
  <% sc = { "open" => "bg-blue-100 text-blue-800", "in_review" => "bg-amber-100 text-amber-800", "resolved" => "bg-green-100 text-green-800" }[@incident_report.status] %>
  <p class="text-sm text-gray-500 mb-4">
    Filed <%= @incident_report.created_at.strftime("%B %-d, %Y at %H:%M %Z") %> ·
    <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= sc %>"><%= @incident_report.status.humanize %></span>
  </p>

  <% if @incident_report.emergency? && @incident_report.acknowledger_names.any? %>
    <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-3 mb-6 text-sm text-green-900">
      Acknowledged by <span class="font-medium"><%= @incident_report.acknowledger_names.to_sentence %></span>.
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100">
    <dl class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <% fields = [
           ["Incident type", @incident_report.incident_type_label],
           ["Event", @incident_report.event_name],
           ["Reporter", @incident_report.reporter_name],
           ["Describes themselves as", @incident_report.role_label],
           ["Email", @incident_report.reporter_email],
           ["Phone", @incident_report.reporter_phone],
           ["Hack Club account", @incident_report.user&.email || "Not signed in"]
         ]
         fields << ["Emergency services called?", @incident_report.emergency_services_called? ? "Yes" : "No"] if @incident_report.medical_emergency?
         fields.each do |label, value| %>
        <div>
          <dt class="text-gray-500"><%= label %></dt>
          <dd class="font-medium text-gray-900 break-words"><%= value.presence || "—" %></dd>
        </div>
      <% end %>
    </dl>

    <div class="p-6">
      <h2 class="text-sm font-medium text-gray-500 mb-2">Details</h2>
      <p class="text-gray-900 whitespace-pre-wrap"><%= @incident_report.details %></p>
    </div>

    <% if @incident_report.attachments.attached? %>
      <div class="p-6">
        <h2 class="text-sm font-medium text-gray-500 mb-2">Attachments</h2>
        <ul class="space-y-1">
          <% @incident_report.attachments.each do |attachment| %>
            <li>
              <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "text-[#ec3750] hover:text-[#d42f46]" do %>
                <%= attachment.filename %>
                <span class="text-gray-400 text-xs">(<%= number_to_human_size(attachment.byte_size) %>)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-semibold mb-4">Add Comment</h2>
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <%= form_with model: IncidentReportComment.new, url: admin_incident_comments_path(@incident_report), html: { multipart: true }, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :body, "Comment", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :body, rows: 3, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]", placeholder: "Add a comment or note about this report..." %>
        </div>
        <div>
          <%= f.label :attachments, "Attachments", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.file_field :attachments, multiple: true, class: "block w-full text-sm text-gray-700 file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" %>
          <p class="mt-1 text-xs text-gray-400">Up to <%= IncidentReportComment::MAX_ATTACHMENT_COUNT %> files, 25MB each.</p>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="flex items-center gap-3">
            <%= f.label :new_status, "Change status to:", class: "text-sm font-medium text-gray-700" %>
            <%= f.select :new_status,
                [ [ "No change", "" ] ] + IncidentReport.statuses.keys.map { |s| [ s.humanize.titleize, s ] },
                {},
                class: "border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#ec3750]" %>
          </div>
          <%= f.submit "Add Comment", class: "bg-[#ec3750] text-white px-4 py-2 rounded-md hover:bg-[#d42f46] cursor-pointer" %>
        </div>
        <% if @incident_report.reporter_phone.present? %>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= check_box_tag :share_with_reporter, "1", false, class: "rounded border-gray-300 text-[#ec3750] focus:ring-[#ec3750]" %>
            Share this update with the reporter? <span class="text-gray-400">(texts the comment to <%= @incident_report.reporter_phone %>)</span>
          </label>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-semibold mb-4">Timeline</h2>
    <div class="bg-white border border-gray-200 rounded-lg p-6">
      <div class="flow-root">
        <%
          timeline_items = []
          comments_with_status_change = @incident_report.comments.includes(:user).select { |c| c.new_status.present? }
          status_change_times = comments_with_status_change.map { |c| c.created_at.to_i }

          @incident_report.versions.each do |v|
            next if v.event == "update" && status_change_times.include?(v.created_at.to_i)
            timeline_items << { type: :version, item: v, time: v.created_at }
          end
          @incident_report.comments.includes(:user).each do |c|
            timeline_items << { type: :comment, item: c, time: c.created_at }
          end
          timeline_items.sort_by! { |t| t[:time] }
        %>
        <% if timeline_items.empty? %>
          <p class="text-sm text-gray-500">No activity yet.</p>
        <% else %>
          <ul class="-mb-8">
            <% timeline_items.each_with_index do |entry, index| %>
              <li>
                <div class="relative pb-8">
                  <% unless index == timeline_items.length - 1 %>
                    <span class="absolute left-4 top-4 -ml-px h-full w-0.5 bg-gray-200"></span>
                  <% end %>
                  <div class="relative flex space-x-3">
                    <% timeline_user = entry[:type] == :comment ? entry[:item].user : User.find_by(id: entry[:item].whodunnit) %>
                    <% is_phone_comment = entry[:type] == :comment && entry[:item].source == "phone" %>
                    <div>
                      <% if is_phone_comment %>
                        <span class="h-8 w-8 rounded-full bg-green-500 flex items-center justify-center ring-8 ring-white text-base">📞</span>
                      <% elsif timeline_user&.avatar_displayable? %>
                        <%= image_tag timeline_user.avatar.variant(resize_to_fill: [ 32, 32 ]), class: "h-8 w-8 rounded-full object-cover ring-8 ring-white" %>
                      <% elsif entry[:type] == :comment %>
                        <span class="h-8 w-8 rounded-full bg-[#ec3750] flex items-center justify-center ring-8 ring-white text-xs font-medium text-white">
                          <%= timeline_user&.initials || "?" %>
                        </span>
                      <% else %>
                        <span class="h-8 w-8 rounded-full bg-gray-400 flex items-center justify-center ring-8 ring-white text-xs font-medium text-white">
                          <%= timeline_user&.initials || "S" %>
                        </span>
                      <% end %>
                    </div>
                    <div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
                      <div class="flex-1">
                        <% if is_phone_comment %>
                          <% comment = entry[:item] %>
                          <p class="text-sm text-gray-700"><%= comment.body %></p>
                        <% elsif entry[:type] == :comment %>
                          <% comment = entry[:item] %>
                          <p class="text-sm text-gray-500">
                            <span class="font-medium text-gray-900"><%= comment.user&.display_name_or_fallback || "System" %></span>
                            commented
                            <% if comment.new_status.present? %>
                              and changed status to <span class="font-medium"><%= comment.new_status.humanize.titleize %></span>
                            <% end %>
                          </p>
                          <div class="mt-2 text-sm text-gray-700 bg-gray-50 rounded-md p-3">
                            <%= simple_format(comment.body) %>
                          </div>
                          <% if comment.attachments.attached? %>
                            <ul class="mt-2 space-y-1">
                              <% comment.attachments.each do |attachment| %>
                                <li>
                                  <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "text-sm text-[#ec3750] hover:text-[#d42f46]" do %>
                                    📎 <%= attachment.filename %>
                                    <span class="text-gray-400 text-xs">(<%= number_to_human_size(attachment.byte_size) %>)</span>
                                  <% end %>
                                </li>
                              <% end %>
                            </ul>
                          <% end %>
                        <% else %>
                          <% version = entry[:item] %>
                          <p class="text-sm text-gray-500">
                            <span class="font-medium text-gray-900"><%= timeline_user&.display_name_or_fallback || "System" %></span>
                            <%= version.event == "create" ? "created" : "updated" %> the report
                          </p>
                        <% end %>
                      </div>
                      <div class="whitespace-nowrap text-right text-sm text-gray-500">
                        <%= entry[:time].strftime("%b %d, %Y %H:%M") %>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</div>

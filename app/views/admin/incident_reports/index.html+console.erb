<% content_for :title, "HQ Incident Inbox – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs([ "Incidents", nil ]) %>
<% show_reports = @view != "logs" %>
<% show_logs = @view != "reports" %>
<% filters = { view: params[:view].presence, priority: params[:priority].presence, event_id: params[:event_id].presence, resolved: (@show_resolved ? "1" : nil) }.compact %>
<% segment = ->(label, path, active) { link_to label, path, class: "cs-segment", "aria-current": (active ? "page" : nil) } %>
<% hidden_count = (show_reports ? @hidden_resolved_count : 0) + (show_logs ? @hidden_closed_count : 0) %>

<div class="cs-stack">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Incidents</h1>
      <p class="cs-description">
        Reports to HQ come from the public form at <code class="font-mono">/incident</code> and from organizers escalating an event incident.
        Event incident logs are what organizers record for their own team.
      </p>
      <%= render "shared/incident_level_legend" %>
    </div>
    <div class="cs-actions">
      <%= link_to "Notification settings", admin_incident_report_settings_path, class: "cs-btn" %>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="cs-segmented" role="group" aria-label="What to show">
      <%= segment.("Everything", admin_incident_reports_path(filters.except(:view)), @view == "all") %>
      <%= segment.("Reports to HQ", admin_incident_reports_path(filters.merge(view: "reports")), @view == "reports") %>
      <%= segment.("Event incident logs", admin_incident_reports_path(filters.merge(view: "logs")), @view == "logs") %>
    </div>
    <%= form_with url: admin_incident_reports_path, method: :get, local: true, data: { controller: "auto-submit" } do %>
      <% filters.except(:resolved).each { |key, value| %><%= hidden_field_tag key, value %><% } %>
      <label class="cs-option mt-0! cursor-pointer">
        <%= check_box_tag :resolved, "1", @show_resolved, class: "cs-toggle", data: { action: "change->auto-submit#submit" } %>
        <span class="cs-option-label">Show resolved<% if hidden_count.positive? %> <span class="cs-counter">(<%= hidden_count %> hidden)</span><% end %></span>
      </label>
      <noscript><button type="submit" class="cs-btn">Apply</button></noscript>
    <% end %>
  </div>

  <% if show_reports %>
    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided">
        <h2 class="cs-h2">Reports to HQ <span class="cs-counter">(<%= @incident_reports.size %>)</span></h2>
        <div class="cs-segmented" role="group" aria-label="Filter by level">
          <%= segment.("All levels", admin_incident_reports_path(filters.except(:priority)), params[:priority].blank?) %>
          <% IncidentLevel::LEVELS.each do |level| %>
            <%= segment.(level.code, admin_incident_reports_path(filters.merge(priority: level.key)), params[:priority] == level.key) %>
          <% end %>
        </div>
      </div>
      <% if @incident_reports.any? %>
        <% IncidentReport.statuses.keys.each do |status| %>
          <% reports = @reports_by_status[status] || [] %>
          <% next if reports.empty? %>
          <div class="cs-container-header cs-container-header-divided">
            <h3 class="cs-h3"><%= status.humanize %> <span class="cs-counter">(<%= reports.size %>)</span></h3>
          </div>
          <div class="cs-table-wrap">
            <table class="cs-table">
              <thead>
                <tr>
                  <th scope="col">Filed</th>
                  <th scope="col">Level</th>
                  <th scope="col">Summary</th>
                  <th scope="col">Event</th>
                  <th scope="col">Reporter</th>
                  <th scope="col">Source</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% reports.each do |report| %>
                  <tr>
                    <td class="whitespace-nowrap"><%= cs_absolute_time_tag(report.created_at) %></td>
                    <td class="whitespace-nowrap"><%= incident_level_badge(report.priority) %></td>
                    <td class="max-w-xs">
                      <span class="block truncate" title="<%= report.summary %>"><%= report.summary %></span>
                      <span class="block cs-small cs-muted"><%= report.incident_type_label %></span>
                    </td>
                    <td class="whitespace-nowrap"><%= report.event_name || "—" %></td>
                    <td class="whitespace-nowrap">
                      <%= report.reporter_name %>
                      <span class="block cs-small cs-muted"><%= report.role_label %></span>
                    </td>
                    <td class="whitespace-nowrap">
                      <% if report.incident %>
                        <%= link_to "Escalated from event log", admin_event_incident_path(report.incident.event, report.incident), class: "cs-link" %>
                      <% else %>
                        <span class="cs-muted">Public form</span>
                      <% end %>
                    </td>
                    <td class="whitespace-nowrap text-right">
                      <%= link_to "View", admin_incident_report_path(report), class: "cs-link" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <% if @reports_truncated %>
          <p class="cs-container-body cs-small cs-muted">Showing the newest <%= Admin::IncidentReportsController::LIMIT %> reports. Filter by level to narrow it down.</p>
        <% end %>
      <% else %>
        <div class="cs-container-body">
          <div class="cs-empty">
            <p class="cs-empty-title">No reports to HQ</p>
            <p>No <%= "unresolved " unless @show_resolved %>reports<%= " match this filter" if params[:priority].present? %>.<% if @hidden_resolved_count.positive? %> <%= link_to "Show #{pluralize(@hidden_resolved_count, 'resolved report')}", admin_incident_reports_path(filters.merge(resolved: "1")), class: "cs-link" %>.<% end %></p>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if show_logs %>
    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided">
        <h2 class="cs-h2">Event incident logs <span class="cs-counter">(<%= @incidents.size %>)</span></h2>
      </div>
      <%= form_with url: admin_incident_reports_path, method: :get, local: true, class: "cs-filter-bar", data: { controller: "auto-submit" } do %>
        <% filters.except(:event_id).each { |key, value| %><%= hidden_field_tag key, value %><% } %>
        <%= select_tag :event_id, options_from_collection_for_select(@log_events, :id, :name, params[:event_id]), include_blank: "All events",
              class: "cs-select w-full sm:max-w-xs", "aria-label": "Filter by event", data: { action: "change->auto-submit#submit" } %>
        <noscript><button type="submit" class="cs-btn">Apply</button></noscript>
      <% end %>
      <% if @incidents.any? %>
        <div class="cs-table-wrap">
          <table class="cs-table">
            <thead>
              <tr>
                <th scope="col">Incident time</th>
                <th scope="col">Event</th>
                <th scope="col">Summary</th>
                <th scope="col">Level</th>
                <th scope="col">Status</th>
                <th scope="col">Reported by</th>
                <th scope="col">HQ</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% @incidents.each do |incident| %>
                <tr>
                  <td class="whitespace-nowrap"><%= cs_absolute_time_tag(incident.occurred_at || incident.created_at) %></td>
                  <td class="whitespace-nowrap"><%= incident.event.name %></td>
                  <td class="max-w-xs">
                    <span class="block truncate" title="<%= incident.summary %>"><%= incident.summary.presence || "No summary" %></span>
                    <span class="block mt-0.5"><%= render_category_badge(incident.category) %></span>
                  </td>
                  <td><%= incident_level_badge(incident.severity) %></td>
                  <td><%= incident_status(incident.status) %></td>
                  <td class="whitespace-nowrap"><%= incident.reported_by.display_name_or_fallback %></td>
                  <td class="whitespace-nowrap">
                    <% if incident.escalated? %>
                      <%= link_to admin_incident_report_path(incident.hq_report), class: "cs-link" do %><%= incident_status(incident.hq_report.status) %><% end %>
                    <% else %>
                      <span class="cs-muted">—</span>
                    <% end %>
                  </td>
                  <td class="text-right">
                    <%= link_to "View", admin_event_incident_path(incident.event, incident), class: "cs-link" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @incidents_truncated %>
          <p class="cs-container-body cs-small cs-muted">Showing the newest <%= Admin::IncidentReportsController::LIMIT %> incidents. Filter by event to narrow it down.</p>
        <% end %>
      <% else %>
        <div class="cs-container-body">
          <div class="cs-empty">
            <p class="cs-empty-title">No event incidents</p>
            <p>No <%= "open " unless @show_resolved %>incidents<%= " match this filter" if params[:event_id].present? %>.<% if @hidden_closed_count.positive? %> <%= link_to "Show #{pluralize(@hidden_closed_count, 'closed incident')}", admin_incident_reports_path(filters.merge(resolved: "1")), class: "cs-link" %>.<% end %></p>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<% content_for :title, "HQ Incident Inbox – Attend" %>

<% status_styles = { "open" => "bg-blue-100 text-blue-800", "in_review" => "bg-amber-100 text-amber-800", "resolved" => "bg-green-100 text-green-800", "closed" => "bg-gray-100 text-gray-800" } %>
<% pill = ->(label, active) { "px-3 py-1.5 rounded-md border #{active ? 'bg-[#d42f46] text-white border-[#ec3750]' : 'bg-white text-gray-700 border-gray-300 hover:border-gray-400'}" } %>
<% show_reports = @view != "logs" %>
<% show_logs = @view != "reports" %>

<div class="max-w-6xl mx-auto px-4 py-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-2">
    <h1 class="text-3xl font-bold">HQ incident inbox</h1>
    <%= link_to "Notification settings →", admin_incident_report_settings_path, class: "text-sm font-medium text-[#ec3750] hover:text-[#d42f46]" %>
  </div>
  <p class="text-gray-600 text-sm mb-6">
    Reports to HQ come from the public form at <code class="bg-gray-100 px-1 py-0.5 rounded">/incident</code> and from organizers escalating an event incident.
    Event incident logs are what organizers record for their own team. Global admins only.
  </p>
  <%= render "shared/incident_level_legend" %>

  <div class="flex flex-wrap gap-2 mb-6 text-sm">
    <%= link_to "Everything", admin_incident_reports_path, class: pill.("", @view == "all") %>
    <%= link_to "Reports to HQ", admin_incident_reports_path(view: "reports"), class: pill.("", @view == "reports") %>
    <%= link_to "Event incident logs", admin_incident_reports_path(view: "logs"), class: pill.("", @view == "logs") %>
  </div>

  <% if show_reports %>
    <div class="flex flex-wrap items-center gap-2 mb-4 text-sm">
      <h2 class="text-xl font-semibold text-gray-900 mr-2">Reports to HQ</h2>
      <%= link_to "All levels", admin_incident_reports_path(view: params[:view]), class: pill.("", params[:priority].blank?) %>
      <% IncidentLevel::LEVELS.each do |level| %>
        <%= link_to level.code, admin_incident_reports_path(view: params[:view], priority: level.key), class: pill.("", params[:priority] == level.key), title: level.short_label %>
      <% end %>
    </div>

    <% if @incident_reports.any? %>
      <% IncidentReport.statuses.keys.each do |status| %>
        <% reports = @reports_by_status[status] || [] %>
        <% next if reports.empty? %>
        <section class="mb-8">
          <div class="flex items-center gap-2 mb-3">
            <h3 class="text-lg font-semibold text-gray-900"><%= status.humanize %></h3>
            <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= status_styles[status] %>"><%= reports.size %></span>
          </div>
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-100">
                <thead class="bg-gray-50">
                  <tr>
                    <% [ "Date", "Level", "Summary", "Event", "Reporter", "Source", "" ].each do |h| %>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= h %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100 text-sm">
                  <% reports.each do |report| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-4 py-3 whitespace-nowrap text-gray-900"><%= report.created_at.strftime("%b %d, %Y %H:%M") %></td>
                      <td class="px-4 py-3 whitespace-nowrap"><%= incident_level_badge(report.priority) %></td>
                      <td class="px-4 py-3 text-gray-700 max-w-xs">
                        <span class="block truncate" title="<%= report.summary %>"><%= report.summary %></span>
                        <span class="block text-xs text-gray-400"><%= report.incident_type_label %></span>
                      </td>
                      <td class="px-4 py-3 whitespace-nowrap text-gray-700"><%= report.event_name || "—" %></td>
                      <td class="px-4 py-3 whitespace-nowrap text-gray-700">
                        <%= report.reporter_name %>
                        <span class="block text-xs text-gray-400"><%= report.role_label %></span>
                      </td>
                      <td class="px-4 py-3 whitespace-nowrap text-gray-700">
                        <% if report.incident %>
                          <%= link_to "Escalated from event log", admin_event_incident_path(report.incident.event, report.incident), class: "text-[#ec3750] hover:text-[#d42f46] text-xs font-medium" %>
                        <% else %>
                          <span class="text-xs text-gray-500">Public form</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3 whitespace-nowrap text-right">
                        <%= link_to "View", admin_incident_report_path(report), class: "text-[#ec3750] hover:text-[#d42f46] font-medium" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-10 text-center text-gray-500 mb-8">
        No reports to HQ<%= " match this filter" if params[:priority].present? %>.
      </div>
    <% end %>
  <% end %>

  <% if show_logs %>
    <div class="flex flex-wrap items-center gap-2 mb-4 text-sm">
      <h2 class="text-xl font-semibold text-gray-900 mr-2">Event incident logs</h2>
      <%= form_with url: admin_incident_reports_path, method: :get, local: true, class: "flex flex-wrap items-center gap-2", data: { controller: "auto-submit" } do %>
        <%= hidden_field_tag :view, params[:view] %>
        <%= select_tag :event_id, options_from_collection_for_select(@log_events, :id, :name, params[:event_id]), include_blank: "All events",
              class: "border border-gray-300 rounded-md px-2 py-1.5 bg-white text-sm", data: { action: "change->auto-submit#submit" } %>
        <label class="inline-flex items-center gap-1">
          <%= check_box_tag :open, "1", params[:open] == "1", class: "rounded border-gray-300 text-[#ec3750] focus:ring-[#ec3750]", data: { action: "change->auto-submit#submit" } %>
          <span>Open only</span>
        </label>
      <% end %>
    </div>

    <% if @incidents.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-8">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-100">
            <thead class="bg-gray-50">
              <tr>
                <% [ "Date", "Event", "Summary", "Level", "Status", "Reported by", "HQ", "" ].each do |h| %>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= h %></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100 text-sm">
              <% @incidents.each do |incident| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 whitespace-nowrap text-gray-900"><%= (incident.occurred_at || incident.created_at).strftime("%b %d, %Y %H:%M") %></td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-700"><%= incident.event.name %></td>
                  <td class="px-4 py-3 text-gray-700 max-w-xs">
                    <span class="block truncate" title="<%= incident.summary %>"><%= incident.summary.presence || "No summary" %></span>
                    <span class="block"><%= render_category_badge(incident.category) %></span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap"><%= render_severity_badge(incident.severity) %></td>
                  <td class="px-4 py-3 whitespace-nowrap"><%= render_status_badge(incident.status) %></td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-700"><%= incident.reported_by.display_name_or_fallback %></td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <% if incident.escalated? %>
                      <%= link_to "Escalated · #{incident.hq_report.status.humanize}", admin_incident_report_path(incident.hq_report), class: "px-2 py-0.5 rounded-full text-xs font-medium #{status_styles[incident.hq_report.status]}" %>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-right">
                    <%= link_to "View", admin_event_incident_path(incident.event, incident), class: "text-[#ec3750] hover:text-[#d42f46] font-medium" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-10 text-center text-gray-500">
        No event incidents<%= " match this filter" if params[:event_id].present? || params[:open] == "1" %>.
      </div>
    <% end %>
  <% end %>
</div>

<% content_for :title, "Incident Reports – Attend" %>

<% priority_badge = ->(p) {
     classes = { "emergency" => "bg-red-100 text-red-800", "elevated" => "bg-amber-100 text-amber-800", "standard" => "bg-gray-100 text-gray-700" }[p] || "bg-gray-100 text-gray-700"
     content_tag(:span, IncidentReport::PRIORITIES[p]&.split(" – ")&.first || p.to_s.humanize, class: "px-2 py-0.5 rounded-full text-xs font-medium #{classes}")
   } %>

<div class="max-w-6xl mx-auto px-4 py-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-2">
    <h1 class="text-3xl font-bold">Incident Reports</h1>
    <%= link_to "Notification settings →", admin_incident_settings_path, class: "text-sm font-medium text-[#ec3750] hover:text-[#d42f46]" %>
  </div>
  <p class="text-gray-600 text-sm mb-6">
    Confidential reports submitted through the public form at
    <code class="bg-gray-100 px-1 py-0.5 rounded">/incident</code>. Visible to global admins only.
  </p>

  <div class="flex flex-wrap gap-2 mb-6 text-sm">
    <% nav_link = ->(label, params_hash) {
         active = params_hash.all? { |k, v| params[k].to_s == v.to_s } && (params_hash.any? || params[:priority].blank?)
         link_to label, admin_incidents_path(params_hash), class: "px-3 py-1.5 rounded-md border #{active ? 'bg-[#d42f46] text-white border-[#ec3750]' : 'bg-white text-gray-700 border-gray-300 hover:border-gray-400'}"
       } %>
    <%= nav_link.("All priorities", {}) %>
    <%= nav_link.("Emergency only", { priority: "emergency" }) %>
  </div>

  <% if @incident_reports.any? %>
    <% status_styles = { "open" => "bg-blue-100 text-blue-800", "in_review" => "bg-amber-100 text-amber-800", "resolved" => "bg-green-100 text-green-800" } %>
    <% IncidentReport.statuses.keys.each do |status| %>
      <% reports = @reports_by_status[status] || [] %>
      <% next if reports.empty? %>
      <section class="mb-8">
        <div class="flex items-center gap-2 mb-3">
          <h2 class="text-lg font-semibold text-gray-900"><%= status.humanize %></h2>
          <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= status_styles[status] %>"><%= reports.size %></span>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-100">
                <thead class="bg-gray-50">
                  <tr>
                    <% [ "Date", "Priority", "Type", "Event", "Reporter", "" ].each do |h| %>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= h %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100 text-sm">
                  <% reports.each do |report| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-4 py-3 whitespace-nowrap text-gray-900"><%= report.created_at.strftime("%b %d, %Y %H:%M") %></td>
                      <td class="px-4 py-3 whitespace-nowrap"><%= priority_badge.(report.priority) %></td>
                      <td class="px-4 py-3 whitespace-nowrap text-gray-700"><%= report.incident_type_label %></td>
                      <td class="px-4 py-3 whitespace-nowrap text-gray-700"><%= report.event_name || "—" %></td>
                      <td class="px-4 py-3 whitespace-nowrap text-gray-700">
                        <%= report.reporter_name %>
                        <span class="block text-xs text-gray-400"><%= report.role_label %></span>
                      </td>
                      <td class="px-4 py-3 whitespace-nowrap text-right">
                        <%= link_to "View", admin_incident_path(report), class: "text-[#ec3750] hover:text-[#d42f46] font-medium" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
      </section>
    <% end %>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-10 text-center text-gray-500">
      No incident reports<%= " match this filter" if params[:priority].present? %>.
    </div>
  <% end %>
</div>

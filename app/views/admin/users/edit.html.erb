<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">Edit User: <%= @user.email %></h1>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-6 py-4">
      <%= form_with model: [:admin, @user], class: "space-y-6", data: { controller: "avatar-preview", avatar_preview_remove_confirm_value: "Are you sure you want to remove this profile picture?" } do |f| %>
        <%= hidden_field_tag "user[remove_avatar]", "0", data: { avatar_preview_target: "removeField" } %>
        <div>
          <p class="text-sm text-gray-600 mb-4">
            <strong>Email:</strong> <%= @user.email %><br>
            <strong>Name (from OIDC):</strong> <%= @user.name || "—" %>
          </p>
        </div>

        <div class="flex items-center gap-6">
          <div class="relative" data-avatar-preview-target="container">
            <% if @user.avatar_displayable? %>
              <%= image_tag @user.avatar.variant(resize_to_fill: [96, 96]), class: "h-24 w-24 rounded-full object-cover", data: { avatar_preview_target: "image" } %>
            <% else %>
              <div class="h-24 w-24 rounded-full bg-gray-200 flex items-center justify-center" data-avatar-preview-target="placeholder">
                <span class="text-2xl font-semibold text-gray-500"><%= @user.initials %></span>
              </div>
              <img src="" class="h-24 w-24 rounded-full object-cover hidden" data-avatar-preview-target="image">
            <% end %>
          </div>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-2">Profile Picture</label>
            <%= f.file_field :avatar, accept: "image/jpeg,image/png,image/gif,image/webp", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100", data: { action: "change->avatar-preview#preview", avatar_preview_target: "input" } %>
            <p class="mt-1 text-xs text-gray-500">JPG, PNG, GIF, or WebP up to 5MB</p>
            <% if @user.avatar.attached? %>
              <button type="button" class="mt-2 text-sm text-red-600 hover:text-red-800" data-action="avatar-preview#remove">Remove picture</button>
            <% end %>
          </div>
        </div>

        <div>
          <%= f.label :display_name, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :display_name, placeholder: @user.name || @user.email, class: "mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] px-3 py-2" %>
          <p class="mt-1 text-xs text-gray-500">This name will be shown on comments, audit logs, and other activity. If left blank, the OIDC name or email will be used.</p>
        </div>

        <div>
          <%= f.label :global_role, "Global Role", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :global_role, [["No Role", "no_role"], ["Global Admin", "global_admin"], ["Read Only", "read_only"]], {}, class: "mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750]" %>
          <p class="mt-1 text-sm text-gray-500">
            <strong>Global Admin:</strong> Full access to all events and settings.<br>
            <strong>Read Only:</strong> Can view all events but cannot make changes.<br>
            <strong>No Role:</strong> Only has access to specifically assigned events.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row justify-end gap-3">
          <%= link_to "Cancel", admin_user_path(@user), class: "w-full sm:w-auto text-center px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition-colors" %>
          <%= f.submit "Save Changes", class: "w-full sm:w-auto px-4 py-2 bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @event_role_assignments.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Event Roles</h2>
      </div>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @event_role_assignments.each do |assignment| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= link_to assignment.event.name, admin_event_dashboard_path(assignment.event.slug), class: "text-[#ec3750] hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assignment.role.titleize %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assignment.created_at.strftime("%B %d, %Y") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @participant_events.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Event Attendance</h2>
      </div>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @participant_events.each do |pe| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= link_to pe.event.name, admin_event_dashboard_path(pe.event.slug), class: "text-[#ec3750] hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= pe.status.titleize %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<% content_for :breadcrumbs, cs_breadcrumbs([ "Users", admin_users_path ], [ "Add user", nil ]) %>

<div class="cs-stack">
  <div class="cs-header mb-0!">
    <div class="cs-header-text">
      <h1 class="cs-h1">Add user</h1>
      <p class="cs-description">The user will sign in using Hack Club Auth.</p>
    </div>
  </div>

  <%= form_with model: [ :admin, @user ], class: "cs-stack" do |f| %>
    <% if @user.errors.any? %>
      <div class="cs-alert cs-alert-error" role="alert">
        <%= cs_status_icon(:error) %>
        <div>
          <p class="cs-alert-title"><%= pluralize(@user.errors.count, "error") %> stopped this user from being created</p>
          <ul class="mt-1 list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">User details</h2>
          <p class="cs-container-description">Fields marked with <span class="text-(--cs-error)">*</span> are required.</p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-field-grid">
          <div>
            <%= f.label :email, label_text("Email", required: true), class: "cs-field-label" %>
            <%= f.email_field :email, required: true, class: "cs-input" %>
          </div>

          <div>
            <%= f.label :name, class: "cs-field-label" %>
            <%= f.text_field :name, class: "cs-input" %>
          </div>
        </div>

        <div class="cs-field mt-4">
          <%= f.label :global_role, "Global role", class: "cs-field-label" %>
          <%= f.select :global_role, [ [ "No role", "no_role" ], [ "Global admin", "global_admin" ], [ "Read only", "read_only" ] ], {}, class: "cs-select" %>
          <p class="cs-field-hint">
            <strong>Global admin:</strong> Full access to all events and settings.<br>
            <strong>Read only:</strong> Can view all events but cannot make changes.<br>
            <strong>No role:</strong> Only has access to specifically assigned events.
          </p>
        </div>
      </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
      <%= link_to "Cancel", admin_users_path, class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button "Create user", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

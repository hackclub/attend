<div class="space-y-6">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <h1 class="text-2xl font-bold text-gray-900"><%= @user.display_name_or_fallback %></h1>
    <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
      <% if current_user.global_admin? && @user != current_user %>
        <%= button_to "Impersonate", admin_user_impersonation_path(@user), method: :post, class: "w-full sm:w-auto text-center px-4 py-2 rounded-md transition-colors", style: "background-color: #f97316; color: white;", data: { confirm: "You will be signed in as #{@user.display_name_or_fallback}. Continue?" } %>
      <% end %>
      <%= link_to "Edit", edit_admin_user_path(@user), class: "w-full sm:w-auto text-center px-4 py-2 bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] transition-colors" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">User Details</h2>
    </div>
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Email</dt>
        <dd class="text-sm text-gray-900"><%= @user.email %></dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Name</dt>
        <dd class="text-sm text-gray-900"><%= @user.name || "—" %></dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Global Role</dt>
        <dd class="text-sm text-gray-900">
          <% if @user.global_admin? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Global Admin</span>
          <% elsif @user.read_only? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Read Only</span>
          <% else %>
            <span class="text-gray-400">No global role</span>
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Hack Club Auth ID</dt>
        <dd class="text-sm text-gray-900"><%= @user.hack_club_account_id || "—" %></dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Slack ID</dt>
        <dd class="text-sm text-gray-900">
          <% if @user.oidc_claims["slack_id"].present? %>
            <%= link_to "slack://user?team=T0266FRGM&id=#{@user.oidc_claims["slack_id"]}", class: "hover:underline" do %><code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm"><%= @user.oidc_claims["slack_id"] %></code><% end %>
          <% else %>
            <span class="text-gray-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Verification Status</dt>
        <dd class="text-sm text-gray-900">
          <% status = @user.oidc_claims["verification_status"] %>
          <% if status == "verified" %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Verified</span>
          <% elsif status.present? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"><%= status.titleize %></span>
          <% else %>
            <span class="text-gray-400">—</span>
          <% end %>
          <% if @user.oidc_claims["ysws_eligible"] == true %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 ml-1">YSWS Eligible</span>
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Sign In Count</dt>
        <dd class="text-sm text-gray-900"><%= @user.sign_in_count %></dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Last Sign In</dt>
        <dd class="text-sm text-gray-900">
          <% if @user.last_sign_in_at %>
            <%= @user.last_sign_in_at.strftime("%B %d, %Y at %I:%M %p") %>
            <span class="text-gray-500">from <%= @user.last_sign_in_ip %></span>
          <% else %>
            Never
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Created</dt>
        <dd class="text-sm text-gray-900"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
      </div>
    </dl>
  </div>

  <div class="bg-white border-2 border-dashed border-orange-400 rounded-lg overflow-hidden"
       data-controller="passport-pairing"
       data-passport-pairing-create-url-value="<%= admin_user_passports_path(@user) %>">
    <div class="px-6 py-4 border-b border-orange-200 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-medium text-gray-900">Hack Club Passports</h2>
        <p class="mt-1 text-sm text-gray-500">Pair an event-agnostic NFC passport to this user.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-2 text-xs text-gray-500">
          <span class="size-2 rounded-full bg-gray-400" data-passport-pairing-target="statusDot"></span>
          <span data-passport-pairing-target="statusText">Not connected</span>
        </span>
        <button type="button"
                class="px-3 py-2 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
                data-passport-pairing-target="connectButton"
                data-action="passport-pairing#toggleConnection">
          Connect
        </button>
        <button type="button"
                class="px-3 py-2 text-sm bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] disabled:cursor-not-allowed disabled:opacity-50"
                data-passport-pairing-target="pairButton"
                data-action="passport-pairing#pair"
                disabled>
          Pair passport
        </button>
      </div>
    </div>

    <div class="px-6 py-3 border-b border-orange-100">
      <p class="text-sm text-gray-600" data-passport-pairing-target="progress">
        Connect the Attend NFC Bridge to pair a passport.
      </p>
    </div>

    <% if @passports.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-100">
          <thead class="bg-orange-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Serial</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Paired</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% @passports.each do |passport| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900"><%= passport.serial_number %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% if passport.revoked? %>
                    <span class="inline-flex rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">Revoked</span>
                  <% elsif passport.active? %>
                    <span class="inline-flex rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Active</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">Pending</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if passport.paired_at? %>
                    <%= passport.paired_at.strftime("%B %d, %Y") %>
                    <% if passport.paired_by %>
                      <span class="block text-xs">by <%= passport.paired_by.display_name_or_fallback %></span>
                    <% end %>
                  <% else %>
                    Not yet paired
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                  <% if passport.active? %>
                    <%= button_to "Revoke",
                      admin_user_passport_path(@user, passport),
                      method: :delete,
                      class: "text-red-600 hover:text-red-800",
                      data: { turbo_confirm: "Revoke passport #{passport.serial_number}?" } %>
                  <% elsif passport.revoked? %>
                    <span class="text-xs text-gray-400"><%= passport.revoked_at.strftime("%B %d, %Y") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-5 text-sm text-gray-500">No passports have been paired with this user.</p>
    <% end %>
  </div>

  <% if @event_role_assignments.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Event Roles</h2>
      </div>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @event_role_assignments.each do |assignment| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= link_to assignment.event.name, admin_event_dashboard_path(assignment.event.slug), class: "text-[#ec3750] hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assignment.role.titleize %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assignment.created_at.strftime("%B %d, %Y") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @participant_events.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Event Attendance</h2>
      </div>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @participant_events.each do |pe| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= link_to pe.event.name, admin_event_participant_path(pe.event, pe), class: "text-[#ec3750] hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= pe.status.titleize %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="flex">
    <%= link_to "← Back to Users", admin_users_path, class: "text-[#ec3750] hover:text-blue-900" %>
  </div>
</div>

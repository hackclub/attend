<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">Audit Logs</h1>
    <%= link_to "Record versions →", versions_admin_audit_logs_path, class: "text-sm text-[#ec3750] hover:text-blue-900" %>
  </div>
  <p class="text-sm text-gray-600">Admin actions taken in this app. For every-record-change history (including non-admin sources), see <%= link_to "record versions", versions_admin_audit_logs_path, class: "text-[#ec3750] underline" %>.</p>

  <div class="bg-white border border-gray-200 rounded-lg">
    <div class="p-4 border-b border-gray-200">
      <%= form_with url: admin_audit_logs_path, method: :get, class: "grid grid-cols-2 md:grid-cols-4 gap-4", data: { turbo_frame: "_top" } do |f| %>
        <div>
          <%= f.label :action_type, "Action", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :action_type, [["All Actions", ""], ["Create", "create"], ["Update", "update"], ["Delete", "delete"], ["View", "view"]], { selected: params[:action_type] }, class: "mt-1 block w-full px-3 py-2 rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] text-sm" %>
        </div>
        <div>
          <%= f.label :record_type, "Record Type", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :record_type, value: params[:record_type], placeholder: "e.g. Participant", class: "mt-1 block w-full px-3 py-2 rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] text-sm" %>
        </div>
        <div>
          <%= f.label :start_date, "From", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "mt-1 block w-full px-3 py-2 rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] text-sm" %>
        </div>
        <div>
          <%= f.label :end_date, "To", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "mt-1 block w-full px-3 py-2 rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750] text-sm" %>
        </div>
        <div class="col-span-2 md:col-span-4 flex justify-end">
          <%= link_to "Clear", admin_audit_logs_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition-colors mr-2" %>
          <%= f.submit "Filter", class: "px-4 py-2 bg-[#d42f46] text-white rounded-md hover:bg-[#b82840] transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <% if @audit_logs.any? %>
      <div class="overflow-x-auto -mx-4 sm:mx-0">
        <table class="min-w-full divide-y divide-gray-100">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Timestamp</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actor</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Record</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Changes</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100 text-xs sm:text-sm">
            <% @audit_logs.each do |log| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <div class="flex items-center gap-2">
                    <% if log.actor&.avatar_displayable? %>
                      <%= image_tag log.actor.avatar.variant(resize_to_fill: [24, 24]), class: "w-6 h-6 rounded-full object-cover flex-shrink-0" %>
                    <% elsif log.actor %>
                      <span class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0 text-xs font-medium text-gray-600"><%= log.actor.initials %></span>
                    <% end %>
                    <span class="truncate max-w-[120px]" title="<%= log.actor&.display_name_or_fallback || 'System' %>"><%= log.actor&.display_name_or_fallback || "System" %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% action_color = case log.action
                     when "create" then "bg-green-100 text-green-800"
                     when "update" then "bg-blue-100 text-blue-800"
                     when "delete" then "bg-red-100 text-red-800"
                     else "bg-gray-100 text-gray-800"
                     end %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= action_color %>">
                    <%= log.action&.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 truncate max-w-[160px]" title="<%= log.record_type %> #<%= log.record_id %>">
                  <%= log.record_type %> #<%= log.record_id&.first(8) %>...
                </td>
                <td class="px-6 py-4 text-sm text-gray-600 max-w-[250px]">
                  <% if log.changed_fields.present? %>
                    <% labels = log.changed_fields.keys.map { |f| audit_field_label(f) } %>
                    <span class="truncate block" title="<%= labels.join(', ') %>">
                      <%= labels.first(3).join(', ') %><%= ', ...' if labels.size > 3 %>
                    </span>
                  <% elsif log.metadata.present? && log.metadata['description'].present? %>
                    <span class="truncate block"><%= log.metadata['description'] %></span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= log.event&.name || "—" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "View", admin_audit_log_path(log), class: "text-[#ec3750] hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-gray-500">No audit logs found matching your criteria.</p>
      </div>
    <% end %>
  </div>
</div>

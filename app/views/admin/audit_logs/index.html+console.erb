<%# Filtered to one event (the sidebar's "Event audit log"), the trail sits under that event. %>
<%# An event the viewer can't open falls back to the plain trail, so its name never leaks. %>
<% audit_event = Event.find_by(id: params[:event_id]) if params[:event_id].present? %>
<% if audit_event && policy(audit_event).show? %>
  <% content_for :breadcrumbs, cs_event_breadcrumbs([ "Event audit log", nil ], event: audit_event) %>
<% else %>
  <% content_for :breadcrumbs, cs_breadcrumbs([ "Audit log", nil ]) %>
<% end %>
<% audit_action_badge = { "create" => "green", "update" => "blue", "delete" => "red" } %>

<div class="cs-stack">
  <div class="cs-header mb-0!">
    <div class="cs-header-text">
      <h1 class="cs-h1">Audit logs</h1>
      <p class="cs-description">Admin actions taken in this app. For every-record-change history (including non-admin sources), see <%= link_to "record versions", versions_admin_audit_logs_path, class: "cs-link" %>.</p>
    </div>
    <div class="cs-actions">
      <%= link_to "Record versions", versions_admin_audit_logs_path, class: "cs-btn" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Admin actions</h2>
    </div>
    <%= form_with url: admin_audit_logs_path, method: :get, class: "px-5 pb-4", data: { turbo_frame: "_top" } do |f| %>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <%= f.label :action_type, "Action", class: "cs-field-label" %>
          <%= f.select :action_type, [ [ "All actions", "" ], [ "Create", "create" ], [ "Update", "update" ], [ "Delete", "delete" ], [ "View", "view" ] ], { selected: params[:action_type] }, class: "cs-select" %>
        </div>
        <div>
          <%= f.label :record_type, "Record type", class: "cs-field-label" %>
          <%= f.text_field :record_type, value: params[:record_type], placeholder: "e.g. Participant", class: "cs-input" %>
        </div>
        <div>
          <%= f.label :start_date, "From", class: "cs-field-label" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "cs-input" %>
        </div>
        <div>
          <%= f.label :end_date, "To", class: "cs-field-label" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "cs-input" %>
        </div>
      </div>
      <div class="flex justify-end gap-2 mt-4">
        <%= link_to "Clear", admin_audit_logs_path, class: "cs-btn cs-btn-link" %>
        <%= f.button "Filter", name: "commit", value: "Filter", class: "cs-btn" %>
      </div>
    <% end %>

    <% if @audit_logs.any? %>
      <div class="cs-table-wrap border-t border-(--cs-border-divider-secondary)">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Logged</th>
              <th scope="col">Actor</th>
              <th scope="col">Action</th>
              <th scope="col">Record</th>
              <th scope="col">Changes</th>
              <th scope="col">Event</th>
              <th scope="col" class="text-right">Details</th>
            </tr>
          </thead>
          <tbody>
            <% @audit_logs.each do |log| %>
              <tr>
                <td class="whitespace-nowrap cs-secondary">
                  <%= cs_absolute_time_tag(log.created_at) %>
                </td>
                <td class="whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <% if log.actor&.avatar_displayable? %>
                      <%= image_tag log.actor.avatar.variant(resize_to_fill: [ 24, 24 ]), class: "w-6 h-6 rounded-full object-cover flex-shrink-0", alt: "" %>
                    <% elsif log.actor %>
                      <span class="cs-avatar cs-small flex-shrink-0" aria-hidden="true"><%= log.actor.initials %></span>
                    <% end %>
                    <span class="truncate max-w-[120px]" title="<%= log.actor&.display_name_or_fallback || 'System' %>"><%= log.actor&.display_name_or_fallback || "System" %></span>
                  </div>
                </td>
                <td class="whitespace-nowrap">
                  <%= cs_badge(log.action&.titleize, audit_action_badge[log.action]) %>
                </td>
                <td class="whitespace-nowrap truncate max-w-[160px]" title="<%= log.record_type %> #<%= log.record_id %>">
                  <%= log.record_type %> <span class="font-mono cs-secondary">#<%= log.record_id&.first(8) %>...</span>
                </td>
                <td class="max-w-[250px]">
                  <% if log.changed_fields.present? %>
                    <% labels = log.changed_fields.keys.map { |f| audit_field_label(f) } %>
                    <span class="truncate block" title="<%= labels.join(', ') %>">
                      <%= labels.first(3).join(', ') %><%= ', ...' if labels.size > 3 %>
                    </span>
                  <% elsif log.metadata.present? && log.metadata['description'].present? %>
                    <span class="truncate block"><%= log.metadata['description'] %></span>
                  <% else %>
                    <span class="cs-muted">—</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap cs-secondary">
                  <%= log.event&.name || "—" %>
                </td>
                <td class="whitespace-nowrap text-right">
                  <%= link_to "View", admin_audit_log_path(log), class: "cs-link" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="cs-empty border-t border-(--cs-border-divider-secondary)">
        <p class="cs-empty-title">No audit logs</p>
        <p>No audit logs found matching your criteria.</p>
      </div>
    <% end %>
  </section>
</div>

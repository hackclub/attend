<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">Audit Log Details</h1>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Timestamp</dt>
        <dd class="text-sm text-gray-900"><%= @audit_log.created_at.strftime("%B %d, %Y at %I:%M:%S %p") %></dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Actor</dt>
        <dd class="text-sm text-gray-900">
          <% if @audit_log.actor %>
            <%= link_to @audit_log.actor.email, admin_user_path(@audit_log.actor), class: "text-[#ec3750] hover:text-blue-900" %>
          <% else %>
            System
          <% end %>
        </dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Action</dt>
        <dd class="text-sm text-gray-900">
          <% action_color = case @audit_log.action
             when "create" then "bg-green-100 text-green-800"
             when "update" then "bg-blue-100 text-blue-800"
             when "delete" then "bg-red-100 text-red-800"
             else "bg-gray-100 text-gray-800"
             end %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= action_color %>">
            <%= @audit_log.action&.titleize %>
          </span>
        </dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Record Type</dt>
        <dd class="text-sm text-gray-900"><%= @audit_log.record_type %></dd>
      </div>
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">Record ID</dt>
        <dd class="text-sm text-gray-900 font-mono"><%= @audit_log.record_id %></dd>
      </div>
      <% if @audit_log.event %>
        <div class="px-6 py-4 flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
          <dt class="text-sm font-medium text-gray-500">Event</dt>
          <dd class="text-sm text-gray-900">
            <%= link_to @audit_log.event.name, admin_event_dashboard_path(@audit_log.event.slug), class: "text-[#ec3750] hover:text-blue-900" %>
          </dd>
        </div>
      <% end %>

    </dl>
  </div>

  <% if @audit_log.changed_fields.present? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Changes</h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% audit_changed_field_pairs(@audit_log.changed_fields).each do |field, old_value, new_value| %>
          <div class="px-6 py-4">
            <div class="text-sm font-medium text-gray-900 mb-2"><%= audit_field_label(field) %></div>
            <% if @audit_log.action == "create" %>
              <div class="text-sm bg-green-50 border border-green-200 rounded px-3 py-2 text-green-900">
                <%= audit_format_value(field, new_value) %>
              </div>
            <% elsif @audit_log.action == "destroy" %>
              <div class="text-sm bg-red-50 border border-red-200 rounded px-3 py-2 text-red-900 line-through">
                <%= audit_format_value(field, old_value) %>
              </div>
            <% else %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                <div>
                  <div class="text-xs uppercase tracking-wide text-gray-500 mb-1">Before</div>
                  <div class="bg-red-50 border border-red-200 rounded px-3 py-2 text-red-900">
                    <%= audit_format_value(field, old_value) %>
                  </div>
                </div>
                <div>
                  <div class="text-xs uppercase tracking-wide text-gray-500 mb-1">After</div>
                  <div class="bg-green-50 border border-green-200 rounded px-3 py-2 text-green-900">
                    <%= audit_format_value(field, new_value) %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <details class="px-6 py-3 border-t border-gray-100 bg-gray-50">
        <summary class="text-xs text-gray-500 cursor-pointer">Show raw JSON</summary>
        <pre class="bg-white border border-gray-200 rounded p-3 mt-2 text-xs overflow-x-auto"><%= JSON.pretty_generate(@audit_log.changed_fields) %></pre>
      </details>
    </div>
  <% end %>

  <% if @audit_log.metadata.present? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-medium text-gray-900">Metadata</h2>
      </div>
      <div class="px-6 py-4">
        <pre class="bg-gray-50 rounded p-4 text-sm overflow-x-auto"><%= JSON.pretty_generate(@audit_log.metadata) %></pre>
      </div>
    </div>
  <% end %>

  <% if @record_versions&.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
        <h2 class="text-lg font-medium text-gray-900">Full record history</h2>
        <% if current_user.global_admin? %>
          <%= link_to "View all versions →", versions_admin_audit_logs_path(item_type: @audit_log.record_type, item_id: @audit_log.record_id), class: "text-sm text-[#ec3750] hover:text-blue-900" %>
        <% end %>
      </div>
      <div class="divide-y divide-gray-100">
        <% @record_versions.each do |version| %>
          <% changes = audit_version_changes(version) %>
          <details class="group">
            <summary class="px-6 py-3 flex items-center gap-3 cursor-pointer hover:bg-gray-50 list-none">
              <span class="text-xs text-gray-500 font-mono w-44 flex-shrink-0"><%= version.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
              <% color = case version.event when "create" then "bg-green-100 text-green-800" when "update" then "bg-blue-100 text-blue-800" when "destroy" then "bg-red-100 text-red-800" else "bg-gray-100 text-gray-800" end %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= color %> w-20 justify-center"><%= version.event.titleize %></span>
              <span class="text-sm text-gray-700 flex-1 truncate"><%= audit_user_label(version.whodunnit) %></span>
              <span class="text-xs text-gray-400">
                <% if changes.any? %><%= pluralize(changes.size, "field") %> changed<% else %>—<% end %>
              </span>
              <span class="text-gray-400 group-open:rotate-90 transition-transform">›</span>
            </summary>
            <div class="px-6 pb-4 pt-1 bg-gray-50">
              <% if changes.any? %>
                <div class="space-y-2">
                  <% changes.each do |field, change| %>
                    <% old_value, new_value = change.is_a?(Array) ? change : [nil, change] %>
                    <div>
                      <div class="text-xs font-medium text-gray-700 mb-1"><%= audit_field_label(field) %></div>
                      <% if version.event == "create" %>
                        <div class="text-xs bg-green-50 border border-green-200 rounded px-2 py-1 text-green-900"><%= audit_format_value(field, new_value) %></div>
                      <% elsif version.event == "destroy" %>
                        <div class="text-xs bg-red-50 border border-red-200 rounded px-2 py-1 text-red-900 line-through"><%= audit_format_value(field, old_value) %></div>
                      <% else %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
                          <div class="bg-red-50 border border-red-200 rounded px-2 py-1 text-red-900"><%= audit_format_value(field, old_value) %></div>
                          <div class="bg-green-50 border border-green-200 rounded px-2 py-1 text-green-900"><%= audit_format_value(field, new_value) %></div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-xs text-gray-500 italic py-2">No tracked field changes recorded for this version.</div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="flex">
    <%= link_to "← Back to Audit Logs", admin_audit_logs_path, class: "text-[#ec3750] hover:text-blue-900" %>
  </div>
</div>

<% content_for :breadcrumbs, cs_breadcrumbs([ "Audit logs", admin_audit_logs_path ], [ "Record versions", nil ]) %>
<% version_badge = { "create" => "green", "update" => "blue", "destroy" => "red" } %>

<div class="cs-stack">
  <div class="cs-header mb-0!">
    <div class="cs-header-text">
      <h1 class="cs-h1">Record versions</h1>
      <p class="cs-description">Every change to every tracked record across the app, regardless of how it was made (admin UI, guardian portal, onboarding, API, etc.).</p>
    </div>
    <div class="cs-actions">
      <%= link_to "Action log", admin_audit_logs_path, class: "cs-btn" %>
    </div>
  </div>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Versions <span class="cs-counter">(<%= @versions.size %><%= "+" if @versions.size >= 500 %>)</span></h2>
    </div>
    <%= form_with url: versions_admin_audit_logs_path, method: :get, class: "px-5 pb-4", data: { turbo_frame: "_top" } do |f| %>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div>
          <%= f.label :item_type, "Record type", class: "cs-field-label" %>
          <%= f.text_field :item_type, value: params[:item_type], placeholder: "e.g. Participant", class: "cs-input" %>
        </div>
        <div>
          <%= f.label :item_id, "Record ID", class: "cs-field-label" %>
          <%= f.text_field :item_id, value: params[:item_id], class: "cs-input" %>
        </div>
        <div>
          <%= f.label :event, "Action", class: "cs-field-label" %>
          <%= f.select :event, [ [ "All", "" ], [ "Create", "create" ], [ "Update", "update" ], [ "Destroy", "destroy" ] ], { selected: params[:event] }, class: "cs-select" %>
        </div>
        <div>
          <%= f.label :start_date, "From", class: "cs-field-label" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "cs-input" %>
        </div>
        <div>
          <%= f.label :end_date, "To", class: "cs-field-label" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "cs-input" %>
        </div>
      </div>
      <div class="flex justify-end gap-2 mt-4">
        <%= link_to "Clear", versions_admin_audit_logs_path, class: "cs-btn cs-btn-link" %>
        <%= f.button "Filter", name: "commit", value: "Filter", class: "cs-btn" %>
      </div>
    <% end %>

    <% if @versions.any? %>
      <div class="divide-y divide-(--cs-border-divider-secondary) border-t border-(--cs-border-divider-secondary)">
        <% @versions.each do |version| %>
          <% changes = audit_version_changes(version) %>
          <details class="cs-expandable">
            <summary class="px-5 py-2 font-normal! hover:bg-(--cs-bg-hover)">
              <span class="cs-small cs-secondary font-mono w-40 flex-shrink-0"><%= version.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
              <span class="w-20 flex-shrink-0"><%= cs_badge(version.event.titleize, version_badge[version.event]) %></span>
              <span class="font-bold w-48 truncate" title="<%= version.item_type %> #<%= version.item_id %>">
                <%= version.item_type %>
              </span>
              <span class="cs-small cs-muted font-mono w-24 truncate" title="<%= version.item_id %>"><%= version.item_id.to_s.first(8) %></span>
              <span class="cs-secondary flex-1 truncate">
                <%= audit_user_label(version.whodunnit, @users_by_id) %>
              </span>
              <span class="cs-small cs-muted">
                <% if changes.any? %><%= pluralize(changes.size, "field") %> changed<% else %>—<% end %>
              </span>
            </summary>
            <div class="cs-expandable-content px-5 pb-4 pl-10">
              <% if changes.any? %>
                <div class="space-y-3">
                  <% changes.each do |field, change| %>
                    <% old_value, new_value = change.is_a?(Array) ? change : [ nil, change ] %>
                    <div>
                      <div class="cs-kv-label mb-1"><%= audit_field_label(field) %></div>
                      <% if version.event == "create" %>
                        <div class="cs-small rounded px-2 py-1 border border-(--cs-success) bg-(--cs-success-bg)"><%= audit_format_value(field, new_value) %></div>
                      <% elsif version.event == "destroy" %>
                        <div class="cs-small rounded px-2 py-1 border border-(--cs-error) bg-(--cs-error-bg) line-through"><%= audit_format_value(field, old_value) %></div>
                      <% else %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 cs-small">
                          <div class="rounded px-2 py-1 border border-(--cs-error) bg-(--cs-error-bg)"><span class="sr-only">Before: </span><%= audit_format_value(field, old_value) %></div>
                          <div class="rounded px-2 py-1 border border-(--cs-success) bg-(--cs-success-bg)"><span class="sr-only">After: </span><%= audit_format_value(field, new_value) %></div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="cs-small cs-muted italic py-2">No tracked field changes recorded for this version.</p>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
      <% if @versions.size >= 500 %>
        <div class="cs-container-footer cs-small">Showing first 500 results — narrow filters to see more.</div>
      <% end %>
    <% else %>
      <div class="cs-empty border-t border-(--cs-border-divider-secondary)">
        <p class="cs-empty-title">No versions</p>
        <p>No versions found matching your criteria.</p>
      </div>
    <% end %>
  </section>
</div>

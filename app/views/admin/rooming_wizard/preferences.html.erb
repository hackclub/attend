<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Rooming Wizard</h1>
      <p class="mt-1 text-sm text-gray-600">Step 2: Link roommate preferences to participants</p>
    </div>
    <div class="flex items-center gap-4">
      <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800">
        Step 2 of 4
      </span>
      <%= link_to setup_admin_event_rooming_wizard_path(@event.slug), class: "text-sm text-gray-500 hover:text-gray-700" do %>
        ← Back to Setup
      <% end %>
    </div>
  </div>

  <%= render "group_filter" %>

  <!-- Progress Banner -->
  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="text-sm">
          <span class="font-medium"><%= @participant_events.count %></span> participants to review
        </div>
        <div class="text-sm">
          <span class="font-medium text-orange-600"><%= @unreviewed_count %></span> unreviewed
        </div>
      </div>
      <div class="flex gap-3">
        <%= form_with url: auto_assign_admin_event_rooming_wizard_path(@event.slug), method: :post, class: "inline" do %>
          <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md  text-white bg-[#d42f46] hover:bg-[#b82840]">
            Continue to Auto-Assign
            <svg class="ml-2 -mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Participant List -->
  <div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100">
    <% @participant_events.each do |pe| %>
      <div class="p-4" id="participant_row_<%= pe.id %>">
        <div class="flex items-start gap-6">
          <!-- Left: Participant Info & Raw Preferences -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3">
              <h3 class="font-medium text-gray-900"><%= pe.participant.full_name %></h3>
              <span class="text-sm text-gray-500">
                Age: <%= pe.age_on_event %>
                <% if pe.is_18_on_event? %>
                  <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 ml-1">18</span>
                <% end %>
              </span>
              <span class="text-sm text-gray-500">
                <%= pe.accommodation&.gender_identity&.titleize || "No gender" %>
                <% if pe.accommodation&.trans_or_nb? %>
                  <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-800 ml-1">Trans/NB</span>
                <% end %>
              </span>
              <% if pe.accommodation&.roommate_links_reviewed? %>
                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">
                  ✓ Reviewed
                </span>
              <% end %>
            </div>

            <div class="mt-2 grid grid-cols-2 gap-4">
              <div>
                <p class="text-xs font-medium text-gray-500 uppercase">Preferred Roommates (raw)</p>
                <p class="text-sm text-gray-700 whitespace-pre-wrap mt-1">
                  <%= pe.accommodation&.roommate_preferences.presence || "None specified" %>
                </p>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-500 uppercase">Excluded Roommates (raw)</p>
                <p class="text-sm text-gray-700 whitespace-pre-wrap mt-1">
                  <%= pe.accommodation&.roommate_exclusions.presence || "None specified" %>
                </p>
              </div>
            </div>

            <div class="mt-2">
              <p class="text-xs font-medium text-gray-500 uppercase">Willing to room with</p>
              <p class="text-sm text-gray-700">
                <%= pe.accommodation&.preferred_roommate_genders&.map(&:titleize)&.join(", ").presence || "Same gender only" %>
              </p>
            </div>
          </div>

          <!-- Right: Linked Preferences -->
          <div class="w-80 flex-shrink-0" id="preference_links_<%= pe.id %>">
            <%= render partial: "admin/rooming_wizard/preference_links", locals: { participant_event: pe } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Link Preference Modal (reusable) -->
<div id="link-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75" data-close-link-modal></div>
    
    <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Link to Participant</h3>
      
      <form id="link-form">
        <input type="hidden" name="participant_event_id" id="link-pe-id">
        <input type="hidden" name="kind" id="link-kind">
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Search Participants</label>
            <input type="text" id="link-search" placeholder="Type to search..." 
                   class="block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750]"
                   data-filter-link-participants>
          </div>
          
          <div id="link-participants" class="max-h-60 overflow-y-auto border rounded-md">
            <% @participant_events.each do |pe| %>
              <label class="link-participant-option flex items-center p-2 hover:bg-gray-50 cursor-pointer" data-name="<%= pe.participant.full_name.downcase %>">
                <input type="radio" name="target_participant_event_id" value="<%= pe.id %>" class="text-[#ec3750] focus:ring-[#ec3750]">
                <span class="ml-2 text-sm">
                  <%= pe.participant.full_name %>
                  - Age <%= pe.age_on_event %>, <%= pe.accommodation&.gender_identity&.titleize %>
                </span>
              </label>
            <% end %>
          </div>
          
          <div id="link-rank-field" class="hidden">
            <label class="block text-sm font-medium text-gray-700">Preference Rank</label>
            <select name="rank" class="mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750]">
              <option value="1">1st choice</option>
              <option value="2">2nd choice</option>
              <option value="3">3rd choice</option>
            </select>
          </div>
        </div>
        
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" data-close-link-modal class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-md">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-[#d42f46] hover:bg-[#b82840] rounded-md">
            Link
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
function openLinkModal(peId, kind) {
  document.getElementById('link-pe-id').value = peId;
  document.getElementById('link-kind').value = kind;
  document.getElementById('link-search').value = '';
  document.getElementById('link-rank-field').classList.toggle('hidden', kind !== 'preference');
  filterLinkParticipants('');
  document.getElementById('link-modal').classList.remove('hidden');
}

function closeLinkModal() {
  document.getElementById('link-modal').classList.add('hidden');
}

function filterLinkParticipants(query) {
  const options = document.querySelectorAll('.link-participant-option');
  const lowerQuery = query.toLowerCase();
  options.forEach(opt => {
    const name = opt.dataset.name;
    opt.classList.toggle('hidden', lowerQuery && !name.includes(lowerQuery));
  });
}

document.getElementById('link-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const formData = new FormData(this);
  
  const response = await fetch('<%= link_preference_admin_event_rooming_wizard_path(@event.slug) %>', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
      'Accept': 'text/vnd.turbo-stream.html'
    },
    body: formData
  });
  
  if (response.ok) {
    closeLinkModal();
    const html = await response.text();
    Turbo.renderStreamMessage(html);
  }
});

document.querySelectorAll('[data-close-link-modal]').forEach((el) => {
  el.addEventListener('click', closeLinkModal);
});

document.querySelector('[data-filter-link-participants]')
  ?.addEventListener('input', (event) => filterLinkParticipants(event.target.value));
</script>

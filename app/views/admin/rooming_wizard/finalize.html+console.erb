<% content_for :title, "Rooming wizard: Room numbers – Attend" %>

<%= render layout: "wizard", locals: {
      current_step: "finalize",
      title: "Room numbers and export",
      description: "Review and assign room numbers."
    } do %>
  <div class="cs-stack">
    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Summary</h2>
        </div>
      </div>
      <div class="cs-container-body cs-stack">
        <dl class="cs-kv cs-kv-4 cs-kv-divided">
          <div>
            <dt class="cs-kv-label">Total rooms</dt>
            <dd class="cs-kv-value-lg"><%= @stats[:total_rooms] %></dd>
          </div>
          <div>
            <dt class="cs-kv-label">Assigned</dt>
            <dd class="cs-kv-value-lg"><%= @stats[:assigned_participants] %></dd>
          </div>
          <% if @stats[:unassigned_participants] > 0 %>
            <div>
              <dt class="cs-kv-label">Unassigned</dt>
              <dd class="cs-kv-value-lg"><%= @stats[:unassigned_participants] %></dd>
            </div>
          <% end %>
          <% if @stats[:rooms_needing_acknowledgment] > 0 %>
            <div>
              <dt class="cs-kv-label">Needs ack</dt>
              <dd class="cs-kv-value-lg"><%= @stats[:rooms_needing_acknowledgment] %></dd>
            </div>
          <% end %>
          <% if @stats[:rooms_with_age_gap] > 0 %>
            <div>
              <dt class="cs-kv-label">Age gap warnings</dt>
              <dd class="cs-kv-value-lg"><%= @stats[:rooms_with_age_gap] %></dd>
            </div>
          <% end %>
        </dl>

        <% if @stats[:unassigned_participants] > 0 %>
          <div class="cs-alert cs-alert-error">
            <%= cs_status_icon(:error) %>
            <div>
              <p class="cs-alert-title">Warning</p>
              <p>
                There are <%= @stats[:unassigned_participants] %> unassigned participants.
                <%= link_to "Go back to fix", assignments_admin_event_rooming_wizard_path(@event.slug), class: "cs-link cs-link-strong" %>
              </p>
            </div>
          </div>
        <% end %>

        <% if @stats[:rooms_needing_acknowledgment] > 0 %>
          <div class="cs-alert cs-alert-warning">
            <%= cs_status_icon(:warning) %>
            <div>
              <p class="cs-alert-title">Note</p>
              <p>There are <%= @stats[:rooms_needing_acknowledgment] %> rooms with trans/NB pairings that need acknowledgment.</p>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided">
        <div>
          <h2 class="cs-h2">Assign room numbers <span class="cs-counter">(<%= @rooms.size %>)</span></h2>
          <p class="cs-container-description">Enter room numbers for each room grouping</p>
        </div>
      </div>
      <div class="cs-table-wrap">
        <table class="cs-table">
          <thead>
            <tr>
              <th scope="col">Room number</th>
              <th scope="col">Occupants</th>
              <th scope="col">Occupancy</th>
            </tr>
          </thead>
          <tbody>
            <% @rooms.each do |room| %>
              <tr>
                <td class="w-40">
                  <input type="text"
                         value="<%= room.name %>"
                         placeholder="Room #"
                         aria-label="Room number"
                         class="cs-input"
                         data-update-room-name="<%= room.id %>">
                </td>
                <td>
                  <div class="cs-token-group">
                    <% room.staff_names_list.each do |staff_name| %>
                      <span class="cs-token cs-token-readonly">
                        <%= staff_name %>
                        <%= cs_badge("Staff", "yellow") %>
                      </span>
                    <% end %>
                    <% room.room_assignments.each do |assignment| %>
                      <% has_lodging_scan = assignment.participant_event.scans.any? { |s| @lodging_scan_context_ids.include?(s.scan_context_id) } %>
                      <span class="cs-token cs-token-readonly">
                        <% if has_lodging_scan %>
                          <%= cs_status(:success, assignment.participant_event.participant.full_name) %>
                        <% else %>
                          <%= assignment.participant_event.participant.full_name %>
                        <% end %>
                        <span class="cs-small cs-muted">(Age <%= assignment.participant_event.age_on_event %>)</span>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="whitespace-nowrap">
                  <div class="flex flex-col items-start gap-1">
                    <span><%= room.room_assignments.size %>/<%= room.capacity %></span>
                    <% if room.staff_only? %>
                      <%= cs_badge("Staff", "yellow") %>
                    <% end %>
                    <% if room.age_gap > 2 %>
                      <%= cs_status(:warning, "Age gap: #{room.age_gap}y") %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @rooms.empty? %>
        <div class="cs-empty">
          <p class="cs-empty-title">No rooms</p>
        </div>
      <% end %>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Export rooming list</h2>
          <p class="cs-container-description">Download the current rooming assignments. You can continue editing after exporting.</p>
        </div>
        <div class="cs-actions">
          <%= link_to export_csv_admin_event_rooming_wizard_path(@event.slug, format: :csv), class: "cs-btn cs-btn-primary" do %>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Export CSV
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <div class="cs-wizard-actions">
    <%= link_to "Previous", assignments_admin_event_rooming_wizard_path(@event.slug), class: "cs-btn" %>
  </div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
async function updateRoomName(roomId, name) {
  const formData = new FormData();
  formData.append('room_id', roomId);
  formData.append('name', name);
  
  await fetch('<%= update_room_admin_event_rooming_wizard_path(@event.slug) %>', {
    method: 'PATCH',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: formData
  });
}

document.querySelectorAll('[data-update-room-name]').forEach((input) => {
  input.addEventListener('change', () => updateRoomName(input.dataset.updateRoomName, input.value));
});
</script>

<%# Which stay the wizard is working on. Each tab opens the same step for that
    stay; the main stay's tab passes stay_id: nil so it drops the segment the
    current request would otherwise carry over. %>
<% stays = @event.rooming_contexts.ordered.to_a %>
<div class="flex flex-wrap items-end justify-between gap-3 mb-5">
  <% if stays.size > 1 %>
    <nav class="cs-tabs" aria-label="Stays">
      <% stays.each do |stay| %>
        <%= link_to stay.name,
            url_for(request.path_parameters.merge(stay_id: (stay.id unless stay.main?), only_path: true)),
            class: "cs-tab", "aria-current": cs_current(stay == @rooming_context) %>
      <% end %>
    </nav>
  <% else %>
    <span></span>
  <% end %>
  <div class="flex gap-2">
    <% if @rooming_context.eligible_only? %>
      <%= link_to "Who's staying (#{@rooming_context.roster_entries.size})",
          admin_event_rooming_stay_roster_entries_path(@event.slug, @rooming_context), class: "cs-btn cs-btn-normal" %>
    <% end %>
    <%= link_to "All stays", admin_event_rooming_stays_path(@event.slug, stay_id: nil), class: "cs-btn cs-btn-link" %>
  </div>
</div>

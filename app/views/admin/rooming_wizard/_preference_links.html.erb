<div class="space-y-3">
  <!-- Linked Preferences -->
  <div>
    <div class="flex items-center justify-between mb-1">
      <p class="text-xs font-medium text-green-700 uppercase">Linked Preferences</p>
      <button type="button" data-open-link-modal="<%= participant_event.id %>" data-link-kind="preference" 
              class="text-xs text-[#ec3750] hover:text-blue-800">+ Add</button>
    </div>
    <div class="space-y-1">
      <% participant_event.roommate_preferences.sort_by { |p| p.rank || Float::INFINITY }.each do |pref| %>
        <div class="flex items-center justify-between bg-green-50 rounded px-2 py-1 text-sm">
          <span>
            <% if pref.rank %><span class="text-green-600 font-medium">#<%= pref.rank %></span><% end %>
            <%= pref.preferred_participant_event.participant.full_name %>
            <% if pref.mutual? %>
              <span class="inline-flex items-center rounded-full bg-green-200 px-1.5 py-0.5 text-xs font-medium text-green-800">Mutual</span>
            <% end %>
          </span>
          <button type="button" 
                  data-unlink="<%= pref.id %>" data-link-kind="preference"
                  class="text-red-500 hover:text-red-700">&times;</button>
        </div>
      <% end %>
      <% if participant_event.roommate_preferences.empty? %>
        <p class="text-xs text-gray-400 italic">No linked preferences</p>
      <% end %>
    </div>
  </div>

  <!-- Linked Exclusions -->
  <div>
    <div class="flex items-center justify-between mb-1">
      <p class="text-xs font-medium text-red-700 uppercase">Linked Exclusions</p>
      <button type="button" data-open-link-modal="<%= participant_event.id %>" data-link-kind="exclusion" 
              class="text-xs text-[#ec3750] hover:text-blue-800">+ Add</button>
    </div>
    <div class="space-y-1">
      <% participant_event.roommate_exclusions.each do |excl| %>
        <div class="flex items-center justify-between bg-red-50 rounded px-2 py-1 text-sm">
          <span><%= excl.excluded_participant_event.participant.full_name %></span>
          <button type="button" 
                  data-unlink="<%= excl.id %>" data-link-kind="exclusion"
                  class="text-red-500 hover:text-red-700">&times;</button>
        </div>
      <% end %>
      <% if participant_event.roommate_exclusions.empty? %>
        <p class="text-xs text-gray-400 italic">No linked exclusions</p>
      <% end %>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
async function unlinkPreference(linkId, kind) {
  if (!confirm('Remove this link?')) return;
  
  await fetch('<%= unlink_preference_admin_event_rooming_wizard_path(@event.slug) %>?' + new URLSearchParams({
    link_id: linkId,
    kind: kind
  }), {
    method: 'DELETE',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    }
  });
  
  location.reload();
}

// Rendered once per participant, so guard against stacking listeners.
// openLinkModal lives in the parent page and is resolved at click time.
if (!window.preferenceLinkHandlersInstalled) {
  window.preferenceLinkHandlersInstalled = true;

  document.addEventListener('click', (event) => {
    const openButton = event.target.closest('[data-open-link-modal]');
    if (openButton) {
      openLinkModal(openButton.dataset.openLinkModal, openButton.dataset.linkKind);
      return;
    }

    const unlinkButton = event.target.closest('[data-unlink]');
    if (unlinkButton) unlinkPreference(unlinkButton.dataset.unlink, unlinkButton.dataset.linkKind);
  });
}
</script>

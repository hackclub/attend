<%= tag.div class: "space-y-6", data: {
    controller: "rooming-assignments",
    rooming_assignments_move_url_value: move_assignment_admin_event_rooming_wizard_path(@event.slug),
    rooming_assignments_reorder_url_value: reorder_rooms_admin_event_rooming_wizard_path(@event.slug),
    rooming_assignments_update_room_url_value: update_room_admin_event_rooming_wizard_path(@event.slug),
    rooming_assignments_destroy_room_url_value: destroy_room_admin_event_rooming_wizard_path(@event.slug),
    rooming_assignments_remove_staff_url_value: remove_staff_admin_event_rooming_wizard_path(@event.slug),
    rooming_assignments_acknowledge_url_value: acknowledge_trans_nb_admin_event_rooming_wizard_path(@event.slug),
    rooming_assignments_drop_active_class: "bg-blue-50 border-blue-300"
} do %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Rooming Wizard</h1>
      <p class="mt-1 text-sm text-gray-600">Step 3: Review and adjust room assignments</p>
    </div>
    <div class="flex items-center gap-4">
      <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800">
        Step 3 of 4
      </span>
      <%= link_to preferences_admin_event_rooming_wizard_path(@event.slug), class: "text-sm text-gray-500 hover:text-gray-700" do %>
        ← Back to Preferences
      <% end %>
    </div>
  </div>

  <%= render "stay_switcher" %>

  <%= render "group_filter" %>

  <!-- Summary Bar -->
  <%= render partial: "admin/rooming_wizard/summary_bar" %>

  <div class="grid grid-cols-4 gap-6">
    <!-- Unassigned Participants Sidebar -->
    <div class="col-span-1">
      <%= render partial: "admin/rooming_wizard/unassigned_sidebar" %>
    </div>

    <!-- Rooms Grid -->
    <div class="col-span-3">
      <div id="rooms_container">
        <%= render partial: "admin/rooming_wizard/rooms_container" %>
      </div>
    </div>
  </div>
<% end %>

<!-- Add Room Modal -->
<div id="add-room-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75" data-hide="add-room-modal"></div>
    
    <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Add Room</h3>
      
      <%= form_with url: create_room_admin_event_rooming_wizard_path(@event.slug), method: :post, data: { turbo: false } do |f| %>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Room Name/Number</label>
            <input type="text" name="name" placeholder="e.g., Room 101" class="mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Capacity</label>
            <input type="number" name="capacity" value="<%= @rooming_plan.room_capacity %>" min="1" class="mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Notes</label>
            <textarea name="notes" rows="2" class="mt-1 block w-full rounded-md border-gray-300  focus:border-[#ec3750] focus:ring-[#ec3750]"></textarea>
          </div>
        </div>
        
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" data-hide="add-room-modal" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-md">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-[#d42f46] hover:bg-[#b82840] rounded-md">
            Create Room
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Add Staff Modal -->
<div id="add-staff-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true"
     data-controller="rooming-staff-modal"
     data-rooming-staff-modal-url-value="<%= add_staff_admin_event_rooming_wizard_path(@event.slug) %>"
     data-action="rooming-room:add-staff@window->rooming-staff-modal#open submit->rooming-staff-modal#submit">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75" data-hide="add-staff-modal"></div>
    
    <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Add Staff Member</h3>
      
      <form id="add-staff-form">
        <input type="hidden" id="add-staff-room-id" data-rooming-staff-modal-target="roomId">
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Staff Name</label>
            <input type="text" id="add-staff-name" placeholder="e.g., Deven" data-rooming-staff-modal-target="name"
                   class="mt-1 block w-full rounded-md border-gray-300  focus:border-orange-500 focus:ring-orange-500">
          </div>
          <p class="text-sm text-gray-500">
            Once a staff member is added to a room, participants cannot be assigned to it.
          </p>
        </div>
        
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" data-hide="add-staff-modal" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 border border-gray-300 rounded-md">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-orange-600 hover:bg-orange-700 rounded-md">
            Add Staff
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

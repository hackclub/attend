<%= form_with model: [:admin, current_event, group], local: true, class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Group details</h2>
      </div>
    </div>
    <div class="cs-container-body">
      <%= cs_form_field f, :name, label: "Name",
            constraint: "For example: Hardware, General attendance or Staff",
            messages: { taken: "This name is already in use by another group in this event." } do |aria| %>
        <%= f.text_field :name, class: "cs-input", required: true, **aria %>
      <% end %>

      <%= cs_form_field f, :slug, label: "Slug", optional: true,
            constraint: "Lowercase letters, numbers and hyphens (-) only. Used in URLs and filters. Leave blank to create one from the name.",
            messages: {
              blank: "Slug is required. Enter a slug or a name.",
              taken: "This slug is already in use.",
              invalid: "Enter a valid slug. Use lowercase letters, numbers and hyphens (-) only."
            } do |aria| %>
        <%= f.text_field :slug, class: "cs-input", pattern: "[a-z0-9\\-]+",
              data: { cs_pattern_message: "Enter a valid slug. Use lowercase letters, numbers and hyphens (-) only." }, **aria %>
      <% end %>

      <%= cs_form_field f, :color, label: "Color", optional: true,
            constraint: "A 6-digit hex color, with or without #. Used as the chip background. For example: #ec3750",
            messages: { invalid: "Enter a valid hex color. For example: #ec3750" } do |aria| %>
        <div class="flex items-center gap-2">
          <div class="w-40">
            <%= f.text_field :color, class: "cs-input", pattern: "#?[0-9a-fA-F]{6}",
                  data: { cs_pattern_message: "Enter a valid hex color. For example: #ec3750" }, **aria %>
          </div>
          <% if group.color.present? && group.errors[:color].empty? %>
            <span class="inline-block h-6 w-6 rounded border border-(--cs-border-input)" style="background-color: <%= group.normalized_color %>"></span>
          <% end %>
        </div>
      <% end %>

      <%= cs_form_field f, :description, label: "Description", optional: true do |aria| %>
        <%= f.text_area :description, rows: 2, class: "cs-input", **aria %>
      <% end %>

      <%= cs_form_field f, :position, label: "Display order", optional: true,
            constraint: "A whole number, 0 or more. Lower numbers appear first." do |aria| %>
        <div class="w-32">
          <%= f.number_field :position, class: "cs-input", min: 0, step: 1, **aria %>
        </div>
      <% end %>
    </div>
  </section>

  <%= cs_form_errors f %>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
    <%= link_to "Cancel", admin_event_groups_path(current_event), class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button group.persisted? ? "Update group" : "Create group", class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

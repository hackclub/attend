<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Groups", admin_event_groups_path(current_event) ], [ @group.name_was.presence || @group.name, nil ]) %>

<div class="max-w-3xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1 flex flex-wrap items-center gap-3">
        Edit group
        <% if @group.color.present? %>
          <span class="cs-badge" style="background-color: <%= @group.normalized_color %>; color: white;"><%= @group.name %></span>
        <% else %>
          <%= cs_badge(@group.name) %>
        <% end %>
      </h1>
    </div>
  </div>

  <div class="cs-stack">
    <%= render "form", group: @group %>

    <section class="cs-container">
      <div class="cs-container-header cs-container-header-divided">
        <div>
          <h2 class="cs-h2">Members <span class="cs-counter">(<%= @members.size %>)</span></h2>
        </div>
      </div>
      <% if @members.any? %>
        <div class="cs-table-wrap">
          <table class="cs-table">
            <thead>
              <tr>
                <th scope="col">Participant</th>
                <th scope="col">Email</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% @members.each do |pe| %>
                <tr>
                  <td><%= link_to pe.participant.display_name, admin_event_participant_path(current_event, pe.participant), class: "cs-link" %></td>
                  <td class="cs-secondary"><%= pe.participant.email %></td>
                  <td class="text-right">
                    <%= button_to "Remove", unassign_admin_event_group_path(current_event, @group, participant_event_ids: [pe.id]),
                        method: :post,
                        class: "cs-btn cs-btn-link",
                        form: { class: "contents", data: { turbo_confirm: "Remove this participant from the group?" } } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="cs-empty">
          <p class="cs-empty-title">No members yet.</p>
        </div>
      <% end %>
    </section>

    <%= form_with url: assign_admin_event_group_path(current_event, @group), method: :post, local: true do %>
      <section class="cs-container" data-controller="multiselect">
        <div class="cs-container-header">
          <div>
            <h2 class="cs-h2">Add members</h2>
          </div>
        </div>
        <div class="cs-filter-bar">
          <label class="cs-search flex-1">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
            <input type="search"
                   data-multiselect-target="search"
                   placeholder="Search participants..."
                   aria-label="Search participants"
                   class="cs-input"
                   data-action="input->multiselect#filter">
          </label>
          <span class="cs-secondary text-sm">
            <strong data-multiselect-target="count">0</strong> participant<span data-multiselect-target="plural">s</span> selected
          </span>
          <button type="button"
                  class="cs-btn cs-btn-link"
                  data-action="click->multiselect#clearAll">
            Clear all
          </button>
        </div>
        <div class="max-h-64 overflow-y-auto border-t border-(--cs-border-divider-secondary)" data-multiselect-target="list">
          <% if @available_participants.empty? %>
            <div class="cs-empty">
              <p class="cs-empty-title">All participants are already in this group.</p>
            </div>
          <% else %>
            <% @available_participants.each do |pe| %>
              <label class="flex items-center gap-3 px-5 py-2 cursor-pointer border-b border-(--cs-border-divider-secondary) last:border-0 hover:bg-(--cs-bg-hover)"
                     data-name="<%= pe.participant.display_name.downcase %> <%= pe.participant.email.downcase %>">
                <input type="checkbox"
                       name="participant_event_ids[]"
                       value="<%= pe.id %>"
                       class="accent-(--cs-accent)"
                       data-multiselect-target="checkbox"
                       data-action="change->multiselect#updateCount">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold truncate"><%= pe.participant.display_name %></p>
                  <p class="cs-small cs-muted truncate"><%= pe.participant.email %></p>
                </div>
              </label>
            <% end %>
          <% end %>
        </div>
        <div class="cs-container-footer flex justify-end">
          <button type="submit" class="cs-btn cs-btn-primary">Add selected</button>
        </div>
      </section>
    <% end %>
  </div>
</div>

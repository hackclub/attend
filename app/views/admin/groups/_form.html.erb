<%= form_with model: [:admin, current_event, group], local: true, class: "cs-stack" do |f| %>
  <% if group.errors.any? %>
    <div class="cs-alert cs-alert-error" role="alert">
      <%= cs_status_icon(:error) %>
      <div>
        <p class="cs-alert-title"><%= pluralize(group.errors.count, "error") %> prohibited this group from being saved:</p>
        <ul class="mt-1 list-disc list-inside">
          <% group.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Group details</h2>
      </div>
    </div>
    <div class="cs-container-body">
      <div class="cs-field">
        <%= f.label :name, class: "cs-field-label" %>
        <%= f.text_field :name, class: "cs-input", placeholder: "e.g., Hardware, General Attendance, Staff" %>
      </div>

      <div class="cs-field">
        <%= f.label :slug, class: "cs-field-label" %>
        <%= f.text_field :slug, class: "cs-input", placeholder: "auto-generated from name if blank" %>
        <p class="cs-field-hint">Lowercase, dashes only. Used for URLs / filters.</p>
      </div>

      <div class="cs-field">
        <%= f.label :color, "Color (hex)", class: "cs-field-label" %>
        <div class="flex items-center gap-2">
          <div class="w-40">
            <%= f.text_field :color, class: "cs-input", placeholder: "#ec3750" %>
          </div>
          <% if group.color.present? %>
            <span class="inline-block h-6 w-6 rounded border border-(--cs-border-input)" style="background-color: <%= group.normalized_color %>"></span>
          <% end %>
        </div>
        <p class="cs-field-hint">6-digit hex (with or without #). Used as the chip background.</p>
      </div>

      <div class="cs-field">
        <%= f.label :description, class: "cs-field-label" %>
        <%= f.text_area :description, rows: 2, class: "cs-input" %>
      </div>

      <div class="cs-field">
        <%= f.label :position, "Display order", class: "cs-field-label" %>
        <div class="w-32">
          <%= f.number_field :position, class: "cs-input", min: 0 %>
        </div>
      </div>
    </div>
  </section>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
    <%= link_to "Cancel", admin_event_groups_path(current_event), class: "cs-btn cs-btn-link cs-btn-full" %>
    <%= f.button group.persisted? ? "Update group" : "Create group", class: "cs-btn cs-btn-primary cs-btn-full" %>
  </div>
<% end %>

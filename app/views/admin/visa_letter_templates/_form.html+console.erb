<%# locals: template: %>
<%= form_with model: [ :admin, template ], local: true, html: { novalidate: true, multipart: true }, data: { controller: "cs-form-validation" } do |f| %>
  <div class="cs-stack">
    <section class="cs-container">
      <div class="cs-container-header"><h2 class="cs-h2">Template</h2></div>
      <div class="cs-container-body space-y-5">
        <%= cs_form_field f, :name, constraint: "For staff only. For example: Default visa letter" do |aria| %>
          <%= f.text_field :name, class: "cs-input", required: true, **aria %>
        <% end %>

        <%= cs_form_field f, :event_id, label: "Event", optional: true,
              description: "Leave empty for a template every event can use." do |aria| %>
          <%= f.collection_select :event_id, Event.order(starts_at: :desc), :id, :name, { include_blank: "Every event" }, class: "cs-select", **aria %>
        <% end %>

        <div class="cs-option">
          <%= f.check_box :is_default %>
          <div>
            <%= f.label :is_default, "Default for every event without its own", class: "cs-option-label" %>
            <p class="cs-option-description">Only one template can be the default. Ignored for a template that belongs to an event.</p>
          </div>
        </div>
        <div class="cs-option">
          <%= f.check_box :active %>
          <div>
            <%= f.label :active, "Active", class: "cs-option-label" %>
            <p class="cs-option-description">Inactive templates are never used for new letters.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Wording</h2>
          <p class="cs-container-description">Plain text. Leave a blank line between paragraphs; &lt;b&gt;, &lt;i&gt; and &lt;u&gt; work. The letterhead, date, signature and verification footer are added around it.</p>
        </div>
      </div>
      <div class="cs-container-body space-y-5">
        <%= cs_form_field f, :body, label: "Letter body", constraint: "At least 100 characters." do |aria| %>
          <%= f.text_area :body, rows: 22, class: "cs-input font-mono text-sm", required: true, **aria %>
        <% end %>
        <details>
          <summary class="cs-link cursor-pointer">Placeholders you can use</summary>
          <ul class="mt-2 grid gap-1 sm:grid-cols-2 cs-small font-mono">
            <% VisaLetterTemplate::PLACEHOLDERS.each do |placeholder| %>
              <li>{{<%= placeholder %>}}</li>
            <% end %>
          </ul>
        </details>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header"><h2 class="cs-h2">Signature</h2></div>
      <div class="cs-container-body space-y-5">
        <div class="cs-field-grid">
          <%= cs_form_field f, :signatory_name, label: "Signed by", constraint: "For example: Zach Latta" do |aria| %>
            <%= f.text_field :signatory_name, class: "cs-input", required: true, **aria %>
          <% end %>
          <%= cs_form_field f, :signatory_title, label: "Their title", constraint: "For example: Executive Director" do |aria| %>
            <%= f.text_field :signatory_title, class: "cs-input", required: true, **aria %>
          <% end %>
        </div>
        <%= cs_form_field f, :signature_image, label: "Signature image", optional: true,
              description: (template.signature_image.attached? ? "A signature is uploaded. Choose a file to replace it." : "Printed above the name. Without one, the space is left for a handwritten signature."),
              constraint: "PNG or JPEG." do |aria| %>
          <%= f.file_field :signature_image, accept: "image/png,image/jpeg", class: "cs-input", **aria %>
        <% end %>
      </div>
    </section>

    <%= cs_form_errors f %>

    <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
      <% if template.persisted? %>
        <%= link_to "Preview saved version", preview_admin_visa_letter_template_path(template), class: "cs-btn cs-btn-link", target: "_blank", rel: "noopener" %>
      <% end %>
      <%= link_to "Cancel", admin_visa_letter_templates_path, class: "cs-btn cs-btn-link" %>
      <%= f.button template.persisted? ? "Save template" : "Add template", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  </div>
<% end %>

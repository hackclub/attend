<% content_for :title, "#{@template.name_was || @template.name} – Visa letter templates – Attend" %>
<div class="max-w-3xl space-y-6">
  <%= link_to "← Visa letter templates", admin_visa_letter_templates_path, class: "text-sm text-gray-500 hover:text-[#ec3750]" %>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @template.name_was || @template.name %></h1>
      <p class="text-sm text-gray-500">Changes apply to letters issued from now on. Letters already sent keep their wording.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Preview", preview_admin_visa_letter_template_path(@template), class: "px-3 py-2 border border-gray-300 rounded-md text-sm", target: "_blank", rel: "noopener" %>
      <%= button_to "Remove", admin_visa_letter_template_path(@template), method: :delete, class: "px-3 py-2 border border-gray-300 rounded-md text-sm",
            form: { data: { turbo_confirm: @template.is_default? && @template.event_id.nil? ? "Remove the default template? Events without their own won't be able to issue letters until there's a new default." : "Remove #{@template.name}?" } } %>
    </div>
  </div>
  <%= render "form", template: @template %>
</div>

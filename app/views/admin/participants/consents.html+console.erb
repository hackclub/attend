<% content_for :title, "Consents – #{@participant_event.participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <div class="cs-stack">
  <section class="cs-container">
    <div class="cs-container-header">
      <div>
        <h2 class="cs-h2">Code of conduct and safeguarding</h2>
        <p class="cs-container-description">
          <a href="https://hackclub.com/conduct/" target="_blank" class="cs-link">hackclub.com/conduct</a>
          ·
          <a href="https://hackclub.com/safeguarding" target="_blank" class="cs-link">hackclub.com/safeguarding</a>
        </p>
      </div>
      <div class="cs-actions">
        <% if @participant_event.code_of_conduct_accepted_at.present? %>
          <%= cs_status(:success, "Signed") %>
        <% else %>
          <%= cs_status(:pending, "Pending") %>
        <% end %>
      </div>
    </div>

    <div class="cs-container-body">
      <% if @participant_event.code_of_conduct_accepted_at.present? %>
        <dl class="cs-kv cs-kv-2">
          <div>
            <dt class="cs-kv-label">Digital signature</dt>
            <dd class="cs-kv-value"><%= @participant_event.code_of_conduct_signature %></dd>
          </div>
          <div>
            <dt class="cs-kv-label">Signed</dt>
            <dd class="cs-kv-value">
              <%= cs_absolute_time_tag(@participant_event.code_of_conduct_accepted_at) %>
            </dd>
          </div>
        </dl>
      <% else %>
        <p class="cs-muted">The participant has not yet signed the code of conduct and safeguarding policy.</p>
      <% end %>
    </div>
  </section>

  <section class="cs-container">
  <div class="cs-container-header cs-container-header-divided">
    <h2 class="cs-h2">Document consents</h2>

    <div class="cs-actions">
      <% waiver_consent = @consents.find { |c| c.waiver? } %>
      <% if waiver_consent&.signed? %>
        <%= button_to "Resend completion email", resend_waiver_completion_email_admin_event_participant_path(current_event, @participant_event),
          method: :post,
          class: "cs-btn",
          data: { turbo_confirm: "This will resend the waiver completion email. Continue?" } %>
      <% end %>

      <% if policy(@participant_event).reset_waiver? %>
        <% freedom_waiver_consent = @consents.find { |c| c.freedom_waiver? } %>
        <% if waiver_consent || (freedom_waiver_consent && current_event.freedom_waivers_enabled?) %>
            <% if waiver_consent %>
              <% waiver_reset_confirm = if @participant_event.requires_guardian?
                "This will clear all DocuSeal data and reset the waiver to pending. The guardian will be emailed with a link to complete it. Are you sure?"
              else
                "This will clear all DocuSeal data and reset the waiver to pending. The participant will be emailed with a link to sign a new waiver. Are you sure?"
              end %>
              <%= button_to "Reset waiver", reset_waiver_admin_event_participant_path(current_event, @participant_event),
                method: :delete,
                class: "cs-btn",
                data: { turbo_confirm: waiver_reset_confirm } %>
            <% end %>
            <% if freedom_waiver_consent && current_event.freedom_waivers_enabled? %>
              <% freedom_reset_confirm = if @participant_event.requires_guardian?
                "This will reset the freedom waiver and clear the freedom waiver granted status. The guardian will be emailed with a link to complete it. Are you sure?"
              else
                "This will reset the freedom waiver and clear the freedom waiver granted status. The participant will be emailed with a link to sign a new waiver. Are you sure?"
              end %>
              <%= button_to "Reset freedom waiver", reset_freedom_waiver_admin_event_participant_path(current_event, @participant_event),
                method: :delete,
                class: "cs-btn",
                data: { turbo_confirm: freedom_reset_confirm } %>
            <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="cs-table-wrap">
    <table class="cs-table">
      <thead>
        <tr>
          <th scope="col">Consent type</th>
          <th scope="col">Status</th>
          <th scope="col">Signed by</th>
          <th scope="col">Signed</th>
          <th scope="col" class="text-right">Document</th>
        </tr>
      </thead>
      <tbody>
        <% # Consents for applicable custom documents render in the Additional
           # Documents section below; keep only ones whose document was since
           # archived or stopped applying (they remain legal records). %>
        <% shown_below = @custom_documents.map(&:id).to_set %>
        <% filtered_consents = @consents.reject { |c| c.freedom_waiver? && !current_event.freedom_waivers_enabled? } %>
        <% filtered_consents = filtered_consents.reject { |c| shown_below.include?(c.custom_document_id) } %>
        <% if filtered_consents.any? %>
          <% filtered_consents.each do |consent| %>
            <tr>
              <td>
                <div class="font-bold"><%= consent.display_name %></div>
                <% if Consent::REQUIRED_CONSENT_TYPES.include?(consent.consent_type) %>
                  <span class="cs-small cs-muted">Required</span>
                <% elsif consent.withdrawn? %>
                  <span class="cs-small cs-muted">
                    Optional — removed by participant <%= cs_relative_time(consent.withdrawn_at, inline: true) %>
                  </span>
                <% end %>
              </td>
              <td>
                <% status_type = case consent.status
                   when 'signed' then :success
                   when 'pending', 'sent', 'viewed' then :pending
                   when 'voided', 'failed' then :error
                   else :info
                   end %>
                <%= cs_status(status_type, consent.status.titleize) %>
                <% if consent.failure_reason.present? %>
                  <div class="mt-1"><%= cs_status(:error, consent.failure_reason.titleize) %></div>
                <% end %>
              </td>
              <td class="cs-secondary">
                <% if consent.guardian_participant_event&.guardian %>
                  <%= consent.guardian_participant_event.guardian.full_name %>
                  <span class="cs-small cs-muted">(Guardian)</span>
                <% elsif consent.signed? %>
                  <span>Participant</span>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="cs-secondary">
                <% if consent.signed_at %>
                  <%= cs_absolute_time_tag(consent.signed_at) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="text-right">
                <% if consent.physical_uploaded? %>
                  <div class="space-y-1">
                    <% consent.physical_uploads.each_with_index do |upload, i| %>
                      <div>
                        <%= link_to "View upload#{" #{i + 1}" if consent.physical_uploads.size > 1}",
                            viewable_upload_path(upload), target: "_blank",
                            class: "cs-link" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif signed_document_labels(consent, "View document").any? %>
                  <div class="space-y-1">
                    <% signed_document_labels(consent, "View document").each_with_index do |document_label, i| %>
                      <div>
                        <%= link_to document_label,
                            consent_document_admin_event_participant_path(current_event, @participant_event, consent_id: consent.id, index: i),
                            target: "_blank", class: "cs-link" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif consent.docuseal_envelope_id.present? %>
                  <span class="cs-muted">DocuSeal: <%= consent.docuseal_envelope_id %></span>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5">
              <div class="cs-empty">
                <p class="cs-empty-title">No consent records</p>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  </section>

  <% if @custom_documents.any? %>
    <% can_resend_custom_documents = policy(@participant_event).reset_waiver? %>
    <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Additional documents</h2>
    </div>
    <div class="cs-table-wrap">
      <table class="cs-table">
        <thead>
          <tr>
            <th scope="col">Document</th>
            <th scope="col">Status</th>
            <th scope="col">Signed by</th>
            <th scope="col">Signed</th>
            <th scope="col" class="text-right">Document</th>
            <% if can_resend_custom_documents %>
              <th scope="col" class="text-right">Actions</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @custom_documents.each do |doc| %>
            <% consent = @custom_document_consents[doc.id] %>
            <% status_label, status_type = if consent&.signed?
                 [ "Signed", :success ]
               elsif consent&.physical_uploaded?
                 [ "Awaiting guardian confirmation", :pending ]
               elsif doc.physical?
                 [ doc.participant_signs? ? "Awaiting participant upload" : "Awaiting guardian upload", :pending ]
               elsif consent.nil? || consent.pending?
                 [ "Not started", :stopped ]
               elsif consent.voided? || consent.failed?
                 [ consent.status.titleize, :error ]
               else
                 [ consent.status.titleize, :in_progress ]
               end %>
            <tr>
              <td>
                <div class="font-bold">
                  <%= doc.name %>
                  <% if doc.optional? %>
                    <span class="ml-1 font-normal"><%= cs_badge("Optional", "blue") %></span>
                  <% end %>
                </div>
                <span class="cs-small cs-muted">
                  <%= doc.physical? ? "Signed on paper" : "DocuSeal" %>
                  · <%= doc.signer_type.to_s.delete_prefix("signed_by_").humanize %>
                  <% if doc.optional? && consent&.opted_in_at %>
                    · Added <%= cs_relative_time(consent.opted_in_at, inline: true) %>
                  <% end %>
                </span>
              </td>
              <td>
                <%= cs_status(status_type, status_label) %>
                <% if consent&.failure_reason.present? %>
                  <div class="mt-1"><%= cs_status(:error, consent.failure_reason.titleize) %></div>
                <% end %>
              </td>
              <td class="cs-secondary">
                <% if consent&.guardian_participant_event&.guardian %>
                  <%= consent.guardian_participant_event.guardian.full_name %>
                  <span class="cs-small cs-muted">(Guardian)</span>
                <% elsif consent&.signed? %>
                  <span>Participant</span>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="cs-secondary">
                <% if consent&.signed_at %>
                  <%= cs_absolute_time_tag(consent.signed_at) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="text-right">
                <% if consent&.physical_uploaded? %>
                  <div class="space-y-1">
                    <% consent.physical_uploads.each_with_index do |upload, i| %>
                      <div>
                        <%= link_to "View upload#{" #{i + 1}" if consent.physical_uploads.size > 1}",
                            viewable_upload_path(upload), target: "_blank",
                            class: "cs-link" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif consent && signed_document_labels(consent, "View document").any? %>
                  <div class="space-y-1">
                    <% signed_document_labels(consent, "View document").each_with_index do |document_label, i| %>
                      <div>
                        <%= link_to document_label,
                            consent_document_admin_event_participant_path(current_event, @participant_event, consent_id: consent.id, index: i),
                            target: "_blank", class: "cs-link" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif consent&.docuseal_envelope_id.present? %>
                  <span class="cs-muted">DocuSeal: <%= consent.docuseal_envelope_id %></span>
                <% else %>
                  —
                <% end %>
              </td>
              <% if can_resend_custom_documents %>
                <td class="text-right">
                  <% # Paper documents never touch DocuSeal. Signed ones can only
                     # be re-issued through Reset, which says out loud that the
                     # signature is being discarded. %>
                  <% if !doc.electronic? %>
                    <span class="cs-muted">—</span>
                  <% elsif consent&.signed? %>
                    <%= button_to "Reset", reset_custom_document_admin_event_participant_path(current_event, @participant_event),
                        method: :delete,
                        params: { custom_document_id: doc.id },
                        class: "cs-btn cs-btn-link",
                        data: { turbo_confirm: "Reset this document? The existing signature is discarded, a new one is issued, and this participant goes back to in progress. Are you sure?" } %>
                  <% else %>
                    <%= button_to "Resend", resend_custom_document_admin_event_participant_path(current_event, @participant_event),
                        method: :post,
                        params: { custom_document_id: doc.id },
                        class: "cs-btn cs-btn-link",
                        data: { turbo_confirm: "Re-send this document? Any existing DocuSeal link stops working and a new one is issued." } %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    </section>
  <% end %>

  <% if @unadded_optional_documents.any? %>
    <section class="cs-container">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Optional documents not added</h2>
          <p class="cs-container-description">
            Offered for opt-in activities. This participant hasn't taken these up, so no signature is
            expected and nothing has been sent to their parent/guardian.
          </p>
        </div>
      </div>
      <div class="cs-container-body">
        <div class="cs-token-group">
          <% @unadded_optional_documents.each do |doc| %>
            <span class="cs-token cs-token-readonly"><%= doc.name %></span>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Required consents</h2>
    </div>
    <div class="cs-container-body">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <% required_types = Consent::REQUIRED_CONSENT_TYPES.reject { |t| t == "freedom_waiver" && !current_event.freedom_waivers_enabled? } %>
        <% required_types.each do |type| %>
          <% if type == "code_of_conduct" %>
            <% is_complete = @participant_event.code_of_conduct_accepted_at.present? %>
          <% else %>
            <% consent = @consents.find { |c| c.consent_type == type } %>
            <% is_complete = consent&.signed? %>
          <% end %>
          <li><%= cs_status(is_complete ? :success : :stopped, type.titleize) %></li>
        <% end %>
      </ul>
    </div>
  </section>
  </div>
</div>

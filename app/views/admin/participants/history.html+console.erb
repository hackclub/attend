<% content_for :title, "History – #{@participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <div>
        <h2 class="cs-h2">Change history</h2>
        <p class="cs-container-description">All changes to this participant and their related records.</p>
      </div>
    </div>
    <% if @versions.any? %>
      <div class="divide-y divide-(--cs-border-divider-secondary)">
        <% @versions.each do |version| %>
          <% changes = audit_version_changes(version, hide_pii: !can_view_participant_pii?) %>
          <details class="cs-expandable">
            <summary class="px-4 sm:px-5 py-3 font-normal! hover:bg-(--cs-bg-hover)">
              <span class="cs-small cs-muted font-mono w-40 flex-shrink-0 hidden sm:block"><%= version.created_at.strftime("%Y-%m-%d %H:%M") %></span>
              <span class="cs-small cs-muted sm:hidden"><%= time_ago_in_words(version.created_at) %> ago</span>
              <% badge_color = case version.event when "create" then "green" when "update" then "blue" when "destroy" then "red" end %>
              <span class="w-20 flex-shrink-0"><%= cs_badge(version.event.titleize, badge_color) %></span>
              <span class="font-bold flex-shrink-0"><%= version.item_type.titleize %></span>
              <span class="cs-secondary flex-1 truncate text-right"><%= audit_user_label(version.whodunnit, @users_by_id) %></span>
              <span class="cs-small cs-muted flex-shrink-0">
                <% if changes.any? %><%= pluralize(changes.size, "field") %><% else %>—<% end %>
              </span>
            </summary>
            <div class="cs-expandable-content px-4 sm:px-5 pb-4 bg-(--cs-bg-shaded)">
              <% if changes.any? %>
                <dl class="space-y-2">
                  <% changes.each do |field, change| %>
                    <% old_value, new_value = change.is_a?(Array) ? change : [nil, change] %>
                    <div>
                      <dt class="cs-kv-label cs-small mb-1"><%= audit_field_label(field) %></dt>
                      <% if version.event == "create" %>
                        <dd class="cs-small rounded px-2 py-1 border border-(--cs-success) bg-(--cs-success-bg)"><%= audit_format_value(field, new_value) %></dd>
                      <% elsif version.event == "destroy" %>
                        <dd class="cs-small rounded px-2 py-1 border border-(--cs-error) bg-(--cs-error-bg) line-through"><%= audit_format_value(field, old_value) %></dd>
                      <% else %>
                        <dd class="grid grid-cols-1 md:grid-cols-2 gap-2 cs-small">
                          <div class="rounded px-2 py-1 border border-(--cs-error) bg-(--cs-error-bg)"><span class="sr-only">Before: </span><%= audit_format_value(field, old_value) %></div>
                          <div class="rounded px-2 py-1 border border-(--cs-success) bg-(--cs-success-bg)"><span class="sr-only">After: </span><%= audit_format_value(field, new_value) %></div>
                        </dd>
                      <% end %>
                    </div>
                  <% end %>
                </dl>
              <% else %>
                <p class="cs-small cs-muted italic py-2">No tracked field changes recorded for this version.</p>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
      <% if @versions.size >= 500 %>
        <div class="cs-container-footer">Showing first 500 results.</div>
      <% end %>
    <% else %>
      <div class="cs-empty">
        <p class="cs-empty-title">No change history yet.</p>
      </div>
    <% end %>
  </section>
</div>

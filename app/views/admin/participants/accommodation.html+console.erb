<% content_for :title, "Accommodation – #{@participant_event.participant.full_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <%= form_with model: @accommodation, url: accommodation_admin_event_participant_path(current_event, @participant_event), method: :patch, local: true, class: "cs-stack", html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Accommodation details</h2>
      </div>
      <div class="cs-container-body">
        <div class="cs-field-grid mb-4">
          <%= cs_form_field f, :check_in_date, label: "Check-in date", as: :date_field, optional: true %>
          <%= cs_form_field f, :check_out_date, label: "Check-out date", as: :date_field, optional: true,
                input: { data: { cs_after: f.field_id(:check_in_date), cs_after_message: "Check-out date must be after the check-in date." } } %>
        </div>

        <%= cs_form_field f, :gender_base, label: "Gender identity", optional: true, group: true, id: "gender_base" do |aria| %>
          <div class="cs-tiles">
            <label class="cs-tile">
              <span class="cs-option">
                <%= f.radio_button :gender_base, "female", { id: "gender_base_female", **aria } %>
                <span class="cs-option-label">Woman</span>
              </span>
            </label>
            <label class="cs-tile">
              <span class="cs-option">
                <%= f.radio_button :gender_base, "male", { id: "gender_base_male", **aria } %>
                <span class="cs-option-label">Man</span>
              </span>
            </label>
            <label class="cs-tile">
              <span class="cs-option">
                <%= f.radio_button :gender_base, "non_binary", { id: "gender_base_non_binary", **aria } %>
                <span class="cs-option-label">Non-binary</span>
              </span>
            </label>
          </div>
        <% end %>

        <div class="cs-field">
          <div class="cs-option">
            <%= f.check_box :is_transgender, { id: "is_transgender_checkbox" }, "true", "false" %>
            <div><label class="cs-option-label" for="is_transgender_checkbox">Transgender</label></div>
          </div>
        </div>

        <%= cs_form_field f, :preferred_roommate_genders, label: "Preferred roommate genders", optional: true, group: true, id: "preferred_roommate_genders" do |aria| %>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <% Accommodation::ROOMMATE_GENDER_OPTIONS.each do |key, value| %>
              <label class="flex items-center gap-2 cursor-pointer">
                <%= check_box_tag "accommodation[preferred_roommate_genders][]",
                  value,
                  @accommodation.preferred_roommate_genders&.include?(value),
                  id: "preferred_roommate_genders_#{key}",
                  class: "w-4 h-4 accent-(--cs-accent)", **aria %>
                <span><%= key.to_s.titleize %></span>
              </label>
            <% end %>
          </div>
        <% end %>

        <%= cs_form_field f, :roommate_preferences, label: "Roommate preferences", optional: true, as: :text_area, input: { rows: 3 },
              constraint: "Names of requested roommates." %>
        <%= cs_form_field f, :roommate_exclusions, label: "Roommate exclusions", optional: true, as: :text_area, input: { rows: 3 },
              constraint: "People this participant should not be roomed with." %>
        <%= cs_form_field f, :accessibility_needs, label: "Accessibility needs", optional: true, as: :text_area, input: { rows: 3 } %>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Room assignment (admin only)</h2>
      </div>
      <div class="cs-container-body">
        <div class="cs-field">
          <div class="cs-option">
            <%= f.check_box :rooming_exempt %>
            <div>
              <%= f.label :rooming_exempt, "Exempt from rooming", class: "cs-option-label" %>
              <p class="cs-option-description">Select if this participant doesn't need a room, for example because they're staying at home.</p>
            </div>
          </div>
        </div>

        <%= cs_form_field f, :assigned_room, label: "Assigned room", optional: true %>
        <%= cs_form_field f, :notes, label: "Admin notes", optional: true, as: :text_area, input: { rows: 3 } %>
      </div>
    </section>

    <%= cs_form_errors f, title: "This accommodation couldn't be saved." %>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
      <%= link_to "Cancel", admin_event_participant_path(current_event, @participant_event), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button "Save accommodation", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

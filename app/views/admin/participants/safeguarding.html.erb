<% content_for :title, "Safeguarding – #{@participant_event.participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <div class="bg-purple-50 border border-purple-200 text-purple-800 px-4 py-3 rounded mb-6">
    <strong>🔒 Restricted Access</strong>
    <p class="text-sm mt-1">This information is restricted to safeguarding leads only.</p>
  </div>

  <div class="space-y-6">
    <section class="bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-lg font-semibold mb-4">Engagement Preference</h2>
      <p class="text-sm text-gray-500 mb-3">How this participant prefers to engage at events – helps identify if low participation is a concern or simply their preference.</p>

      <% participant = @participant_event.participant %>
      <% if participant.engagement_preference.present? || participant.engagement_notes.present? %>
        <div class="space-y-3">
          <% if participant.engagement_preference.present? %>
            <div class="flex items-center gap-2">
              <% preference = participant.engagement_preference %>
              <% badge_class = case preference
                when "very_social" then "bg-green-100 text-green-800"
                when "social_with_downtime" then "bg-blue-100 text-blue-800"
                when "balanced" then "bg-gray-100 text-gray-800"
                when "mostly_focused" then "bg-yellow-100 text-yellow-800"
                when "very_focused" then "bg-orange-100 text-orange-800"
                else "bg-gray-100 text-gray-800"
              end %>
              <% preference_label = {
                "very_social" => "Very social – loves group activities",
                "social_with_downtime" => "Social with downtime needed",
                "balanced" => "Balanced – mix of social and focused",
                "mostly_focused" => "Mostly focused on projects",
                "very_focused" => "Very focused – prefers heads-down work"
              }[preference] || preference.humanize %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= badge_class %>">
                <%= preference_label %>
              </span>
            </div>
          <% end %>

          <% if participant.engagement_notes.present? %>
            <div class="bg-gray-50 border border-gray-200 rounded-md p-3">
              <p class="text-sm text-gray-700"><%= participant.engagement_notes %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 italic">Not provided</p>
      <% end %>
    </section>
    <section class="bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-lg font-semibold mb-4">Safeguarding Flags</h2>

      <%= form_with model: @safeguarding_info, url: safeguarding_admin_event_participant_path(current_event, @participant_event), method: :patch, local: true do |f| %>
        <% if @safeguarding_info.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-6">
            <ul class="list-disc list-inside">
              <% @safeguarding_info.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-6">
          <div class="space-y-4">
            <div>
              <%= f.label :high_support_flag, class: "flex items-center gap-2 cursor-pointer" do %>
                <%= f.check_box :high_support_flag, class: "w-4 h-4 rounded border-gray-300 text-purple-600 focus:ring-purple-500" %>
                <span class="text-sm font-medium text-purple-700">High Support Flag</span>
              <% end %>
              <p class="ml-6 text-sm text-gray-500">Mark if participant requires additional support</p>
            </div>

            <div>
              <%= f.label :high_support_notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_area :high_support_notes, rows: 3, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
            </div>
          </div>

          <div class="space-y-4">
            <% if current_event.freedom_waivers_enabled? %>
            <div>
              <%= f.label :freedom_waiver_granted, class: "flex items-center gap-2 cursor-pointer" do %>
                <%= f.check_box :freedom_waiver_granted, class: "w-4 h-4 rounded border-gray-300 text-green-600 focus:ring-green-500" %>
                <span class="text-sm font-medium text-green-700">Freedom Waiver Granted</span>
              <% end %>
              <p class="ml-6 text-sm text-gray-500">Participant has guardian permission for independent movement</p>
            </div>
            <% end %>

            <div>
              <%= f.label :can_leave_unaccompanied, class: "flex items-center gap-2 cursor-pointer" do %>
                <%= f.check_box :can_leave_unaccompanied, class: "w-4 h-4 rounded border-gray-300 text-[#ec3750] focus:ring-[#ec3750]" %>
                <span class="text-sm font-medium text-gray-700">Can Leave Unaccompanied</span>
              <% end %>
              <p class="ml-6 text-sm text-gray-500">Participant can leave venue without supervision</p>
            </div>
          </div>

          <div>
            <%= f.label :authorized_pickup_adults, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :authorized_pickup_adults, rows: 3, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
            <p class="mt-1 text-sm text-gray-500">Names and contact information of adults authorized to pick up the participant</p>
          </div>

          <div>
            <%= f.label :other_instructions, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :other_instructions, rows: 3, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500" %>
            <p class="mt-1 text-sm text-gray-500">Any other safeguarding instructions or notes</p>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-3">
            <%= f.submit "Save Safeguarding Information", class: "w-full sm:w-auto bg-purple-600 text-white px-6 py-2 rounded-md hover:bg-purple-700 cursor-pointer" %>
            <%= link_to "Cancel", admin_event_participant_path(current_event, @participant_event), class: "w-full sm:w-auto text-center px-6 py-2 text-gray-600 hover:text-gray-900" %>
          </div>
        </div>
      <% end %>
    </section>

    <section class="bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-lg font-semibold mb-4">Guardians</h2>

      <% if @guardians.any? %>
        <div class="space-y-4">
          <% @guardians.each do |guardian| %>
            <div class="border rounded-lg p-4">
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-gray-900"><%= guardian.full_name %></div>
                  <div class="text-sm text-gray-600"><%= guardian.email %></div>
                  <% if guardian.phone.present? %>
                    <div class="text-sm text-gray-600"><%= guardian.phone %></div>
                  <% end %>
                  <% if guardian.address_line_1.present? %>
                    <div class="text-sm text-gray-500 mt-2">
                      <%= guardian.address_line_1 %><br>
                      <% if guardian.address_line_2.present? %><%= guardian.address_line_2 %><br><% end %>
                      <%= [guardian.city, guardian.state, guardian.postal_code].compact.join(", ") %><br>
                      <%= guardian.country %>
                    </div>
                  <% end %>
                </div>
                <% gpe = @participant_event.guardian_participant_events.find_by(guardian: guardian) %>
                <% if gpe&.is_primary_guardian %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">Primary</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">No guardians linked to this participant.</p>
      <% end %>
    </section>

    <section class="bg-white rounded-lg border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold">Emergency Contacts</h2>
        <% if policy(@participant_event).update_safeguarding? %>
          <%= link_to "+ Add contact", new_admin_event_participant_emergency_contact_path(current_event, @participant_event), class: "text-sm bg-purple-600 text-white px-3 py-1.5 rounded-md hover:bg-purple-700" %>
        <% end %>
      </div>

      <% if @emergency_contacts.any? %>
        <div class="space-y-3">
          <% @emergency_contacts.order(:priority).each_with_index do |contact, index| %>
            <div class="flex items-start gap-4 border-b border-gray-100 pb-3 last:border-0 last:pb-0">
              <span class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-xs font-medium"><%= index + 1 %></span>
              <div class="flex-1">
                <div class="font-medium text-gray-900"><%= contact.name %></div>
                <div class="text-sm text-gray-600"><%= contact.phone %></div>
                <% if contact.email.present? %>
                  <div class="text-sm text-gray-600"><%= contact.email %></div>
                <% end %>
                <% if contact.relationship.present? %>
                  <div class="text-sm text-gray-500"><%= contact.relationship %></div>
                <% end %>
                <% if contact.guardian.present? %>
                  <div class="text-xs text-gray-400 mt-1">Linked to guardian: <%= contact.guardian.full_name %></div>
                <% end %>
              </div>
              <% if policy(@participant_event).update_safeguarding? %>
                <div class="flex gap-3 text-sm">
                  <%= link_to "Edit", edit_admin_event_participant_emergency_contact_path(current_event, @participant_event, contact), class: "text-purple-600 hover:text-purple-700" %>
                  <%= button_to "Delete", admin_event_participant_emergency_contact_path(current_event, @participant_event, contact), method: :delete, data: { turbo_confirm: "Delete this emergency contact?" }, class: "text-red-600 hover:text-red-700 cursor-pointer", form: { class: "inline" } %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">No emergency contacts recorded.</p>
      <% end %>
    </section>
  </div>
</div>

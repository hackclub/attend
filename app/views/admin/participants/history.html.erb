<% content_for :title, "History – #{@participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <div class="flex justify-between items-center mb-4">
    <h2 class="text-lg font-semibold">Change history</h2>
    <span class="text-sm text-gray-500">All changes to this participant and their related records.</span>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <% if @versions.any? %>
      <div class="divide-y divide-gray-100">
        <% @versions.each do |version| %>
          <% changes = audit_version_changes(version, hide_pii: !can_view_participant_pii?) %>
          <details class="group">
            <summary class="px-4 sm:px-6 py-3 flex items-center gap-3 cursor-pointer hover:bg-gray-50 list-none">
              <span class="text-xs text-gray-500 font-mono w-40 flex-shrink-0 hidden sm:block"><%= version.created_at.strftime("%Y-%m-%d %H:%M") %></span>
              <span class="text-xs text-gray-500 sm:hidden"><%= time_ago_in_words(version.created_at) %> ago</span>
              <% color = case version.event when "create" then "bg-green-100 text-green-800" when "update" then "bg-blue-100 text-blue-800" when "destroy" then "bg-red-100 text-red-800" else "bg-gray-100 text-gray-800" end %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= color %> w-20 justify-center flex-shrink-0"><%= version.event.titleize %></span>
              <span class="text-sm font-medium text-gray-900 flex-shrink-0"><%= version.item_type.titleize %></span>
              <span class="text-sm text-gray-600 flex-1 truncate text-right"><%= audit_user_label(version.whodunnit, @users_by_id) %></span>
              <span class="text-xs text-gray-400 flex-shrink-0">
                <% if changes.any? %><%= pluralize(changes.size, "field") %><% else %>—<% end %>
              </span>
              <span class="text-gray-400 group-open:rotate-90 transition-transform">›</span>
            </summary>
            <div class="px-4 sm:px-6 pb-4 pt-1 bg-gray-50">
              <% if changes.any? %>
                <div class="space-y-2">
                  <% changes.each do |field, change| %>
                    <% old_value, new_value = change.is_a?(Array) ? change : [nil, change] %>
                    <div>
                      <div class="text-xs font-medium text-gray-700 mb-1"><%= audit_field_label(field) %></div>
                      <% if version.event == "create" %>
                        <div class="text-xs bg-green-50 border border-green-200 rounded px-2 py-1 text-green-900"><%= audit_format_value(field, new_value) %></div>
                      <% elsif version.event == "destroy" %>
                        <div class="text-xs bg-red-50 border border-red-200 rounded px-2 py-1 text-red-900 line-through"><%= audit_format_value(field, old_value) %></div>
                      <% else %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
                          <div class="bg-red-50 border border-red-200 rounded px-2 py-1 text-red-900"><%= audit_format_value(field, old_value) %></div>
                          <div class="bg-green-50 border border-green-200 rounded px-2 py-1 text-green-900"><%= audit_format_value(field, new_value) %></div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-xs text-gray-500 italic py-2">No tracked field changes recorded for this version.</div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
      <% if @versions.size >= 500 %>
        <div class="px-6 py-3 text-xs text-gray-500 border-t border-gray-100">Showing first 500 results.</div>
      <% end %>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">No change history yet.</div>
    <% end %>
  </div>
</div>

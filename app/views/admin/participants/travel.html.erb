<% content_for :title, "Travel – #{@participant_event.participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <% if @participant_event.unaccompanied_minor_declared? || !@participant_event.um_none? || @participant_event.um_proof.attached? %>
    <section class="cs-container mb-5">
      <div class="cs-container-header">
        <div>
          <h2 class="cs-h2">Unaccompanied Minor Verification</h2>
          <p class="cs-container-description">
            UM means the airline's formal (paid) unaccompanied minor chaperone service — not just an under-18 travelling alone.
            Only approved participants show the UM badge in the Travel Calendar and admin views.
          </p>
        </div>
        <% badge = {
          "none" => ["Not reviewed", :stopped],
          "pending" => ["Pending review", :pending],
          "approved" => ["Verified UM", :success],
          "rejected" => ["Rejected", :error]
        }[@participant_event.um_status] %>
        <div class="cs-actions"><%= cs_status(badge[1], badge[0]) %></div>
      </div>

      <div class="cs-container-body">
        <dl class="cs-kv cs-kv-2">
          <div>
            <dt class="cs-kv-label">Declared on</dt>
            <dd class="cs-kv-value">
              <%= [("inbound flight" if @participant_event.travel_inbound&.plane? && @participant_event.travel_inbound.is_unaccompanied_minor?),
                   ("outbound flight" if @participant_event.travel_outbound&.plane? && @participant_event.travel_outbound.is_unaccompanied_minor?)].compact.join(" and ").presence || "—" %>
            </dd>
          </div>
          <div>
            <dt class="cs-kv-label">Proof of UM booking</dt>
            <dd class="cs-kv-value">
              <% if @participant_event.um_proof.attached? %>
                <%= link_to @participant_event.um_proof.filename, um_proof_admin_event_participant_path(current_event, @participant_event), target: "_blank", rel: "noopener", class: "cs-link" %>
              <% else %>
                Not uploaded
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="cs-kv-label">Guardian double-confirmed</dt>
            <dd class="cs-kv-value"><%= @participant_event.um_guardian_confirmed_at&.strftime("%b %d, %Y %H:%M") || "Not yet" %></dd>
          </div>
          <% if @participant_event.um_verified_at.present? %>
            <div>
              <dt class="cs-kv-label">Reviewed</dt>
              <dd class="cs-kv-value"><%= @participant_event.um_verified_at.strftime("%b %d, %Y %H:%M") %><%= " by #{@participant_event.um_verified_by.name || @participant_event.um_verified_by.email}" if @participant_event.um_verified_by %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="cs-container-footer flex flex-wrap justify-end gap-2">
        <% unless @participant_event.um_rejected? %>
          <%= button_to "Reject UM status", reject_um_admin_event_participant_path(current_event, @participant_event), method: :post, class: "cs-btn" %>
        <% end %>
        <% unless @participant_event.um_approved? %>
          <%= button_to "Approve UM status", approve_um_admin_event_participant_path(current_event, @participant_event), method: :post, class: "cs-btn cs-btn-primary" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= form_with url: travel_admin_event_participant_path(current_event, @participant_event), method: :patch, local: true, class: "cs-stack", data: { controller: "travel-form" } do |form| %>

    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Inbound travel (arriving at event)</h2>
      </div>
      <div class="cs-container-body">

      <%= fields_for :travel_inbound, @travel_inbound do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :arrangement_status, "Arrangement status", class: "cs-field-label" %>
            <%= f.select :arrangement_status, Travel.arrangement_statuses.keys.map { |status| [status.titleize, status] },
                { include_blank: "Select status..." }, class: "cs-select",
                data: { action: "change->travel-form#updateFields", travel_form_target: "inboundStatus" } %>
          </div>
          <!-- Mode -->
          <div>
            <%= f.label :mode, "Travel mode", class: "cs-field-label" %>
            <%= f.select :mode, Travel.modes.keys.map { |m| [m.titleize, m] },
                { include_blank: "Select mode..." },
                class: "cs-select",
                data: { action: "change->travel-form#updateFields", travel_form_target: "inboundMode" } %>
          </div>

          <% if current_event.visa_options_enabled? %>
          <!-- Visa Status -->
          <div>
            <%= f.label :visa_status, "Visa status", class: "cs-field-label" %>
            <%= f.select :visa_status, Travel.visa_statuses.keys.map { |s| [s.titleize.gsub("_", " "), s] },
                { include_blank: "Select status..." },
                class: "cs-select" %>
          </div>
          <% end %>

          <!-- Unaccompanied Minor -->
          <div class="cs-option">
            <%= f.check_box :is_unaccompanied_minor %>
            <div><%= f.label :is_unaccompanied_minor, "Travelling as unaccompanied minor", class: "cs-option-label" %></div>
          </div>

          <!-- Flight Legs (for plane mode) -->
          <% if @travel_inbound.plane? || @travel_inbound.mode.nil? %>
            <div class="border-t border-(--cs-border-divider-secondary) pt-4 mt-4" id="inbound-flight-legs">
              <h3 class="cs-h3 mb-3">Flight legs</h3>
              <div data-travel-form-target="inboundLegs" class="space-y-4">
                <% @travel_inbound.travel_legs.order(:position).each_with_index do |leg, index| %>
                  <%= render "shared/flight_leg_fields", leg: leg, index: index, direction: "inbound", show_remove: leg.persisted?, default_date: current_event.starts_at&.strftime('%Y-%m-%d'), refresh_url: refresh_flight_leg_admin_event_participant_path(current_event, @participant_event, leg_id: leg.id) %>
                <% end %>
              </div>
              <button type="button" data-action="click->travel-form#addLeg" data-direction="inbound" class="cs-btn mt-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add flight leg
              </button>
            </div>
          <% end %>

          <!-- Train fields -->
          <% if @travel_inbound.train? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <div>
                <%= f.label :train_departure_station, "Departure station", class: "cs-field-label" %>
                <%= f.text_field :train_departure_station, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :train_arrival_station, "Arrival station", class: "cs-field-label" %>
                <%= f.text_field :train_arrival_station, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :arrival_time, "Arrival time", class: "cs-field-label" %>
                <%= f.datetime_local_field :arrival_time, class: "cs-input" %>
              </div>
            </div>
          <% end %>

          <!-- Bus fields -->
          <% if @travel_inbound.bus? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <div>
                <%= f.label :bus_departure_location, "Departure location", class: "cs-field-label" %>
                <%= f.text_field :bus_departure_location, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :bus_arrival_location, "Arrival location", class: "cs-field-label" %>
                <%= f.text_field :bus_arrival_location, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :departure_time, "Departure time", class: "cs-field-label" %>
                <%= f.datetime_local_field :departure_time, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :arrival_time, "Arrival time", class: "cs-field-label" %>
                <%= f.datetime_local_field :arrival_time, class: "cs-input" %>
              </div>
            </div>
          <% end %>

          <!-- Car fields -->
          <% if @travel_inbound.car? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <% if can_view_participant_pii? %>
                <div data-controller="address-autocomplete">
                  <%= f.label :origin_address, "Travelling from", class: "cs-field-label" %>
                  <%= f.text_field :origin_address, class: "cs-input", data: { address_autocomplete_target: "input" } %>
                </div>
              <% end %>
              <div>
                <%= f.label :expected_arrival_time, "Expected arrival time", class: "cs-field-label" %>
                <%= f.datetime_local_field :expected_arrival_time, class: "cs-input" %>
              </div>
            </div>
          <% end %>

          <!-- Other fields -->
          <% if @travel_inbound.other? %>
            <div class="border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <%= f.label :other_details, "Travel details", class: "cs-field-label" %>
              <%= f.text_area :other_details, rows: 3, class: "cs-input" %>
            </div>
          <% end %>

          <!-- Notes -->
          <div class="border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
            <%= f.label :notes, "Notes", class: "cs-field-label" %>
            <%= f.text_area :notes, rows: 2, class: "cs-input", placeholder: "Any additional notes..." %>
          </div>
        </div>
      <% end %>
      </div>
    </section>

    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Outbound travel (leaving event)</h2>
      </div>
      <div class="cs-container-body">

      <%= fields_for :travel_outbound, @travel_outbound do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :arrangement_status, "Arrangement status", class: "cs-field-label" %>
            <%= f.select :arrangement_status, Travel.arrangement_statuses.keys.map { |status| [status.titleize, status] },
                { include_blank: "Select status..." }, class: "cs-select",
                data: { action: "change->travel-form#updateFields", travel_form_target: "outboundStatus" } %>
          </div>
          <!-- Mode -->
          <div>
            <%= f.label :mode, "Travel mode", class: "cs-field-label" %>
            <%= f.select :mode, Travel.modes.keys.map { |m| [m.titleize, m] },
                { include_blank: "Select mode..." },
                class: "cs-select",
                data: { action: "change->travel-form#updateFields", travel_form_target: "outboundMode" } %>
          </div>

          <!-- Unaccompanied Minor -->
          <div class="cs-option">
            <%= f.check_box :is_unaccompanied_minor %>
            <div><%= f.label :is_unaccompanied_minor, "Travelling as unaccompanied minor", class: "cs-option-label" %></div>
          </div>

          <!-- Flight Legs (for plane mode) -->
          <% if @travel_outbound.plane? || @travel_outbound.mode.nil? %>
            <div class="border-t border-(--cs-border-divider-secondary) pt-4 mt-4" id="outbound-flight-legs">
              <h3 class="cs-h3 mb-3">Flight legs</h3>
              <div data-travel-form-target="outboundLegs" class="space-y-4">
                <% @travel_outbound.travel_legs.order(:position).each_with_index do |leg, index| %>
                  <%= render "shared/flight_leg_fields", leg: leg, index: index, direction: "outbound", show_remove: leg.persisted?, default_date: current_event.ends_at&.strftime('%Y-%m-%d'), refresh_url: refresh_flight_leg_admin_event_participant_path(current_event, @participant_event, leg_id: leg.id) %>
                <% end %>
              </div>
              <button type="button" data-action="click->travel-form#addLeg" data-direction="outbound" class="cs-btn mt-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add flight leg
              </button>
            </div>
          <% end %>

          <!-- Train fields -->
          <% if @travel_outbound.train? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <div>
                <%= f.label :train_departure_station, "Departure station", class: "cs-field-label" %>
                <%= f.text_field :train_departure_station, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :train_arrival_station, "Arrival station", class: "cs-field-label" %>
                <%= f.text_field :train_arrival_station, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :departure_time, "Departure time", class: "cs-field-label" %>
                <%= f.datetime_local_field :departure_time, class: "cs-input" %>
              </div>
            </div>
          <% end %>

          <!-- Bus fields -->
          <% if @travel_outbound.bus? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <div>
                <%= f.label :bus_departure_location, "Departure location", class: "cs-field-label" %>
                <%= f.text_field :bus_departure_location, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :bus_arrival_location, "Arrival location", class: "cs-field-label" %>
                <%= f.text_field :bus_arrival_location, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :departure_time, "Departure time", class: "cs-field-label" %>
                <%= f.datetime_local_field :departure_time, class: "cs-input" %>
              </div>
              <div>
                <%= f.label :arrival_time, "Arrival time", class: "cs-field-label" %>
                <%= f.datetime_local_field :arrival_time, class: "cs-input" %>
              </div>
            </div>
          <% end %>

          <!-- Car fields -->
          <% if @travel_outbound.car? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <% if can_view_participant_pii? %>
                <div data-controller="address-autocomplete">
                  <%= f.label :origin_address, "Travelling to", class: "cs-field-label" %>
                  <%= f.text_field :origin_address, class: "cs-input", data: { address_autocomplete_target: "input" } %>
                </div>
              <% end %>
              <div>
                <%= f.label :departure_time, "Departure time", class: "cs-field-label" %>
                <%= f.datetime_local_field :departure_time, class: "cs-input" %>
              </div>
            </div>
          <% end %>

          <!-- Other fields -->
          <% if @travel_outbound.other? %>
            <div class="border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
              <%= f.label :other_details, "Travel details", class: "cs-field-label" %>
              <%= f.text_area :other_details, rows: 3, class: "cs-input" %>
            </div>
          <% end %>

          <!-- Notes -->
          <div class="border-t border-(--cs-border-divider-secondary) pt-4 mt-4">
            <%= f.label :notes, "Notes", class: "cs-field-label" %>
            <%= f.text_area :notes, rows: 2, class: "cs-input", placeholder: "Any additional notes..." %>
          </div>
        </div>
      <% end %>
      </div>
    </section>

    <!-- Submit -->
    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
      <%= link_to "Cancel", admin_event_participant_path(current_event, @participant_event), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= form.button "Save travel information", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

<!-- Template for adding new flight legs dynamically -->
<template id="leg-template">
  <div class="border border-(--cs-border-container) rounded-(--cs-radius-container) p-4 relative"
       data-travel-form-target="legTemplate"
       data-autosave-skip>
    <button type="button" data-action="click->travel-form#removeLeg" class="cs-modal-close absolute top-2 right-2" aria-label="Remove leg">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="cs-h3 mb-3 leg-number">Leg 1</div>
    <input type="hidden" class="leg-position" name="" value="">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <label class="cs-field-label">Flight Code <span aria-hidden="true">*</span></label>
        <input type="text"
               class="leg-flight-code cs-input"
               name=""
               placeholder="e.g. LH1234"
               required>
      </div>
      <div>
        <label class="cs-field-label">Confirmation Code</label>
        <input type="text" class="leg-confirmation-code cs-input" name="" placeholder="Booking reference">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div data-controller="airport-autocomplete" class="relative">
        <label class="cs-field-label">Departure Airport <span aria-hidden="true">*</span></label>
        <input type="text"
               class="leg-departure-airport cs-input"
               name=""
               placeholder="e.g. LHR"
               required
               autocomplete="off"
               data-airport-autocomplete-target="input"
               data-action="input->airport-autocomplete#search keydown->airport-autocomplete#onKeydown blur->airport-autocomplete#onBlur">
        <div data-airport-autocomplete-target="dropdown" class="hidden cs-menu cs-menu-scroll left-0 w-full">
          <div data-airport-autocomplete-target="results"></div>
        </div>
      </div>
      <div data-controller="airport-autocomplete" class="relative">
        <label class="cs-field-label">Arrival Airport <span aria-hidden="true">*</span></label>
        <input type="text"
               class="leg-arrival-airport cs-input"
               name=""
               placeholder="e.g. VIE"
               required
               autocomplete="off"
               data-airport-autocomplete-target="input"
               data-action="input->airport-autocomplete#search keydown->airport-autocomplete#onKeydown blur->airport-autocomplete#onBlur">
        <div data-airport-autocomplete-target="dropdown" class="hidden cs-menu cs-menu-scroll left-0 w-full">
          <div data-airport-autocomplete-target="results"></div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="cs-field-label">Departure Time <span aria-hidden="true">*</span> <span class="font-normal cs-muted">(local airport time)</span></label>
        <input type="datetime-local" class="leg-departure-time cs-input" name="" required>
        <select class="leg-departure-tz mt-1 cs-select" name=""><%= travel_leg_time_zone_options %></select>
      </div>
      <div>
        <label class="cs-field-label">Arrival Time <span aria-hidden="true">*</span> <span class="font-normal cs-muted">(local airport time)</span></label>
        <input type="datetime-local" class="leg-arrival-time cs-input" name="" required>
        <select class="leg-arrival-tz mt-1 cs-select" name=""><%= travel_leg_time_zone_options %></select>
      </div>
    </div>
  </div>
</template>

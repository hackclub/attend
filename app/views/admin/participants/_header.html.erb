<% participant_tab_labels = {
     "travel" => "Travel",
     "accommodation" => "Accommodation",
     "medical" => "Medical",
     "safeguarding" => "Safeguarding",
     "consents" => "Consents",
     "notes" => "Notes",
     "history" => "History",
     "merge" => "Merge duplicate",
     "slack_invite_link" => "Slack invite"
   } %>
<% content_for :breadcrumbs, cs_breadcrumbs(
     [ "Participants", admin_event_participants_path(current_event) ],
     *(participant_tab_labels.key?(action_name) ?
       [ [ participant_name(@participant), admin_event_participant_path(current_event, @participant_event) ], [ participant_tab_labels[action_name], nil ] ] :
       [ [ participant_name(@participant), nil ] ])
   ) %>

<div class="cs-header">
  <div class="cs-header-text flex items-start gap-4">
    <% if @participant.headshot.attached? && @participant.headshot.blob.persisted? %>
      <%= image_tag @participant.headshot, alt: "", class: "w-20 h-20 rounded-full object-cover border border-(--cs-border-divider) shrink-0" %>
    <% else %>
      <div class="w-20 h-20 shrink-0 rounded-full flex items-center justify-center bg-(--cs-bg-shaded) text-(--cs-text-muted) font-bold text-2xl" aria-hidden="true">
        <%= @participant.initials %>
      </div>
    <% end %>
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <h1 class="cs-h1"><%= participant_name(@participant) %></h1>
        <%= render_display_status_badge(@participant_event) %>
        <%= render_blocking_step_badge(@participant_event) %>
        <% if current_event.groups_enabled? %>
          <% @participant_event.groups.ordered.each do |g| %>
            <%= link_to edit_admin_event_group_path(current_event, g),
                class: "cs-badge",
                style: "background-color: #{g.normalized_color || '#e5e7eb'}; color: #{g.color.present? ? 'white' : '#1f2d3d'};",
                title: "Edit group: #{g.name}" do %>
              <%= g.name %>
            <% end %>
          <% end %>
        <% end %>
        <% if current_event.freedom_waivers_enabled? && policy(@safeguarding_info || SafeguardingInfo.new(participant_event: @participant_event)).show? %>
          <% if @safeguarding_info&.freedom_waiver_granted? %>
            <%= cs_status(:success, "Freedom") %>
          <% else %>
            <%= cs_status(:error, "No freedom") %>
          <% end %>
        <% end %>
      </div>
      <% if @participant.preferred_name.present? %>
        <p class="cs-description">Legal name: <%= participant_name(@participant, legal: true) %></p>
      <% end %>
      <p class="cs-description flex flex-wrap items-center gap-2">
        <%= @participant.email %>
        <% if @participant.email_undeliverable? %>
          <span title="This address hard-bounced and is suppressed — emails to it will not be delivered. Correct the email to clear this."><%= cs_status(:error, "Email bouncing") %></span>
        <% end %>
      </p>
    </div>
  </div>
  <div class="cs-actions relative w-full lg:w-auto" data-controller="dropdown">
    <button type="button" data-action="dropdown#toggle" class="cs-btn cs-btn-full">
      Actions
      <svg class="cs-btn-caret" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>
    </button>
    <div class="hidden cs-menu cs-menu-right top-full" data-dropdown-target="menu">
      <%= link_to edit_admin_event_participant_path(current_event, @participant_event), class: "cs-menu-item" do %>
        <span class="cs-menu-item-label">Edit</span>
      <% end %>
      <% if policy(@participant_event).update? && @participant_event.invitation_resendable? %>
        <% invitation_held = current_event.invitations.held.for_email(@participant.email).exists? %>
        <%= button_to resend_invitation_admin_event_participant_path(current_event, @participant_event),
            method: :post,
            data: { turbo_confirm: invitation_held ? "#{@participant.email} hasn't been sent their onboarding invitation yet#{current_event.onboarding_invites_held? ? ' (this event is holding them)' : ''}. Send it now?" : "Resend the onboarding invitation to #{@participant.email}?" },
            class: "cs-menu-item" do %>
          <span class="cs-menu-item-label"><%= invitation_held ? "Send invitation" : "Resend invitation" %></span>
        <% end %>
      <% end %>
      <% if policy(@participant_event).merge_duplicate? %>
        <%= link_to merge_admin_event_participant_path(current_event, @participant_event), class: "cs-menu-item" do %>
          <span class="cs-menu-item-label">Merge duplicate</span>
        <% end %>
      <% end %>
      <% if @participant_event.participant.slack_user_id.present? %>
        <%= link_to "https://hackclub.enterprise.slack.com/team/#{@participant_event.participant.slack_user_id}", target: "_blank", rel: "noopener noreferrer", class: "cs-menu-item" do %>
          <span class="cs-menu-item-label">View on Slack</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 2h5v5M14 2L7 9M12 9v5H2V4h5"/></svg>
        <% end %>
      <% end %>
      <% if policy(@participant_event).withdraw? || policy(@participant_event).destroy? %>
        <div class="cs-menu-divider"></div>
      <% end %>
      <% if policy(@participant_event).withdraw? && !@participant_event.withdrawn? %>
        <%= button_to withdraw_admin_event_participant_path(current_event, @participant_event),
            method: :post,
            data: { turbo_confirm: "Are you sure you want to mark #{@participant.display_name} as withdrawn?" },
            class: "cs-menu-item" do %>
          <span class="cs-menu-item-label">Withdraw</span>
        <% end %>
      <% end %>
      <% if policy(@participant_event).withdraw? && @participant_event.withdrawn? %>
        <%= button_to unwithdraw_admin_event_participant_path(current_event, @participant_event),
            method: :post,
            data: { turbo_confirm: "Are you sure you want to reinstate #{@participant.display_name}?" },
            class: "cs-menu-item" do %>
          <span class="cs-menu-item-label">Reinstate</span>
        <% end %>
      <% end %>
      <% if policy(@participant_event).destroy? %>
        <%= button_to admin_event_participant_path(current_event, @participant_event),
            method: :delete,
            data: { turbo_confirm: "Are you sure you want to remove #{@participant.display_name} from this event? This action cannot be undone." },
            class: "cs-menu-item" do %>
          <span class="cs-menu-item-label">Remove from event</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="cs-tabs mb-5">
  <%= link_to "Overview", admin_event_participant_path(current_event, @participant_event),
      class: "cs-tab", "aria-current": cs_current(action_name == "show") %>
  <% if current_event.travel_enabled? %>
    <%= link_to "Travel", travel_admin_event_participant_path(current_event, @participant_event),
        class: "cs-tab", "aria-current": cs_current(action_name == "travel") %>
  <% end %>
  <% if current_event.accommodation_enabled? %>
    <%= link_to "Accommodation", accommodation_admin_event_participant_path(current_event, @participant_event),
        class: "cs-tab", "aria-current": cs_current(action_name == "accommodation") %>
  <% end %>
  <% if policy(@participant_event.medical || Medical.new(participant_event: @participant_event)).show? %>
    <%= link_to "Medical", medical_admin_event_participant_path(current_event, @participant_event),
        class: "cs-tab", "aria-current": cs_current(action_name == "medical") %>
  <% end %>
  <% if policy(@safeguarding_info || SafeguardingInfo.new(participant_event: @participant_event)).show? %>
    <%= link_to "Safeguarding", safeguarding_admin_event_participant_path(current_event, @participant_event),
        class: "cs-tab", "aria-current": cs_current(action_name == "safeguarding") %>
  <% end %>
  <%= link_to "Consents", consents_admin_event_participant_path(current_event, @participant_event),
      class: "cs-tab", "aria-current": cs_current(action_name == "consents") %>
  <%= link_to notes_admin_event_participant_path(current_event, @participant_event),
      class: "cs-tab", "aria-current": cs_current(action_name == "notes") do %>
    Notes <span class="cs-counter">(<%= @notes.count %>)</span>
  <% end %>
  <%= link_to "History", history_admin_event_participant_path(current_event, @participant_event),
      class: "cs-tab", "aria-current": cs_current(action_name == "history") %>
</div>

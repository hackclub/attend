<% content_for :title, "Consents – #{@participant_event.participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <!-- Code of Conduct & Safeguarding -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="flex items-start justify-between">
      <div>
        <h2 class="text-lg font-semibold mb-1">Code of Conduct &amp; Safeguarding</h2>
        <p class="text-sm text-gray-500">
          <a href="https://hackclub.com/conduct/" target="_blank" class="text-[#ec3750] hover:underline">hackclub.com/conduct</a>
          ·
          <a href="https://hackclub.com/safeguarding" target="_blank" class="text-[#ec3750] hover:underline">hackclub.com/safeguarding</a>
        </p>
      </div>
      <% if @participant_event.code_of_conduct_accepted_at.present? %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          Signed
        </span>
      <% else %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
          Pending
        </span>
      <% end %>
    </div>

    <% if @participant_event.code_of_conduct_accepted_at.present? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-gray-500">Digital Signature</dt>
            <dd class="font-medium text-gray-900"><%= @participant_event.code_of_conduct_signature %></dd>
          </div>
          <div>
            <dt class="text-gray-500">Signed On</dt>
            <dd class="text-gray-900">
              <%= @participant_event.code_of_conduct_accepted_at.strftime("%B %d, %Y") %>
              <span class="text-gray-400 text-xs ml-1"><%= @participant_event.code_of_conduct_accepted_at.strftime("%H:%M") %></span>
            </dd>
          </div>
        </dl>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-gray-500">The participant has not yet signed the Code of Conduct &amp; Safeguarding Policy.</p>
    <% end %>
  </div>

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold">Document Consents</h2>
    
    <div class="flex items-center gap-3">
      <% waiver_consent = @consents.find { |c| c.waiver? } %>
      <% if waiver_consent&.signed? %>
        <%= button_to "Resend Completion Email", resend_waiver_completion_email_admin_event_participant_path(current_event, @participant_event),
          method: :post,
          class: "text-sm text-[#ec3750] hover:text-blue-800 font-medium",
          data: { turbo_confirm: "This will resend the waiver completion email. Continue?" } %>
      <% end %>

      <% if policy(@participant_event).reset_waiver? %>
        <% freedom_waiver_consent = @consents.find { |c| c.freedom_waiver? } %>
        <% if waiver_consent || (freedom_waiver_consent && current_event.freedom_waivers_enabled?) %>
          <div class="flex items-center gap-4">
            <% if waiver_consent %>
              <% waiver_reset_confirm = if @participant_event.requires_guardian?
                "This will clear all DocuSeal data and reset the waiver to pending. The guardian will be emailed with a link to complete it. Are you sure?"
              else
                "This will clear all DocuSeal data and reset the waiver to pending. The participant will be emailed with a link to sign a new waiver. Are you sure?"
              end %>
              <%= button_to "Reset Waiver", reset_waiver_admin_event_participant_path(current_event, @participant_event),
                method: :delete,
                class: "text-sm text-red-600 hover:text-red-800 font-medium",
                data: { turbo_confirm: waiver_reset_confirm } %>
            <% end %>
            <% if freedom_waiver_consent && current_event.freedom_waivers_enabled? %>
              <% freedom_reset_confirm = if @participant_event.requires_guardian?
                "This will reset the freedom waiver and clear the freedom waiver granted status. The guardian will be emailed with a link to complete it. Are you sure?"
              else
                "This will reset the freedom waiver and clear the freedom waiver granted status. The participant will be emailed with a link to sign a new waiver. Are you sure?"
              end %>
              <%= button_to "Reset Freedom Waiver", reset_freedom_waiver_admin_event_participant_path(current_event, @participant_event),
                method: :delete,
                class: "text-sm text-red-600 hover:text-red-800 font-medium",
                data: { turbo_confirm: freedom_reset_confirm } %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Consent Type</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Signed By</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Document</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% # Consents for applicable custom documents render in the Additional
           # Documents section below; keep only ones whose document was since
           # archived or stopped applying (they remain legal records). %>
        <% shown_below = @custom_documents.map(&:id).to_set %>
        <% filtered_consents = @consents.reject { |c| c.freedom_waiver? && !current_event.freedom_waivers_enabled? } %>
        <% filtered_consents = filtered_consents.reject { |c| shown_below.include?(c.custom_document_id) } %>
        <% if filtered_consents.any? %>
          <% filtered_consents.each do |consent| %>
            <tr>
              <td class="px-6 py-4">
                <div class="font-medium text-gray-900"><%= consent.display_name %></div>
                <% if Consent::REQUIRED_CONSENT_TYPES.include?(consent.consent_type) %>
                  <span class="text-xs text-gray-500">Required</span>
                <% elsif consent.withdrawn? %>
                  <span class="text-xs text-gray-500">
                    Optional — removed by participant <%= consent.withdrawn_at.strftime("%B %d, %Y") %>
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <% status_class = case consent.status
                   when 'signed' then 'bg-green-100 text-green-800'
                   when 'pending', 'sent', 'viewed' then 'bg-yellow-100 text-yellow-800'
                   when 'voided', 'failed' then 'bg-red-100 text-red-800'
                   else 'bg-gray-100 text-gray-800'
                   end %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_class %>">
                  <%= consent.status.titleize %>
                </span>
                <% if consent.failure_reason.present? %>
                  <div class="text-xs text-red-600 mt-1"><%= consent.failure_reason.titleize %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <% if consent.guardian_participant_event&.guardian %>
                  <%= consent.guardian_participant_event.guardian.full_name %>
                  <span class="text-xs text-gray-400">(Guardian)</span>
                <% elsif consent.signed? %>
                  <span class="text-gray-500">Participant</span>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <% if consent.signed_at %>
                  <%= consent.signed_at.strftime("%B %d, %Y") %>
                  <div class="text-xs text-gray-400"><%= consent.signed_at.strftime("%H:%M") %></div>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-right text-sm">
                <% if consent.physical_uploaded? %>
                  <div class="space-y-1">
                    <% consent.physical_uploads.each_with_index do |upload, i| %>
                      <div>
                        <%= link_to "View Upload#{" #{i + 1}" if consent.physical_uploads.size > 1}",
                            viewable_upload_path(upload), target: "_blank",
                            class: "text-[#ec3750] hover:text-blue-800" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif consent.document_url.present? %>
                  <%= link_to "View Document", consent.document_url, target: "_blank", class: "text-[#ec3750] hover:text-blue-800" %>
                <% elsif consent.docuseal_envelope_id.present? %>
                  <span class="text-gray-400">DocuSeal: <%= consent.docuseal_envelope_id %></span>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-gray-500">
              No consent records found.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @custom_documents.any? %>
    <h2 class="text-lg font-semibold mt-8 mb-4">Additional Documents</h2>
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Document</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Signed By</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Document</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @custom_documents.each do |doc| %>
            <% consent = @custom_document_consents[doc.id] %>
            <% status_label, status_class = if consent&.signed?
                 [ "Signed", "bg-green-100 text-green-800" ]
               elsif consent&.physical_uploaded?
                 [ "Awaiting guardian confirmation", "bg-yellow-100 text-yellow-800" ]
               elsif doc.physical?
                 [ doc.participant_signs? ? "Awaiting participant upload" : "Awaiting guardian upload", "bg-yellow-100 text-yellow-800" ]
               elsif consent.nil? || consent.pending?
                 [ "Not started", "bg-gray-100 text-gray-800" ]
               elsif consent.voided? || consent.failed?
                 [ consent.status.titleize, "bg-red-100 text-red-800" ]
               else
                 [ consent.status.titleize, "bg-yellow-100 text-yellow-800" ]
               end %>
            <tr>
              <td class="px-6 py-4">
                <div class="font-medium text-gray-900">
                  <%= doc.name %>
                  <% if doc.optional? %>
                    <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-700">Optional</span>
                  <% end %>
                </div>
                <span class="text-xs text-gray-500">
                  <%= doc.physical? ? "Signed on paper" : "DocuSeal" %>
                  · <%= doc.signer_type.to_s.delete_prefix("signed_by_").humanize %>
                  <% if doc.optional? && consent&.opted_in_at %>
                    · Added <%= consent.opted_in_at.strftime("%B %d, %Y") %>
                  <% end %>
                </span>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_class %>">
                  <%= status_label %>
                </span>
                <% if consent&.failure_reason.present? %>
                  <div class="text-xs text-red-600 mt-1"><%= consent.failure_reason.titleize %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <% if consent&.guardian_participant_event&.guardian %>
                  <%= consent.guardian_participant_event.guardian.full_name %>
                  <span class="text-xs text-gray-400">(Guardian)</span>
                <% elsif consent&.signed? %>
                  <span class="text-gray-500">Participant</span>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600">
                <% if consent&.signed_at %>
                  <%= consent.signed_at.strftime("%B %d, %Y") %>
                  <div class="text-xs text-gray-400"><%= consent.signed_at.strftime("%H:%M") %></div>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-6 py-4 text-right text-sm">
                <% if consent&.physical_uploaded? %>
                  <div class="space-y-1">
                    <% consent.physical_uploads.each_with_index do |upload, i| %>
                      <div>
                        <%= link_to "View Upload#{" #{i + 1}" if consent.physical_uploads.size > 1}",
                            viewable_upload_path(upload), target: "_blank",
                            class: "text-[#ec3750] hover:text-blue-800" %>
                      </div>
                    <% end %>
                  </div>
                <% elsif consent&.document_url.present? %>
                  <%= link_to "View Document", consent.document_url, target: "_blank", class: "text-[#ec3750] hover:text-blue-800" %>
                <% elsif consent&.docuseal_envelope_id.present? %>
                  <span class="text-gray-400">DocuSeal: <%= consent.docuseal_envelope_id %></span>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @unadded_optional_documents.any? %>
    <div class="mt-6 bg-gray-50 rounded-lg p-4">
      <h3 class="font-medium text-gray-900 mb-1">Optional Documents Not Added</h3>
      <p class="text-xs text-gray-500 mb-3">
        Offered for opt-in activities. This participant hasn't taken these up, so no signature is
        expected and nothing has been sent to their parent/guardian.
      </p>
      <div class="flex flex-wrap gap-2">
        <% @unadded_optional_documents.each do |doc| %>
          <div class="flex items-center gap-2 bg-white px-3 py-2 rounded border">
            <span class="w-3 h-3 rounded-full bg-gray-300"></span>
            <span class="text-sm"><%= doc.name %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-6 bg-gray-50 rounded-lg p-4">
    <h3 class="font-medium text-gray-900 mb-2">Required Consents</h3>
    <div class="flex flex-wrap gap-2">
      <% required_types = Consent::REQUIRED_CONSENT_TYPES.reject { |t| t == "freedom_waiver" && !current_event.freedom_waivers_enabled? } %>
      <% required_types.each do |type| %>
        <% if type == "code_of_conduct" %>
          <% is_complete = @participant_event.code_of_conduct_accepted_at.present? %>
        <% else %>
          <% consent = @consents.find { |c| c.consent_type == type } %>
          <% is_complete = consent&.signed? %>
        <% end %>
        <div class="flex items-center gap-2 bg-white px-3 py-2 rounded border">
          <span class="w-3 h-3 rounded-full <%= is_complete ? 'bg-green-500' : 'bg-gray-300' %>"></span>
          <span class="text-sm"><%= type.titleize %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

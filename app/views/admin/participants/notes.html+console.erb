<% content_for :title, "Notes – #{@participant_event.participant.display_name} – #{current_event.name} – Attend" %>

<div>
  <%= render "header" %>

  <div class="cs-stack">
  <section class="cs-container">
    <div class="cs-container-header">
      <h2 class="cs-h2">Add note</h2>
    </div>

    <%= form_with model: Note.new, url: admin_event_participant_notes_path(current_event, @participant_event), method: :post, local: true, html: { novalidate: true }, data: { controller: "cs-form-validation" } do |f| %>
      <div class="cs-container-body">
        <%= cs_form_field f, :body, label: "Note", as: :text_area, input: { rows: 4, required: true } %>

        <div class="cs-field-grid mt-4">
          <%= cs_form_field f, :note_type, label: "Type" do |aria| %>
            <%= f.select :note_type, Note.note_types.keys.map { |t| [t.titleize, t] }, {}, class: "cs-select", id: f.field_id(:note_type), **aria %>
          <% end %>

          <%= cs_form_field f, :sensitivity, label: "Sensitivity" do |aria| %>
            <%= f.select :sensitivity, Note.sensitivities.keys.map { |s| [s.titleize, s] }, {}, class: "cs-select", id: f.field_id(:sensitivity), **aria %>
          <% end %>
        </div>
      </div>
      <div class="cs-container-footer flex justify-end">
        <%= f.button "Add note", class: "cs-btn cs-btn-primary" %>
      </div>
    <% end %>
  </section>

  <section class="cs-container">
    <div class="cs-container-header cs-container-header-divided">
      <h2 class="cs-h2">Notes <span class="cs-counter">(<%= @notes.size %>)</span></h2>
    </div>
    <% if @notes.any? %>
      <ul class="divide-y divide-(--cs-border-divider-secondary)">
        <% @notes.each do |note| %>
          <li class="px-5 py-4 <%= note.restricted? ? 'border-l-4 border-l-(--cs-accent)' : '' %>">
            <div class="flex justify-between items-start gap-3 mb-2">
              <div class="flex flex-wrap items-center gap-2">
                <%= cs_badge(note.note_type.titleize) %>
                <% if note.restricted? %>
                  <%= cs_badge("Restricted", "red") %>
                <% end %>
              </div>
              <%= button_to "Delete", admin_event_participant_note_path(current_event, @participant_event, note),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this note?" },
                  class: "cs-btn cs-btn-link" %>
            </div>

            <p class="whitespace-pre-wrap"><%= note.body %></p>

            <div class="mt-3 cs-small cs-muted">
              <%= note.author&.email || "Unknown" %> · <%= cs_relative_time(note.created_at) %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="cs-empty">
        <p class="cs-empty-title">No notes</p>
        <p>Notes you add with the previous form appear here.</p>
      </div>
    <% end %>
  </section>
  </div>
</div>

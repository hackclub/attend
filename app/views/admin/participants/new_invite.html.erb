<% content_for :title, "Invite Participant – #{current_event.name} – Attend" %>
<% content_for :breadcrumbs, cs_breadcrumbs(
     [ "Participants", admin_event_participants_path(current_event) ],
     [ "Invite participant", nil ]
   ) %>

<div class="max-w-2xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Invite participant</h1>
      <p class="cs-description">
        Send an email invitation to a participant to complete their onboarding for <strong><%= current_event.name %></strong>.
      </p>
    </div>
  </div>

  <%= form_with url: send_invite_admin_event_participants_path(current_event), method: :post, class: "cs-stack", data: { turbo: false } do |f| %>
    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Participant</h2>
      </div>
      <div class="cs-container-body">
        <div class="cs-field">
          <%= f.label "invite[email]", "Email address", class: "cs-field-label" %>
          <%= f.email_field "invite[email]", required: true, placeholder: "participant@example.com", class: "cs-input" %>
        </div>

        <div class="cs-field">
          <%= f.label "invite[name]", "Name (optional)", class: "cs-field-label" %>
          <%= f.text_field "invite[name]", placeholder: "First Last", class: "cs-input" %>
          <p class="cs-field-hint">If provided, the name will be used in the email greeting.</p>
        </div>

        <% if current_event.groups_enabled? && current_event.groups.any? %>
          <fieldset class="cs-field">
            <legend class="cs-field-label">Groups (optional)</legend>
            <p class="cs-field-description">Selected groups will be applied when the participant accepts the invite.</p>
            <% current_event.groups.ordered.each do |g| %>
              <div class="cs-option">
                <%= check_box_tag "invite[group_ids][]", g.id, false, id: "invite_group_ids_#{g.id}" %>
                <div>
                  <label class="cs-option-label" for="invite_group_ids_<%= g.id %>">
                    <span class="cs-badge"
                          style="background-color: <%= g.normalized_color || '#e5e7eb' %>; color: <%= g.color.present? ? 'white' : '#1f2d3d' %>;">
                      <%= g.name %>
                    </span>
                  </label>
                </div>
              </div>
            <% end %>
          </fieldset>
        <% end %>
      </div>
    </section>

    <% if current_event.onboarding_invites_held? %>
      <div class="cs-alert cs-alert-warning">
        <%= cs_status_icon(:warning) %>
        <div>
          <p class="cs-alert-title">Onboarding invitations are held for this event.</p>
          <p>The participant will be added to the pending invitations list without an email. Their invitation goes out when this event's held invitations are sent, from the participants page or the series page.</p>
        </div>
      </div>
    <% else %>
      <div class="cs-alert">
        <%= cs_status_icon(:info) %>
        <div>
          <p class="cs-alert-title">What happens next</p>
          <p>The participant will receive an email with a link to sign in with Hack Club Auth and complete the onboarding process for this event.</p>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
      <%= link_to "Cancel", admin_event_participants_path(current_event), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button current_event.onboarding_invites_held? ? "Add participant" : "Send invitation", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

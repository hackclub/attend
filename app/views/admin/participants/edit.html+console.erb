<% content_for :title, "Edit #{@participant.display_name} – #{current_event.name} – Attend" %>
<% content_for :breadcrumbs, cs_event_breadcrumbs([ "Participants", admin_event_participants_path(current_event) ], [ participant_name(@participant), admin_event_participant_path(current_event, @participant_event) ], [ "Edit", nil ]) %>

<div class="max-w-2xl">
  <div class="cs-header">
    <div class="cs-header-text">
      <h1 class="cs-h1">Edit participant</h1>
    </div>
  </div>

  <%= form_with model: @participant, url: admin_event_participant_path(current_event, @participant_event), method: :patch, local: true, multipart: true, class: "cs-stack", data: { controller: "phone-input" } do |f| %>
    <% if @participant.errors.any? %>
      <div class="cs-alert cs-alert-error" role="alert">
        <%= cs_status_icon(:error) %>
        <div>
          <p class="cs-alert-title"><%= pluralize(@participant.errors.count, "error") %> stopped these changes from saving</p>
          <ul class="mt-1 list-disc list-inside">
            <% @participant.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <section class="cs-container">
      <div class="cs-container-header">
        <h2 class="cs-h2">Participant details</h2>
      </div>
      <div class="cs-container-body">
        <div class="border-2 border-dashed border-orange-400 rounded px-4 py-4 mb-5">
          <div class="cs-field">
            <%= f.label :headshot, "Profile photo", class: "cs-field-label" %>
            <div class="flex items-center gap-4">
              <% if @participant.headshot.attached? && @participant.headshot.blob.persisted? %>
                <%= image_tag @participant.headshot, alt: "Current headshot", class: "w-20 h-20 rounded-full object-cover border border-(--cs-border-divider) shrink-0" %>
              <% else %>
                <div class="w-20 h-20 shrink-0 rounded-full flex items-center justify-center bg-(--cs-bg-shaded) text-(--cs-text-muted) font-bold text-2xl" aria-hidden="true">
                  <%= @participant.initials %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <%= f.file_field :headshot, accept: "image/jpeg,image/png,image/webp", class: "cs-file" %>
                <p class="cs-field-hint">JPEG, PNG, or WebP. Max 10MB.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="cs-field-grid">
          <div>
            <%= f.label :legal_first_name, "Legal first name", class: "cs-field-label" %>
            <%= f.text_field :legal_first_name, class: "cs-input" %>
          </div>
          <div>
            <%= f.label :legal_last_name, "Legal last name", class: "cs-field-label" %>
            <%= f.text_field :legal_last_name, class: "cs-input" %>
          </div>

          <div>
            <%= f.label :preferred_name, "Preferred name", class: "cs-field-label" %>
            <%= f.text_field :preferred_name, class: "cs-input" %>
            <p class="cs-field-hint">Leave blank if same as legal name</p>
          </div>
          <div>
            <%= f.label :email, class: "cs-field-label" %>
            <%= f.email_field :email, class: "cs-input" %>
          </div>

          <% if can_view_participant_pii? %>
            <div>
              <%= f.label :date_of_birth, "Date of birth", class: "cs-field-label" %>
              <%= f.date_field :date_of_birth, class: "cs-input" %>
            </div>
          <% end %>
          <% if can_view_participant_pii? %>
            <div>
              <%= f.label :phone, class: "cs-field-label" %>
              <%= f.telephone_field :phone, class: "cs-input" %>
            </div>
          <% end %>

          <div>
            <%= f.label :pronouns, class: "cs-field-label" %>
            <%= f.text_field :pronouns, class: "cs-input" %>
          </div>
          <div>
            <%= f.label :tshirt_size, "T-shirt size", class: "cs-field-label" %>
            <%= f.select :tshirt_size, [["Select size", ""], "XS", "S", "M", "L", "XL", "XXL"], {}, class: "cs-select" %>
          </div>
        </div>
      </div>
    </section>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
      <%= link_to "Cancel", admin_event_participant_path(current_event, @participant_event), class: "cs-btn cs-btn-link cs-btn-full" %>
      <%= f.button "Save changes", class: "cs-btn cs-btn-primary cs-btn-full" %>
    </div>
  <% end %>
</div>

<% content_for :title, "Your portals – Attend" %>

<div class="w-full max-w-2xl mx-auto">
  <%= render "shared/portal_masthead" %>

  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
    <div class="min-w-0">
      <h1 class="portal-title text-2xl mb-2">Your portals</h1>
      <p class="portal-hint text-sm break-words">
        Verified as <%= verified_contact["contact_value"] %>
      </p>
    </div>
    <%= button_to "Sign out", guardian_portal_center_session_path, method: :delete,
          class: "portal-btn portal-btn-secondary shrink-0" %>
  </div>

  <% if @pending_portals.empty? && @completed_portals.empty? %>
    <div class="portal-card p-6 sm:p-8 text-center">
      <span class="portal-medallion portal-medallion-neutral mx-auto mb-4">
        <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
        </svg>
      </span>
      <h2 class="portal-heading text-lg mb-2">Nothing linked to this contact</h2>
      <p class="portal-body mb-6 mx-auto max-w-prose">
        The event organizers may have a different email or phone number on file for you. Try another, or
        ask them which one they used.
      </p>
      <%= link_to "Try a different email or phone number", guardian_portal_center_path,
            class: "portal-btn portal-btn-primary w-full sm:w-auto" %>
    </div>
  <% end %>

  <% if @pending_portals.any? %>
    <section class="mb-8" aria-labelledby="pending-heading">
      <h2 id="pending-heading" class="portal-heading text-lg mb-3">Needs you</h2>
      <ul class="space-y-3">
        <% @pending_portals.each do |gpe| %>
          <% participant_event = gpe.participant_event %>
          <% event = participant_event.event %>
          <li class="portal-card p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <p class="portal-heading text-base"><%= event.name %></p>
                <% if gpe.status == "in_progress" %>
                  <span class="portal-badge portal-badge-waiting">In progress</span>
                <% else %>
                  <span class="portal-badge portal-badge-pending">Not started</span>
                <% end %>
              </div>
              <p class="portal-body text-sm">For <%= participant_event.participant.full_name %></p>
              <% if event.starts_at.present? && event.ends_at.present? %>
                <p class="portal-hint text-sm mt-0.5">
                  <%= event.starts_at.strftime("%B %-d") %> – <%= event.ends_at.strftime("%B %-d, %Y") %>
                </p>
              <% end %>
            </div>
            <%= button_to "Open portal", guardian_portal_center_open_path(id: gpe.id),
                  class: "portal-btn portal-btn-primary shrink-0 w-full sm:w-auto" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @completed_portals.any? %>
    <section aria-labelledby="completed-heading">
      <h2 id="completed-heading" class="portal-heading text-lg mb-3">Done</h2>
      <ul class="space-y-3">
        <% @completed_portals.each do |gpe| %>
          <% participant_event = gpe.participant_event %>
          <% event = participant_event.event %>
          <li class="portal-card p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <p class="portal-heading text-base"><%= event.name %></p>
                <% if participant_event.withdrawn? %>
                  <span class="portal-badge portal-badge-neutral">Withdrawn</span>
                <% else %>
                  <span class="portal-badge portal-badge-done">Complete</span>
                <% end %>
              </div>
              <p class="portal-body text-sm">For <%= participant_event.participant.full_name %></p>
              <% if gpe.completed_at.present? %>
                <p class="portal-hint text-sm mt-0.5">Completed <%= gpe.completed_at.strftime("%B %-d, %Y") %></p>
              <% end %>
            </div>
            <%= button_to "View", guardian_portal_center_open_path(id: gpe.id),
                  class: "portal-btn portal-btn-secondary shrink-0 w-full sm:w-auto" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <p class="portal-hint text-sm text-center mt-8">
    This verified session lasts one hour. Questions? Contact the event organizers.
  </p>
</div>

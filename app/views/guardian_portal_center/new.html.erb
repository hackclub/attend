<% content_for :title, "Find your portals – Attend" %>

<div class="w-full max-w-lg mx-auto">
  <%= render "shared/portal_masthead" %>

  <div class="mb-8">
    <h1 class="portal-title text-2xl mb-3">Find your portals</h1>
    <p class="portal-body text-lg">
      Every parent and guardian portal linked to you — including the ones you've already finished, and
      a fresh link for any that expired.
    </p>
  </div>

  <div class="portal-card p-5 sm:p-6 mb-6">
    <%= form_with url: guardian_portal_center_request_code_path, method: :post do |f| %>
      <%= label_tag :contact, "Email address or phone number", class: "portal-label" %>
      <p class="portal-hint text-sm mb-3">
        Use whichever one the event organizers have on file for you. For a phone number, include the
        country code — for example +1 555 555 5555.
      </p>
      <%= f.text_field :contact, id: "contact", required: true, autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "portal-input" %>

      <% if TurnstileVerifier.site_key.present? && !user_signed_in? %>
        <div class="cf-turnstile mt-4" data-sitekey="<%= TurnstileVerifier.site_key %>"></div>
      <% end %>

      <button type="submit" class="portal-btn portal-btn-primary w-full sm:w-auto mt-4">
        Send me a verification code
      </button>
    <% end %>
  </div>

  <div class="portal-panel p-5">
    <h2 class="portal-heading text-sm mb-1">How this works</h2>
    <p class="portal-hint text-sm">
      We send a 6-digit code to check it's really you. Once you enter it, you'll see every pending and
      completed portal for that email or phone number — no invite link needed.
    </p>
  </div>
</div>

<% if TurnstileVerifier.site_key.present? && !user_signed_in? %>
  <%= javascript_include_tag "https://challenges.cloudflare.com/turnstile/v0/api.js", async: true, defer: true %>
<% end %>

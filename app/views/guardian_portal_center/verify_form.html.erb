<% content_for :title, "Enter your verification code – Attend" %>
<% sent_to_phone = @pending&.dig("contact_type") == "phone" %>

<div class="w-full max-w-lg mx-auto">
  <%= render "shared/portal_masthead",
        back_to: { label: "Change", path: guardian_portal_center_path } %>

  <div class="mb-8">
    <h1 class="portal-title text-2xl mb-3">
      Check your <%= sent_to_phone ? "messages" : "email" %>
    </h1>
    <p class="portal-body text-lg">
      If any parent or guardian portals are linked to
      <strong class="portal-heading break-words"><%= @pending&.dig("contact_value") %></strong>,
      we've just sent a 6-digit code there. It's good for 10 minutes.
    </p>
  </div>

  <div class="portal-card p-5 sm:p-6 mb-6">
    <%= form_with url: guardian_portal_center_verify_path, method: :post do |f| %>
      <%= label_tag :code, "Verification code", class: "portal-label" %>
      <%= f.text_field :code, id: "code", required: true, autofocus: true,
            inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6, pattern: "\\d{6}",
            placeholder: "000000",
            class: "portal-input text-center text-2xl font-mono tracking-[0.4em] pl-[0.4em]" %>

      <button type="submit" class="portal-btn portal-btn-primary w-full sm:w-auto mt-4">Verify</button>
    <% end %>
  </div>

  <div class="flex flex-col items-center gap-1">
    <%= form_with url: guardian_portal_center_request_code_path, method: :post do |f| %>
      <%= f.hidden_field :contact, value: @pending&.dig("contact_value") %>
      <button type="submit" class="portal-btn portal-btn-quiet">Send a new code</button>
    <% end %>
    <%= link_to "Use a different email or phone number", guardian_portal_center_path, class: "portal-hint text-sm underline underline-offset-2" %>
  </div>
</div>

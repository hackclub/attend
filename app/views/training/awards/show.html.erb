<% content_for :title, "#{@award.badge.name} – Attend" %>
<% state = training_award_state(@award) %>
<% holder = @award.user_id == current_user.id %>

<div class="w-full max-w-2xl mx-auto">
  <%= link_to "← All training", training_path, class: "portal-link text-sm inline-block mb-6" %>

  <div class="portal-card p-8 sm:p-10 text-center mb-6">
    <div class="flex justify-center mb-5">
      <%= training_badge_art(@award.badge, size: "size-20",
            tone: { current: "success", expiring: "warn", expired: "neutral", revoked: "neutral" }.fetch(state)) %>
    </div>
    <p class="portal-meta text-xs uppercase tracking-wide mb-2">Hack Club training badge</p>
    <h1 class="portal-title text-2xl sm:text-3xl mb-2"><%= @award.badge.name %></h1>
    <p class="portal-body mb-6">Held by <strong class="portal-heading"><%= @award.user.display_name_or_fallback %></strong></p>

    <dl class="grid gap-4 sm:grid-cols-2 text-left portal-inset p-4 rounded-lg">
      <div>
        <dt class="portal-meta text-xs uppercase tracking-wide">Awarded</dt>
        <dd class="portal-body"><%= @award.awarded_at.to_date.to_fs(:long) %></dd>
      </div>
      <div>
        <dt class="portal-meta text-xs uppercase tracking-wide">Status</dt>
        <dd class="portal-body"><%= training_award_state_label(@award) %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="portal-meta text-xs uppercase tracking-wide">How it was earned</dt>
        <dd class="portal-body">
          <% if @award.course %>
            Completed <%= @award.course.title %>
          <% else %>
            Training recorded by Hack Club<%= ": #{@award.note}" if @award.note.present? %>
          <% end %>
        </dd>
      </div>
    </dl>

    <% if @award.badge.description.present? %>
      <p class="portal-hint text-sm mt-6"><%= @award.badge.description %></p>
    <% end %>
  </div>

  <% if holder %>
    <section id="share" class="portal-card p-6 sm:p-8" aria-labelledby="share-heading">
      <h2 id="share-heading" class="portal-heading text-lg mb-1">Share this badge</h2>

      <% if @award.shared? %>
        <p class="portal-hint text-sm mb-4">
          Anyone with this link can check that you hold this badge, and whether it's still valid. It shows your name, the badge and its dates — nothing else — and isn't listed in search engines.
        </p>
        <% link = badge_verification_url(@award.share_token) %>
        <div class="flex flex-col sm:flex-row gap-2 mb-4">
          <input type="text" readonly value="<%= link %>" class="portal-input flex-1 font-mono text-sm" aria-label="Verification link">
          <button type="button" class="portal-btn portal-btn-secondary" data-controller="clipboard" data-clipboard-content-value="<%= link %>" data-action="clipboard#copy">Copy link</button>
        </div>
        <div class="flex flex-col sm:flex-row gap-2">
          <% if @award.current? %>
            <%= button_to linkedin_training_award_path(@award), method: :post, class: "portal-btn portal-btn-primary w-full sm:w-auto", form: { target: "_blank", data: { turbo: false } } do %>
              Add to LinkedIn
            <% end %>
          <% end %>
          <%= button_to "Stop sharing", share_training_award_path(@award), method: :delete, class: "portal-btn portal-btn-quiet w-full sm:w-auto",
                data: { turbo_confirm: "Stop sharing? The link stops working, including anywhere you've posted it." } %>
        </div>
      <% elsif !@award.current? %>
        <p class="portal-hint text-sm">Only a current badge can be shared<%= state == :expired ? " — renew it by retaking the course" : "" %>.</p>
      <% else %>
        <p class="portal-hint text-sm mb-4">
          Get a link anyone can use to check this badge — for LinkedIn, a CV, or an event partner. It shows your name, the badge and its dates, and you can turn it off at any time.
        </p>
        <div class="flex flex-col sm:flex-row gap-2">
          <% if @award.current? %>
            <%= button_to linkedin_training_award_path(@award), method: :post, class: "portal-btn portal-btn-primary w-full sm:w-auto", form: { target: "_blank", data: { turbo: false } } do %>
              Add to LinkedIn
            <% end %>
          <% end %>
          <%= button_to "Get a verification link", share_training_award_path(@award), method: :post, class: "portal-btn portal-btn-secondary w-full sm:w-auto" %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

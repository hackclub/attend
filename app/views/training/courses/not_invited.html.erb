<% content_for :title, "Invite-only training – Attend" %>

<div class="w-full max-w-xl mx-auto">
  <div class="portal-card p-6 sm:p-8 text-center">
    <span class="portal-medallion portal-medallion-neutral mx-auto mb-4">
      <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
      </svg>
    </span>
    <h1 class="portal-title text-2xl mb-2"><%= @course.title %> is invite-only</h1>
    <p class="portal-body mb-6 mx-auto max-w-prose">
      You'll get access once you're added to an event that needs this training, or when someone at Hack Club invites you.
      If you think you should have it already, ask your event organizer — and check you're signed in as <strong class="portal-heading"><%= current_user.email %></strong>.
    </p>
    <%= link_to "Back to training", training_path, class: "portal-btn portal-btn-secondary w-full sm:w-auto" %>
  </div>
</div>

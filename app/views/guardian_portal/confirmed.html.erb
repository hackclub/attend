<% @consent = @participant_event.consents.waiver.first %>

<div class="w-full max-w-lg mx-auto text-center">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-6">
      <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 mb-4">Thank You!</h1>

    <p class="text-gray-600 mb-6">
      You have successfully completed the guardian portion for
      <strong><%= @participant.legal_first_name %> <%= @participant.legal_last_name %></strong>'s
      registration for <strong><%= @event.name %></strong>.
    </p>

    <% if @guardian_participant_event.completed_at %>
      <p class="text-sm text-gray-500 mb-6">
        Completed on <%= @guardian_participant_event.completed_at.strftime("%B %d, %Y at %I:%M %p") %>
      </p>
    <% end %>

    <% guardian_signed = @consent&.guardian_signed_at.present? %>
    <% if @consent&.docuseal_guardian_slug.present? && !guardian_signed %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
        <h3 class="text-sm font-medium text-yellow-800 mb-2">⚠️ Action Required: Sign the Waiver</h3>
        <p class="text-sm text-yellow-700 mb-4">
          Please sign the waiver to complete <%= @participant.legal_first_name %>'s registration.
        </p>
        <%= link_to "Sign Waiver Now", guardian_portal_waiver_path(token: @token), 
            class: "inline-block bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700 font-medium" %>
      </div>
    <% elsif guardian_signed %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
        <h3 class="text-sm font-medium text-green-800">✓ Waiver Signed</h3>
        <p class="text-sm text-green-700">Your portion of the waiver has been signed successfully. <%= @participant.legal_first_name %> will need to complete their portion.</p>
      </div>
    <% else %>
      <div class="bg-blue-50 rounded-lg p-4 text-left mb-6">
        <h3 class="text-sm font-medium text-blue-800 mb-2">What happens next?</h3>
        <ul class="text-sm text-blue-700 space-y-1">
          <li>• A waiver will be sent to your email shortly for you to sign</li>
          <li>• After you sign, <%= @participant.legal_first_name %> will also need to sign</li>
          <li>• You'll be contacted if any additional information is needed</li>
        </ul>
      </div>
    <% end %>

    <%= render "custom_documents" %>

    <% support_email = @event.support_email.presence || 'team@hackclub.com' %>
    <div class="mt-8 text-sm text-gray-500">
      <p>Questions? Contact the event organizers at</p>
      <p><a href="mailto:<%= support_email %>" class="text-blue-600 hover:text-blue-800"><%= support_email %></a></p>
    </div>
  </div>
</div>

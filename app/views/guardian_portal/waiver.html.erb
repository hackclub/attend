<% content_for :title, "Sign the waiver – Attend" %>

<div class="w-full max-w-3xl mx-auto">
  <%= render "shared/portal_masthead",
        subtitle: @event.name,
        back_to: { label: "Consents", path: guardian_portal_step_path(token: @token, step: :consents) } %>

  <% if @waiver_paused %>
    <h1 class="portal-title text-2xl mb-3">The waiver isn't open yet</h1>
    <div class="portal-note portal-note-warn">
      <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
      <p class="portal-body text-sm">
        Signing hasn't opened for this event yet. We'll email you as soon as it does — nothing else is
        needed from you right now.
      </p>
    </div>
  <% else %>
    <h1 class="portal-title text-2xl mb-3">Sign the waiver</h1>

    <p class="portal-body mb-6 max-w-prose">
      Review and sign the waiver for
      <strong class="portal-heading"><%= @participant.legal_first_name %> <%= @participant.legal_last_name %></strong>'s
      participation in <strong class="portal-heading"><%= @event.name %></strong>. Scroll to the bottom of the
      document to enter your details.
    </p>

    <%# The "completed" callback below is the fast path off this page, but it
        isn't guaranteed to reach us (signed in the new-tab fallback, a
        dropped postMessage). Poll alongside it so a signature that lands
        some other way still moves the page on. %>
    <div data-controller="document-status"
         data-document-status-url-value="<%= guardian_portal_signing_status_path(token: @token, consent_id: @consent.id) %>"
         data-document-status-signed-ids-value="[]"></div>
    <%= render "shared/docuseal_form",
        signing_url: @signing_url,
        host: @consent.docuseal_host,
        complete_url: guardian_portal_waiver_complete_path(token: @token) %>

    <p class="portal-hint text-sm text-center">
      Having trouble? <%= link_to "Open the waiver in a new tab", @signing_url, target: "_blank", rel: "noopener", class: "portal-link" %>.
    </p>
  <% end %>
</div>

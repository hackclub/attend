<div class="w-full max-w-3xl mx-auto py-8">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-bold">Preparing the Document</h1>
    <p class="text-gray-600 mt-2">
      We're preparing the document for <strong><%= @participant.legal_first_name %> <%= @participant.legal_last_name %></strong>.
    </p>
  </div>

  <%= render "shared/document_preparing", title: "Almost there" %>

  <p class="mt-6 text-sm text-gray-500 text-center">
    If the page doesn't refresh, <a href="" class="text-blue-600 hover:underline">click here</a>.
  </p>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  setTimeout(function() {
    window.location.reload();
  }, 5000);
</script>

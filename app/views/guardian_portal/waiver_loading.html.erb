<% content_for :title, "Preparing your document – Attend" %>

<div class="w-full max-w-3xl mx-auto">
  <%= render "shared/portal_masthead", subtitle: @event.name %>

  <div class="mb-6 text-center">
    <h1 class="portal-title text-2xl">Preparing the document</h1>
    <p class="portal-body mt-2">
      We're getting the document ready for
      <strong class="portal-heading"><%= @participant.legal_first_name %> <%= @participant.legal_last_name %></strong>.
    </p>
  </div>

  <%= render "shared/document_preparing", title: "Almost there" %>

  <p class="portal-hint text-sm text-center mt-6">
    Not refreshing on its own? <%= link_to "Reload the page", request.fullpath, class: "portal-link" %>.
  </p>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  setTimeout(function() {
    window.location.reload();
  }, 5000);
</script>

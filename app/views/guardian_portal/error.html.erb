<% content_for :title, "Something went wrong – Attend" %>

<div class="w-full max-w-lg mx-auto">
  <%= render "shared/portal_masthead" %>

  <div class="mb-8">
    <span class="portal-medallion portal-medallion-danger mb-5">
      <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
      </svg>
    </span>

    <h1 class="portal-title text-2xl mb-3">Something went wrong</h1>
    <p class="portal-body text-lg">
      <%= @error_message || "We couldn't open that portal link." %>
    </p>
  </div>

  <section class="portal-card p-5 sm:p-6 mb-6">
    <h2 class="portal-heading text-base mb-1">Most likely, your link expired</h2>
    <p class="portal-hint text-sm mb-4">
      Verify your email address or phone number and we'll show you every portal linked to you — with a
      fresh link for each one.
    </p>
    <%= link_to "Find my portals", guardian_portal_center_path, class: "portal-btn portal-btn-primary w-full sm:w-auto" %>
  </section>

  <section class="portal-card p-5 sm:p-6 mb-6">
    <h2 class="portal-heading text-base mb-3">Other things to try</h2>
    <ul class="space-y-3">
      <% [
           "Reload the page — it may have been a temporary hiccup.",
           "Open the newest email we sent you; older links stop working.",
           "Ask the event organizers to send you a new invitation."
         ].each do |suggestion| %>
        <li class="flex items-start gap-3">
          <svg class="size-5 shrink-0 mt-0.5" style="color: var(--text-muted);" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
          </svg>
          <span class="portal-body text-sm"><%= suggestion %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @error_code.present? %>
    <p class="portal-meta text-xs text-center">
      If you contact us, quote this reference:
      <code class="portal-panel px-1.5 py-0.5 rounded"><%= @error_code %></code>
    </p>
  <% end %>
</div>

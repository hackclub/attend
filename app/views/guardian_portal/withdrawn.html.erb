<% content_for :title, "Registration withdrawn – Attend" %>

<div class="w-full max-w-lg mx-auto">
  <%= render "shared/portal_masthead" %>

  <div class="mb-8">
    <span class="portal-medallion portal-medallion-neutral mb-5">
      <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
      </svg>
    </span>

    <h1 class="portal-title text-2xl mb-3">This registration was withdrawn</h1>
    <p class="portal-body text-lg">
      The participant is no longer registered for this event, so there's nothing left for you to sign.
    </p>
  </div>

  <section class="portal-card p-5 sm:p-6">
    <h2 class="portal-heading text-base mb-1">Think this is a mistake?</h2>
    <p class="portal-hint text-sm">
      Contact the event organizers — they can tell you why the registration was withdrawn and reinstate
      it if it was withdrawn in error.
    </p>
  </section>
</div>

<nav class="mb-8 overflow-x-auto">
  <ol class="flex items-center w-full min-w-max">
    <% steps.each_with_index do |step, index| %>
      <% step_number = index + 1 %>
      <% is_completed = completed_steps.include?(step) %>

      <li class="flex items-center <%= 'flex-1' unless index == steps.length - 1 %>">
        <div class="flex flex-col items-center">
          <div class="flex items-center justify-center w-10 h-10 rounded-full border-2 <%= if is_completed
              'bg-green-600 border-green-600 text-white'
            else
              'bg-white border-gray-300 text-gray-500'
            end %>">
            <% if is_completed %>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            <% else %>
              <%= step_number %>
            <% end %>
          </div>
          <span class="mt-2 text-xs font-medium text-gray-500 whitespace-nowrap">
            <%= step.to_s.titleize %>
          </span>
        </div>

        <% unless index == steps.length - 1 %>
          <div class="flex-1 h-0.5 mx-4 <%= is_completed ? 'bg-green-600' : 'bg-gray-300' %>"></div>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>

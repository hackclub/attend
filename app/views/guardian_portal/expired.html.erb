<% content_for :title, "Link expired – Attend" %>

<div class="w-full max-w-lg mx-auto">
  <%= render "shared/portal_masthead" %>

  <div class="mb-8">
    <span class="portal-medallion portal-medallion-warn mb-5">
      <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
    </span>

    <h1 class="portal-title text-2xl mb-3">This link has expired</h1>
    <p class="portal-body text-lg">
      Guardian links stop working after 7 days. Nothing you filled in is lost — you just need a fresh
      way in.
    </p>
  </div>

  <section class="portal-card p-5 sm:p-6 mb-6">
    <h2 class="portal-heading text-base mb-1">Get back in now</h2>
    <p class="portal-hint text-sm mb-4">
      Verify your email address or phone number and we'll reopen this portal straight away — no need to
      wait for another email.
    </p>
    <%= link_to "Find my portals", guardian_portal_center_path, class: "portal-btn portal-btn-primary w-full sm:w-auto" %>
  </section>

  <section class="portal-card p-5 sm:p-6 mb-6">
    <h2 class="portal-heading text-base mb-3">Or, if you'd rather wait</h2>
    <ul class="space-y-4">
      <li>
        <p class="portal-heading text-sm">Check for a newer email</p>
        <p class="portal-hint text-sm mt-0.5">The most recent invitation link is always the valid one.</p>
      </li>
      <li>
        <p class="portal-heading text-sm">Ask for a new invitation</p>
        <p class="portal-hint text-sm mt-0.5">The participant or the event organizers can resend it to you.</p>
      </li>
    </ul>
  </section>

  <p class="portal-hint text-sm">
    Links expire so that a forwarded email can't give a stranger access to a participant's medical and
    contact details.
  </p>
</div>

<nav class="mb-8 overflow-x-auto">
  <ol class="flex items-center w-full min-w-max">
    <% @steps.each_with_index do |step, index| %>
      <% step_number = index + 1 %>
      <% is_completed = @completed_steps.include?(step) %>
      <% is_current = step == @current_step %>

      <li class="flex items-center <%= 'flex-1' unless index == @steps.length - 1 %>">
        <div class="flex flex-col items-center">
          <% if is_completed %>
            <%= link_to guardian_step_path(@guardian_participant_event.invite_token, step), class: "flex items-center justify-center w-10 h-10 rounded-full bg-green-600 border-2 border-green-600 text-white hover:bg-green-700 transition-colors" do %>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            <% end %>
          <% elsif is_current %>
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 border-2 border-blue-600 text-white">
              <%= step_number %>
            </div>
          <% else %>
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-white border-2 border-gray-300 text-gray-500">
              <%= step_number %>
            </div>
          <% end %>
          <span class="mt-2 text-xs font-medium whitespace-nowrap <%= is_current ? 'text-blue-600' : (is_completed ? 'text-green-600' : 'text-gray-500') %>">
            <%= step.to_s.titleize %>
          </span>
        </div>

        <% unless index == @steps.length - 1 %>
          <div class="flex-1 h-0.5 mx-4 <%= is_completed ? 'bg-green-600' : 'bg-gray-300' %>"></div>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>

<% content_for :title, "Freedom waiver – Attend" %>

<div class="w-full max-w-3xl mx-auto">
  <%= render "shared/portal_masthead",
        subtitle: @event.name,
        back_to: { label: "Consents", path: guardian_portal_step_path(token: @token, step: :consents) } %>

  <% if @waiver_paused %>
    <h1 class="portal-title text-2xl mb-3">The freedom waiver isn't open yet</h1>
    <div class="portal-note portal-note-warn">
      <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
      <p class="portal-body text-sm">
        Signing hasn't opened for this event yet. We'll email you as soon as it does.
      </p>
    </div>
  <% else %>
    <h1 class="portal-title text-2xl mb-3">Freedom waiver</h1>

    <div class="portal-note portal-note-info mb-6">
      <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.852l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
      </svg>
      <div>
        <h2 class="portal-heading text-sm">This one is a yes-or-no decision, not a formality</h2>
        <p class="portal-body text-sm mt-1">
          It decides whether <%= @participant.legal_first_name %> may leave the venue unsupervised during free
          time. Grant it and they can explore the surrounding area independently; deny it and they stay
          with Hack Club staff at all times. Either answer is fine — we just need to know.
        </p>
      </div>
    </div>

    <p class="portal-body mb-6 max-w-prose">
      Complete the waiver below for
      <strong class="portal-heading"><%= @participant.legal_first_name %> <%= @participant.legal_last_name %></strong>'s
      participation in <strong class="portal-heading"><%= @event.name %></strong>.
    </p>

    <div class="portal-card overflow-hidden mb-6">
      <docuseal-form
        id="docusealForm"
        data-src="<%= @signing_url %>"
        style="height: 70vh; min-height: 480px; overflow: auto;">
      </docuseal-form>
    </div>

    <p class="portal-hint text-sm text-center">
      Having trouble? <%= link_to "Open the waiver in a new tab", @signing_url, target: "_blank", rel: "noopener", class: "portal-link" %>.
    </p>
  <% end %>
</div>

<% unless @waiver_paused %>
  <script src="https://<%= @consent.docuseal_host %>/js/form.js"></script>
  <script nonce="<%= content_security_policy_nonce %>">
    document.getElementById('docusealForm').addEventListener('completed', function() {
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = '<%= guardian_portal_freedom_waiver_complete_path(token: @token) %>';

      var csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = document.querySelector('meta[name="csrf-token"]').content;
      form.appendChild(csrfInput);

      document.body.appendChild(form);
      form.submit();
    });
  </script>
<% end %>

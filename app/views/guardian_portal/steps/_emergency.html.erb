<% existing_contacts = @emergency_contacts.select { |c| c.persisted? && c.name.present? } %>
<% has_existing_contacts = existing_contacts.any? %>

<% if has_existing_contacts %>
  <section class="portal-card p-5 sm:p-6 mb-6" aria-labelledby="existing-contacts-heading">
    <h2 id="existing-contacts-heading" class="portal-heading text-base mb-1">Contacts on file</h2>
    <p class="portal-hint text-sm mb-4">
      We've added you as the primary contact. Add another below if someone else should be reached
      during the event.
    </p>

    <ul class="divide-y" style="border-color: var(--border);">
      <% existing_contacts.each do |contact| %>
        <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3 first:pt-0 last:pb-0">
          <div class="min-w-0">
            <p class="portal-heading text-sm">
              <%= contact.name %>
              <span class="portal-meta font-normal">· <%= contact.relationship %></span>
            </p>
            <p class="portal-hint text-sm mt-0.5"><%= contact.phone %></p>
          </div>
          <%= link_to guardian_portal_step_path(token: @token, step: "emergency", contact_id: contact.id),
                class: "portal-btn portal-btn-quiet text-sm shrink-0" do %>
            Edit<span class="sr-only"> <%= contact.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% else %>
  <div class="portal-note portal-note-info mb-6">
    <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.852l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
    </svg>
    <p class="portal-body text-sm">
      Give us at least one person we can reach during the event.
    </p>
  </div>
<% end %>

<%= form_with model: @emergency_contact, url: guardian_portal_update_step_path(token: @token, step: "emergency"), method: :patch, local: true, data: { turbo: false, controller: "phone-input" } do |f| %>
  <div class="portal-card p-5 sm:p-6">
    <h2 class="portal-heading text-base mb-1">
      <%= @emergency_contact.persisted? ? "Edit contact" : (has_existing_contacts ? "Add another contact" : "Add a contact") %>
    </h2>
    <p class="portal-hint text-sm mb-6">
      Fields marked with <span class="portal-required" aria-hidden="true">*</span> are required.
    </p>

    <%= f.hidden_field :id if @emergency_contact.persisted? %>

    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, label_text("Full name", required: true), class: "portal-label" %>
          <%= f.text_field :name, class: "portal-input", required: true, autocomplete: "name" %>
        </div>

        <div>
          <%= f.label :relationship, label_text("Relationship to #{@participant.legal_first_name}", required: true), class: "portal-label" %>
          <%= f.text_field :relationship, class: "portal-input", required: true, placeholder: "e.g. Aunt, family friend" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :phone, label_text("Phone", required: true), class: "portal-label" %>
          <%= f.telephone_field :phone, class: "portal-input", required: true, autocomplete: "tel" %>
        </div>

        <div>
          <%= f.label :email, "Email", class: "portal-label" %>
          <%= f.email_field :email, class: "portal-input", autocomplete: "email", inputmode: "email", placeholder: "Optional" %>
        </div>
      </div>

      <div>
        <%= f.label :priority, "When should we call them?", class: "portal-label" %>
        <%= f.select :priority, [ [ "First — call them before anyone else", 1 ], [ "Second — call if the first can't be reached", 2 ], [ "Third — last resort", 3 ] ], {}, class: "portal-select" %>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row gap-3">
        <button type="submit" name="advance" value="true" class="portal-btn portal-btn-primary w-full sm:w-auto">
          <%= has_existing_contacts && !@emergency_contact.persisted? ? "Add and continue" : "Save and continue" %>
        </button>

        <% if has_existing_contacts && !@emergency_contact.persisted? %>
          <%= link_to "Skip — I've added everyone", guardian_portal_step_path(token: @token, step: "consents"),
                class: "portal-btn portal-btn-secondary w-full sm:w-auto" %>
        <% else %>
          <button type="submit" class="portal-btn portal-btn-secondary w-full sm:w-auto">
            Save and come back later
          </button>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

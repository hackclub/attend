<%= form_with model: @guardian, url: guardian_portal_update_step_path(token: @token, step: "details"), method: :patch, local: true, data: { turbo: false, controller: "phone-input" } do |f| %>
  <div class="portal-card p-5 sm:p-6">
    <p class="portal-hint text-sm mb-6">
      Fields marked with <span class="portal-required" aria-hidden="true">*</span> are required.
    </p>

    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :legal_first_name, label_text("First name", required: true), class: "portal-label" %>
          <%= f.text_field :legal_first_name, class: "portal-input", required: true, autocomplete: "given-name" %>
        </div>

        <div>
          <%= f.label :legal_last_name, label_text("Last name", required: true), class: "portal-label" %>
          <%= f.text_field :legal_last_name, class: "portal-input", required: true, autocomplete: "family-name" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :email, label_text("Email", required: true), class: "portal-label" %>
          <%= f.email_field :email, class: "portal-input", required: true, autocomplete: "email", inputmode: "email" %>
        </div>

        <div>
          <%= f.label :phone, label_text("Phone", required: true), class: "portal-label" %>
          <%= f.telephone_field :phone, class: "portal-input", required: true, autocomplete: "tel" %>
        </div>
      </div>

      <div>
        <%= label_tag :relationship, label_text("Your relationship to #{@participant.legal_first_name}", required: true), class: "portal-label" %>
        <select name="relationship" id="relationship" class="portal-select" required>
          <option value="">Select relationship</option>
          <% [ "Parent", "Legal Guardian", "Grandparent", "Other" ].each do |option| %>
            <option value="<%= option %>" <%= "selected" if @guardian_participant_event.relationship == option %>><%= option %></option>
          <% end %>
        </select>
      </div>

      <div class="portal-inset pt-6">
        <h2 class="portal-heading text-base mb-4">Your address</h2>

        <div class="space-y-4">
          <div>
            <%= f.label :address_line_1, label_text("Address line 1", required: true), class: "portal-label" %>
            <%= f.text_field :address_line_1, class: "portal-input", required: true, autocomplete: "address-line1" %>
          </div>

          <div>
            <%= f.label :address_line_2, "Address line 2", class: "portal-label" %>
            <%= f.text_field :address_line_2, class: "portal-input", autocomplete: "address-line2", placeholder: "Apartment, suite, unit (optional)" %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= f.label :city, label_text("City", required: true), class: "portal-label" %>
              <%= f.text_field :city, class: "portal-input", required: true, autocomplete: "address-level2" %>
            </div>

            <div>
              <%= f.label :state, label_text("State / province", required: true), class: "portal-label" %>
              <%= f.text_field :state, class: "portal-input", required: true, autocomplete: "address-level1" %>
            </div>

            <div>
              <%= f.label :postal_code, label_text("Postal code", required: true), class: "portal-label" %>
              <%= f.text_field :postal_code, class: "portal-input", required: true, autocomplete: "postal-code" %>
            </div>

            <div>
              <%= f.label :country, label_text("Country", required: true), class: "portal-label" %>
              <%= f.select :country, country_options_for_select(@guardian.country), {}, class: "portal-select", required: true, autocomplete: "country-name" %>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row gap-3">
        <button type="submit" name="advance" value="true" class="portal-btn portal-btn-primary w-full sm:w-auto">
          Save and continue
        </button>
        <button type="submit" class="portal-btn portal-btn-secondary w-full sm:w-auto">
          Save and come back later
        </button>
      </div>
    </div>
  </div>
<% end %>

<%= form_with model: @guardian, url: guardian_portal_update_step_path(token: @token, step: "details"), method: :patch, local: true, data: { turbo: false, controller: "phone-input" } do |f| %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm text-gray-600 mb-6">Fields marked with <span class="text-red-500">*</span> are required.</p>

    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :legal_first_name, label_text("First Name", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :legal_first_name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>

        <div>
          <%= f.label :legal_last_name, label_text("Last Name", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :legal_last_name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :email, label_text("Email", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>

        <div>
          <%= f.label :phone, label_text("Phone", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1"><%= label_text("Relationship to Participant", required: true) %></label>
        <select name="relationship" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" required>
          <option value="">Select relationship</option>
          <option value="Parent" <%= 'selected' if @guardian_participant_event.relationship == 'Parent' %>>Parent</option>
          <option value="Legal Guardian" <%= 'selected' if @guardian_participant_event.relationship == 'Legal Guardian' %>>Legal Guardian</option>
          <option value="Grandparent" <%= 'selected' if @guardian_participant_event.relationship == 'Grandparent' %>>Grandparent</option>
          <option value="Other" <%= 'selected' if @guardian_participant_event.relationship == 'Other' %>>Other</option>
        </select>
      </div>

      <hr class="my-6">

      <h3 class="text-lg font-medium mb-4">Address</h3>

      <div class="space-y-4">
        <div>
          <%= f.label :address_line_1, label_text("Address Line 1", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :address_line_1, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>

        <div>
          <%= f.label :address_line_2, "Address Line 2 (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :address_line_2, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          <div>
            <%= f.label :city, label_text("City", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :city, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
          </div>

          <div>
            <%= f.label :state, label_text("State/Province", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :state, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
          </div>

          <div>
            <%= f.label :postal_code, label_text("Postal Code", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :postal_code, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
          </div>

          <div>
            <%= f.label :country, label_text("Country", required: true), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :country, country_options_for_select(@guardian.country), {}, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
          </div>
        </div>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row gap-3">
        <%= f.submit "Save", class: "w-full sm:w-auto bg-gray-200 text-gray-800 px-6 py-2 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 font-medium cursor-pointer" %>
        <button type="submit" name="advance" value="true" class="w-full sm:w-auto bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium cursor-pointer">
          Save & Continue
        </button>
      </div>
    </div>
  </div>
<% end %>

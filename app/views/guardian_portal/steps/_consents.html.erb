<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <p class="text-gray-600 mb-6">
    Please review and sign the following consent forms for <%= @participant.legal_first_name %>'s participation.
  </p>

  <% if @waivers_paused %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-yellow-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <div>
          <h3 class="font-medium text-yellow-800">Waivers are not ready yet</h3>
          <p class="text-sm text-yellow-700 mt-1">
            Waiver signing isn't open for this event yet. Everything else you've filled in is saved —
            we'll email you when the waivers are ready to sign.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @required_consent_types.empty? %>
    <div class="text-center py-8">
      <svg class="mx-auto h-12 w-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900">No Additional Consents Required</h3>
      <p class="mt-2 text-gray-500">All required consents have been completed or none are required for this event.</p>
      <div class="mt-6">
        <%= link_to "Return to Overview", guardian_portal_path(token: @token), class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium" %>
      </div>
    </div>
  <% else %>
    <div class="space-y-6">
      <% @required_consent_types.each do |consent_type| %>
        <% existing_consent = @consents.find { |c| c.consent_type == consent_type } %>
        <% is_waiver = consent_type == "waiver" %>
        <% is_freedom_waiver = consent_type == "freedom_waiver" %>
        <% is_code_of_conduct = consent_type == "code_of_conduct" %>
        <% is_docuseal = is_waiver || is_freedom_waiver %>
        <% if is_waiver %>
          <% is_complete = existing_consent&.signed? %>
        <% elsif is_freedom_waiver %>
          <% is_complete = existing_consent&.signed? %>
        <% elsif is_code_of_conduct %>
          <% is_complete = @participant_event.code_of_conduct_accepted_at.present? %>
        <% else %>
          <% is_complete = existing_consent&.agreed? %>
        <% end %>
        <% guardian_signed_waiver = is_waiver && existing_consent&.guardian_signed? && !existing_consent&.signed? %>
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-medium text-gray-900"><%= is_code_of_conduct ? "Code of Conduct & Safeguarding" : consent_type.titleize %></h3>
            <% if is_complete %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Signed
              </span>
            <% elsif guardian_signed_waiver %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                Awaiting Student
              </span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Pending
              </span>
            <% end %>
          </div>

          <% if is_code_of_conduct %>
            <p class="text-sm text-gray-600 mt-2">
              <%= link_to "Read the Hack Club Code of Conduct", "https://hackclub.com/conduct", target: "_blank", class: "text-blue-600 hover:underline" %>
              ·
              <%= link_to "Safeguarding Policy", "https://hackclub.com/safeguarding", target: "_blank", class: "text-blue-600 hover:underline" %>
            </p>
            <% if is_complete %>
              <p class="text-sm text-green-600 mt-2">
                ✓ <%= @participant.legal_first_name %> agreed to the Code of Conduct &amp; Safeguarding Policy on <%= @participant_event.code_of_conduct_accepted_at.strftime("%B %d, %Y at %I:%M %p") %>
              </p>
            <% else %>
              <p class="text-sm text-yellow-700 mt-2">
                Awaiting agreement from <%= @participant.legal_first_name %> during their onboarding.
              </p>
            <% end %>
          <% elsif is_docuseal %>
            <% if is_complete %>
              <p class="text-sm text-gray-500 mt-2">
                <% signed_at = is_waiver ? existing_consent.guardian_signed_at : existing_consent.signed_at %>
                Signed on <%= signed_at&.strftime("%B %d, %Y at %I:%M %p") %>
              </p>
            <% elsif is_waiver && existing_consent&.guardian_signed? %>
              <%# Guardian signed but waiting for participant %>
              <p class="text-sm text-green-600 mt-2">
                ✓ You signed this waiver on <%= existing_consent.guardian_signed_at&.strftime("%B %d, %Y at %I:%M %p") %>
              </p>
              <div class="bg-blue-50 border border-blue-200 rounded-md p-3 mt-3">
                <p class="text-sm text-blue-800">
                  <strong><%= @participant.legal_first_name %></strong> also needs to sign this waiver.
                  They can complete their signature by logging into their onboarding portal.
                </p>
              </div>
            <% elsif @waivers_paused %>
              <p class="text-sm text-gray-500 mt-2">Not ready to sign yet — we'll email you when this is available.</p>
            <% elsif existing_consent&.docuseal_guardian_slug.present? %>
              <p class="text-sm text-gray-600 mt-2 mb-4">
                <% if is_freedom_waiver %>
                  Decide whether to grant or deny permission for <%= @participant.legal_first_name %> to leave the venue unsupervised.
                <% else %>
                  Please sign the waiver form for <%= @participant.legal_first_name %>'s participation.
                <% end %>
              </p>
              <% sign_path = is_freedom_waiver ? guardian_portal_freedom_waiver_path(token: @token) : guardian_portal_waiver_path(token: @token) %>
              <%= link_to (is_freedom_waiver ? "Complete Freedom Waiver" : "Sign Waiver"), sign_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium" %>
            <% else %>
              <p class="text-sm text-gray-500 mt-2">Preparing document...</p>
            <% end %>
          <% elsif !is_complete %>
            <%= form_with url: guardian_portal_update_step_path(token: @token, step: "consents"), method: :patch, local: true, data: { turbo: false } do |f| %>
              <%= hidden_field_tag "consent[consent_type]", consent_type %>

              <div class="mt-4">
                <div class="flex items-start">
                  <%= check_box_tag "consent[agreed]", true, false, class: "h-5 w-5 text-blue-600 focus:ring-blue-500 border-gray-300 rounded mt-0.5", required: true %>
                  <label for="consent_agreed" class="ml-3 text-sm text-gray-700">
                    I have read and agree to the terms of this consent form.
                  </label>
                </div>
              </div>

              <div class="mt-4">
                <%= label_tag "consent[signature]", "Digital Signature (type your full name)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= text_field_tag "consent[signature]", nil, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true, placeholder: "Type your full legal name" %>
              </div>

              <div class="mt-4">
                <%= submit_tag "Sign Consent", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium cursor-pointer" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500 mt-2">
              Signed by <%= existing_consent.signature %> on <%= existing_consent.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="pt-6">
      <%= link_to "Return to Overview", guardian_portal_path(token: @token), class: "bg-gray-200 text-gray-800 px-6 py-2 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 font-medium" %>
    </div>
  <% end %>

  <%= render "guardian_portal/custom_documents" %>
</div>

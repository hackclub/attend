<% first_name = @participant.legal_first_name %>

<% if @waivers_paused %>
  <div class="portal-note portal-note-warn mb-6">
    <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
    </svg>
    <div>
      <h2 class="portal-heading text-sm">Waivers aren't open yet</h2>
      <p class="portal-body text-sm mt-1">
        Signing isn't open for this event yet. Everything else you've filled in is saved — we'll email
        you the moment the waivers are ready.
      </p>
    </div>
  </div>
<% end %>

<% if @required_consent_types.empty? %>
  <div class="portal-card p-8 text-center">
    <span class="portal-medallion portal-medallion-success mx-auto mb-4">
      <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
      </svg>
    </span>
    <h2 class="portal-heading text-lg mb-2">Nothing to sign</h2>
    <p class="portal-body mb-6 mx-auto max-w-prose">
      This event doesn't need any consent forms from you, or they're already done.
    </p>
    <%= link_to "Back to overview", guardian_portal_path(token: @token), class: "portal-btn portal-btn-primary w-full sm:w-auto" %>
  </div>
<% else %>
  <section class="portal-card p-5 sm:p-6" aria-labelledby="consents-heading">
    <h2 id="consents-heading" class="portal-heading text-base mb-1">Forms for this event</h2>
    <p class="portal-hint text-sm mb-2">
      Review and sign each one for <%= first_name %>'s participation.
    </p>

    <ul class="divide-y" style="border-color: var(--border);">
      <% @required_consent_types.each do |consent_type| %>
        <% existing_consent = @consents.find { |c| c.consent_type == consent_type } %>
        <% is_waiver = consent_type == "waiver" %>
        <% is_freedom_waiver = consent_type == "freedom_waiver" %>
        <% is_code_of_conduct = consent_type == "code_of_conduct" %>
        <% is_docuseal = is_waiver || is_freedom_waiver %>
        <% is_complete = if is_docuseal
             existing_consent&.signed?
           elsif is_code_of_conduct
             @participant_event.code_of_conduct_accepted_at.present?
           else
             existing_consent&.agreed?
           end %>
        <% guardian_signed_waiver = is_waiver && existing_consent&.guardian_signed? && !existing_consent&.signed? %>
        <% dom_id = consent_type.parameterize(separator: "_") %>

        <li class="py-5 first:pt-4 last:pb-0">
          <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 mb-1">
            <h3 class="portal-heading text-base">
              <%= is_code_of_conduct ? "Code of Conduct & Safeguarding" : consent_type_label(consent_type) %>
            </h3>
            <% if is_complete %>
              <span class="portal-badge portal-badge-done">Signed</span>
            <% elsif guardian_signed_waiver %>
              <span class="portal-badge portal-badge-waiting">Waiting on <%= first_name %></span>
            <% else %>
              <span class="portal-badge portal-badge-pending">Needs you</span>
            <% end %>
          </div>

          <% description = consent_type_description(consent_type) %>
          <% if description.present? && !is_code_of_conduct %>
            <p class="portal-hint text-sm mb-3"><%= description %></p>
          <% end %>

          <% if is_code_of_conduct %>
            <p class="portal-hint text-sm mb-3">
              <%= link_to "Read the Hack Club Code of Conduct", "https://hackclub.com/conduct", target: "_blank", rel: "noopener", class: "portal-link" %>
              ·
              <%= link_to "Safeguarding Policy", "https://hackclub.com/safeguarding", target: "_blank", rel: "noopener", class: "portal-link" %>
            </p>
            <% if is_complete %>
              <p class="portal-hint text-sm">
                <%= first_name %> agreed on <%= @participant_event.code_of_conduct_accepted_at.strftime("%B %-d, %Y at %-I:%M %p") %>.
              </p>
            <% else %>
              <p class="portal-hint text-sm">
                <%= first_name %> agrees to this during their own onboarding — nothing for you to do here.
              </p>
            <% end %>

          <% elsif is_docuseal %>
            <% if is_complete %>
              <% signed_at = is_waiver ? existing_consent.guardian_signed_at : existing_consent.signed_at %>
              <p class="portal-hint text-sm">Signed on <%= signed_at&.strftime("%B %-d, %Y at %-I:%M %p") %>.</p>
            <% elsif is_waiver && existing_consent&.guardian_signed? %>
              <p class="portal-hint text-sm mb-3">
                You signed on <%= existing_consent.guardian_signed_at&.strftime("%B %-d, %Y at %-I:%M %p") %>.
              </p>
              <div class="portal-note portal-note-info">
                <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.852l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
                </svg>
                <p class="portal-body text-sm">
                  <strong class="portal-heading"><%= first_name %></strong> also needs to sign this waiver, from
                  their own onboarding portal.
                </p>
              </div>
            <% elsif @waivers_paused %>
              <p class="portal-hint text-sm">Not open for signing yet — we'll email you when it is.</p>
            <% elsif existing_consent&.docuseal_guardian_slug.present? %>
              <% sign_path = is_freedom_waiver ? guardian_portal_freedom_waiver_path(token: @token) : guardian_portal_waiver_path(token: @token) %>
              <%= link_to (is_freedom_waiver ? "Complete the freedom waiver" : "Sign the waiver"), sign_path,
                    class: "portal-btn portal-btn-primary w-full sm:w-auto mt-1" %>
            <% else %>
              <p class="portal-hint text-sm">Preparing this document — check back in a moment.</p>
            <% end %>

          <% elsif !is_complete %>
            <%= form_with url: guardian_portal_update_step_path(token: @token, step: "consents"), method: :patch, local: true, data: { turbo: false } do |f| %>
              <%= hidden_field_tag "consent[consent_type]", consent_type, id: "consent_type_#{dom_id}" %>

              <div class="space-y-4 mt-3">
                <label class="portal-check-row" for="agreed_<%= dom_id %>">
                  <%= check_box_tag "consent[agreed]", true, false, id: "agreed_#{dom_id}", class: "portal-check mt-0.5", required: true %>
                  <span class="text-sm">I have read and agree to the terms of this form.</span>
                </label>

                <div>
                  <%= label_tag "signature_#{dom_id}", label_text("Type your full legal name to sign", required: true), class: "portal-label" %>
                  <%= text_field_tag "consent[signature]", nil, id: "signature_#{dom_id}", class: "portal-input", required: true, autocomplete: "name", placeholder: @guardian.full_name.presence || "Your full legal name" %>
                </div>

                <button type="submit" class="portal-btn portal-btn-primary w-full sm:w-auto">Sign this form</button>
              </div>
            <% end %>

          <% else %>
            <p class="portal-hint text-sm">
              Signed by <%= existing_consent.signature %> on <%= existing_consent.created_at.strftime("%B %-d, %Y at %-I:%M %p") %>.
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <%= render "guardian_portal/custom_documents" %>

  <div class="mt-6">
    <%= link_to "Back to overview", guardian_portal_path(token: @token), class: "portal-btn portal-btn-secondary w-full sm:w-auto" %>
  </div>
<% end %>

<div class="portal-note portal-note-info mb-6">
  <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.852l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
  </svg>
  <p class="portal-body text-sm">
    <%= @participant.legal_first_name %> filled most of this in already. Correct anything that's wrong and
    add what's missing — the event team relies on it for their safety.
  </p>
</div>

<%= form_with url: guardian_portal_update_step_path(token: @token, step: "participant_info"), method: :patch, local: true, data: { turbo: false, controller: "phone-input" } do |f| %>
  <div class="space-y-8">
    <p class="portal-hint text-sm">Fields marked with <span class="portal-required" aria-hidden="true">*</span> are required.</p>

    <section class="portal-card p-5 sm:p-6">
      <h2 class="portal-heading text-lg mb-5">Profile</h2>

      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="participant_legal_first_name" class="portal-label"><%= label_text("Legal First Name", required: true) %></label>
            <input type="text" name="participant[legal_first_name]" id="participant_legal_first_name" value="<%= @participant_data.legal_first_name %>" class="portal-input" required>
          </div>
          <div>
            <label for="participant_legal_last_name" class="portal-label"><%= label_text("Legal Last Name", required: true) %></label>
            <input type="text" name="participant[legal_last_name]" id="participant_legal_last_name" value="<%= @participant_data.legal_last_name %>" class="portal-input" required>
          </div>
        </div>

        <div>
          <label for="participant_date_of_birth" class="portal-label"><%= label_text("Date of Birth", required: true) %></label>
          <input type="date" name="participant[date_of_birth]" id="participant_date_of_birth" value="<%= @participant_data.date_of_birth&.to_s %>" class="portal-input" required>
        </div>

        <div>
          <label for="participant_email" class="portal-label"><%= label_text("Email", required: true) %></label>
          <input type="email" name="participant[email]" id="participant_email" value="<%= @participant_data.email %>" class="portal-input" required>
        </div>

        <div>
          <label for="participant_phone" class="portal-label"><%= label_text("Phone Number", required: true) %></label>
          <input type="tel" name="participant[phone]" id="participant_phone" value="<%= @participant_data.phone %>" class="portal-input" required>
        </div>

        <div data-controller="address-autocomplete" data-address-autocomplete-fill-components-value="true" class="space-y-4">
          <div>
            <label for="participant_address_line_1" class="portal-label"><%= label_text("Address Line 1", required: true) %></label>
            <input type="text" name="participant[address_line_1]" id="participant_address_line_1" value="<%= @participant_data.address_line_1 %>" class="portal-input" required data-address-autocomplete-target="input">
          </div>

          <div>
            <label for="participant_address_line_2" class="portal-label">Address Line 2</label>
            <input type="text" name="participant[address_line_2]" id="participant_address_line_2" value="<%= @participant_data.address_line_2 %>" class="portal-input">
            <p class="portal-hint text-sm mt-1">Apartment, suite, unit, etc. (optional)</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="participant_city" class="portal-label"><%= label_text("City", required: true) %></label>
              <input type="text" name="participant[city]" id="participant_city" value="<%= @participant_data.city %>" class="portal-input" required data-address-autocomplete-target="city">
            </div>
            <div>
              <label for="participant_state" class="portal-label"><%= label_text("State / Province / Region", required: true) %></label>
              <input type="text" name="participant[state]" id="participant_state" value="<%= @participant_data.state %>" class="portal-input" required data-address-autocomplete-target="state">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="participant_postal_code" class="portal-label"><%= label_text("Postal / ZIP Code", required: true) %></label>
              <input type="text" name="participant[postal_code]" id="participant_postal_code" value="<%= @participant_data.postal_code %>" class="portal-input" required data-address-autocomplete-target="postalCode">
            </div>
            <div>
              <label for="participant_country_of_residence" class="portal-label"><%= label_text("Country", required: true) %></label>
              <%= select_tag "participant[country_of_residence]", country_options_for_select(@participant_data.country_of_residence), class: "portal-select", required: true, data: { address_autocomplete_target: "country" } %>
            </div>
          </div>
        </div>

        <div>
          <label for="participant_tshirt_size" class="portal-label">T-Shirt Size</label>
          <select name="participant[tshirt_size]" id="participant_tshirt_size" class="portal-input">
            <option value="">Select size</option>
            <% %w[XS S M L XL XXL XXXL].each do |size| %>
              <option value="<%= size %>" <%= "selected" if @participant_data.tshirt_size == size %>><%= size %></option>
            <% end %>
          </select>
        </div>
      </div>
    </section>

    <% if @event.travel_enabled? %>
    <section class="portal-card p-5 sm:p-6" data-controller="travel-form">
      <h2 class="portal-heading text-lg mb-5">Travel</h2>

      <div class="space-y-6">
        <!-- Inbound Travel -->
        <div class="pb-6 portal-inset-bottom">
          <h3 class="portal-heading text-base mb-4">Arrival (Getting to <%= @event.location_city || "the event" %>)</h3>
          <div class="space-y-4">
            <div>
              <label for="travel_inbound_mode" class="portal-label">Travel Mode</label>
              <select name="travel_inbound[mode]" id="travel_inbound_mode" data-action="change->travel-form#updateFields" data-travel-form-target="inboundMode" class="portal-input">
                <option value="">Select mode</option>
                <option value="plane" <%= "selected" if @travel_inbound&.plane? %>>Flight</option>
                <option value="train" <%= "selected" if @travel_inbound&.train? %>>Train</option>
                <option value="bus" <%= "selected" if @travel_inbound&.bus? %>>Bus</option>
                <option value="car" <%= "selected" if @travel_inbound&.car? %>>Car</option>
                <option value="other" <%= "selected" if @travel_inbound&.other? %>>Other</option>
              </select>
            </div>

            <!-- Flight Fields -->
            <div data-travel-form-target="inboundPlane" class="<%= 'hidden' unless @travel_inbound&.plane? %> space-y-4">
              <% legs = @travel_inbound&.travel_legs.presence || [TravelLeg.new(position: 0)] %>
              <% legs.each_with_index do |leg, index| %>
                <div class="portal-panel p-4">
                  <div class="portal-meta text-xs font-semibold uppercase tracking-wider mb-3">Flight <%= index + 1 %></div>
                  <input type="hidden" name="travel_inbound[travel_legs_attributes][<%= index %>][id]" value="<%= leg.id %>">
                  <input type="hidden" name="travel_inbound[travel_legs_attributes][<%= index %>][position]" value="<%= index %>">
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label for="travel_inbound_leg_<%= index %>_flight_code" class="portal-label">Flight Code</label>
                      <input type="text" name="travel_inbound[travel_legs_attributes][<%= index %>][flight_code]" id="travel_inbound_leg_<%= index %>_flight_code" value="<%= leg.flight_code %>" placeholder="e.g. LH1234" class="portal-input">
                    </div>
                    <div>
                      <label for="travel_inbound_leg_<%= index %>_confirmation_code" class="portal-label">Confirmation Code</label>
                      <input type="text" name="travel_inbound[travel_legs_attributes][<%= index %>][confirmation_code]" id="travel_inbound_leg_<%= index %>_confirmation_code" value="<%= leg.confirmation_code %>" placeholder="Booking reference" class="portal-input">
                    </div>
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label for="travel_inbound_leg_<%= index %>_departure_airport" class="portal-label">Departure Airport</label>
                      <input type="text" name="travel_inbound[travel_legs_attributes][<%= index %>][departure_airport]" id="travel_inbound_leg_<%= index %>_departure_airport" value="<%= leg.departure_airport %>" placeholder="e.g. LHR" class="portal-input">
                    </div>
                    <div>
                      <label for="travel_inbound_leg_<%= index %>_arrival_airport" class="portal-label">Arrival Airport</label>
                      <input type="text" name="travel_inbound[travel_legs_attributes][<%= index %>][arrival_airport]" id="travel_inbound_leg_<%= index %>_arrival_airport" value="<%= leg.arrival_airport %>" placeholder="e.g. VIE" class="portal-input">
                    </div>
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="travel_inbound_leg_<%= index %>_departure_time" class="portal-label">Departure Time <span class="portal-meta font-normal">(local airport time)</span></label>
                      <input type="datetime-local" name="travel_inbound[travel_legs_attributes][<%= index %>][departure_time]" id="travel_inbound_leg_<%= index %>_departure_time" value="<%= flight_local_input_value(leg.departure_time, leg.departure_airport) %>" class="portal-input">
                      <select name="travel_inbound[travel_legs_attributes][<%= index %>][departure_time_zone]" aria-label="Departure time zone for flight <%= index + 1 %>" class="portal-select mt-1 text-sm"><%= travel_leg_time_zone_options %></select>
                    </div>
                    <div>
                      <label for="travel_inbound_leg_<%= index %>_arrival_time" class="portal-label">Arrival Time <span class="portal-meta font-normal">(local airport time)</span></label>
                      <input type="datetime-local" name="travel_inbound[travel_legs_attributes][<%= index %>][arrival_time]" id="travel_inbound_leg_<%= index %>_arrival_time" value="<%= flight_local_input_value(leg.arrival_time, leg.arrival_airport) %>" class="portal-input">
                      <select name="travel_inbound[travel_legs_attributes][<%= index %>][arrival_time_zone]" aria-label="Arrival time zone for flight <%= index + 1 %>" class="portal-select mt-1 text-sm"><%= travel_leg_time_zone_options %></select>
                    </div>
                  </div>
                </div>
              <% end %>
              
              <label class="portal-check-row items-center">
                <input type="hidden" name="travel_inbound[is_unaccompanied_minor]" value="0">
                <input type="checkbox" name="travel_inbound[is_unaccompanied_minor]" value="1" <%= "checked" if @travel_inbound&.is_unaccompanied_minor %> class="portal-check" data-travel-form-target="umCheckbox" data-action="change->travel-form#toggleUmSection">
                <span class="text-sm font-medium">Travelling as an unaccompanied minor (formal airline UM service)</span>
              </label>
            </div>

            <!-- Train Fields -->
            <div data-travel-form-target="inboundTrain" class="<%= 'hidden' unless @travel_inbound&.train? %> space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="travel_inbound_train_departure_station" class="portal-label">Departure Station</label>
                  <input type="text" name="travel_inbound[train_departure_station]" id="travel_inbound_train_departure_station" value="<%= @travel_inbound&.train_departure_station %>" placeholder="e.g. London St Pancras" class="portal-input">
                </div>
                <div>
                  <label for="travel_inbound_train_arrival_station" class="portal-label">Arrival Station</label>
                  <input type="text" name="travel_inbound[train_arrival_station]" id="travel_inbound_train_arrival_station" value="<%= @travel_inbound&.train_arrival_station %>" placeholder="e.g. Wien Hauptbahnhof" class="portal-input">
                </div>
              </div>
              <div>
                <label for="travel_inbound_train_arrival_time" class="portal-label">Arrival Time in <%= @event.location_city || "the event" %></label>
                <input type="datetime-local" name="travel_inbound[arrival_time]" id="travel_inbound_train_arrival_time" value="<%= @travel_inbound&.arrival_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
              </div>
            </div>

            <!-- Bus Fields -->
            <div data-travel-form-target="inboundBus" class="<%= 'hidden' unless @travel_inbound&.bus? %> space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="travel_inbound_bus_departure_location" class="portal-label">Departure Location</label>
                  <input type="text" name="travel_inbound[bus_departure_location]" id="travel_inbound_bus_departure_location" value="<%= @travel_inbound&.bus_departure_location %>" class="portal-input">
                </div>
                <div>
                  <label for="travel_inbound_bus_arrival_location" class="portal-label">Arrival Location</label>
                  <input type="text" name="travel_inbound[bus_arrival_location]" id="travel_inbound_bus_arrival_location" value="<%= @travel_inbound&.bus_arrival_location %>" class="portal-input">
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="travel_inbound_bus_departure_time" class="portal-label">Departure Time</label>
                  <input type="datetime-local" name="travel_inbound[departure_time]" id="travel_inbound_bus_departure_time" value="<%= @travel_inbound&.departure_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
                </div>
                <div>
                  <label for="travel_inbound_bus_arrival_time" class="portal-label">Arrival Time</label>
                  <input type="datetime-local" name="travel_inbound[arrival_time]" id="travel_inbound_bus_arrival_time" value="<%= @travel_inbound&.arrival_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
                </div>
              </div>
            </div>

            <!-- Car Fields -->
            <div data-travel-form-target="inboundCar" class="<%= 'hidden' unless @travel_inbound&.car? %> space-y-4">
              <div data-controller="address-autocomplete">
                <label for="travel_inbound_origin_address" class="portal-label">Where are you travelling from?</label>
                <textarea name="travel_inbound[origin_address]" id="travel_inbound_origin_address" rows="2" class="portal-textarea" data-address-autocomplete-target="input"><%= @travel_inbound&.origin_address %></textarea>
              </div>
              <div>
                <label for="travel_inbound_expected_arrival_time" class="portal-label">Expected Arrival Time in <%= @event.location_city || "the event" %></label>
                <input type="datetime-local" name="travel_inbound[expected_arrival_time]" id="travel_inbound_expected_arrival_time" value="<%= @travel_inbound&.expected_arrival_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
              </div>
            </div>

            <!-- Other Fields -->
            <div data-travel-form-target="inboundOther" class="<%= 'hidden' unless @travel_inbound&.other? %>">
              <label for="travel_inbound_other_details" class="portal-label">Please describe travel arrangements</label>
              <textarea name="travel_inbound[other_details]" id="travel_inbound_other_details" rows="4" class="portal-textarea"><%= @travel_inbound&.other_details %></textarea>
            </div>
          </div>
        </div>

        <!-- Outbound Travel -->
        <div>
          <h3 class="portal-heading text-base mb-4">Departure (Leaving <%= @event.location_city || "the event" %>)</h3>
          <div class="space-y-4">
            <div>
              <label for="travel_outbound_mode" class="portal-label">Travel Mode</label>
              <select name="travel_outbound[mode]" id="travel_outbound_mode" data-action="change->travel-form#updateFields" data-travel-form-target="outboundMode" class="portal-input">
                <option value="">Select mode</option>
                <option value="plane" <%= "selected" if @travel_outbound&.plane? %>>Flight</option>
                <option value="train" <%= "selected" if @travel_outbound&.train? %>>Train</option>
                <option value="bus" <%= "selected" if @travel_outbound&.bus? %>>Bus</option>
                <option value="car" <%= "selected" if @travel_outbound&.car? %>>Car</option>
                <option value="other" <%= "selected" if @travel_outbound&.other? %>>Other</option>
              </select>
            </div>

            <!-- Flight Fields -->
            <div data-travel-form-target="outboundPlane" class="<%= 'hidden' unless @travel_outbound&.plane? %> space-y-4">
              <% legs = @travel_outbound&.travel_legs.presence || [TravelLeg.new(position: 0)] %>
              <% legs.each_with_index do |leg, index| %>
                <div class="portal-panel p-4">
                  <div class="portal-meta text-xs font-semibold uppercase tracking-wider mb-3">Flight <%= index + 1 %></div>
                  <input type="hidden" name="travel_outbound[travel_legs_attributes][<%= index %>][id]" value="<%= leg.id %>">
                  <input type="hidden" name="travel_outbound[travel_legs_attributes][<%= index %>][position]" value="<%= index %>">
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label for="travel_outbound_leg_<%= index %>_flight_code" class="portal-label">Flight Code</label>
                      <input type="text" name="travel_outbound[travel_legs_attributes][<%= index %>][flight_code]" id="travel_outbound_leg_<%= index %>_flight_code" value="<%= leg.flight_code %>" placeholder="e.g. LH1234" class="portal-input">
                    </div>
                    <div>
                      <label for="travel_outbound_leg_<%= index %>_confirmation_code" class="portal-label">Confirmation Code</label>
                      <input type="text" name="travel_outbound[travel_legs_attributes][<%= index %>][confirmation_code]" id="travel_outbound_leg_<%= index %>_confirmation_code" value="<%= leg.confirmation_code %>" placeholder="Booking reference" class="portal-input">
                    </div>
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label for="travel_outbound_leg_<%= index %>_departure_airport" class="portal-label">Departure Airport</label>
                      <input type="text" name="travel_outbound[travel_legs_attributes][<%= index %>][departure_airport]" id="travel_outbound_leg_<%= index %>_departure_airport" value="<%= leg.departure_airport %>" placeholder="e.g. VIE" class="portal-input">
                    </div>
                    <div>
                      <label for="travel_outbound_leg_<%= index %>_arrival_airport" class="portal-label">Arrival Airport</label>
                      <input type="text" name="travel_outbound[travel_legs_attributes][<%= index %>][arrival_airport]" id="travel_outbound_leg_<%= index %>_arrival_airport" value="<%= leg.arrival_airport %>" placeholder="e.g. LHR" class="portal-input">
                    </div>
                  </div>
                  
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="travel_outbound_leg_<%= index %>_departure_time" class="portal-label">Departure Time <span class="portal-meta font-normal">(local airport time)</span></label>
                      <input type="datetime-local" name="travel_outbound[travel_legs_attributes][<%= index %>][departure_time]" id="travel_outbound_leg_<%= index %>_departure_time" value="<%= flight_local_input_value(leg.departure_time, leg.departure_airport) %>" class="portal-input">
                      <select name="travel_outbound[travel_legs_attributes][<%= index %>][departure_time_zone]" aria-label="Departure time zone for flight <%= index + 1 %>" class="portal-select mt-1 text-sm"><%= travel_leg_time_zone_options %></select>
                    </div>
                    <div>
                      <label for="travel_outbound_leg_<%= index %>_arrival_time" class="portal-label">Arrival Time <span class="portal-meta font-normal">(local airport time)</span></label>
                      <input type="datetime-local" name="travel_outbound[travel_legs_attributes][<%= index %>][arrival_time]" id="travel_outbound_leg_<%= index %>_arrival_time" value="<%= flight_local_input_value(leg.arrival_time, leg.arrival_airport) %>" class="portal-input">
                      <select name="travel_outbound[travel_legs_attributes][<%= index %>][arrival_time_zone]" aria-label="Arrival time zone for flight <%= index + 1 %>" class="portal-select mt-1 text-sm"><%= travel_leg_time_zone_options %></select>
                    </div>
                  </div>
                </div>
              <% end %>
              
              <label class="portal-check-row items-center">
                <input type="hidden" name="travel_outbound[is_unaccompanied_minor]" value="0">
                <input type="checkbox" name="travel_outbound[is_unaccompanied_minor]" value="1" <%= "checked" if @travel_outbound&.is_unaccompanied_minor %> class="portal-check" data-travel-form-target="umCheckbox" data-action="change->travel-form#toggleUmSection">
                <span class="text-sm font-medium">Travelling as an unaccompanied minor (formal airline UM service)</span>
              </label>
            </div>

            <!-- Train Fields -->
            <div data-travel-form-target="outboundTrain" class="<%= 'hidden' unless @travel_outbound&.train? %> space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="travel_outbound_train_departure_station" class="portal-label">Departure Station</label>
                  <input type="text" name="travel_outbound[train_departure_station]" id="travel_outbound_train_departure_station" value="<%= @travel_outbound&.train_departure_station %>" placeholder="e.g. Wien Hauptbahnhof" class="portal-input">
                </div>
                <div>
                  <label for="travel_outbound_train_arrival_station" class="portal-label">Arrival Station</label>
                  <input type="text" name="travel_outbound[train_arrival_station]" id="travel_outbound_train_arrival_station" value="<%= @travel_outbound&.train_arrival_station %>" class="portal-input">
                </div>
              </div>
              <div>
                <label for="travel_outbound_train_departure_time" class="portal-label">Departure Time from <%= @event.location_city || "the event" %></label>
                <input type="datetime-local" name="travel_outbound[departure_time]" id="travel_outbound_train_departure_time" value="<%= @travel_outbound&.departure_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
              </div>
            </div>

            <!-- Bus Fields -->
            <div data-travel-form-target="outboundBus" class="<%= 'hidden' unless @travel_outbound&.bus? %> space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="travel_outbound_bus_departure_location" class="portal-label">Departure Location</label>
                  <input type="text" name="travel_outbound[bus_departure_location]" id="travel_outbound_bus_departure_location" value="<%= @travel_outbound&.bus_departure_location %>" class="portal-input">
                </div>
                <div>
                  <label for="travel_outbound_bus_arrival_location" class="portal-label">Arrival Location</label>
                  <input type="text" name="travel_outbound[bus_arrival_location]" id="travel_outbound_bus_arrival_location" value="<%= @travel_outbound&.bus_arrival_location %>" class="portal-input">
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="travel_outbound_bus_departure_time" class="portal-label">Departure Time</label>
                  <input type="datetime-local" name="travel_outbound[departure_time]" id="travel_outbound_bus_departure_time" value="<%= @travel_outbound&.departure_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
                </div>
                <div>
                  <label for="travel_outbound_bus_arrival_time" class="portal-label">Arrival Time</label>
                  <input type="datetime-local" name="travel_outbound[arrival_time]" id="travel_outbound_bus_arrival_time" value="<%= @travel_outbound&.arrival_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
                </div>
              </div>
            </div>

            <!-- Car Fields -->
            <div data-travel-form-target="outboundCar" class="<%= 'hidden' unless @travel_outbound&.car? %> space-y-4">
              <div data-controller="address-autocomplete">
                <label for="travel_outbound_origin_address" class="portal-label">Where are you travelling to?</label>
                <textarea name="travel_outbound[origin_address]" id="travel_outbound_origin_address" rows="2" class="portal-textarea" data-address-autocomplete-target="input"><%= @travel_outbound&.origin_address %></textarea>
              </div>
              <div>
                <label for="travel_outbound_departure_time" class="portal-label">Departure Time from <%= @event.location_city || "the event" %></label>
                <input type="datetime-local" name="travel_outbound[departure_time]" id="travel_outbound_departure_time" value="<%= @travel_outbound&.departure_time&.strftime('%Y-%m-%dT%H:%M') %>" class="portal-input">
              </div>
            </div>

            <!-- Other Fields -->
            <div data-travel-form-target="outboundOther" class="<%= 'hidden' unless @travel_outbound&.other? %>">
              <label for="travel_outbound_other_details" class="portal-label">Please describe travel arrangements</label>
              <textarea name="travel_outbound[other_details]" id="travel_outbound_other_details" rows="4" class="portal-textarea"><%= @travel_outbound&.other_details %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Unaccompanied Minor confirmation -->
      <% um_declared = @travel_inbound&.is_unaccompanied_minor || @travel_outbound&.is_unaccompanied_minor %>
      <div class="portal-note portal-note-warn mt-6 block <%= 'hidden' unless um_declared %>" data-travel-form-target="umSection">
        <h3 class="portal-heading text-sm mb-2">Please confirm the unaccompanied minor booking</h3>
        <p class="portal-body text-sm mb-3">
          The unaccompanied minor (UM) service is a <strong>paid airline service</strong> where airline staff chaperone your child through the airport and onto the flight. It is <strong>not</strong> the same as your child being under 18 and travelling alone — it must be booked with the airline in advance, usually with an extra fee.
        </p>
        <label class="portal-check-row">
          <input type="hidden" name="um_guardian_confirmation" value="0">
          <input type="checkbox" name="um_guardian_confirmation" value="1" <%= "checked" if @participant_event.um_guardian_confirmed_at.present? %> class="portal-check mt-0.5">
          <span class="text-sm font-medium">I confirm that <%= @participant.preferred_name.presence || @participant.legal_first_name %> is formally booked with the airline's unaccompanied minor service for the flights above.</span>
        </label>
      </div>
    </section>
    <% end %>

    <section class="portal-card p-5 sm:p-6">
      <h2 class="portal-heading text-lg mb-5">Medical</h2>

      <div class="space-y-4">
        <div>
          <label for="medical_allergies" class="portal-label">Allergies</label>
          <textarea name="medical[allergies]" id="medical_allergies" rows="2" class="portal-textarea" placeholder="List any allergies (medications, environmental, etc.)"><%= @medical&.allergies %></textarea>
        </div>

        <div>
          <label for="medical_medical_conditions" class="portal-label">Medical Conditions</label>
          <textarea name="medical[medical_conditions]" id="medical_medical_conditions" rows="2" class="portal-textarea" placeholder="Any conditions we should be aware of"><%= @medical&.medical_conditions %></textarea>
        </div>

        <div>
          <label for="medical_medications" class="portal-label">Current Medications</label>
          <textarea name="medical[medications]" id="medical_medications" rows="2" class="portal-textarea" placeholder="List any medications taken regularly"><%= @medical&.medications %></textarea>
        </div>

        <div class="space-y-2">
          <label class="portal-check-row items-center">
            <input type="hidden" name="medical[has_anaphylaxis_risk]" value="0">
            <input type="checkbox" name="medical[has_anaphylaxis_risk]" value="1" <%= "checked" if @medical&.has_anaphylaxis_risk %> class="portal-check">
            <span class="text-sm font-medium">At risk of anaphylaxis</span>
          </label>

          <label class="portal-check-row items-center">
            <input type="hidden" name="medical[requires_refrigeration]" value="0">
            <input type="checkbox" name="medical[requires_refrigeration]" value="1" <%= "checked" if @medical&.requires_refrigeration %> class="portal-check">
            <span class="text-sm font-medium">Needs refrigeration for medications</span>
          </label>
        </div>
      </div>
    </section>

    <section class="portal-card p-5 sm:p-6">
      <h2 class="portal-heading text-lg mb-5">Food and diet</h2>

      <div class="space-y-4">
        <div>
          <label for="dietary_diet_type" class="portal-label">Diet Type</label>
          <select name="dietary[diet_type]" id="dietary_diet_type" class="portal-input">
            <option value="">No specific diet</option>
            <option value="vegetarian" <%= "selected" if @dietary&.diet_type == "vegetarian" %>>Vegetarian</option>
            <option value="vegan" <%= "selected" if @dietary&.diet_type == "vegan" %>>Vegan</option>
            <option value="halal" <%= "selected" if @dietary&.diet_type == "halal" %>>Halal</option>
            <option value="kosher" <%= "selected" if @dietary&.diet_type == "kosher" %>>Kosher</option>
            <option value="other" <%= "selected" if @dietary&.diet_type == "other" %>>Other</option>
          </select>
        </div>

        <div>
          <label for="dietary_intolerances" class="portal-label">Food Intolerances</label>
          <textarea name="dietary[intolerances]" id="dietary_intolerances" rows="2" class="portal-textarea" placeholder="e.g., lactose, gluten, nuts"><%= @dietary&.intolerances %></textarea>
        </div>

        <div>
          <label for="dietary_life_threatening_allergies" class="portal-label">Life-Threatening Food Allergies</label>
          <textarea name="dietary[life_threatening_allergies]" id="dietary_life_threatening_allergies" rows="2" class="portal-textarea" placeholder="List any severe food allergies"><%= @dietary&.life_threatening_allergies %></textarea>
          <p class="portal-hint text-sm mt-1">This helps our catering team take extra precautions</p>
        </div>
      </div>
    </section>

    <section class="portal-card p-5 sm:p-6">
      <h2 class="portal-heading text-lg mb-5">Accessibility and learning needs</h2>

      <div class="space-y-6">
        <fieldset>
          <legend class="portal-label">Learning & Cognitive Needs</legend>
          <div class="space-y-2">
            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[has_adhd]" value="0">
              <input type="checkbox" name="accessibility[has_adhd]" value="1" <%= "checked" if @accessibility&.has_adhd %> class="portal-check">
              <span class="text-sm">ADHD</span>
            </label>

            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[has_dyslexia]" value="0">
              <input type="checkbox" name="accessibility[has_dyslexia]" value="1" <%= "checked" if @accessibility&.has_dyslexia %> class="portal-check">
              <span class="text-sm">Dyslexia</span>
            </label>

            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[has_autism]" value="0">
              <input type="checkbox" name="accessibility[has_autism]" value="1" <%= "checked" if @accessibility&.has_autism %> class="portal-check">
              <span class="text-sm">Autism</span>
            </label>
          </div>
        </fieldset>

        <div>
          <label for="accessibility_neurodivergent_notes" class="portal-label">Additional Notes for Learning Needs</label>
          <textarea name="accessibility[neurodivergent_notes]" id="accessibility_neurodivergent_notes" rows="3" class="portal-textarea" placeholder="Any specific accommodations or support that would help"><%= @accessibility&.neurodivergent_notes %></textarea>
        </div>

        <fieldset>
          <legend class="portal-label">Mobility Needs</legend>
          <div class="space-y-2">
            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[uses_wheelchair]" value="0">
              <input type="checkbox" name="accessibility[uses_wheelchair]" value="1" <%= "checked" if @accessibility&.uses_wheelchair %> class="portal-check">
              <span class="text-sm">Wheelchair accessible room/venue</span>
            </label>

            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[step_free_required]" value="0">
              <input type="checkbox" name="accessibility[step_free_required]" value="1" <%= "checked" if @accessibility&.step_free_required %> class="portal-check">
              <span class="text-sm">Step-free access required</span>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="portal-label">Sensory Needs</legend>
          <div class="space-y-2">
            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[needs_captioning]" value="0">
              <input type="checkbox" name="accessibility[needs_captioning]" value="1" <%= "checked" if @accessibility&.needs_captioning %> class="portal-check">
              <span class="text-sm">Captioning/hearing assistance</span>
            </label>

            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[needs_large_print]" value="0">
              <input type="checkbox" name="accessibility[needs_large_print]" value="1" <%= "checked" if @accessibility&.needs_large_print %> class="portal-check">
              <span class="text-sm">Large print materials</span>
            </label>

            <label class="portal-check-row items-center">
              <input type="hidden" name="accessibility[needs_sign_language]" value="0">
              <input type="checkbox" name="accessibility[needs_sign_language]" value="1" <%= "checked" if @accessibility&.needs_sign_language %> class="portal-check">
              <span class="text-sm">Sign language interpreter needed</span>
            </label>
          </div>
        </fieldset>

        <div>
          <label for="accessibility_other_needs" class="portal-label">Other Accessibility or Communication Needs</label>
          <textarea name="accessibility[other_needs]" id="accessibility_other_needs" rows="3" class="portal-textarea" placeholder="Please describe any additional needs"><%= @accessibility&.other_needs %></textarea>
        </div>
      </div>
    </section>

    <div class="flex flex-col sm:flex-row gap-3">
      <button type="submit" name="advance" value="1" class="portal-btn portal-btn-primary w-full sm:w-auto">
        Save and continue
      </button>
      <button type="submit" class="portal-btn portal-btn-secondary w-full sm:w-auto">
        Save and come back later
      </button>
    </div>
  </div>
<% end %>

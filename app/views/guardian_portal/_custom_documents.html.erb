<%# Event-specific documents the guardian signs, beyond the standard consents.
    Renders as its own section so it never nests inside another card. %>
<% guardian_docs = @participant_event.applicable_custom_documents.select(&:guardian_signs?) %>
<% if guardian_docs.any? %>
  <% first_name = @participant.legal_first_name %>

  <section class="portal-card p-5 sm:p-6 mt-6 text-left" aria-labelledby="custom-docs-heading">
    <h2 id="custom-docs-heading" class="portal-heading text-base mb-1">
      <%= @event.name %> documents
    </h2>
    <p class="portal-hint text-sm mb-2">
      Forms this event asks for on top of the standard consents.
    </p>

    <ul class="divide-y" style="border-color: var(--border);">
      <% guardian_docs.each do |doc| %>
        <% consent = @participant_event.consents.find { |c| c.custom_document_id == doc.id } %>
        <% if doc.physical? %>
          <% awaiting_upload = doc.participant_signs? && !consent&.physical_uploads&.attached? %>
          <li class="py-5 first:pt-4 last:pb-0">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 mb-1">
              <h3 class="portal-heading text-base"><%= doc.name %></h3>
              <% if consent&.signed? %>
                <span class="portal-badge portal-badge-done">Confirmed</span>
              <% elsif awaiting_upload %>
                <span class="portal-badge portal-badge-waiting">Waiting on <%= first_name %></span>
              <% else %>
                <span class="portal-badge portal-badge-pending">Needs you</span>
              <% end %>
            </div>

            <% if consent&.signed? %>
              <p class="portal-hint text-sm">Confirmed on <%= consent.signed_at&.strftime("%B %-d, %Y at %-I:%M %p") %>.</p>
            <% elsif awaiting_upload %>
              <p class="portal-hint text-sm">
                This one is signed on paper. <%= first_name %> uploads a photo of the signed form first —
                then you'll review and confirm it here.
              </p>
            <% elsif doc.signed_by_guardian? %>
              <p class="portal-hint text-sm mb-3">
                Download it, print and sign it, then upload a photo of the signed form.
              </p>
              <%= link_to guardian_portal_custom_document_path(token: @token, custom_document_id: doc.id),
                    class: "portal-btn portal-btn-primary w-full sm:w-auto" do %>
                Sign and upload<span class="sr-only"> <%= doc.name %></span>
              <% end %>
            <% else %>
              <p class="portal-hint text-sm mb-3">
                <%= first_name %> uploaded a photo of the signed document — please review and confirm it.
              </p>
              <%= link_to guardian_portal_custom_document_path(token: @token, custom_document_id: doc.id),
                    class: "portal-btn portal-btn-primary w-full sm:w-auto" do %>
                Review and confirm<span class="sr-only"> <%= doc.name %></span>
              <% end %>
            <% end %>
          </li>
          <% next %>
        <% end %>

        <% participant_handling = consent&.docuseal_envelope_id.present? && consent.docuseal_guardian_slug.blank? %>
        <% awaiting_participant = (doc.signed_by_participant_and_guardian? || doc.signed_by_minor_and_guardian?) && !consent&.participant_signed? %>
        <li class="py-5 first:pt-4 last:pb-0">
          <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 mb-1">
            <h3 class="portal-heading text-base"><%= doc.name %></h3>
            <% if consent&.signed? %>
              <span class="portal-badge portal-badge-done">Signed</span>
            <% elsif participant_handling || awaiting_participant %>
              <span class="portal-badge portal-badge-waiting">Waiting on <%= first_name %></span>
            <% else %>
              <span class="portal-badge portal-badge-pending">Needs you</span>
            <% end %>
          </div>

          <% if consent&.signed? %>
            <p class="portal-hint text-sm">Signed on <%= consent.signed_at&.strftime("%B %-d, %Y at %-I:%M %p") %>.</p>
          <% elsif participant_handling %>
            <p class="portal-hint text-sm"><%= first_name %> is signing this one themselves.</p>
          <% elsif awaiting_participant %>
            <p class="portal-hint text-sm">
              <%= first_name %> signs their portion first — then you'll be able to sign yours.
            </p>
          <% else %>
            <p class="portal-hint text-sm mb-3">
              Please sign this for <%= first_name %>'s participation.
            </p>
            <%= link_to guardian_portal_custom_document_path(token: @token, custom_document_id: doc.id),
                  class: "portal-btn portal-btn-primary w-full sm:w-auto" do %>
              Sign<span class="sr-only"> <%= doc.name %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

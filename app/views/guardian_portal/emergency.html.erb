<div class="w-full max-w-2xl mx-auto">
  <%= render "step_nav" %>

  <h1 class="text-2xl font-bold mb-2">Emergency Information</h1>
  <p class="text-gray-600 mb-6">Provide emergency contact details and medical consents for <%= @participant.legal_first_name %>.</p>

  <%= form_with model: @guardian_participant_event, url: guardian_step_path(@guardian_participant_event.invite_token, :emergency), method: :patch, local: true, data: { turbo: false, controller: "nested-form phone-input" } do |f| %>
    <div class="space-y-8">
      <section>
        <h2 class="text-lg font-semibold mb-4 pb-2 border-b">Medical Consents</h2>

        <div class="space-y-4">
          <div class="bg-gray-50 rounded-md p-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <%= f.check_box :emergency_medical_consent, class: "w-5 h-5 mt-0.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500", checked: @guardian_participant_event.emergency_medical_consent %>
              <div>
                <span class="font-medium text-gray-900">Emergency Medical Treatment Consent</span>
                <p class="text-sm text-gray-600 mt-1">
                  I authorize event staff to seek emergency medical treatment for <%= @participant.legal_first_name %> if I cannot be reached in time. I understand that I will be notified as soon as possible.
                </p>
              </div>
            </label>
          </div>

          <div class="bg-gray-50 rounded-md p-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <%= f.check_box :otc_medication_consent, class: "w-5 h-5 mt-0.5 rounded border-gray-300 text-blue-600 focus:ring-blue-500", checked: @guardian_participant_event.otc_medication_consent %>
              <div>
                <span class="font-medium text-gray-900">Over-the-Counter Medication Consent</span>
                <p class="text-sm text-gray-600 mt-1">
                  I authorize event staff to administer common over-the-counter medications (e.g., pain relievers, antihistamines, antacids) to <%= @participant.legal_first_name %> as needed for minor ailments.
                </p>
              </div>
            </label>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-4 pb-2 border-b">Secondary Emergency Contact</h2>
        <p class="text-sm text-gray-600 mb-4">Please provide at least one additional emergency contact who can be reached if you are unavailable.</p>

        <% secondary_contact = @emergency_contacts.find { |c| c.priority == 1 } || @guardian_participant_event.emergency_contacts.build(priority: 1) %>
        <div class="space-y-4 bg-gray-50 rounded-md p-4">
          <%= f.fields_for :emergency_contacts, secondary_contact do |ec| %>
            <%= ec.hidden_field :priority, value: 1 %>
            <%= ec.hidden_field :id if secondary_contact.persisted? %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <%= ec.label :name, "Full Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= ec.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
              </div>

              <div>
                <%= ec.label :relationship, "Relationship", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= ec.select :relationship, [["Select relationship", ""], "Parent", "Grandparent", "Aunt/Uncle", "Sibling", "Family Friend", "Neighbor", "Other"], {}, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <%= ec.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= ec.telephone_field :phone, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
              </div>

              <div>
                <%= ec.label :email, "Email (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= ec.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <section>
        <div class="flex justify-between items-center mb-4 pb-2 border-b">
          <h2 class="text-lg font-semibold">Additional Emergency Contacts</h2>
          <span class="text-sm text-gray-500">(Optional)</span>
        </div>

        <div id="additional-contacts" data-nested-form-target="container">
          <% additional_contacts = @emergency_contacts.select { |c| c.priority.to_i > 1 } %>
          <% additional_contacts.each do |contact| %>
            <div class="space-y-4 bg-gray-50 rounded-md p-4 mb-4 relative" data-nested-form-target="item">
              <button type="button" class="absolute top-2 right-2 text-gray-400 hover:text-red-600" data-action="nested-form#remove">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>

              <%= f.fields_for :emergency_contacts, contact do |ec| %>
                <%= ec.hidden_field :priority %>
                <%= ec.hidden_field :id if contact.persisted? %>
                <%= ec.hidden_field :_destroy, value: "0", data: { nested_form_target: "destroyField" } %>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <%= ec.label :name, "Full Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                    <%= ec.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                  </div>

                  <div>
                    <%= ec.label :relationship, "Relationship", class: "block text-sm font-medium text-gray-700 mb-1" %>
                    <%= ec.select :relationship, [["Select relationship", ""], "Parent", "Grandparent", "Aunt/Uncle", "Sibling", "Family Friend", "Neighbor", "Other"], {}, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <%= ec.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
                    <%= ec.telephone_field :phone, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                  </div>

                  <div>
                    <%= ec.label :email, "Email (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                    <%= ec.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <template data-nested-form-target="template">
          <div class="space-y-4 bg-gray-50 rounded-md p-4 mb-4 relative" data-nested-form-target="item">
            <button type="button" class="absolute top-2 right-2 text-gray-400 hover:text-red-600" data-action="nested-form#remove">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>

            <input type="hidden" name="guardian_participant_event[emergency_contacts_attributes][NEW_RECORD][priority]" value="">
            <input type="hidden" name="guardian_participant_event[emergency_contacts_attributes][NEW_RECORD][_destroy]" value="0" data-nested-form-target="destroyField">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                <input type="text" name="guardian_participant_event[emergency_contacts_attributes][NEW_RECORD][name]" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Relationship</label>
                <select name="guardian_participant_event[emergency_contacts_attributes][NEW_RECORD][relationship]" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                  <option value="">Select relationship</option>
                  <option value="Parent">Parent</option>
                  <option value="Grandparent">Grandparent</option>
                  <option value="Aunt/Uncle">Aunt/Uncle</option>
                  <option value="Sibling">Sibling</option>
                  <option value="Family Friend">Family Friend</option>
                  <option value="Neighbor">Neighbor</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                <input type="tel" name="guardian_participant_event[emergency_contacts_attributes][NEW_RECORD][phone]" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email (optional)</label>
                <input type="email" name="guardian_participant_event[emergency_contacts_attributes][NEW_RECORD][email]" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>
            </div>
          </div>
        </template>

        <button type="button" class="flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium" data-action="nested-form#add">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          Add Another Contact
        </button>
      </section>

      <div class="pt-4 flex flex-col sm:flex-row gap-3">
        <%= link_to "Back", guardian_step_path(@guardian_participant_event.invite_token, :details), class: "w-full sm:w-auto text-center px-6 py-3 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium" %>
        <%= f.submit "Save & Continue", class: "w-full sm:w-auto flex-1 bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

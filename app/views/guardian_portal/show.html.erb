<div class="w-full max-w-2xl mx-auto">
  <div class="bg-white rounded-lg shadow-sm border p-6 mb-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Welcome, <%= @guardian.full_name %>!</h1>
        <p class="text-gray-600">Guardian Portal</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Participant</p>
        </div>
        <p class="text-lg font-semibold text-gray-900"><%= @participant.full_name %></p>
        <p class="text-sm text-gray-600 mt-1"><%= @participant.email %></p>
      </div>

      <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Event</p>
        </div>
        <p class="text-lg font-semibold text-gray-900"><%= @event.name %></p>
        <% if @event.starts_at.present? && @event.ends_at.present? %>
          <p class="text-sm text-gray-600 mt-1">
            <%= @event.starts_at.strftime("%B %d") %> – <%= @event.ends_at.strftime("%B %d, %Y") %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border p-6 mb-8">
    <h2 class="text-lg font-semibold mb-4">Completion Progress</h2>

    <% overall_complete = @completed_steps.length == @steps.length %>
    <div class="mb-4">
      <div class="flex justify-between text-sm mb-1">
        <span class="text-gray-600">Overall Progress</span>
        <span class="font-medium"><%= @completed_steps.length %>/<%= @steps.length %> complete</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2.5">
        <div class="<%= overall_complete ? 'bg-green-600' : 'bg-blue-600' %> h-2.5 rounded-full transition-all" style="width: <%= (@completed_steps.length.to_f / @steps.length * 100).round %>%"></div>
      </div>
    </div>

    <% waiver_consent = @participant_event.consents.find_by(consent_type: "waiver") %>
    <% guardian_signed_awaiting_participant = waiver_consent&.guardian_signed? && !waiver_consent&.signed? %>

    <ul class="space-y-3">
      <% @steps.each do |step| %>
        <% is_completed = @completed_steps.include?(step) %>
        <li class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-3 rounded-md <%= is_completed ? 'bg-green-50' : 'bg-gray-50' %>">
          <div class="flex items-center gap-3">
            <% if is_completed %>
              <div class="w-6 h-6 bg-green-600 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
            <% else %>
              <div class="w-6 h-6 border-2 border-gray-300 rounded-full"></div>
            <% end %>
            <span class="font-medium <%= is_completed ? 'text-green-800' : 'text-gray-700' %>">
              <%= step.titleize %>
            </span>
          </div>
          <%= link_to guardian_portal_step_path(token: @token, step: step), class: "text-sm font-medium #{ is_completed ? 'text-green-700 hover:text-green-800' : 'text-blue-600 hover:text-blue-700' }" do %>
            <%= is_completed ? 'Edit' : 'Complete' %>
            <span aria-hidden="true"> →</span>
          <% end %>
        </li>
        <% if step == "consents" && guardian_signed_awaiting_participant %>
          <li class="bg-blue-50 border border-blue-200 rounded-md p-3">
            <p class="text-sm text-blue-800">
              <strong><%= @participant.legal_first_name %></strong> also needs to sign this waiver.
              They can complete their signature by logging into their onboarding portal.
            </p>
          </li>
        <% end %>
        <% if step == "consents" && @docs_awaiting_participant_upload.any? %>
          <li class="bg-blue-50 border border-blue-200 rounded-md p-3">
            <p class="text-sm text-blue-800">
              <strong><%= @participant.legal_first_name %></strong> still needs to upload a photo of the signed
              <%= @docs_awaiting_participant_upload.map(&:name).to_sentence %>.
              Once they do, you'll review and confirm it here.
            </p>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>

  <% if @completed_steps.length == @steps.length %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-6 text-center">
      <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
      </div>
      <% if @docs_awaiting_participant_upload.any? %>
        <h3 class="text-lg font-semibold text-green-800 mb-2">Your Part Is Done — For Now!</h3>
        <p class="text-green-700 mb-4">
          You've provided all required information and consents.
          <strong><%= @participant.legal_first_name %></strong> still needs to upload a photo of the signed
          <%= @docs_awaiting_participant_upload.map(&:name).to_sentence %> — once they do, we'll ask you to
          come back and confirm it.
        </p>
      <% else %>
        <h3 class="text-lg font-semibold text-green-800 mb-2">All Steps Complete!</h3>
        <p class="text-green-700 mb-4">You've provided all required information and consents.</p>
      <% end %>
      <% unless @guardian_participant_event.completed? %>
        <%= button_to "Submit & Finish", guardian_portal_complete_path(token: @token), method: :post, class: "inline-flex items-center px-6 py-3 bg-green-600 text-white font-medium rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" %>
      <% else %>
        <p class="text-sm text-green-600">Submitted on <%= @guardian_participant_event.completed_at&.strftime("%B %d, %Y at %l:%M %p") %></p>
      <% end %>
    </div>
  <% else %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-blue-600 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
        <div>
          <h3 class="font-medium text-blue-800">Complete all steps to finish</h3>
          <p class="text-sm text-blue-700 mt-1">Please complete all sections above to submit your consent for <%= @participant.legal_first_name %>'s participation.</p>
        </div>
      </div>

      <% next_step = @steps.find { |s| !@completed_steps.include?(s) } %>
      <% if next_step %>
        <div class="mt-4">
          <%= link_to guardian_portal_step_path(token: @token, step: next_step), class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" do %>
            Continue to <%= next_step.titleize %>
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

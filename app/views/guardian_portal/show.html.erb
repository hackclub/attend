<% content_for :title, "Guardian portal – Attend" %>
<% first_name = @participant.legal_first_name %>
<% overall_complete = @completed_steps.length == @steps.length %>
<% next_step = @steps.find { |s| !@completed_steps.include?(s) } %>

<div class="w-full max-w-2xl mx-auto">
  <%= render "shared/portal_masthead", subtitle: @event.name %>

  <header class="mb-8">
    <h1 class="portal-title text-2xl mb-3">
      <%= @guardian.full_name.presence || "Welcome" %>, here's what <%= first_name %> needs from you
    </h1>
    <p class="portal-body text-lg">
      <%= overall_complete ? "Everything is filled in." : "#{pluralize(@steps.length - @completed_steps.length, 'section')} left." %>
      You can stop and come back to this link at any time — nothing is lost.
    </p>
  </header>

  <div class="portal-card p-5 sm:p-6 mb-6">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
      <div>
        <dt class="portal-meta text-xs font-semibold uppercase tracking-wider mb-1">Participant</dt>
        <dd class="portal-heading text-base"><%= @participant.full_name %></dd>
        <% if @participant.email.present? %>
          <dd class="portal-hint text-sm mt-0.5 break-words"><%= @participant.email %></dd>
        <% end %>
      </div>
      <div>
        <dt class="portal-meta text-xs font-semibold uppercase tracking-wider mb-1">Event</dt>
        <dd class="portal-heading text-base"><%= @event.name %></dd>
        <% if @event.starts_at.present? && @event.ends_at.present? %>
          <dd class="portal-hint text-sm mt-0.5">
            <%= @event.starts_at.strftime("%B %-d") %> – <%= @event.ends_at.strftime("%B %-d, %Y") %>
          </dd>
        <% end %>
      </div>
    </dl>
  </div>

  <% waiver_consent = @participant_event.consents.find_by(consent_type: "waiver") %>
  <% guardian_signed_awaiting_participant = waiver_consent&.guardian_signed? && !waiver_consent&.signed? %>

  <section class="portal-card p-5 sm:p-6 mb-6" aria-labelledby="progress-heading">
    <div class="flex items-baseline justify-between gap-4 mb-2">
      <h2 id="progress-heading" class="portal-heading text-lg">Your sections</h2>
      <p class="portal-hint text-sm font-medium tabular-nums">
        <%= @completed_steps.length %> of <%= @steps.length %> done
      </p>
    </div>

    <div class="portal-progress mb-5"
         role="progressbar"
         aria-labelledby="progress-heading"
         aria-valuenow="<%= @completed_steps.length %>"
         aria-valuemin="0"
         aria-valuemax="<%= @steps.length %>">
      <div class="portal-progress-fill <%= "portal-progress-fill-done" if overall_complete %>"
           style="--portal-progress: <%= (@completed_steps.length.to_f / @steps.length).round(3) %>"></div>
    </div>

    <ul class="space-y-2">
      <% @steps.each_with_index do |step, index| %>
        <% is_completed = @completed_steps.include?(step) %>
        <li class="portal-step-row <%= "portal-step-row-done" if is_completed %>"
            style="animation-delay: <%= index * 55 %>ms">
          <div class="flex items-start gap-3 min-w-0">
            <span class="portal-step-marker <%= is_completed ? "portal-step-marker-done" : (step == next_step ? "portal-step-marker-current" : "") %>">
              <% if is_completed %>
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                </svg>
                <span class="sr-only">Completed:</span>
              <% else %>
                <%= index + 1 %>
              <% end %>
            </span>
            <div class="min-w-0">
              <p class="portal-heading text-sm sm:text-base"><%= guardian_step_label(step) %></p>
              <p class="portal-hint text-sm mt-0.5"><%= guardian_step_description(step, first_name) %></p>
            </div>
          </div>
          <%= link_to guardian_portal_step_path(token: @token, step: step),
                class: "portal-btn #{is_completed ? 'portal-btn-quiet' : 'portal-btn-secondary'} shrink-0 self-stretch sm:self-auto" do %>
            <%= is_completed ? "Review" : "Fill in" %>
            <span class="sr-only"><%= guardian_step_label(step) %></span>
          <% end %>
        </li>

        <% if step == "consents" && guardian_signed_awaiting_participant %>
          <li class="portal-note portal-note-info">
            <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.852l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
            </svg>
            <p class="portal-body text-sm">
              <strong class="portal-heading"><%= first_name %></strong> also needs to sign this waiver.
              They can do that from their own onboarding portal.
            </p>
          </li>
        <% end %>

        <% if step == "consents" && @docs_awaiting_participant_upload.any? %>
          <li class="portal-note portal-note-info">
            <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.852l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
            </svg>
            <p class="portal-body text-sm">
              <strong class="portal-heading"><%= first_name %></strong> still needs to upload a photo of the signed
              <%= @docs_awaiting_participant_upload.map(&:name).to_sentence %>.
              Once they do, you'll review and confirm it here.
            </p>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>

  <% if overall_complete %>
    <section class="portal-card p-6 sm:p-8 text-center">
      <span class="portal-medallion portal-medallion-success mx-auto mb-4">
        <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
        </svg>
      </span>

      <% if @docs_awaiting_participant_upload.any? %>
        <h2 class="portal-heading text-xl mb-2">Your part is done — for now</h2>
        <p class="portal-body mb-6 mx-auto max-w-prose">
          You've given us everything we need from you.
          <strong class="portal-heading"><%= first_name %></strong> still needs to upload a photo of the signed
          <%= @docs_awaiting_participant_upload.map(&:name).to_sentence %> — once they do, we'll ask you to come
          back and confirm it.
        </p>
      <% else %>
        <h2 class="portal-heading text-xl mb-2">Everything's filled in</h2>
        <p class="portal-body mb-6 mx-auto max-w-prose">
          You've given us all the information and consents we need for <%= first_name %>.
        </p>
      <% end %>

      <% unless @guardian_participant_event.completed? %>
        <%= button_to "Submit and finish", guardian_portal_complete_path(token: @token),
              method: :post, class: "portal-btn portal-btn-primary w-full sm:w-auto" %>
      <% else %>
        <p class="portal-hint text-sm">
          Submitted <%= @guardian_participant_event.completed_at&.strftime("%B %-d, %Y at %l:%M %p")&.squish %>
        </p>
      <% end %>
    </section>
  <% elsif next_step %>
    <section class="portal-card p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="portal-heading text-base">Up next: <%= guardian_step_label(next_step) %></h2>
        <p class="portal-hint text-sm mt-0.5">
          <%= guardian_step_description(next_step, first_name) %>
        </p>
      </div>
      <%= link_to guardian_portal_step_path(token: @token, step: next_step),
            class: "portal-btn portal-btn-primary shrink-0" do %>
        Continue
        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
      <% end %>
    </section>
  <% end %>
</div>

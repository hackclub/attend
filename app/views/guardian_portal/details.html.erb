<div class="w-full max-w-2xl mx-auto">
  <%= render "step_nav" %>

  <h1 class="text-2xl font-bold mb-2">Guardian Details</h1>
  <p class="text-gray-600 mb-6">Please confirm or update your contact information.</p>

  <%= form_with model: @guardian, url: guardian_step_path(@guardian_participant_event.invite_token, :details), method: :patch, local: true, data: { turbo: false, controller: "phone-input" } do |f| %>
    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :legal_first_name, "First Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :legal_first_name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>

        <div>
          <%= f.label :legal_last_name, "Last Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :legal_last_name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        </div>
      </div>

      <div>
        <%= f.label :relationship, "Relationship to #{@participant.legal_first_name}", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :relationship, [["Select relationship", ""], "Parent", "Legal Guardian", "Grandparent", "Aunt/Uncle", "Sibling (18+)", "Other"], {}, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
      </div>

      <div>
        <%= f.label :email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        <p class="mt-1 text-sm text-gray-500">We'll send important updates and confirmation to this email</p>
      </div>

      <div>
        <%= f.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
        <p class="mt-1 text-sm text-gray-500">Include country code (e.g., +1 for US)</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :country, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :timezone, "Timezone", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.time_zone_select :timezone, nil, { include_blank: "Select timezone" }, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <p class="mt-1 text-sm text-gray-500">Helps us contact you at appropriate times</p>
        </div>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row gap-3">
        <%= link_to "Back", guardian_invite_path(@guardian_participant_event.invite_token), class: "w-full sm:w-auto text-center px-6 py-3 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium" %>
        <%= f.submit "Save & Continue", class: "w-full sm:w-auto flex-1 bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

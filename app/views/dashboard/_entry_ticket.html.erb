<%# The entry ticket with wallet and download links. Shown on the dashboard and
    on the "you're registered" screen once the registration is confirmed. The
    event leads; the QR sits on the stub, which turns landscape from sm up.
    locals: participant_event:, participant:, event: %>
<% dates = event.formatted_date_range || event.local_starts_at&.strftime("%B %-d, %Y") %>
<section class="mb-8" aria-labelledby="entry-ticket-heading">
  <h2 id="entry-ticket-heading" class="text-lg font-semibold text-(--text-strong) mb-3">Your entry ticket</h2>

  <div class="ticket ticket-split w-full max-w-2xl">
    <div class="ticket-part ticket-main flex flex-col">
      <div class="ticket-edge entry-ticket-header"></div>
      <div class="flex flex-1 flex-col px-5 pt-4 pb-5 sm:px-6 sm:pt-5">
        <div class="flex items-start justify-between gap-4">
          <p class="text-sm font-medium text-(--text-soft)">Entry ticket</p>
          <img src="/flag.png" alt="Hack Club" class="h-6 w-auto shrink-0 -mr-1">
        </div>
        <p class="mt-2 text-2xl sm:text-3xl font-bold leading-tight tracking-tight text-(--text-strong) break-words [text-wrap:balance]"><%= event.name %></p>
        <p class="mt-1 text-sm font-medium text-(--text)"><%= [ dates, event.location_city.presence ].compact.join(" · ") %></p>

        <dl class="mt-auto pt-5 grid grid-cols-2 gap-4 text-sm">
          <div class="min-w-0">
            <dt class="ticket-label">Attendee</dt>
            <dd class="mt-0.5 font-semibold text-(--text-strong) break-words"><%= participant.display_name %></dd>
          </div>
          <% if event.freedom_waivers_enabled? %>
            <div class="min-w-0">
              <dt class="ticket-label">Freedom waiver</dt>
              <dd class="mt-1"><%= render "dashboard/entry_ticket_waiver", participant_event: participant_event, labelled: true %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>
    <div class="ticket-perf" aria-hidden="true"></div>
    <div class="ticket-part ticket-stub flex flex-col items-center justify-center px-5 py-5 sm:w-56">
      <div class="ticket-qr w-full max-w-60 sm:max-w-none p-2.5 ring-1 ring-(--border-card)">
        <%= qr_code_svg(CheckinCode.for(participant_event), size: 200, level: :m) %>
      </div>
      <p class="mt-2 text-center text-xs font-medium text-(--text-soft)">Show this QR code when you arrive</p>
    </div>
  </div>

  <div class="mt-4 max-w-2xl">
    <%= render "dashboard/entry_ticket_actions", participant_event: participant_event, event: event %>
  </div>
</section>

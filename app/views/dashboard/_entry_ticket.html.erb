<%# The entry ticket with wallet and download links. Shown on the dashboard and
    on the "you're registered" screen once the registration is confirmed.
    locals: participant_event:, participant:, event: %>
<section class="mb-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-(--text-muted) mb-3 flex items-center gap-2">
    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
    </svg>
    Your entry ticket
  </h2>

  <div class="max-w-md rounded-lg overflow-hidden border border-(--border-card) bg-(--bg-elev)">
    <div class="entry-ticket-header bg-[#d42f46] text-white px-4 py-3 flex justify-between items-center">
      <span class="font-bold tracking-wider text-sm">ENTRY TICKET</span>
      <img src="/flag.png" alt="Hack Club" class="h-5 opacity-90">
    </div>

    <div class="p-4 flex items-center justify-between gap-4">
      <div class="min-w-0">
        <p class="font-bold text-lg text-(--text-strong) break-words"><%= participant.display_name %></p>
        <p class="text-sm font-medium text-(--text) break-words"><%= event.name %></p>
        <p class="text-sm text-(--text-muted)"><%= [ event.local_starts_at&.strftime("%b %-d"), event.location_city.presence ].compact.join(" · ") %></p>
        <% if event.freedom_waivers_enabled? %>
          <% if participant_event.safeguarding_info&.freedom_waiver_granted? %>
            <p class="mt-2 text-sm font-semibold text-(--success-text)">✓ Freedom waiver</p>
          <% else %>
            <p class="mt-2 text-sm font-semibold text-(--danger-strong)">✗ No freedom waiver</p>
          <% end %>
        <% end %>
      </div>
      <%# literal white, not bg-white — themes.css remaps --color-white to the theme
surface, which would put black QR modules on a dark tile %>
      <div class="shrink-0 bg-[#ffffff] p-2 rounded-lg border border-(--border-card)">
        <%= qr_code_svg(attend_deep_link(participant_event.participant_id), size: 100) %>
      </div>
    </div>

    <p class="px-4 pb-4 text-xs text-(--text-muted)">Show this QR code when you arrive</p>
  </div>

  <!-- Add to Wallet -->
  <div class="mt-4 rounded-2xl border border-(--border-card) bg-(--bg-elev) p-4">
    <p class="text-sm font-medium text-(--text-soft) mb-3 flex items-center gap-2">
      <svg class="size-5 text-(--text-muted)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
      </svg>
      Save your pass for easy access
    </p>
    <div class="flex flex-wrap gap-2 items-center">
      <% if (apple_wallet_url = wallet_pass_url(participant_event)) %>
        <%= link_to apple_wallet_url, class: "inline-flex items-center hover:opacity-80 transition-opacity" do %>
          <img src="/add-to-apple-wallet.svg" alt="Add to Apple Wallet" class="h-11">
        <% end %>
      <% end %>
      <button
        id="google-wallet-btn"
        data-url="<%= dashboard_google_wallet_path(participant_event) %>"
        class="inline-flex items-center hover:opacity-80 transition-opacity cursor-pointer relative"
      >
        <img src="/add-to-google-wallet.svg" alt="Add to Google Wallet" class="h-11" id="google-wallet-img">
        <div id="google-wallet-loading" class="hidden absolute inset-0 flex items-center justify-center bg-white/80 rounded">
          <svg class="animate-spin size-6 text-gray-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
      </button>
      <%= link_to dashboard_download_ticket_path(participant_event), class: "inline-flex items-center gap-2 px-4 h-11 rounded-lg bg-(--bg-elev-2) hover:bg-(--bg-elev-3) text-(--text) transition-colors" do %>
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="text-sm font-medium">Download PDF</span>
      <% end %>
      <%= link_to dashboard_download_excuse_letter_path(participant_event), class: "inline-flex items-center gap-2 px-4 h-11 rounded-lg bg-(--bg-elev-2) hover:bg-(--bg-elev-3) text-(--text) transition-colors" do %>
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="text-sm font-medium">Excuse letter</span>
      <% end %>
      <%= link_to dashboard_download_invitation_letter_path(participant_event), class: "inline-flex items-center gap-2 px-4 h-11 rounded-lg bg-(--bg-elev-2) hover:bg-(--bg-elev-3) text-(--text) transition-colors",
            title: "For border crossings that don't need a visa" do %>
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="text-sm font-medium">Invitation letter</span>
      <% end %>
    </div>
  </div>

  <script nonce="<%= content_security_policy_nonce %>">
    document.getElementById('google-wallet-btn').addEventListener('click', function(e) {
      var btn = this;
      var loading = document.getElementById('google-wallet-loading');
      btn.disabled = true;
      loading.classList.remove('hidden');
      fetch(btn.dataset.url)
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.url) {
            window.location.href = data.url;
          } else {
            alert('Failed to generate Google Wallet pass. Please try again.');
            loading.classList.add('hidden');
            btn.disabled = false;
          }
        })
        .catch(function(error) {
          console.error('Error:', error);
          alert('Failed to generate Google Wallet pass. Please try again.');
          loading.classList.add('hidden');
          btn.disabled = false;
        });
    });
  </script>
</section>

<%# Wallet passes and printable documents for the entry ticket.
    locals: participant_event:, event: %>
<div class="flex flex-wrap items-center gap-2">
  <% if (apple_wallet_url = wallet_pass_url(participant_event)) %>
    <%= link_to apple_wallet_url, class: "inline-flex rounded-md transition-opacity hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-[#ec3750]/30" do %>
      <img src="/add-to-apple-wallet.svg" alt="Add to Apple Wallet" class="h-10">
    <% end %>
  <% end %>
  <button
    type="button"
    id="google-wallet-btn"
    data-url="<%= dashboard_google_wallet_path(participant_event) %>"
    class="relative inline-flex cursor-pointer rounded-md transition-opacity hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-[#ec3750]/30 disabled:cursor-wait"
  >
    <img src="/add-to-google-wallet.svg" alt="Add to Google Wallet" class="h-10" id="google-wallet-img">
    <span id="google-wallet-loading" class="hidden absolute inset-0 items-center justify-center rounded-md bg-(--bg-elev)/80">
      <svg class="size-5 animate-spin text-(--text-soft)" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="sr-only">Creating your Google Wallet pass</span>
    </span>
  </button>
</div>

<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm font-medium">
  <% doc_icon = capture do %>
    <svg class="size-4 shrink-0 text-(--text-muted)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  <% end %>
  <% link_class = "inline-flex items-center gap-1.5 rounded-sm text-(--text-soft) underline decoration-(--border-strong) underline-offset-4 transition-colors hover:text-(--text-strong) hover:decoration-(--text-muted) focus:outline-none focus:ring-2 focus:ring-[#ec3750]/30" %>
  <li><%= link_to dashboard_download_ticket_path(participant_event), class: link_class do %><%= doc_icon %>Ticket PDF<% end %></li>
  <li><%= link_to dashboard_download_excuse_letter_path(participant_event), class: link_class do %><%= doc_icon %>Excuse letter<% end %></li>
  <% unless event.hide_invitation_letter? %>
    <li><%= link_to dashboard_download_invitation_letter_path(participant_event), class: link_class, title: "For border crossings that don't need a visa" do %><%= doc_icon %>Invitation letter<% end %></li>
  <% end %>
</ul>

<script nonce="<%= content_security_policy_nonce %>">
  document.getElementById('google-wallet-btn').addEventListener('click', function() {
    var btn = this;
    var loading = document.getElementById('google-wallet-loading');
    btn.disabled = true;
    loading.classList.remove('hidden');
    loading.classList.add('flex');
    var reset = function() {
      alert('Failed to generate Google Wallet pass. Please try again.');
      loading.classList.add('hidden');
      loading.classList.remove('flex');
      btn.disabled = false;
    };
    fetch(btn.dataset.url)
      .then(function(response) { return response.json(); })
      .then(function(data) { data.url ? (window.location.href = data.url) : reset(); })
      .catch(function(error) { console.error('Error:', error); reset(); });
  });
</script>

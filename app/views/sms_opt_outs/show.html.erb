<% content_for :title, "Text messages – Attend" %>

<div class="w-full max-w-lg mx-auto">
  <%= render "shared/portal_masthead" %>

  <h1 class="portal-title text-2xl mb-3">Text messages</h1>

  <div class="portal-card p-5 sm:p-6">
    <% if @opted_out %>
      <p class="portal-body mb-4">
        Texts and WhatsApp messages about Hack Club events are off for the number ending <strong><%= @phone.last(4) %></strong>.
        You'll still get emails, and codes you ask for.
      </p>
      <%= button_to "Turn texts back on", sms_opt_out_path(params[:token]), method: :delete,
            class: "portal-btn portal-btn-secondary w-full sm:w-auto", data: { turbo: false } %>
    <% else %>
      <p class="portal-body mb-4">
        Stop texts and WhatsApp messages about Hack Club events to the number ending <strong><%= @phone.last(4) %></strong>?
        You'll still get emails, and codes you ask for.
      </p>
      <%= button_to "Stop texts", sms_opt_out_path(params[:token]), method: :post,
            class: "portal-btn portal-btn-primary w-full sm:w-auto", data: { turbo: false } %>
    <% end %>
  </div>
</div>

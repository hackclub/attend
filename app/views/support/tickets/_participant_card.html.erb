<div class="flex items-start gap-3">
  <% if participant.headshot.attached? %>
    <%= image_tag participant.headshot.variant(resize_to_fill: [48, 48]), class: "w-12 h-12 rounded-full object-cover" %>
  <% else %>
    <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 text-sm font-medium">
      <%= participant.legal_first_name[0] %><%= participant.legal_last_name[0] %>
    </div>
  <% end %>
  <div class="flex-1 min-w-0">
    <p class="font-medium text-gray-900"><%= participant.full_name %></p>
    <p class="text-xs text-gray-500"><%= participant.email %></p>
    <% if participant.date_of_birth %>
      <p class="text-xs text-gray-500">Age: <%= participant.age_on(Date.current) %></p>
    <% end %>
    <% if participant.phone %>
      <p class="text-xs text-gray-500 font-mono"><%= participant.phone %></p>
    <% end %>
  </div>
</div>
<% if participant_event && event %>
  <div class="mt-3 pt-3 border-t border-gray-200 flex items-center justify-between">
    <span class="text-xs text-gray-600"><%= event.name %></span>
    <span class="px-1.5 py-0.5 rounded text-xs <%= participant_event.status == 'confirmed' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>"><%= participant_event.status.humanize %></span>
  </div>
<% end %>

<%= turbo_stream.prepend "ticket_notes" do %>
  <%= render "support/tickets/note", note: @note %>
<% end %>

<%= turbo_stream.replace "note_body" do %>
  <textarea name="note[body]" id="note_body" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Add a note..."></textarea>
<% end %>

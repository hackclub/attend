<%# The series' registration note ("Bring a laptop!"), shown on the welcome,
    review and done screens. Renders nothing when the series has none.
    locals: event:, class: nil %>
<% if (note = event.registration_note) %>
  <div class="portal-note portal-note-info <%= local_assigns[:class] %>">
    <svg class="portal-note-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
    </svg>
    <div class="portal-body text-sm space-y-2"><%= simple_format(note, {}, wrapper_tag: "p") %></div>
  </div>
<% end %>

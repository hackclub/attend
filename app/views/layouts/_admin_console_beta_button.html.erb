<%# Moves a staff member who switched back to the original admin onto the
    console again. Submitted without Turbo so the redirect is a full page
    load into the other layout.
    A Deepened Red fill (DESIGN.md): themes.css remaps bg-[#d42f46] /
    hover:bg-[#b82840] per theme and pins their foreground to --accent-on.
    `compact` is the one-line version for the mobile header. %>
<% compact = local_assigns.fetch(:compact, false) %>
<%= button_to admin_console_beta_path,
      method: :patch,
      params: { enabled: true },
      form: { class: local_assigns[:extra_class], data: { turbo: false } },
      class: [
        "flex items-center gap-2 rounded-lg bg-[#d42f46] text-white text-left cursor-pointer hover:bg-[#b82840] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ec3750]/30 focus-visible:ring-offset-2",
        compact ? "px-3 py-1.5 text-xs font-semibold" : "w-full px-3 py-2.5"
      ] do %>
  <svg class="<%= compact ? "h-3.5 w-3.5" : "h-4 w-4" %> flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>
  </svg>
  <% if compact %>
    <span>Use the new admin</span>
  <% else %>
    <span class="min-w-0">
      <span class="block text-sm font-semibold leading-5">Use the new admin</span>
      <span class="block text-xs leading-4">You can switch back anytime</span>
    </span>
  <% end %>
<% end %>

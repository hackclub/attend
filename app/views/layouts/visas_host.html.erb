<%# Standalone, like the badge host's page: this renders on visas.hackclub.com,
    for embassy staff checking a letter, so it doesn't load Attend's
    stylesheets or JavaScript. Files in public/ are served on every host. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= content_for(:title) || "Hack Club Travel Ready Centre" %></title>
    <link rel="icon" href="/icon.png" type="image/png">
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f3f4f6; --card: #ffffff; --text: #1f2d3d; --muted: #5c6d7e; --border: #d1d5db;
        --accent: #ec3750; --accent-dark: #d42f46; --soft: #f9fafb;
        --ok-bg: #dcfce7; --ok: #15803d; --wait-bg: #fef9c3; --wait: #a16207; --wait-text: #854d0e;
        --alert-bg: #fef2f2; --alert-border: #fecaca; --alert: #b91c1c;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17171d; --card: #252429; --text: #f3f4f6; --muted: #a0a8b3; --border: #3c4858; --soft: #1f1e24;
          --ok-bg: #14532d; --ok: #86efac; --wait-bg: #422006; --wait: #fde047; --wait-text: #fde68a;
          --alert-bg: #450a0a; --alert-border: #7f1d1d; --alert: #fca5a5;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: flex; flex-direction: column;
        background: var(--bg); color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
      }
      header { background: var(--card); border-bottom: 4px solid var(--accent); padding: 1rem; }
      header img { display: block; height: 2.5rem; width: auto; }
      main { flex: 1; width: 100%; max-width: 36rem; margin: 0 auto; padding: 2rem 1rem; }
      footer { padding: 1.5rem 1rem; text-align: center; font-size: 0.875rem; color: var(--muted); }
      footer p { margin: 0.25rem 0; }
      a { color: var(--accent); }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 2rem 1.5rem; }
      .center { text-align: center; }
      h1 { margin: 0 0 0.5rem; font-size: 1.5rem; line-height: 1.3; }
      h2 { margin: 0 0 1rem; font-size: 1rem; }
      p { margin: 0 0 1rem; }
      .muted { color: var(--muted); }
      .small { font-size: 0.875rem; }
      .icon { display: inline-flex; align-items: center; justify-content: center; width: 4rem; height: 4rem; border-radius: 999px; margin-bottom: 1rem; }
      .icon svg { width: 2rem; height: 2rem; }
      .icon-ok { background: var(--ok-bg); color: var(--ok); }
      .icon-wait { background: var(--wait-bg); color: var(--wait); }
      .title-ok { color: var(--ok); }
      .title-wait { color: var(--wait); }
      .notice { background: var(--wait-bg); color: var(--wait-text); border-radius: 0.5rem; padding: 1rem; font-size: 0.875rem; }
      .alert { background: var(--alert-bg); border: 1px solid var(--alert-border); color: var(--alert); border-radius: 0.5rem; padding: 0.75rem 1rem; margin-bottom: 1.5rem; }
      .details { background: var(--soft); border-radius: 0.5rem; padding: 1.5rem; margin-top: 1.5rem; }
      .details dl { display: grid; grid-template-columns: 1fr; gap: 1rem; margin: 0; font-size: 0.875rem; }
      @media (min-width: 30rem) { .details dl { grid-template-columns: 1fr 1fr; } }
      .details dt { color: var(--muted); }
      .details dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
      label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.25rem; }
      input[type="text"] {
        width: 100%; padding: 0.75rem 0.5rem; font-size: 0.875rem; text-align: center;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        background: var(--card); color: var(--text); border: 1px solid var(--border); border-radius: 0.5rem;
      }
      @media (min-width: 30rem) { input[type="text"] { padding: 0.75rem 1rem; font-size: 1rem; letter-spacing: 0.05em; } }
      input[type="text"]:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
      .button {
        display: block; width: 100%; margin-top: 1.5rem; padding: 0.75rem 1rem; border: 0; border-radius: 0.5rem;
        background: var(--accent); color: #ffffff; font-size: 1rem; font-weight: 600; cursor: pointer; text-align: center; text-decoration: none;
      }
      .button:hover { background: var(--accent-dark); }
      .divider { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    </style>
  </head>
  <body>
    <header>
      <a href="<%= visas_host_verify_path %>"><img src="/flag.png" alt="Hack Club"></a>
    </header>
    <main>
      <% if flash[:alert].present? %>
        <div class="alert" role="alert"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer>
      <p>Questions? <a href="mailto:visas@hackclub.com">visas@hackclub.com</a></p>
      <p>&copy; <%= Date.current.year %> The Hack Foundation (EIN: 81-2908499). All rights reserved.</p>
    </footer>
  </body>
</html>

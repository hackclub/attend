<%# The event's dates moved after waivers went out, so the waivers people
    signed (or have yet to sign) still show the old dates. Stays up until the
    Attend team fixes the DocuSeal templates and clears it. %>
<div class="border-b-2 border-amber-400 bg-amber-50" role="alert" data-testid="waiver-dates-banner">
  <div class="px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row sm:items-center gap-4">
    <svg class="h-8 w-8 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
    </svg>
    <div class="flex-1 min-w-0">
      <p class="text-lg font-semibold text-amber-900">Reach out to Attend team to get waivers updated</p>
      <p class="mt-1 text-sm text-amber-800">
        <%= event.name %>'s dates changed on <%= event.waiver_dates_stale_since.in_time_zone(event.event_time_zone).strftime("%B %-d") %>, after waivers had been sent.
        Waivers still show the old dates until they're updated.
      </p>
    </div>
    <% if policy(event).clear_waiver_dates_warning? %>
      <div class="border-2 border-dashed border-orange-400 rounded-md p-1 self-start sm:self-center">
        <%= button_to "Waivers updated", clear_waiver_dates_warning_admin_event_path(event),
              method: :patch,
              form: { data: { turbo_confirm: "Have the DocuSeal templates been fixed and unsigned waivers resent?" } },
              class: "px-3 py-2 text-sm font-medium rounded-md bg-white text-amber-900 border border-amber-300 hover:bg-amber-100 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

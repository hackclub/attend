<%# The signed-in user's menu at the right edge of the console's top navigation. %>
<div class="relative" data-controller="dropdown">
  <button type="button" class="cs-topnav-utility" data-action="dropdown#toggle" aria-haspopup="true" aria-expanded="false" aria-label="Account menu for <%= current_user.display_name_or_fallback %>">
    <% if current_user.avatar_displayable? %>
      <%= image_tag current_user.avatar.variant(resize_to_fill: [ 48, 48 ]), class: "cs-avatar", alt: "" %>
    <% else %>
      <span class="cs-avatar" aria-hidden="true"><%= current_user.initials %></span>
    <% end %>
    <span class="hidden md:inline"><%= current_user.display_name_or_fallback %></span>
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </button>

  <div class="hidden cs-menu cs-menu-right" data-dropdown-target="menu">
    <p class="cs-menu-header truncate"><%= current_user.email %></p>
    <%= link_to dashboard_profile_path(anchor: "staff-settings"), class: "cs-menu-item" do %>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span class="cs-menu-item-label">Profile settings</span>
    <% end %>
    <div class="cs-menu-divider"></div>
    <div class="px-4 py-2">
      <p class="cs-kv-label mb-1">Theme</p>
      <%= render "shared/theme_picker", compact: true %>
      <p class="cs-small cs-muted mt-1">The console shows light themes in light mode and the rest in dark.</p>
    </div>
    <div class="cs-menu-divider"></div>
    <%= button_to destroy_user_session_path, method: :delete, class: "cs-menu-item", form: { class: "block" } do %>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      <span class="cs-menu-item-label">Sign out</span>
    <% end %>
  </div>
</div>

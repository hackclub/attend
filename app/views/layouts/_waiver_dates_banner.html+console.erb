<%# The event's dates moved after waivers went out, so the waivers people
    signed (or have yet to sign) still show the old dates. Stays up until
    someone regenerates the waivers, or the Attend team clears it after
    fixing them by hand. %>
<% can_regenerate = policy(event).regenerate_waivers? %>
<div class="cs-alert cs-alert-warning mb-5" role="alert" data-testid="waiver-dates-banner">
  <%= cs_status_icon(:warning) %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 w-full">
    <div>
      <p class="cs-alert-title">
        <%= can_regenerate ? "Waivers still show the old dates" : "Reach out to Attend team to get waivers updated" %>
      </p>
      <p>
        <%= event.name %>'s dates changed on <%= event.waiver_dates_stale_since.in_time_zone(event.event_time_zone).strftime("%B %-d") %>, after waivers had been sent.
        Waivers still show the old dates until they're updated.
      </p>
    </div>
    <div class="flex flex-wrap sm:flex-nowrap sm:shrink-0 items-center gap-2 self-start sm:self-auto">
      <% if can_regenerate %>
        <%= link_to "Update waivers", new_admin_event_waiver_regeneration_path(event), class: "cs-btn whitespace-nowrap" %>
      <% end %>
      <% if policy(event).clear_waiver_dates_warning? %>
        <span class="inline-flex border-2 border-dashed border-orange-400 rounded">
          <%= button_to "Dismiss", clear_waiver_dates_warning_admin_event_path(event),
                method: :patch,
                form: { data: { turbo_confirm: "Dismiss without regenerating? Only do this if the waivers were already fixed by hand." } },
                class: "cs-btn whitespace-nowrap" %>
        </span>
      <% end %>
    </div>
  </div>
</div>

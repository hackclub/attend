<% content_for :title, "Authorize #{@client_name}" %>
<style>
  .tc-wrap { display: flex; align-items: center; justify-content: center; padding: 2.5rem 1rem; min-height: 70vh; }
  .tc-card { width: 100%; max-width: 34rem; background: #14151d; border: 1px solid rgba(255,255,255,.10);
             border-radius: 16px; padding: 1.75rem; box-shadow: 0 24px 60px -20px rgba(0,0,0,.7); }
  .tc-head { display: flex; align-items: flex-start; gap: .75rem; margin-bottom: 1.25rem; }
  .tc-icon { flex: 0 0 auto; width: 2.75rem; height: 2.75rem; border-radius: 12px; display: flex;
             align-items: center; justify-content: center; background: rgba(236,55,80,.15); color: #ec3750; }
  .tc-title { font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0; line-height: 1.2; }
  .tc-sub { font-size: .875rem; color: rgba(255,255,255,.55); margin: .15rem 0 0; }
  .tc-trust { margin-bottom: 1.25rem; border: 1px solid rgba(255,255,255,.10); background: rgba(0,0,0,.25);
              border-radius: 8px; padding: .625rem .75rem; font-size: .75rem; line-height: 1.5; color: rgba(255,255,255,.6); }
  .tc-trust code { color: rgba(255,255,255,.85); word-break: break-all; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .tc-label { font-size: .875rem; font-weight: 500; color: rgba(255,255,255,.7); margin: 0 0 .75rem; }
  .tc-scopes { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
  .tc-scope { display: flex; align-items: flex-start; gap: .75rem; border: 1px solid rgba(255,255,255,.10);
              background: rgba(255,255,255,.03); border-radius: 8px; padding: .625rem .75rem; cursor: pointer; }
  .tc-scope.tc-sensitive { border-color: rgba(251,191,36,.3); background: rgba(251,191,36,.07); }
  .tc-scope input[type=checkbox] { margin-top: .15rem; width: 1rem; height: 1rem; flex: 0 0 auto; accent-color: #ec3750; }
  .tc-fixed { margin-top: .15rem; width: 1rem; height: 1rem; flex: 0 0 auto; border-radius: 4px; background: #ec3750;
              color: #fff; display: inline-flex; align-items: center; justify-content: center; }
  .tc-scope-name { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .875rem; font-weight: 600; color: #fff; }
  .tc-scope-desc { display: block; margin-top: .15rem; font-size: .875rem; color: rgba(255,255,255,.6); }
  .tc-badge { display: inline-block; margin-left: .4rem; border-radius: 999px; padding: .1rem .4rem; font-size: 10px;
              font-weight: 600; text-transform: uppercase; letter-spacing: .03em; vertical-align: middle; }
  .tc-badge.sensitive { background: rgba(251,191,36,.16); color: #fcd34d; }
  .tc-badge.required { background: rgba(255,255,255,.12); color: rgba(255,255,255,.65); }
  .tc-btn { display: block; width: 100%; border-radius: 8px; padding: .625rem 1rem; font-size: .875rem;
            font-weight: 600; text-align: center; cursor: pointer; border: 0; }
  .tc-btn-primary { background: #ec3750; color: #fff; box-shadow: 0 10px 30px -10px rgba(236,55,80,.6); }
  .tc-btn-primary:hover { background: #d42f46; }
  .tc-btn-ghost { margin-top: .75rem; background: transparent; color: rgba(255,255,255,.7);
                  border: 1px solid rgba(255,255,255,.15); font-weight: 500; }
  .tc-btn-ghost:hover { background: rgba(255,255,255,.05); color: #fff; }
  .tc-foot { margin-top: 1.5rem; text-align: center; font-size: .75rem; color: rgba(255,255,255,.4); }
  .tc-section { margin: 0 0 1.5rem; }
  .tc-error { margin-bottom: 1.25rem; border: 1px solid rgba(236,55,80,.45); background: rgba(236,55,80,.12);
              border-radius: 8px; padding: .625rem .75rem; font-size: .8125rem; color: #ffb3bf; }
  .tc-choice { display: flex; align-items: flex-start; gap: .75rem; border: 1px solid rgba(255,255,255,.10);
               background: rgba(255,255,255,.03); border-radius: 8px; padding: .625rem .75rem; cursor: pointer;
               margin-bottom: .5rem; }
  .tc-choice input { margin-top: .15rem; width: 1rem; height: 1rem; flex: 0 0 auto; accent-color: #ec3750; }
  .tc-choice-name { font-size: .875rem; font-weight: 600; color: #fff; }
  .tc-choice-desc { display: block; margin-top: .15rem; font-size: .8125rem; color: rgba(255,255,255,.6); }
  .tc-events { margin: 0 0 .25rem; border: 1px solid rgba(255,255,255,.10); border-radius: 8px;
               background: rgba(0,0,0,.25); max-height: 13rem; overflow-y: auto; padding: .25rem; }
  .tc-events[data-disabled="true"] { opacity: .45; }
  .tc-event { display: flex; align-items: center; gap: .625rem; padding: .375rem .5rem; border-radius: 6px;
              font-size: .8125rem; color: rgba(255,255,255,.8); cursor: pointer; }
  .tc-event:hover { background: rgba(255,255,255,.05); }
  .tc-event input { width: .9rem; height: .9rem; flex: 0 0 auto; accent-color: #ec3750; }
  .tc-event-dates { margin-left: auto; padding-left: .5rem; font-size: .6875rem; color: rgba(255,255,255,.4); white-space: nowrap; }
  .tc-filter { width: 100%; margin-bottom: .5rem; border-radius: 6px; border: 1px solid rgba(255,255,255,.12);
               background: rgba(0,0,0,.3); padding: .375rem .5rem; font-size: .8125rem; color: #fff; }
  .tc-filter::placeholder { color: rgba(255,255,255,.35); }
  .tc-empty { padding: .5rem; font-size: .8125rem; color: rgba(255,255,255,.45); }
  .tc-anon { border-color: rgba(56,189,248,.3); background: rgba(56,189,248,.07); }
  .tc-note { margin: .35rem 0 0; font-size: .75rem; color: rgba(255,255,255,.45); line-height: 1.5; }
</style>

<div class="tc-wrap">
  <div class="tc-card">
    <div class="tc-head">
      <span class="tc-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </span>
      <div>
        <h1 class="tc-title">Authorize <%= @client_name %></h1>
        <p class="tc-sub">wants to access your Attend account as <%= @current_resource_owner.try(:email) || "you" %></p>
      </div>
    </div>

    <% if @mcp_settings_error.present? %>
      <div class="tc-error"><%= @mcp_settings_error %></div>
    <% end %>

    <div class="tc-trust">
      After you authorize, you'll be sent to <code><%= @redirect_uri %></code>.
      Only continue if you started this from a tool you trust.
    </div>

    <%= form_tag @authorize_url, method: :post, data: { turbo: false } do %>
      <% @oauth_params&.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag "original_scope", @original_scope %>

      <% if @scope_list&.any? %>
        <p class="tc-label">This will be allowed to:</p>
        <ul class="tc-scopes">
          <% @scope_list.each do |s|
            sensitive = s[:description].to_s.include?("(sensitive)")
            description = s[:description].to_s.sub(/\s*\(sensitive\)\s*/, "") %>
            <li>
              <label class="tc-scope <%= "tc-sensitive" if sensitive %>">
                <% if @optional %>
                  <%= check_box_tag "scope[]", s[:name], true, disabled: s[:required], id: "scope_#{s[:name].parameterize}" %>
                  <% if s[:required] %><%= hidden_field_tag "scope[]", s[:name] %><% end %>
                <% else %>
                  <%= hidden_field_tag "scope[]", s[:name] %>
                  <span class="tc-fixed">
                    <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd"/></svg>
                  </span>
                <% end %>
                <span>
                  <span class="tc-scope-name"><%= s[:name] %></span>
                  <% if sensitive %><span class="tc-badge sensitive">sensitive</span><% end %>
                  <% if s[:required] %><span class="tc-badge required">required</span><% end %>
                  <span class="tc-scope-desc"><%= description %></span>
                </span>
              </label>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div class="tc-section" data-mcp-events>
        <p class="tc-label">Which events can it see?</p>

        <label class="tc-choice">
          <%= radio_button_tag "mcp_event_scope", "all", @mcp_event_scope != "selected", data: { mcp_scope: "all" } %>
          <span>
            <span class="tc-choice-name">Every event you can access</span>
            <span class="tc-choice-desc">Including events you're added to later.</span>
          </span>
        </label>

        <label class="tc-choice">
          <%= radio_button_tag "mcp_event_scope", "selected", @mcp_event_scope == "selected", data: { mcp_scope: "selected" } %>
          <span>
            <span class="tc-choice-name">Only the events I pick</span>
            <span class="tc-choice-desc">Anything outside them is invisible to this app, even where you have access.</span>
          </span>
        </label>

        <% if @mcp_events&.any? %>
          <% if @mcp_events.size > 8 %>
            <input type="search" class="tc-filter" placeholder="Filter events…" data-mcp-filter aria-label="Filter events">
          <% end %>
          <div class="tc-events" data-mcp-event-list data-disabled="<%= @mcp_event_scope != "selected" %>">
            <% @mcp_events.each do |event| %>
              <label class="tc-event" data-mcp-event-name="<%= event.name.to_s.downcase %>">
                <%= check_box_tag "mcp_event_ids[]", event.id,
                      @mcp_selected_event_ids.include?(event.id.to_s),
                      id: "mcp_event_#{event.id}",
                      disabled: @mcp_event_scope != "selected" %>
                <span><%= event.name %></span>
                <% if event.starts_at %>
                  <span class="tc-event-dates"><%= event.starts_at.strftime("%b %Y") %></span>
                <% end %>
              </label>
            <% end %>
          </div>
        <% else %>
          <div class="tc-events"><p class="tc-empty">You don't have access to any events yet.</p></div>
        <% end %>
      </div>

      <div class="tc-section">
        <p class="tc-label">Privacy</p>
        <label class="tc-choice tc-anon">
          <%= check_box_tag "mcp_anonymize", "1", @mcp_anonymize %>
          <span>
            <span class="tc-choice-name">Anonymise everything</span>
            <span class="tc-choice-desc">
              Names come back as initials, and emails, phone numbers and addresses are
              stripped from every response. The app also becomes read-only, so it can't
              change anything in Attend.
            </span>
          </span>
        </label>
        <p class="tc-note">
          The app can switch anonymising on for itself, but never off. Turning it back off
          means reconnecting the app from Attend.
        </p>
      </div>

      <%= submit_tag "Authorize", class: "tc-btn tc-btn-primary" %>
    <% end %>

    <%= form_tag @authorize_url, method: :delete, data: { turbo: false } do %>
      <% @oauth_params&.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= submit_tag "Deny", class: "tc-btn tc-btn-ghost" %>
    <% end %>

    <p class="tc-foot">
      You can change or revoke access anytime.
      <% if @optional %>Uncheck anything you don't want to grant.<% end %>
    </p>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  // Progressive only: without JS every checkbox is server-rendered in the right
  // state, and the server re-checks the scope choice on POST either way.
  (function () {
    var section = document.querySelector('[data-mcp-events]');
    if (!section) return;

    var list = section.querySelector('[data-mcp-event-list]');
    var boxes = section.querySelectorAll('input[name="mcp_event_ids[]"]');
    var radios = section.querySelectorAll('input[name="mcp_event_scope"]');
    var filter = section.querySelector('[data-mcp-filter]');

    function sync() {
      var picking = section.querySelector('[data-mcp-scope="selected"]').checked;
      if (list) list.setAttribute('data-disabled', picking ? 'false' : 'true');
      boxes.forEach(function (box) { box.disabled = !picking; });
      if (filter) filter.disabled = !picking;
    }

    radios.forEach(function (radio) { radio.addEventListener('change', sync); });

    boxes.forEach(function (box) {
      box.addEventListener('change', function () {
        if (box.checked) section.querySelector('[data-mcp-scope="selected"]').checked = true;
        sync();
      });
    });

    if (filter) {
      filter.addEventListener('input', function () {
        var term = filter.value.trim().toLowerCase();
        section.querySelectorAll('[data-mcp-event-name]').forEach(function (row) {
          var hit = !term || row.getAttribute('data-mcp-event-name').indexOf(term) !== -1;
          row.style.display = hit ? '' : 'none';
        });
      });
    }

    sync();
  })();
<% end %>

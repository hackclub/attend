<%# One line explaining the S0–S3 badges on a list page. %>
<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600 mb-6">
  <% IncidentLevel::LEVELS.each do |level| %>
    <span class="inline-flex items-center gap-1.5"><%= incident_level_badge(level.key) %> <span><%= level.name %> · <%= level.target %></span></span>
  <% end %>
  <%= link_to "Triage chart →", incident_levels_docs_path, target: "_blank", rel: "noopener", class: "text-[#ec3750] hover:text-[#d42f46] font-medium" %>
</div>

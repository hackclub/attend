<%# Download → physically sign → upload-a-photo UI for a physical custom
    document. Locals:
      custom_document:  the CustomDocument
      consent:          the Consent (may have uploads already)
      participant_event: the ParticipantEvent
      upload_url:       where the upload form posts
      remove_url_for:   lambda taking an upload attachment, returning the
                        DELETE path that removes it %>
<% both_sign = custom_document.participant_signs? && custom_document.guardian_signs? && participant_event.requires_guardian? %>

<div class="border border-gray-200 rounded-lg bg-white p-5">
  <% if custom_document.description.present? %>
    <div class="mb-4"><%= simple_format(custom_document.description, class: "text-sm text-gray-600") %></div>
  <% end %>

  <ol class="space-y-3 mb-5">
    <li class="flex gap-3 text-sm text-gray-700">
      <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-semibold shrink-0">1</span>
      <div>
        <p class="font-medium text-gray-900">Download and print the document</p>
        <% if custom_document.template_pdf.attached? %>
          <%= link_to rails_blob_path(custom_document.template_pdf, disposition: "attachment"),
              class: "inline-flex items-center gap-1.5 mt-1 text-blue-600 hover:text-blue-800 font-medium" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Download <%= custom_document.name %> (PDF)
          <% end %>
        <% else %>
          <p class="text-red-600 mt-1">The document isn't available to download — please contact the event team.</p>
        <% end %>
      </div>
    </li>
    <li class="flex gap-3 text-sm text-gray-700">
      <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-semibold shrink-0">2</span>
      <div>
        <p class="font-medium text-gray-900">Sign it physically</p>
        <p class="text-gray-600 mt-0.5">
          <% if both_sign %>
            Both you and your parent/guardian need to sign the printed document in ink.
          <% else %>
            Sign the printed document in ink — electronic signatures can't be accepted for this one.
          <% end %>
        </p>
      </div>
    </li>
    <li class="flex gap-3 text-sm text-gray-700">
      <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-semibold shrink-0">3</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium text-gray-900">Take a photo of the signed document and upload it</p>
        <p class="text-gray-600 mt-0.5">Make sure every page and signature is clearly visible. You can upload multiple photos or a PDF scan.</p>
      </div>
    </li>
  </ol>

  <% if consent&.physical_uploaded? %>
    <div class="border border-gray-200 rounded-lg p-3 mb-4 bg-gray-50">
      <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-medium text-gray-900">Uploaded so far</p>
        <% if custom_document.template_page_count %>
          <p class="text-xs text-gray-500"><%= consent.physical_uploads.size %> of <%= custom_document.template_page_count %> <%= "file".pluralize(custom_document.template_page_count) %> uploaded</p>
        <% end %>
      </div>
      <ul class="space-y-1">
        <% consent.physical_uploads.each do |upload| %>
          <li class="flex items-center gap-2 text-sm">
            <%= link_to upload.filename, viewable_upload_path(upload), target: "_blank",
                class: "text-blue-600 hover:underline" %>
            <span class="text-gray-400">· <%= number_to_human_size(upload.byte_size) %></span>
            <% unless consent.signed? %>
              <%= button_to "Remove", remove_url_for.call(upload), method: :delete,
                  data: { turbo_confirm: "Remove #{upload.filename}? You can upload a replacement afterwards." },
                  form_class: "inline-flex",
                  class: "text-xs text-red-600 hover:text-red-800 hover:underline cursor-pointer" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: upload_url, method: :post, multipart: true, data: { turbo: false } do %>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <%= consent&.physical_uploaded? ? "Add more photos" : "Upload photo(s) of the signed document" %>
    </label>
    <input type="file" name="consent[physical_uploads][]" multiple required
           accept="image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
           class="block w-full text-sm text-gray-700 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
    <button type="submit" class="mt-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition-colors cursor-pointer">
      Upload
    </button>
  <% end %>

  <% if both_sign %>
    <p class="text-xs text-gray-500 mt-3">
      After you upload, your parent/guardian will review the photo and confirm the document is complete.
    </p>
  <% end %>
</div>

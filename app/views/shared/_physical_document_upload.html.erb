<%# Download → physically sign → upload-a-photo UI for a physical custom
    document. Locals:
      custom_document:  the CustomDocument
      consent:          the Consent (may have uploads already)
      participant_event: the ParticipantEvent
      upload_url:       where the upload form posts
      remove_url_for:   lambda taking an upload attachment, returning the
                        DELETE path that removes it %>
<% both_sign = custom_document.participant_signs? && custom_document.guardian_signs? && participant_event.requires_guardian? %>

<div class="portal-card p-5 sm:p-6">
  <% if custom_document.description.present? %>
    <div class="mb-5"><%= simple_format(custom_document.description, class: "portal-body text-sm") %></div>
  <% end %>

  <ol class="space-y-4 mb-6">
    <li class="flex gap-3">
      <span class="portal-step-marker shrink-0">1</span>
      <div class="min-w-0">
        <p class="portal-heading text-sm">Download and print it</p>
        <% if custom_document.template_pdf.attached? %>
          <%= link_to rails_blob_path(custom_document.template_pdf, disposition: "attachment"),
              class: "portal-link inline-flex items-center gap-1.5 mt-1 text-sm" do %>
            <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            Download <%= custom_document.name %> (PDF)
          <% end %>
        <% else %>
          <p class="text-sm mt-1" style="color: var(--danger);">
            The document isn't available to download — please contact the event team.
          </p>
        <% end %>
      </div>
    </li>

    <li class="flex gap-3">
      <span class="portal-step-marker shrink-0">2</span>
      <div class="min-w-0">
        <p class="portal-heading text-sm">Sign it in ink</p>
        <p class="portal-hint text-sm mt-0.5">
          <% if both_sign %>
            Both you and your parent or guardian need to sign the printed copy.
          <% else %>
            Electronic signatures can't be accepted for this one.
          <% end %>
        </p>
      </div>
    </li>

    <li class="flex gap-3">
      <span class="portal-step-marker shrink-0">3</span>
      <div class="min-w-0 flex-1">
        <p class="portal-heading text-sm">Photograph it and upload</p>
        <p class="portal-hint text-sm mt-0.5">
          Every page and signature needs to be readable. Several photos or a PDF scan are both fine.
        </p>
      </div>
    </li>
  </ol>

  <% if consent&.physical_uploaded? %>
    <div class="portal-panel p-4 mb-5">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-2">
        <p class="portal-heading text-sm">Uploaded so far</p>
        <% if custom_document.template_page_count %>
          <p class="portal-meta text-xs"><%= "#{consent.physical_uploads.size} of #{custom_document.template_page_count} #{'file'.pluralize(custom_document.template_page_count)}" %></p>
        <% end %>
      </div>
      <ul class="space-y-1.5">
        <% consent.physical_uploads.each do |upload| %>
          <li class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
            <%= link_to upload.filename, viewable_upload_path(upload), target: "_blank", rel: "noopener", class: "portal-link break-all" %>
            <span class="portal-meta"><%= number_to_human_size(upload.byte_size) %></span>
            <% unless consent.signed? %>
              <%= button_to remove_url_for.call(upload), method: :delete,
                  data: { turbo_confirm: "Remove #{upload.filename}? You can upload a replacement afterwards." },
                  form_class: "inline-flex",
                  class: "text-xs font-medium underline underline-offset-2 cursor-pointer",
                  style: "color: var(--danger);" do %>
                Remove<span class="sr-only"> <%= upload.filename %></span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: upload_url, method: :post, multipart: true, data: { turbo: false } do %>
    <%= label_tag :physical_uploads, consent&.physical_uploaded? ? "Add more photos" : "Upload photo(s) of the signed document", class: "portal-label" %>
    <input type="file" name="consent[physical_uploads][]" id="physical_uploads" multiple required
           accept="image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
           class="portal-file">
    <button type="submit" class="portal-btn portal-btn-primary mt-4 w-full sm:w-auto">
      Upload
    </button>
  <% end %>

  <% if both_sign %>
    <p class="portal-hint text-sm mt-4">
      After you upload, your parent or guardian reviews the photo and confirms the document is complete.
    </p>
  <% end %>
</div>

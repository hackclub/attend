<%# Skeleton "document being prepared" loader.
    Locals: title (optional), message (optional) %>
<% title ||= "Preparing your document" %>
<% message ||= "This usually takes a few seconds — the page will refresh automatically." %>

<div class="portal-card p-6 sm:p-8">
  <div class="mx-auto max-w-sm">
    <!-- Skeleton document -->
    <div class="portal-panel p-5">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 rounded-lg animate-pulse portal-skeleton"></div>
        <div class="flex-1 space-y-2">
          <div class="h-2.5 w-1/2 rounded-full animate-pulse portal-skeleton"></div>
          <div class="h-2 w-1/3 rounded-full animate-pulse portal-skeleton"></div>
        </div>
      </div>
      <div class="space-y-2.5">
        <div class="h-2.5 w-full rounded-full animate-pulse portal-skeleton"></div>
        <div class="h-2.5 w-11/12 rounded-full animate-pulse portal-skeleton"></div>
        <div class="h-2.5 w-full rounded-full animate-pulse portal-skeleton"></div>
        <div class="h-2.5 w-2/3 rounded-full animate-pulse portal-skeleton"></div>
      </div>
      <div class="mt-5 pt-4 portal-inset flex items-center justify-between">
        <div class="h-2 w-24 rounded-full animate-pulse portal-skeleton"></div>
        <div class="h-8 w-24 rounded-lg animate-pulse portal-skeleton-strong"></div>
      </div>
    </div>

    <div class="mt-6 text-center">
      <div class="flex items-center justify-center gap-1.5 mb-3" aria-hidden="true">
        <span class="w-2 h-2 rounded-full portal-dot [animation-delay:-0.3s]"></span>
        <span class="w-2 h-2 rounded-full portal-dot [animation-delay:-0.15s]"></span>
        <span class="w-2 h-2 rounded-full portal-dot"></span>
      </div>
      <p class="portal-heading"><%= title %></p>
      <p class="portal-hint text-sm mt-1"><%= message %></p>
    </div>
  </div>
</div>

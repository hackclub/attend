<%# Skeleton "document being prepared" loader.
    Locals: title (optional), message (optional) %>
<% title ||= "Preparing your document" %>
<% message ||= "This usually takes a few seconds — the page will refresh automatically." %>

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8">
  <div class="mx-auto max-w-sm">
    <!-- Skeleton document -->
    <div class="rounded-xl border border-gray-200 bg-gray-50 p-5">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 rounded-lg bg-gray-200 animate-pulse"></div>
        <div class="flex-1 space-y-2">
          <div class="h-2.5 w-1/2 rounded-full bg-gray-200 animate-pulse"></div>
          <div class="h-2 w-1/3 rounded-full bg-gray-200 animate-pulse"></div>
        </div>
      </div>
      <div class="space-y-2.5">
        <div class="h-2.5 w-full rounded-full bg-gray-200 animate-pulse"></div>
        <div class="h-2.5 w-11/12 rounded-full bg-gray-200 animate-pulse"></div>
        <div class="h-2.5 w-full rounded-full bg-gray-200 animate-pulse"></div>
        <div class="h-2.5 w-2/3 rounded-full bg-gray-200 animate-pulse"></div>
      </div>
      <div class="mt-5 pt-4 border-t border-gray-200 flex items-center justify-between">
        <div class="h-2 w-24 rounded-full bg-gray-200 animate-pulse"></div>
        <div class="h-8 w-24 rounded-lg bg-gray-300 animate-pulse"></div>
      </div>
    </div>

    <div class="mt-6 text-center">
      <div class="flex items-center justify-center gap-1.5 mb-3" aria-hidden="true">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-bounce [animation-delay:-0.3s]"></span>
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-bounce [animation-delay:-0.15s]"></span>
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-bounce"></span>
      </div>
      <p class="text-gray-900 font-medium"><%= title %></p>
      <p class="text-sm text-gray-500 mt-1"><%= message %></p>
    </div>
  </div>
</div>
